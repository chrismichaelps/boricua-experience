/** @Constants.Limits.Bounds — sizes, counts, and windows */
module Constants.Limits

/// Event field lengths, matching the database checks.
export const TITLE_MIN: Int = 4
export const TITLE_MAX: Int = 120
export const SUMMARY_MIN: Int = 10
export const SUMMARY_MAX: Int = 200
export const DESCRIPTION_MAX: Int = 5000
export const INSTRUCTIONS_MAX: Int = 2000
export const VENUE_MIN: Int = 2
export const VENUE_MAX: Int = 120
/// Shortest place name.
export const PLACE_NAME_MIN: Int = 2
export const ADDRESS_MAX: Int = 200
export const CAPACITY_MAX: Int = 100000
export const PRICE_MAX_CENTS: Int = 10000000
/// Longest event, in hours.
export const EVENT_MAX_HOURS: Int = 336

/// Account field lengths.
export const DISPLAY_NAME_MAX: Int = 60
export const BIO_MAX: Int = 280
export const MESSAGE_MAX: Int = 500
export const REPORT_DETAIL_MAX: Int = 1000
export const EMAIL_MAX: Int = 254
export const PASSWORD_MIN: Int = 8
export const PASSWORD_MAX: Int = 72
export const QUERY_MAX: Int = 120

/// Results per page of a listing.
export const PAGE_SIZE: Int = 24
/// Recommendations on the home page.
export const RECOMMENDED_COUNT: Int = 12
/// Events in a home rail.
export const RAIL_COUNT: Int = 10
/// Upcoming events read to choose hidden gems from.
export const GEMS_POOL: Int = 60
/// Most joins, saves, and likes an event may have and still count as a hidden gem.
export const GEM_ENGAGEMENT_MAX: Int = 3
/// Nearby towns listed on a town page.
export const NEIGHBOR_COUNT: Int = 6
/// Pins on the map.
export const MAP_PINS: Int = 60
/// Search suggestions.
export const SUGGEST_COUNT: Int = 6
/// Default and largest radius for nearby searches, in metres.
export const NEARBY_RADIUS_M: Int = 15000
export const RADIUS_MAX_M: Int = 200000

/// Seconds an access token may have left before it is refreshed.
export const REFRESH_MARGIN_SECONDS: Int = 60
/// Seconds since sign-in within which a Google account may delete itself without a password.
export const RECENT_SIGN_IN_SECONDS: Int = 600
/// Milliseconds reference data is kept per instance.
export const CATALOG_TTL_MILLIS: Int = 600000
/// Largest request body read, in bytes; room for one base64 photo.
export const BODY_BYTES_MAX: Int = 1048576
/// Largest accepted photo after the browser resizes it, in bytes.
export const AVATAR_BYTES_MAX: Int = 614400
/// Largest place photograph or menu document stored, in bytes; enforced again by the database and bucket.
export const MEDIA_BYTES_MAX: Int = 3145728
/// Longest label of a menu document.
export const MEDIA_LABEL_MAX: Int = 80
/// Leading bytes read back from storage to confirm a file is what its upload declared.
export const MEDIA_SIGNATURE_BYTES: Int = 16

/// Contact form bounds: name and message lengths, and the seconds a genuine visitor needs at least
/// and may take at most between opening the form and sending it.
export const CONTACT_NAME_MIN: Int = 2
export const CONTACT_NAME_MAX: Int = 80
export const CONTACT_BODY_MIN: Int = 20
export const CONTACT_BODY_MAX: Int = 3000
export const CONTACT_MIN_SECONDS: Int = 4
export const CONTACT_MAX_SECONDS: Int = 7200
/// Summaries sent in one daily run, under the mail provider's free allowance of one hundred a day.
export const DIGEST_BATCH: Int = 80

/// Web addresses a contact message may carry; more reads as link spam.
export const CONTACT_LINKS_MAX: Int = 3

/// Highest stated activity age floor.
export const ACTIVITY_MIN_AGE_MAX: Int = 21
