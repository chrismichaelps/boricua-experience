    ("external_booking", "problem.external_booking"),
    ("event_full", "problem.event_full"),
    ("event_held", "problem.event_held"),
    ("event_cancelled", "problem.event_cancelled"),
    ("event_ended", "problem.event_ended"),
    ("own_event", "problem.own_event"),
    ("already_requested", "problem.already_requested"),
    ("request_rejected", "problem.request_rejected"),
    ("already_decided", "problem.already_decided"),
