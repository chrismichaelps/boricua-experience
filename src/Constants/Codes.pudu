    ("media_too_large", "media.too_large"),
    ("media_limit", "media.limit"),
    ("media_unsupported", "media.unsupported"),
    ("not_authenticated", "problem.signed_out"),
    ("profile_missing", "problem.signed_out"),
    ("onboarding_required", "problem.onboarding"),
    ("account_paused", "problem.paused"),
    ("forbidden", "problem.forbidden"),
    ("not_found", "problem.not_found"),
    ("place_exists", "problem.place_exists"),
    ("too_many_places", "problem.too_many_places"),
    ("invalid_details", "problem.invalid_details"),
    ("missing_details", "problem.invalid_details"),
    ("invalid_hours", "form.hours_invalid"),
    ("not_owner", "problem.forbidden"),
    ("own_place", "problem.own_place"),
    ("account_too_new", "problem.account_too_new"),
    ("too_many_reviews", "problem.too_many_reviews"),
    ("review_removed", "problem.review_removed"),
    ("own_review", "problem.own_review"),
    ("invalid_rating", "review.rating_required"),
