/** @Constants.Codes.Problems — failure codes and their message keys */
module Constants.Codes

/// Failure codes the database API raises, each mapped to the message key shown to a person.
/// A code missing here is shown with `problem.generic`.
export const MESSAGES: Map[Str, Str] = mapOf([
  ("not_authenticated", "problem.signed_out"),
  ("profile_missing", "problem.signed_out"),
  ("onboarding_required", "problem.onboarding"),
  ("account_paused", "problem.paused"),
  ("forbidden", "problem.forbidden"),
  ("not_found", "problem.not_found"),
  ("event_full", "problem.event_full"),
  ("event_cancelled", "problem.event_cancelled"),
  ("event_ended", "problem.event_ended"),
  ("own_event", "problem.own_event"),
  ("already_requested", "problem.already_requested"),
  ("request_rejected", "problem.request_rejected"),
  ("already_decided", "problem.already_decided"),
  ("capacity_below_approved", "problem.capacity_below_approved"),
  ("starts_in_past", "problem.starts_in_past"),
  ("too_many_events", "problem.too_many_events"),
  ("invalid_schedule", "problem.invalid_schedule"),
  ("schedule_too_long", "problem.schedule_too_long"),
  ("invalid_coordinates", "problem.invalid_coordinates"),
  ("outside_puerto_rico", "problem.outside_puerto_rico"),
  ("private_requires_approval", "problem.private_requires_approval"),
  ("invalid_category", "problem.invalid_category"),
  ("invalid_municipality", "problem.invalid_municipality"),
  ("adult_required", "problem.adult_required"),
  ("consent_required", "problem.consent_required"),
  ("invalid_credentials", "problem.invalid_credentials"),
  ("email_taken", "problem.email_taken"),
  ("weak_password", "problem.weak_password"),
  ("email_not_confirmed", "problem.email_not_confirmed"),
  ("rate_limited", "problem.rate_limited"),
  ("unavailable", "problem.unavailable"),
  ("flow_expired", "problem.flow_expired"),
  ("session_expired", "problem.session_expired"),
  ("reauthenticate", "problem.reauthenticate"),
  ("invalid_avatar", "problem.invalid_avatar")
])

/// Codes the server itself raises.
export const UNAVAILABLE: Str = "unavailable"
export const INVALID_INPUT: Str = "invalid_input"
export const INVALID_CREDENTIALS: Str = "invalid_credentials"
export const EMAIL_TAKEN: Str = "email_taken"
export const WEAK_PASSWORD: Str = "weak_password"
export const EMAIL_NOT_CONFIRMED: Str = "email_not_confirmed"
export const RATE_LIMITED: Str = "rate_limited"
export const NOT_AUTHENTICATED: Str = "not_authenticated"
export const FORBIDDEN: Str = "forbidden"
export const NOT_FOUND: Str = "not_found"
export const SESSION_EXPIRED: Str = "session_expired"
export const FLOW_EXPIRED: Str = "flow_expired"
