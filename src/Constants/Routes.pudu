/** @Constants.Routes.Paths — every address the server answers */
module Constants.Routes

/// Home: search, categories, and recommendations.
export const HOME: Str = "/"
/// Search results and filters.
export const SEARCH: Str = "/search"
/// The map of upcoming events.
export const MAP: Str = "/map"
/// Prefix of an event page; the slug follows.
export const EVENT_PREFIX: Str = "/e/"
export const EVENT: Str = "/e/:slug"
export const EVENT_EDIT: Str = "/e/:slug/edit"
export const EVENT_MANAGE: Str = "/e/:slug/requests"
