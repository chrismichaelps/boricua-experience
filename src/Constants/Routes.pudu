export const EVENT_CANCEL: Str = "/e/:slug/cancel"
export const EVENT_CALENDAR: Str = "/e/:slug/calendar.ics"
/// A decision on one join request.
export const REQUEST_DECIDE: Str = "/requests/:id/decide"
/// Prefix of a category page; the slug follows.
export const CATEGORY_PREFIX: Str = "/c/"
export const CATEGORY: Str = "/c/:slug"
/// Prefix of a municipality page; the slug follows.
export const TOWN_PREFIX: Str = "/pueblo/"
