/** @Constants.Assistant.Bounds — free inference and public discovery limits */
module Constants.Assistant

/// Conversation and transport bounds.
export const BODY_MAX: Int = 24000
export const MESSAGE_MAX: Int = 1200
export const HISTORY_MAX: Int = 6
export const RESULTS: Int = 6
/// The service-only reservation RPC: whether an answer may start, and why not.
export const QUOTA: Str = "assistant_reserve"

/// Maximum reference rows returned by a catalog tool call.
export const CATALOG_MAX: Int = 24
