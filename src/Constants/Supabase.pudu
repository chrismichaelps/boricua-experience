/// Path prefixes under the project address.
export const RPC_PATH: Str = "rest/v1/rpc/"
export const AUTH_PATH: Str = "auth/v1/"
/// Storage paths: writes go to `STORAGE_OBJECT`, public reads come from `STORAGE_PUBLIC`.
export const STORAGE_OBJECT: Str = "storage/v1/object/"
export const STORAGE_PUBLIC: Str = "storage/v1/object/public/"
/// The bucket of member photos and the file each member's photo is stored as.
export const AVATAR_BUCKET: Str = "avatars"
export const AVATAR_FILE: Str = "avatar.webp"
/// The bucket of place photographs and menu documents, written only by the server.
export const MEDIA_BUCKET: Str = "place-media"
/// Signed one-path upload addresses, minted with the service key; the storage API path they answer is
/// relative to `STORAGE_ROOT`.
export const STORAGE_UPLOAD_SIGN: Str = "storage/v1/object/upload/sign/"
export const STORAGE_ROOT: Str = "storage/v1"

/// Identity endpoints, relative to `AUTH_PATH`.
export const AUTH_SIGN_UP: Str = "signup"
export const AUTH_TOKEN: Str = "token"
export const AUTH_RECOVER: Str = "recover"
export const AUTH_USER: Str = "user"
export const AUTH_LOGOUT: Str = "logout"
export const AUTH_AUTHORIZE: Str = "authorize"
export const AUTH_ADMIN_USERS: Str = "admin/users/"

/// Headers the platform reads.
export const API_KEY_HEADER: Str = "apikey"
export const PROFILE_HEADER: Str = "content-profile"

/// Name of the named HTTP client every call uses.
export const CLIENT_NAME: Str = "supabase"
/// Milliseconds one call may take, attempts included.
export const CALL_TIMEOUT_MILLIS: Int = 8000
/// Milliseconds one attempt may take.
export const ATTEMPT_TIMEOUT_MILLIS: Int = 4000

/// Service-only contact relay: record a message under rate windows, then mark its delivery.
export const SUBMIT_CONTACT: Str = "submit_contact"
export const MARK_CONTACT: Str = "mark_contact"
