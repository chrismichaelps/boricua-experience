/** @Api.Plans.Client — plans near a point, a shared plan, and a plan's road route */
module Api.Plans

import Std.Json as Json
import Api.Supabase.Gateway as Gateway
import Constants.Supabase as Supabase
import Domain.Plan as Plan
import Domain.Problem as Problem

/// Plans of nearby activities between two instants, best first.
export fn outings(gateway: &Gateway.Gateway, request: &Plan.Request, from: Str, to: Str) -> Result[Plan.Outings, Problem.Problem] {
  Gateway.query(gateway, Supabase.PLAN_OUTINGS, &[
      ("p_lat", Gateway.fraction(Some(request.lat))),
      ("p_lng", Gateway.fraction(Some(request.lng))),
      ("p_from", Gateway.text(from)),
      ("p_to", Gateway.text(to)),
      ("p_style", Gateway.text(request.style)),
      ("p_stops", Json.Number(request.stops)),
      ("p_mode", Gateway.text(Plan.modeName(&request.mode))),
      ("p_radius_m", Json.Number(request.radiusM)),
      ("p_seed", Json.Number(request.seed))
    ], None, Gateway.Read)
}

/// One plan rebuilt from its activities in order.
export fn shared(gateway: &Gateway.Gateway, slugs: &Array[Str]) -> Result[Plan.Outings, Problem.Problem] {
  Gateway.query(gateway, Supabase.PLAN_OF, &[("p_slugs", Json.list(&slugs.map(|slug: Str| Json.Text(slug))))], None, Gateway.Read)
}

/// The ways to reach each stop after the first, fastest first; working out a leg's options may write them.
export fn routeOptions(gateway: &Gateway.Gateway, slugs: &Array[Str]) -> Result[Json.Json, Problem.Problem] {
  Gateway.call(gateway, Supabase.PLAN_ROUTE_OPTIONS, &[("p_slugs", Json.list(&slugs.map(|slug: Str| Json.Text(slug))))], None, Gateway.Write)
}

/// The island's next 48 hours of weather by town, from the stored forecasts.
export fn weather(gateway: &Gateway.Gateway) -> Result[Json.Json, Problem.Problem] {
  Gateway.call(gateway, Supabase.ISLAND_WEATHER, &[], None, Gateway.Read)
}

/// The ways from a rounded position to an activity; working them out may write the route between junctions.
export fn approach(gateway: &Gateway.Gateway, lat: Float64, lng: Float64, slug: Str) -> Result[Json.Json, Problem.Problem] {
  Gateway.call(gateway, Supabase.APPROACH_OPTIONS, &[("p_lat", Gateway.fraction(Some(lat))), ("p_lng", Gateway.fraction(Some(lng))), ("p_slug", Gateway.text(slug))], None, Gateway.Write)
}

/// Confirms a trip stop for the member and answers what it unlocked; the position is not stored.
export fn arrive(gateway: &Gateway.Gateway, arrival: &Plan.Arrival, locale: Str, token: Str) -> Result[Plan.Arrived, Problem.Problem] {
  Gateway.query(gateway, Supabase.RECORD_TRIP_ARRIVAL, &[
      ("p_slug", Gateway.text(arrival.slug)),
      ("p_lat", Gateway.fraction(Some(arrival.lat))),
      ("p_lng", Gateway.fraction(Some(arrival.lng))),
      ("p_plan", Json.list(&arrival.plan.map(|slug: Str| Json.Text(slug)))),
      ("p_locale", Gateway.text(locale))
    ], Some(token), Gateway.Write)
}

/// The road route between the activities in order, as drawing coordinates per leg.
export fn route(gateway: &Gateway.Gateway, slugs: &Array[Str]) -> Result[Json.Json, Problem.Problem] {
  Gateway.call(gateway, Supabase.PLAN_ROUTE, &[("p_slugs", Json.list(&slugs.map(|slug: Str| Json.Text(slug))))], None, Gateway.Read)
}
