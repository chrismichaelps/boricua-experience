/** @Services.Admin.Moderation — the administrator's dashboard and decisions */
module Services.Admin

import Api.Admin as AdminApi
import Api.Reviews as ReviewsApi
import Domain.Admin as Admin
import Domain.Problem as Problem
import Domain.Review as Review
import Domain.Session as Session
import Services.Runtime as Runtime

/** @Services.Admin.Dashboard — counts and open reports together */
export type Dashboard = { overview: Admin.Overview, reports: Array[Admin.Report], reviews: Array[Review.ReportedReview], funnel: Array[Admin.Channel] }

/// The dashboard; the database refuses anyone who is not an administrator.
export fn dashboard(runtime: &Runtime.Runtime, session: &Session.Session) -> Result[Dashboard, Problem.Problem] {
  let overview = AdminApi.overview(&runtime.gateway, session.accessToken) ?
  let reports = AdminApi.reports(&runtime.gateway, session.accessToken) ?
  let reviews = ReviewsApi.queue(&runtime.gateway, session.accessToken) ?
  // The funnel is a convenience: the dashboard still opens when it cannot be read.
  let funnel = match AdminApi.funnel(&runtime.gateway, session.accessToken) {
    case Ok(found) => found
    case Err(_) => []
  }
  Ok(Dashboard{overview: overview, reports: reports, reviews: reviews, funnel: funnel})
}

/// Decisions an administrator may take on a report: dismiss it, cancel the activity, restore a held
/// activity, or hold it while reviewing.
const ACTIONS: Set[Str] = setOf(["dismissed", "actioned", "restore", "hold"])

/// Applies one decision on a report; anything outside the known decisions is refused before the call.
export fn resolve(runtime: &Runtime.Runtime, reportId: Int, action: Str, session: &Session.Session) -> Result[(), Problem.Problem] {
  if !ACTIONS.contains(action) { return Err(Problem.Refused("invalid_action")) }
  AdminApi.resolve(&runtime.gateway, reportId, action, session.accessToken)
}
