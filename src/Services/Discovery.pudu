/** @Services.Discovery.Feed — the home feed, search, suggestions, and the map */
module Services.Discovery

import Std.Concurrent as Concurrent
import Std.Option as Option
import Std.Result as Result
import Std.Sync as Sync
import Std.Time as StdTime
import Api.Events as EventsApi
import Constants.Limits as Limits
import Domain.Event as Event
import Domain.Problem as Problem
import Domain.Search as Search
import Services.Runtime as Runtime
import Utils.Time as Time

/** @Services.Discovery.Home — the rails the home page shows; no event appears in more than one */
export type Home = { recommended: Array[Event.Card], soon: Array[Event.Card], weekend: Array[Event.Card], free: Array[Event.Card], gems: Array[Event.Card] }

/** @Services.Discovery.Raw — the rails as the database answered them, before deduplication */
export type Raw = { recommended: Array[Event.Card], soon: Array[Event.Card], weekend: Array[Event.Card], free: Array[Event.Card], month: Array[Event.Card] }

/// Milliseconds in a day.
const DAY_MILLIS: Int = 86400000
/// Saturday and Sunday as weekdays, Sunday = 0.
const SATURDAY: Int = 6

/// The window's first and last instants as database timestamps; empty for any time.
export fn bounds(window: &Search.When, now: &StdTime.Instant) -> (Str, Str) {
  let today = Time.dayNumber(now)
  let weekday = Time.local(now).weekday
  let span = match window {
    case Search.Anytime => None
    case Search.Today => Some((today, today + 1))
    case Search.Tomorrow => Some((today + 1, today + 2))
    case Search.Weekend => {
      let untilSaturday = if weekday == 0 { -1 } else { SATURDAY - weekday }
      Some((today + untilSaturday, today + untilSaturday + 2))
    }
    case Search.Week => Some((today, today + 7))
    case Search.Month => Some((today, today + 31))
  }
  match span {
    case Some((first, last)) => {
      let from = Time.startOfDay(first)
      let start = if from.millis < now.millis { StdTime.instantOf(now.millis - DAY_MILLIS / 2) } else { from }
      (Time.toTimestamp(&start), Time.toTimestamp(&Time.startOfDay(last)))
    }
    case None => ("", "")
  }
}

/// The database arguments for a visitor's filters.
export fn argumentsFor(filters: &Search.Filters, limit: Int, now: &StdTime.Instant) -> EventsApi.SearchArgs {
  let (from, to) = bounds(&filters.window, now)
  let sort = if filters.sort == Search.Near && filters.lat == None { Search.Soon } else { filters.sort }
  let ranked = if sort == Search.Relevant && filters.query.trim().isEmpty() { Search.Soon } else { sort }
  EventsApi.SearchArgs {
    query: filters.query.trim().take(Limits.QUERY_MAX),
    category: filters.category,
    municipality: filters.municipality,
    from: from,
    to: to,
    maxPriceCents: if filters.freeOnly { Some(0) } else { filters.maxPriceCents },
    lat: filters.lat,
    lng: filters.lng,
    radiusM: match filters.radiusM {
      case Some(radius) => Some(if radius > Limits.RADIUS_MAX_M { Limits.RADIUS_MAX_M } else { radius })
      case None => None
    },
    sort: Search.sortName(&ranked),
    limit: limit,
    after: filters.after
  }
}

/// One page of results for the filters.
export fn search(runtime: &Runtime.Runtime, filters: &Search.Filters, token: Option[Str]) -> Result[Event.Page, Problem.Problem] {
  EventsApi.search(&runtime.gateway, &argumentsFor(filters, Limits.PAGE_SIZE, &Time.now()), token)
}

/// The home rails, read together: recommendations, the next events, this weekend, free ones, and
/// lesser-known ones with complete details. Each rail reads more than it shows so that removing
/// events shown higher on the page still leaves it full.
export fn home(runtime: &Runtime.Runtime, lat: Option[Float64], lng: Option[Float64], token: Option[Str]) -> Result[Home, Problem.Problem] {
  let now = Time.now()
  let held = *runtime
  let recommended = Sync.cell(Ok([]))
  let soon = Sync.cell(Ok([]))
  let weekend = Sync.cell(Ok([]))
  let free = Sync.cell(Ok([]))
  let month = Sync.cell(Ok([]))
  let rail = |filters: Search.Filters, count: Int| EventsApi.search(&held.gateway, &argumentsFor(&filters, count, &now), token)
  let everything = Search.everything()
  let reach = Limits.RAIL_COUNT * 2
  let ran = Concurrent.parallel(&[
        || { let _set = Sync.set(&recommended, EventsApi.recommended(&held.gateway, lat, lng, Limits.RECOMMENDED_COUNT, token)) },
        || { let _set = Sync.set(&soon, Result.map(rail(everything, reach), |page: Event.Page| page.items)) },
        || { let _set = Sync.set(&weekend, Result.map(rail(Search.Filters{..everything, window: Search.Weekend}, reach), |page: Event.Page| page.items)) },
        || { let _set = Sync.set(&free, Result.map(rail(Search.Filters{..everything, freeOnly: true, window: Search.Week}, reach), |page: Event.Page| page.items)) },
        || { let _set = Sync.set(&month, Result.map(rail(Search.Filters{..everything, window: Search.Month}, Limits.GEMS_POOL), |page: Event.Page| page.items)) }
    ])
  if Result.isErr(&ran) { return Err(Problem.Unavailable("the home rails could not run")) }
  Ok(arrange(&Raw {
        recommended: read(&recommended) ?,
        soon: read(&soon) ?,
        weekend: read(&weekend) ?,
        free: read(&free) ?,
        month: read(&month) ?
      }))
}

/// The rails in page order with every event kept only in the first rail that shows it: recommended,
/// this weekend, coming up, free this week, then hidden gems.
export fn arrange(raw: &Raw) -> Home {
  let recommended = unseen(&raw.recommended, &[], Limits.RECOMMENDED_COUNT)
  let weekend = unseen(&raw.weekend, &idsOf(&recommended), Limits.RAIL_COUNT)
  let soon = unseen(&raw.soon, &idsOf(&recommended.concat(weekend)), Limits.RAIL_COUNT)
  let free = unseen(&raw.free, &idsOf(&recommended.concat(weekend).concat(soon)), Limits.RAIL_COUNT)
  let shown = idsOf(&recommended.concat(weekend).concat(soon).concat(free))
  Home{recommended: recommended, soon: soon, weekend: weekend, free: free, gems: gems(&raw.month, &shown)}
}

/// The ids of cards.
fn idsOf(cards: &Array[Event.Card]) -> Array[Str] { cards.map(|card: Event.Card| card.id) }

/// At most `count` cards whose ids are not already shown, in their order, without repeats.
export fn unseen(cards: &Array[Event.Card], shown: &Array[Str], count: Int) -> Array[Event.Card] {
  var kept: Array[Event.Card] = []
  var taken = *shown
  for card in *cards {
    if kept.length() < count && !taken.contains(card.id) {
      kept = kept.push(card)
      taken = taken.push(card.id)
    }
  }
  kept
}

/// Lesser-known upcoming events whose details can be trusted: a known price, a named organizer or
/// an official source, and few people engaged so far; the least engaged first.
export fn gems(cards: &Array[Event.Card], shown: &Array[Str]) -> Array[Event.Card] {
  let trusted = cards.filter(|card: Event.Card| card.status == "published" && card.priceCents != None
      && (card.source == "curated" || card.organizerName != None) && engagement(&card) <= Limits.GEM_ENGAGEMENT_MAX)
  let ordered = trusted.sortBy(|a: Event.Card, b: Event.Card| engagement(&a) < engagement(&b))
  unseen(&ordered, shown, Limits.RAIL_COUNT)
}

/// How many people have joined, saved, or liked an event.
fn engagement(card: &Event.Card) -> Int { card.approvedCount + card.savedCount + card.likeCount }

/// The value a worker stored.
fn read(cell: &Sync.Cell[Result[Array[Event.Card], Problem.Problem]]) -> Result[Array[Event.Card], Problem.Problem] {
  match Sync.get(cell) {
    case Ok(stored) => stored
    case Err(_) => Err(Problem.Unavailable("a home rail was lost"))
  }
}

/// Titles and slugs matching what a visitor has typed so far.
export fn suggest(runtime: &Runtime.Runtime, query: Str) -> Result[Array[Event.Card], Problem.Problem] {
  if query.trim().length() < 2 { return Ok([]) }
  let filters = Search.Filters{..Search.everything(), query: query, sort: Search.Relevant}
  let page = EventsApi.search(&runtime.gateway, &argumentsFor(&filters, Limits.SUGGEST_COUNT, &Time.now()), None) ?
  Ok(page.items)
}

/// Map pins for the same filters as a listing, up to the map's bound.
export fn pins(runtime: &Runtime.Runtime, filters: &Search.Filters) -> Result[Search.Pins, Problem.Problem] {
  let args = argumentsFor(filters, Limits.MAP_PINS, &Time.now())
  match filters.viewport {
    case Some(box) => EventsApi.inView(&runtime.gateway, &args, &box)
    case None => {
      let page = EventsApi.search(&runtime.gateway, &args, None) ?
      Ok(Search.Pins{items: page.items, limited: page.next != None})
    }
  }
}
