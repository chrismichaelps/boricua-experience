/** @Services.Participation.Joining — requests, decisions, saves, reactions, and reports */
module Services.Participation

import Std.Bytes as Bytes
import Std.Concurrent as Concurrent
import Std.Crypto as Crypto
import Std.Result as Result
import Std.Sync as Sync
import Api.Events as EventsApi
import Api.Participation as ParticipationApi
import Domain.Event as Event
import Domain.Participation as Participation
import Domain.Problem as Problem
import Domain.Search as Search
import Domain.Session as Session
import Services.Runtime as Runtime
import Validation.Participation as Rules

/** @Services.Participation.Activity — what the activity page shows */
export type Activity = { requests: Array[Participation.MyRequest], saved: Array[Event.Card], organizing: Array[Event.Card], searches: Array[Search.SavedSearch] }

/** @Services.Participation.Queue — an event and the requests waiting on its organizer */
export type Queue = { event: Event.Detail, requests: Array[Participation.IncomingRequest], insights: Option[Participation.Insights] }

/// Asks to join with an optional message; answers `approved` or `pending`.
export fn join(runtime: &Runtime.Runtime, eventId: Str, message: Str, channel: Str, session: &Session.Session) -> Result[Str, Problem.Problem] {
  let valid = Rules.message(message) ?
  let outcome = ParticipationApi.requestJoin(&runtime.gateway, eventId, valid.trim(), channel, session.accessToken) ?
  Ok(outcome.status)
}

/// Withdraws the member's request.
export fn withdraw(runtime: &Runtime.Runtime, eventId: Str, session: &Session.Session) -> Result[(), Problem.Problem] {
  ParticipationApi.withdraw(&runtime.gateway, eventId, session.accessToken)
}

/// Approves or rejects a request with an optional note.
export fn decide(runtime: &Runtime.Runtime, requestId: Str, approve: Bool, note: Str, session: &Session.Session) -> Result[Str, Problem.Problem] {
  let valid = Rules.message(note) ?
  let outcome = ParticipationApi.decide(&runtime.gateway, requestId, approve, valid.trim(), session.accessToken) ?
  Ok(outcome.status)
}

/// An organizer's event with its requests, pending first.
export fn queue(runtime: &Runtime.Runtime, slug: Str, session: &Session.Session) -> Result[Queue, Problem.Problem] {
  let found = EventsApi.detail(&runtime.gateway, slug, Some(session.accessToken)) ?
  if !found.viewer.isOrganizer { return Err(Problem.Forbidden) }
  let requests = ParticipationApi.incoming(&runtime.gateway, found.card.id, session.accessToken) ?
  // The numbers are a convenience: the queue still opens when they cannot be read.
  let insights = match ParticipationApi.insights(&runtime.gateway, found.card.id, session.accessToken) {
    case Ok(found) => Some(found)
    case Err(_) => None
  }
  Ok(Queue{event: found, requests: requests, insights: insights})
}

/// Approves every pending request that fits; answers how many were approved.
export fn approveAll(runtime: &Runtime.Runtime, slug: Str, session: &Session.Session) -> Result[Int, Problem.Problem] {
  let found = EventsApi.detail(&runtime.gateway, slug, Some(session.accessToken)) ?
  if !found.viewer.isOrganizer { return Err(Problem.Forbidden) }
  let bulk = ParticipationApi.approvePending(&runtime.gateway, found.card.id, session.accessToken) ?
  Ok(bulk.approved)
}

/// The signature that makes a member's calendar feed address unguessable.
export fn calendarToken(runtime: &Runtime.Runtime, userId: Str) -> Str {
  Bytes.encodeBase64Url(&Crypto.hmacSha256(&runtime.sessionKey, &Bytes.fromText("calendar-feed|" + userId))).take(32)
}

/// A member's calendar entries when the feed's signature matches, and nothing otherwise.
export fn calendarFeed(runtime: &Runtime.Runtime, userId: Str, token: Str) -> Result[Array[Event.CalendarEntry], Problem.Problem] {
  if !Crypto.bytesMatch(&Bytes.fromText(calendarToken(runtime, userId)), &Bytes.fromText(token)) { return Err(Problem.Missing) }
  ParticipationApi.calendarFeed(&runtime.gateway, userId)
}

/// Saves or unsaves an event; answers whether it is now saved.
export fn toggleSaved(runtime: &Runtime.Runtime, eventId: Str, session: &Session.Session) -> Result[Bool, Problem.Problem] {
  let state = ParticipationApi.toggleSaved(&runtime.gateway, eventId, session.accessToken) ?
  Ok(state.saved)
}

/// Keeps a listing; the label and query are built by the server from parsed filters.
export fn saveSearch(runtime: &Runtime.Runtime, saving: &Search.Saving, session: &Session.Session) -> Result[(), Problem.Problem] {
  let valid = Rules.saving(saving) ?
  ParticipationApi.saveSearch(&runtime.gateway, &valid, session.accessToken)
}

/// Removes one saved search.
export fn deleteSearch(runtime: &Runtime.Runtime, id: Str, session: &Session.Session) -> Result[(), Problem.Problem] {
  ParticipationApi.deleteSearch(&runtime.gateway, id, session.accessToken)
}

/// Sets the member's reaction; answers the reaction and the new like count.
export fn react(runtime: &Runtime.Runtime, eventId: Str, value: Int, session: &Session.Session) -> Result[Participation.ReactionState, Problem.Problem] {
  let valid = Rules.reaction(value) ?
  ParticipationApi.react(&runtime.gateway, eventId, valid, session.accessToken)
}

/// Reports an event for moderation.
export fn report(runtime: &Runtime.Runtime, eventId: Str, form: &Rules.Report, session: &Session.Session) -> Result[(), Problem.Problem] {
  let valid = Rules.report(form) ?
  ParticipationApi.report(&runtime.gateway, eventId, valid.reason, valid.detail.trim(), session.accessToken)
}

/// The member's requests, saved events, and organized events, read together.
export fn activity(runtime: &Runtime.Runtime, session: &Session.Session) -> Result[Activity, Problem.Problem] {
  let held = *runtime
  let token = session.accessToken
  let requests = Sync.cell(Ok([]))
  let saved = Sync.cell(Ok([]))
  let organizing = Sync.cell(Ok([]))
  let searches = Sync.cell(Ok([]))
  let ran = Concurrent.parallel(&[
        || { let _set = Sync.set(&searches, ParticipationApi.savedSearches(&held.gateway, token)) },
        || { let _set = Sync.set(&requests, ParticipationApi.mine(&held.gateway, token)) },
        || { let _set = Sync.set(&saved, ParticipationApi.saved(&held.gateway, token)) },
        || { let _set = Sync.set(&organizing, EventsApi.mine(&held.gateway, token)) }
    ])
  if Result.isErr(&ran) { return Err(Problem.Unavailable("the activity lists could not run")) }
  Ok(Activity {
      requests: Result.unwrapOr(Sync.get(&requests), Err(Problem.Unavailable("lost"))) ?,
      saved: Result.unwrapOr(Sync.get(&saved), Err(Problem.Unavailable("lost"))) ?,
      organizing: Result.unwrapOr(Sync.get(&organizing), Err(Problem.Unavailable("lost"))) ?,
      searches: Result.unwrapOr(Sync.get(&searches), Err(Problem.Unavailable("lost"))) ?
    })
}
