/** @Services.Plans.Outings — plans near a visitor, a shared plan, and its road route */
module Services.Plans

import Std.Math.Float as Float
import Std.Json as Json
import Api.Plans as PlansApi
import Domain.Plan as Plan
import Domain.Problem as Problem
import Domain.Search as Search
import Domain.Session as Session
import Services.Discovery as Discovery
import Services.Runtime as Runtime
import Utils.Time as Time

/// The search window a plan window covers.
fn searchWindow(window: &Plan.Window) -> Search.When {
  match window {
    case Plan.Today => Search.Today
    case Plan.Tomorrow => Search.Tomorrow
    case Plan.Weekend => Search.Weekend
  }
}

/// Plans of nearby activities for the visitor's position, window and style, best first.
export fn outings(runtime: &Runtime.Runtime, request: &Plan.Request) -> Result[Plan.Outings, Problem.Problem] {
  if request.lat < 17.5 || request.lat > 18.7 || request.lng < -67.5 || request.lng > -65.1 { return Err(Problem.Refused("invalid_coordinates")) }
  let (from, to) = Discovery.bounds(&searchWindow(&request.window), &Time.now())
  PlansApi.outings(&runtime.gateway, request, from, to)
}

/// A shared plan rebuilt from its activities in order.
export fn shared(runtime: &Runtime.Runtime, slugs: &Array[Str]) -> Result[Plan.Outings, Problem.Problem] {
  if slugs.isEmpty() { return Ok(Plan.Outings{plans: []}) }
  PlansApi.shared(&runtime.gateway, slugs)
}

/// The road route between activities in order, for the plan's map.
export fn route(runtime: &Runtime.Runtime, slugs: &Array[Str]) -> Result[Json.Json, Problem.Problem] {
  if slugs.length() < 2 { return Ok(Json.object(&[("legs", Json.list(&[]))])) }
  PlansApi.route(&runtime.gateway, slugs)
}

/// Confirms a trip stop the member reached; a malformed arrival is refused before the database.
export fn arrive(runtime: &Runtime.Runtime, arrival: &Plan.Arrival, locale: Str, session: &Session.Session) -> Result[Plan.Arrived, Problem.Problem] {
  if !Plan.validArrival(arrival) { return Err(Problem.Refused("invalid_arrival")) }
  PlansApi.arrive(&runtime.gateway, arrival, locale, session.accessToken)
}

/// The ways to reach each stop of a trip after the first, fastest first.
export fn routeOptions(runtime: &Runtime.Runtime, slugs: &Array[Str]) -> Result[Json.Json, Problem.Problem] {
  if slugs.length() < 2 { return Ok(Json.object(&[("legs", Json.list(&[]))])) }
  PlansApi.routeOptions(&runtime.gateway, slugs)
}

/// The island's next 48 hours of weather by town.
export fn weather(runtime: &Runtime.Runtime) -> Result[Json.Json, Problem.Problem] {
  PlansApi.weather(&runtime.gateway)
}

/// The ways from where the visitor is to an activity. The position is rounded to about 110 m before it
/// leaves the server, and only a well-formed activity address in Puerto Rico is asked about.
export fn approach(runtime: &Runtime.Runtime, lat: Float64, lng: Float64, slug: Str) -> Result[Json.Json, Problem.Problem] {
  if lat < 17.5 || lat > 18.7 || lng < -67.5 || lng > -65.1 || Plan.sharedSlugs(slug) != [slug] { return Err(Problem.Refused("invalid_approach")) }
  PlansApi.approach(&runtime.gateway, Float.round(lat * 1000.0) / 1000.0, Float.round(lng * 1000.0) / 1000.0, slug)
}
