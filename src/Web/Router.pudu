/** @Web.Router.Table — every route the application answers */
module Web.Router

import Std.Http as Http
import Std.Http.Server.Route as Route
import App.Assembly as Assembly
import Domain.Problem as Problem
import Web.Context as Context
import Web.Handlers.Account as Account
import Web.Handlers.Achievements as Achievements
import Web.Handlers.Admin as Admin
import Web.Handlers.Assistant as Assistant
import Web.Handlers.Contact as Contact
import Web.Handlers.Digest as Digest
import Web.Handlers.Discover as Discover
import Web.Handlers.EventCover as EventCover
import Web.Handlers.Events as Events
import Web.Handlers.Forum as Forum
import Web.Handlers.Identity as Identity
import Web.Handlers.Location as Location
import Web.Handlers.Media as Media
import Web.Handlers.Menus as Menus
import Web.Handlers.Participation as Participation
import Web.Handlers.Places as Places
import Web.Handlers.Plans as Plans
import Web.Handlers.Privacy as Privacy
import Web.Handlers.Site as Site
import Web.Respond as Respond

/// The router: every handler's routes, and a 404 page for anything else.
export fn routes(app: &Assembly.App) -> Route.Router {
  let held = *app
  let table = Discover.routes(app)
    .concat(Assistant.routes(app))
    .concat(Events.routes(app))
    .concat(Places.routes(app))
    .concat(Forum.routes(app))
    .concat(Plans.routes(app))
    .concat(Menus.routes(app))
    .concat(Media.routes(app))
    .concat(EventCover.routes(app))
    .concat(Participation.routes(app))
    .concat(Account.routes(app))
    .concat(Privacy.routes(app))
    .concat(Identity.routes(app))
    .concat(Location.routes(app))
    .concat(Site.routes(app))
    .concat(Admin.routes(app))
    .concat(Contact.routes(app))
    .concat(Achievements.routes(app))
    .concat(Digest.routes(app))
  Route.withFallback(&Route.routing(&table), fn(request: Route.Request) -> Http.Response {
      let visitor = Context.resolve(&held, &request, true)
      Respond.finish(&held, &visitor, Respond.problem(&held, &visitor, &Problem.Missing))
    })
}
