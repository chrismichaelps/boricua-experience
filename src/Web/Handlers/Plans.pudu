/** @Web.Handlers.Plans.Routes — plans near the visitor, a plan's calendar file, and its road route */
module Web.Handlers.Plans

import Std.Http as Http
import Std.Http.Server.Route as Route
import Std.Json as Json
import Std.Option as Option
import App.Assembly as Assembly
import Constants.Cookies as Cookies
import Constants.Http as HttpConstants
import Constants.Routes as Routes
import Domain.Achievement as Achievement
import Domain.Catalog as Catalog
import Domain.Locale as Locale
import Domain.Plan as Plan
import Domain.Problem as Problem
import Domain.Search as Search
import Domain.Session as Session
import Utils.Geo as Geo
import Utils.Time as Time
import Utils.Wire as Wire
import View.Calendar as Calendar
import View.Frame as Frame
import View.Pages.Plan as PlanPage
import View.Pages.Trip as TripPage
import Web.Context as Context
import Web.Respond as Respond
import Web.Serve as Serve

/// The plan routes.
export fn routes(app: &Assembly.App) -> Array[Route.Route] {
  let held = *app
  [
    Route.get(Routes.PLAN, Serve.page(app, |visitor: Context.Visitor| page(&held, &visitor))),
    Route.get(Routes.PLAN_CALENDAR, Serve.page(app, |visitor: Context.Visitor| calendar(&held, &visitor))),
    Route.get(Routes.API_PLAN_ROUTE, Serve.api(app, |visitor: Context.Visitor| route(&held, &visitor))),
    Route.get(Routes.API_PLAN_ROUTES, Serve.api(app, |visitor: Context.Visitor| routeOptions(&held, &visitor))),
    Route.get(Routes.PLAN_TRIP, Serve.page(app, |visitor: Context.Visitor| trip(&held, &visitor))),
    Route.post(Routes.API_TRIP_ARRIVE, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| arrive(&held, &visitor, &session)))
  ]
}

/// The visitor's mode: the one just chosen, else the remembered one, else local.
fn modeOf(visitor: &Context.Visitor) -> Plan.Mode {
  let chosen = Serve.query(visitor, "mode")
  Plan.modeFrom(if chosen.isEmpty() { Option.unwrapOr(visitor.cookies.get(Cookies.MODE), "") } else { chosen })
}

/// Where the plan starts: the device's position, else a chosen town, else the remembered nearby town.
fn originOf(visitor: &Context.Visitor, catalog: &Catalog.Catalog) -> (Option[Float64], Option[Float64], Str) {
  match (Geo.parseDegrees(Serve.query(visitor, "lat")), Geo.parseDegrees(Serve.query(visitor, "lng"))) {
    case (Some(lat), Some(lng)) => { return (Some(lat), Some(lng), "") }
    case _ => {}
  }
  let chosen = Serve.query(visitor, "town")
  let town = if chosen.isEmpty() {
    match Option.andThen(visitor.cookies.get(Cookies.NEAR), |value: Str| Search.rememberedNear(value)) {
      case Some((slug, _meters)) => slug
      case None => ""
    }
  } else { chosen }
  match Catalog.municipality(catalog, town) {
    case Some(found) => (Some(found.lat), Some(found.lng), found.slug)
    case None => (None, None, "")
  }
}

/// The plans page: a shared plan, the plans for the chosen start, or the choices alone.
fn page(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  let mode = modeOf(visitor)
  let (lat, lng, town) = originOf(visitor, &catalog)
  let choices = PlanPage.Choices{lat: lat, lng: lng, town: town, window: Plan.windowFrom(Serve.query(visitor, "when")), style: Plan.styleFrom(Serve.query(visitor, "style")), stops: Plan.stopsFrom(Serve.query(visitor, "stops")), mode: mode}
  let shared = Plan.sharedSlugs(Serve.query(visitor, "e"))
  let shown = if !shared.isEmpty() {
    match Serve.ask(app, &app.kinds.planShared, shared) {
      case Ok(found) => PlanPage.Shared(found)
      case Err(problem) => { return Respond.problem(app, visitor, &problem) }
    }
  } else {
    match (lat, lng) {
      case (Some(atLat), Some(atLng)) => {
        // "Surprise me" asks for a fresh mix every time; other plans are stable for the same choices.
        let seed = if Serve.query(visitor, "surprise") == "1" { Time.nowSeconds() % 99991 + 1 } else { 0 }
        let request = Plan.Request{lat: atLat, lng: atLng, window: choices.window, style: choices.style, stops: choices.stops, mode: mode, radiusM: Plan.RADIUS_M, seed: seed}
        match Serve.ask(app, &app.kinds.planOutings, request) {
          case Ok(found) => PlanPage.Found(found)
          case Err(problem) => { return Respond.problem(app, visitor, &problem) }
        }
      }
      case _ => PlanPage.Nothing
    }
  }
  let response = Respond.page(200, &PlanPage.render(&Context.frame(app, visitor), &catalog, &choices, &shown))
  let chosen = Serve.query(visitor, "mode")
  if chosen.isEmpty() || visitor.cookies.get(Cookies.MODE) == Some(Plan.modeName(&mode)) { response } else { Respond.withPreference(app, response, Cookies.MODE, Plan.modeName(&mode)) }
}

/// A plan as a calendar file: each stop at the time the plan reaches it.
fn calendar(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let slugs = Plan.sharedSlugs(Serve.query(visitor, "e"))
  match Serve.ask(app, &app.kinds.planShared, slugs) {
    case Ok(found) => match Option.fromArray(&found.plans) {
      case Some(plan) => Http.Response{..Respond.document(HttpConstants.CALENDAR, Calendar.plan(app.runtime.siteUrl, Frame.t(&Context.frame(app, visitor), "plan.calendar_name"), &plan.stops.map(|stop: Plan.Stop| (stop.card, stop.arrive, stop.leave)))), headers: [
          ("content-type", HttpConstants.CALENDAR),
          ("content-disposition", "attachment; filename=\"plan.ics\""),
          ("cache-control", HttpConstants.CACHE_PRIVATE)
        ] }
      case None => Respond.problem(app, visitor, &Problem.Missing)
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// The road route between the activities in order, for the plan's map.
fn route(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  match Serve.ask(app, &app.kinds.planRoute, Plan.sharedSlugs(Serve.query(visitor, "e"))) {
    case Ok(found) => Http.Response{..Respond.json(200, &found), headers: Respond.json(200, &found).headers.push(("cache-control", HttpConstants.CACHE_SHARED_PINS))}
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// A plan's trip: the map that follows the visitor and the stops in order. A plan without stops is missing.
fn trip(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let slugs = Plan.sharedSlugs(Serve.query(visitor, "e"))
  match Serve.ask(app, &app.kinds.planShared, slugs) {
    case Ok(found) => match Option.fromArray(&found.plans) {
      case Some(plan) => Respond.page(200, &TripPage.render(&Context.frame(app, visitor), &plan))
      case None => Respond.problem(app, visitor, &Problem.Missing)
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// A trip stop the member reached: confirmed on the server, answered with what it unlocked.
fn arrive(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let arrival: Plan.Arrival = match Wire.parse(visitor.request.message.body) {
    case Ok(found) => found
    case Err(_) => { return Respond.problem(app, visitor, &Problem.Refused("invalid_arrival")) }
  }
  match Serve.ask(app, &app.kinds.tripArrival, Serve.signed(session, (arrival, Locale.code(&visitor.locale)))) {
    case Ok(answer) => Respond.json(200, &Json.object(&[
        ("arrived", Json.Boolean(answer.arrived)),
        ("completed", Json.Boolean(answer.completed)),
        ("unlocked", Json.list(&answer.unlocked.map(|found: Achievement.Unlocked| found.encode())))
      ]))
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// The ways to reach each stop of a trip. Shared caches keep them briefly: a leg still being worked out
/// answers with its fastest route only, and its other options appear on a later visit.
fn routeOptions(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  match Serve.ask(app, &app.kinds.planRouteOptions, Plan.sharedSlugs(Serve.query(visitor, "e"))) {
    case Ok(found) => Http.Response{..Respond.json(200, &found), headers: Respond.json(200, &found).headers.push(("cache-control", HttpConstants.CACHE_ROUTE_OPTIONS))}
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}
