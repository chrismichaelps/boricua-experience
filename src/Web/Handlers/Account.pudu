/** @Web.Handlers.Account.Routes — the account page, profiles, notifications, and onboarding */
module Web.Handlers.Account

import Std.Http as Http
import Std.Http.Server.Route as Route
import Std.Json as Json
import Std.Option as Option
import App.Assembly as Assembly
import App.Messages as Messages
import Constants.Cookies as Cookies
import Constants.Routes as Routes
import Domain.Achievement as Achievement
import Domain.Credentials as Credentials
import Domain.Locale as Locale
import Domain.Problem as Problem
import Domain.Profile as Profile
import Domain.Session as Session
import Services.Participation as ParticipationService
import Utils.Form as Form
import Utils.Wire as Wire
import Validation.Account as AccountRules
import View.Pages.Account as AccountPage
import View.Pages.Auth as AuthPage
import View.Pages.Notifications as NotificationsPage
import View.Pages.Profile as ProfilePage
import Web.Context as Context
import Web.Respond as Respond
import Web.Serve as Serve

/// The account routes.
export fn routes(app: &Assembly.App) -> Array[Route.Route] {
  let held = *app
  [
    Route.get(Routes.ACCOUNT, Serve.memberPage(app, |visitor: Context.Visitor, session: Session.Session| accountPage(&held, &visitor, &session, None))),
    Route.post(Routes.ACCOUNT_PROFILE, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| saveProfile(&held, &visitor, &session))),
    Route.post(Routes.ACCOUNT_DISCOVERY, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| saveDiscovery(&held, &visitor, &session))),
    Route.post(Routes.ACCOUNT_PREFERENCES, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| savePreferences(&held, &visitor, &session))),
    Route.post(Routes.ACCOUNT_PASSWORD, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| changePassword(&held, &visitor, &session))),
    Route.post(Routes.ACCOUNT_AVATAR, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| changeAvatar(&held, &visitor, &session))),
    Route.post(Routes.ACCOUNT_AVATAR_REMOVE, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| removeAvatar(&held, &visitor, &session))),
    Route.get(Routes.PROFILE, Serve.page(app, |visitor: Context.Visitor| profilePage(&held, &visitor))),
    Route.get(Routes.NOTIFICATIONS, Serve.memberPage(app, |visitor: Context.Visitor, session: Session.Session| inbox(&held, &visitor, &session))),
    Route.get(Routes.ONBOARDING, Serve.memberPage(app, |visitor: Context.Visitor, _session: Session.Session| welcome(&held, &visitor, None))),
    Route.post(Routes.ONBOARDING, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| onboard(&held, &visitor, &session))),
    Route.get(Routes.TERMS_ACCEPT, Serve.memberPage(app, |visitor: Context.Visitor, _session: Session.Session| renewal(&held, &visitor, None))),
    Route.post(Routes.TERMS_ACCEPT, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| renew(&held, &visitor, &session)))
  ]
}

/// The account page, with the problem of the last form when there is one.
export fn accountPage(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session, problem: Option[Problem.Problem]) -> Http.Response {
  let me = match visitor.member {
    case Some(found) => found
    case None => match Serve.ask(app, &app.kinds.me, Serve.signed(session, ())) {
      case Ok(found) => found
      case Err(found) => { return Respond.problem(app, visitor, &found) }
    }
  }
  match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(catalog) => {
      let status = match problem {
        case Some(found) => Problem.status(&found)
        case None => 200
      }
      let feed = app.runtime.siteUrl + Routes.CALENDAR_FEED.replace(":user", me.id).replace(":token", ParticipationService.calendarToken(&app.runtime, me.id))
      Respond.page(status, &AccountPage.render(&Context.frame(app, visitor), &me, &catalog, session.email, Session.usesPassword(session), &problem, feed))
    }
    case Err(found) => Respond.problem(app, visitor, &found)
  }
}

/// The account page after a refused form, with the member reloaded for the shell.
fn refused(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session, problem: &Problem.Problem) -> Http.Response {
  match problem {
    case Problem.Invalid(_) => accountPage(app, &Context.resolve(app, &visitor.request, true), session, Some(*problem))
    case Problem.Refused(_) => accountPage(app, &Context.resolve(app, &visitor.request, true), session, Some(*problem))
    case _ => Respond.problem(app, visitor, problem)
  }
}

/// Saves the profile; a language change takes effect at once.
fn saveProfile(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let fields = Serve.fields(visitor)
  let edit = Profile.ProfileEdit{displayName: Form.text(&fields, "displayName"), bio: Form.paragraph(&fields, "bio"), homeMunicipality: Form.text(&fields, "town"), locale: Locale.code(&Locale.fromCode(Form.text(&fields, "locale")))}
  match Serve.ask(app, &app.kinds.updateProfile, Serve.signed(session, edit)) {
    case Ok(_) => Respond.withPreference(app, Respond.withFlash(app, Respond.redirect(Routes.ACCOUNT), "flash.saved_profile"), Cookies.LOCALE, edit.locale)
    case Err(problem) => refused(app, visitor, session, &problem)
  }
}

/// Saves the discovery radius and favourite towns; each town is a `town_<slug>` checkbox.
fn saveDiscovery(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let fields = Serve.fields(visitor)
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  var towns: Array[Str] = []
  for town in catalog.municipalities {
    if Form.flag(&fields, "town_" + town.slug) { towns = towns.push(town.slug) }
  }
  let chosen = Profile.Discovery{radiusKm: Form.whole(&fields, "radius"), towns: towns}
  match Serve.ask(app, &app.kinds.updateDiscovery, Serve.signed(session, chosen)) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Routes.ACCOUNT + "#discovery"), "flash.saved_settings")
    case Err(problem) => refused(app, visitor, session, &problem)
  }
}

/// Saves the preferences.
fn savePreferences(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let fields = Serve.fields(visitor)
  let chosen = Profile.Preferences {
    notifyRequestUpdates: Form.flag(&fields, "notifyRequestUpdates"),
    notifyNewRequests: Form.flag(&fields, "notifyNewRequests"),
    notifyReminders: Form.flag(&fields, "notifyReminders"),
    notifyEventChanges: Form.flag(&fields, "notifyEventChanges"),
    marketingOptIn: Form.flag(&fields, "marketingOptIn"),
    locationVisibility: Form.text(&fields, "locationVisibility"),
    showInAttendeeLists: Form.flag(&fields, "showInAttendeeLists"),
    emailDigest: Form.flag(&fields, "emailDigest")
  }
  match Serve.ask(app, &app.kinds.updatePreferences, Serve.signed(session, chosen)) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Routes.ACCOUNT + "#preferences"), "flash.saved_settings")
    case Err(problem) => refused(app, visitor, session, &problem)
  }
}

/// Changes the password of an email account.
fn changePassword(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let fields = Serve.fields(visitor)
  let form = Credentials.NewPassword{password: Option.unwrapOr(fields.get("password"), ""), confirmation: Option.unwrapOr(fields.get("confirmation"), "")}
  match Serve.ask(app, &app.kinds.changePassword, Serve.signed(session, form)) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Routes.ACCOUNT), "flash.password_changed")
    case Err(problem) => refused(app, visitor, session, &problem)
  }
}

/// An organizer's public profile.
fn profilePage(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  match Serve.ask(app, &app.kinds.profile, Serve.param(visitor, "id")) {
    case Ok(person) => {
      let badges = match Serve.ask(app, &app.kinds.showcase, (person.id, Locale.code(&visitor.locale))) {
        case Ok(found) => found
        case Err(_) => Achievement.Showcase{total: 0, items: []}
      }
      Respond.page(200, &ProfilePage.render(&Context.frame(app, visitor), &person, &badges))
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// The inbox.
fn inbox(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  match Serve.ask(app, &app.kinds.notifications, Serve.signed(session, ())) {
    case Ok(notes) => Respond.page(200, &NotificationsPage.render(&Context.frame(app, visitor), &notes))
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// The onboarding page.
fn welcome(app: &Assembly.App, visitor: &Context.Visitor, problem: Option[Problem.Problem]) -> Http.Response {
  let name = match visitor.member {
    case Some(member) => member.displayName
    case None => ""
  }
  if Option.holds(&visitor.member, |member: Profile.MyProfile| member.onboarded) && problem == None {
    return Respond.redirect(Respond.returnPath(Route.queryParam(&visitor.request, "return")))
  }
  if visitor.cookies.containsKey(Cookies.AGE_GATE) {
    if let Some(session) = visitor.session { return refuseMinor(app, visitor, &session) }
  }
  Respond.page(if problem == None { 200 } else { 422 }, &AuthPage.welcome(&Context.frame(app, visitor), name, Respond.returnPath(Option.orElse(Route.queryParam(&visitor.request, "return"), Route.fieldsOf(&visitor.request).get("return"))), &problem))
}

/// Deletes an account a provider created for someone the date of birth shows is a minor, then refuses.
fn refuseMinor(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  match Serve.ask(app, &app.kinds.refuseMinor, Serve.signed(session, ())) {
    case Ok(_) => Respond.underage(app, &AuthPage.unavailable(&Context.frame(app, visitor)))
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// Records the confirmations and continues.
fn onboard(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let fields = Serve.fields(visitor)
  let form = Credentials.Onboarding{displayName: Form.text(&fields, "displayName"), birthDate: Form.text(&fields, "birthDate"), terms: Form.flag(&fields, "terms"), privacy: Form.flag(&fields, "privacy")}
  if AccountRules.underage(form.birthDate) { return refuseMinor(app, visitor, session) }
  match Serve.ask(app, &app.kinds.onboard, Serve.signed(session, Messages.Onboard{form: form, locale: Locale.code(&visitor.locale)})) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Respond.returnPath(fields.get("return"))), "flash.welcome")
    case Err(problem) => welcome(app, &Context.resolve(app, &visitor.request, true), Some(problem))
  }
}

/// The page asking for the new Terms of Use and Privacy Policy; anyone who does not owe them moves on.
fn renewal(app: &Assembly.App, visitor: &Context.Visitor, problem: Option[Problem.Problem]) -> Http.Response {
  let returnTo = Respond.returnPath(Option.orElse(Route.queryParam(&visitor.request, "return"), Route.fieldsOf(&visitor.request).get("return")))
  match visitor.member {
    case Some(member) => if !member.onboarded { return Respond.redirect(Routes.ONBOARDING + "?return=" + returnTo) } else if !AccountRules.owesRenewal(&member) && problem == None { return Respond.redirect(returnTo) }
    case None => {}
  }
  Respond.page(if problem == None { 200 } else { 422 }, &AuthPage.renewal(&Context.frame(app, visitor), returnTo, &problem))
}

/// Records the renewed acceptance and continues.
fn renew(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let fields = Serve.fields(visitor)
  let form = Credentials.Renewal{terms: Form.flag(&fields, "terms"), privacy: Form.flag(&fields, "privacy")}
  match Serve.ask(app, &app.kinds.renewConsent, Serve.signed(session, form)) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Respond.returnPath(fields.get("return"))), "flash.terms_renewed")
    case Err(problem) => renewal(app, &Context.resolve(app, &visitor.request, true), Some(problem))
  }
}

/** @Web.Handlers.Account.Photo — the JSON the account page posts: a base64 image */
type Photo = { image: Str } derives Json.Decode

/// Stores a new photo; answers its address as JSON for the page to show at once.
fn changeAvatar(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let photo: Photo = match Wire.parse(visitor.request.message.body) {
    case Ok(found) => found
    case Err(_) => { return Respond.problem(app, visitor, &Problem.Invalid([Problem.FieldError{field: "photo", key: "form.photo_invalid"}])) }
  }
  match Serve.ask(app, &app.kinds.changeAvatar, Serve.signed(session, photo.image)) {
    case Ok(address) => Respond.json(200, &Json.object(&[("avatarUrl", Json.Text(address))]))
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// Removes the photo and returns to the account page.
fn removeAvatar(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  match Serve.ask(app, &app.kinds.removeAvatar, Serve.signed(session, ())) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Routes.ACCOUNT), "flash.photo_removed")
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}
