import View.Pages.Map as MapPage
import View.Pages.Search as SearchPage
import Web.Context as Context
import Web.Respond as Respond
import Web.Serve as Serve

/// The filters a query string describes.
export fn filtersOf(visitor: &Context.Visitor) -> Search.Filters {
  filtersFrom(|name: Str| Serve.query(visitor, name))
}

/// The filters a source of named values describes: a request's query, or a posted query string.
export fn filtersFrom(read: fn(Str) -> Str) -> Search.Filters {
  let lat = Geo.parseDegrees(read("lat"))
  let lng = Geo.parseDegrees(read("lng"))
  let located = match (lat, lng) {
    case (Some(y), Some(x)) => Geo.inPuertoRico(y, x)
    case _ => false
  }
  let query = read("q").trim()
  let near = if located { "" } else { read("cerca").trim() }
  let radius = Search.radiusFrom(read("radio"))
  let asked = Search.sortFrom(read("sort"))
  let unsorted = read("sort").isEmpty()
  Search.Filters {
    query: query,
    category: read("category"),
    municipality: read("pueblo"),
    near: near,
    window: Search.windowFrom(read("when")),
    freeOnly: read("free") == "1",
    traits: Search.traitsFrom(read("t")),
    maxPriceCents: None,
    viewport: None,
    lat: if located { lat } else { None },
    lng: if located { lng } else { None },
    radiusM: if located { Some(Option.unwrapOr(radius, Limits.NEARBY_RADIUS_M * 2)) } else if near.isEmpty() { None } else { radius },
    sort: if unsorted && !query.isEmpty() { Search.Relevant } else if unsorted && (located || !near.isEmpty()) { Search.Near } else { asked },
    after: read("after")
  }
}

/// The discovery routes.
export fn routes(app: &Assembly.App) -> Array[Route.Route] {
  let held = *app
  [
    Route.post(Routes.SEARCH_SAVE, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| saveSearch(&held, &visitor, &session))),
    Route.post(Routes.SEARCH_DELETE, Serve.memberAction(app, |visitor: Context.Visitor, session: Session.Session| deleteSearch(&held, &visitor, &session))),
    Route.get(Routes.HOME, Serve.page(app, |visitor: Context.Visitor| home(&held, &visitor))),
    Route.get(Routes.SEARCH, Serve.page(app, |visitor: Context.Visitor| listing(&held, &visitor, SearchPage.Open, filtersOf(&visitor)))),
    Route.get(Routes.CATEGORY, Serve.page(app, |visitor: Context.Visitor| landingPage(&held, &visitor, true))),
    Route.get(Routes.TOWN, Serve.page(app, |visitor: Context.Visitor| landingPage(&held, &visitor, false))),
    Route.get(Routes.NEAR_ME, Serve.page(app, |visitor: Context.Visitor| nearMe(&held, &visitor))),
    Route.get(Routes.MAP, Serve.page(app, |visitor: Context.Visitor| map(&held, &visitor))),
    Route.get(Routes.API_SUGGEST, Serve.api(app, |visitor: Context.Visitor| suggest(&held, &visitor))),
    Route.get(Routes.API_MAP, Serve.api(app, |visitor: Context.Visitor| viewport(&held, &visitor))),
    Route.get(Routes.API_NEARBY, Serve.api(app, |visitor: Context.Visitor| nearby(&held, &visitor))),
    Route.get(Routes.API_HOME_NEAR, Serve.api(app, |visitor: Context.Visitor| nearRail(&held, &visitor)))
  ]
}

/// The home page.
fn home(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  match Serve.ask(app, &app.kinds.home, Serve.visit(visitor, Messages.Place{lat: None, lng: None, radiusM: None})) {
    case Ok(rails) => Respond.page(200, &HomePage.render(&Context.frame(app, visitor), &catalog, &rails))
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// A listing for the filters, inside a landing when one fixes a category or town.
fn listing(app: &Assembly.App, visitor: &Context.Visitor, landing: SearchPage.Landing, filters: Search.Filters) -> Http.Response {
  listingWith(app, visitor, landing, filters, ("", ""))
}

/// A listing with the places of a category or town, named as (category, town); both empty for none.
fn listingWith(app: &Assembly.App, visitor: &Context.Visitor, landing: SearchPage.Landing, filters: Search.Filters, placesOf: (Str, Str)) -> Http.Response {
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  let anchored = Search.anchored(&filters, &catalog)
  let placeFilters = Search.Filters{..anchored, after: Serve.query(visitor, "places_after")}
  if Context.wantsJson(visitor) && !placeFilters.after.isEmpty() {
    return match Serve.ask(app, &app.kinds.placesListed, placeFilters) {
      case Ok(places) => Respond.json(200, &Json.object(&[
            ("html", Json.Text(SearchPage.placeCards(&Context.frame(app, visitor), &catalog, &places.items))),
            ("next", match places.next { case Some(cursor) => Json.Text(visitor.request.path + SearchPage.placeQueryOf(&anchored, &landing, cursor)) case None => Json.Null })
          ]))
      case Err(problem) => Respond.problem(app, visitor, &problem)
    }
  }
  match Serve.ask(app, &app.kinds.search, Serve.visit(visitor, anchored)) {
    case Ok(page) => {
      if Context.wantsJson(visitor) { return Respond.json(200, &pageJson(app, visitor, &anchored, &landing, &page)) }
      let places = match Serve.ask(app, &app.kinds.placesListed, placeFilters) {
        case Ok(found) => found
        case Err(problem) => { return Respond.problem(app, visitor, &problem) }
      }
      // A town's guide is a courtesy: the listing answers without it.
      let guide = match landing {
        case SearchPage.ForTown(town) => Result.toOption(Serve.ask(app, &app.kinds.townGuide, town.slug))
        case _ => None
      }
      remembered(app, visitor, &anchored, Respond.page(200, &SearchPage.renderResults(&Context.frame(app, visitor), &catalog, &anchored, &landing, &page, &places, !placeFilters.after.isEmpty(), guide)))
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// The response remembering the town a visitor chose to search around, or forgetting it when they
/// chose anywhere; a listing that names no nearby choice leaves the cookie alone.
fn remembered(app: &Assembly.App, visitor: &Context.Visitor, filters: &Search.Filters, response: Http.Response) -> Http.Response {
  if !filters.near.isEmpty() {
    let value = Search.nearValue(filters.near, Option.unwrapOr(filters.radiusM, Search.DEFAULT_RADIUS_KM * 1000))
    if visitor.cookies.get(Cookies.NEAR) == Some(value) { return response }
    return Respond.withPreference(app, response, Cookies.NEAR, value)
  }
  if Route.queryParam(&visitor.request, "cerca") == Some("") && visitor.cookies.get(Cookies.NEAR) != None {
    return Respond.withCookie(response, Cookie.expire(Cookies.NEAR, app.runtime.secureCookies))
  }
  response
}

/// The home rail around the visitor's remembered town, as rendered markup for the home page script.
/// The home page itself stays the same for every guest so that the edge may keep it.
fn nearRail(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let (town, meters) = match Option.orElse(Option.andThen(visitor.cookies.get(Cookies.NEAR), |value: Str| Search.rememberedNear(value)), preferredNear(app, visitor)) {
    case Some(found) => found
    case None => { return private(Respond.json(200, &Json.object(&[("html", Json.Text(""))]))) }
  }
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  let filters = Search.anchored(&Search.Filters{..Search.everything(), near: town, radiusM: Some(meters), sort: Search.Near}, &catalog)
  let place = match Catalog.municipality(&catalog, town) {
    case Some(found) => found.name
    case None => { return private(Respond.json(200, &Json.object(&[("html", Json.Text(""))]))) }
  }
  match Serve.ask(app, &app.kinds.search, Serve.visit(visitor, filters)) {
    case Ok(page) => private(Respond.json(200, &Json.object(&[("html", Json.Text(HomePage.nearRail(&Context.frame(app, visitor), place, &filters, &page.items)))])))
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// Keeps the posted listing: its query string is parsed into filters and rendered again, so only
/// known filters are stored, and its label is written from them in the member's language.
fn saveSearch(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  let posted = Option.unwrapOr(Serve.fields(visitor).get("query"), "")
  let pairs = Url.parseQuery(if posted.startsWith("?") { posted.drop(1) } else { posted })
  let read = |name: Str| {
    var found = ""
    for pair in pairs {
      if pair[0] == name && found.isEmpty() { found = pair[1] }
    }
    found
  }
  let filters = Search.Filters{..filtersFrom(read), after: ""}
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  let query = SearchPage.queryOf(&filters, &SearchPage.Open, "")
  let saving = Search.Saving{label: SearchPage.label(&Context.frame(app, visitor), &catalog, &filters), query: query}
  match Serve.ask(app, &app.kinds.saveSearch, Serve.signed(session, saving)) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Routes.SEARCH + query), "flash.search_saved")
    case Err(Problem.Refused(reason)) => Respond.withFlash(app, Respond.redirect(Routes.SEARCH + query), "problem." + reason)
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// Removes a saved search, then returns to the activity page.
fn deleteSearch(app: &Assembly.App, visitor: &Context.Visitor, session: &Session.Session) -> Http.Response {
  match Serve.ask(app, &app.kinds.deleteSearch, Serve.signed(session, Serve.param(visitor, "id"))) {
    case Ok(_) => Respond.withFlash(app, Respond.redirect(Routes.ACTIVITY + "#searches"), "flash.search_deleted")
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// A signed-in member's first favourite town (or home town) with their preferred radius, used when
/// the browser remembers no nearby choice.
fn preferredNear(app: &Assembly.App, visitor: &Context.Visitor) -> Option[(Str, Int)] {
  let session = visitor.session ?
  let me = match Serve.ask(app, &app.kinds.me, Serve.signed(&session, ())) {
    case Ok(found) => found
    case Err(_) => { return None }
  }
  let town = Option.orElse(Option.fromArray(&me.preferredTowns), me.homeMunicipality) ?
  Some((town, Option.unwrapOr(me.preferredRadiusKm, Search.DEFAULT_RADIUS_KM) * 1000))
}

/// A script answer that depends on the visitor's cookies and is never kept by a shared cache.
fn private(response: Http.Response) -> Http.Response {
  Http.Response{..response, headers: response.headers.concat([("cache-control", HttpConstants.CACHE_PRIVATE), ("vary", "cookie")])}
}

/// A further page of results for the "load more" script: rendered cards and the next link.
fn pageJson(app: &Assembly.App, visitor: &Context.Visitor, filters: &Search.Filters, landing: &SearchPage.Landing, page: &Event.Page) -> Json.Json {
  let rendered = SearchPage.cards(&Context.frame(app, visitor), &page.items)
  let next = match page.next {
    case Some(cursor) => Json.Text(visitor.request.path + SearchPage.queryOf(filters, landing, cursor))
    case None => Json.Null
  }
  Json.object(&[("html", Json.Text(rendered)), ("next", next)])
}

/// A category or municipality landing page.
fn landingPage(app: &Assembly.App, visitor: &Context.Visitor, byCategory: Bool) -> Http.Response {
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  let slug = Serve.param(visitor, "slug")
  let filters = filtersOf(visitor)
  if byCategory {
    match Catalog.category(&catalog, slug) {
      case Some(category) => listingWith(app, visitor, SearchPage.ForCategory(category), Search.Filters{..filters, category: slug}, (if Catalog.takes(&category, Catalog.PLACE) { slug } else { "" }, ""))
      case None => Respond.problem(app, visitor, &Problem.Missing)
    }
  } else {
    match Catalog.municipality(&catalog, slug) {
      case Some(town) => listingWith(app, visitor, SearchPage.ForTown(town), Search.Filters{..filters, municipality: slug}, ("", slug))
      case None => Respond.problem(app, visitor, &Problem.Missing)
    }
  }
}

/// The map, with pins for the filters' position or the next events.
fn map(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  let located = Search.anchored(&filtersOf(visitor), &catalog)
  let filters = Search.Filters{..located, viewport: Some(Search.Viewport{south: App.BOUNDS_SOUTH, west: App.BOUNDS_WEST, north: App.BOUNDS_NORTH, east: App.BOUNDS_EAST})}
  match Serve.ask(app, &app.kinds.pins, filters) {
    case Ok(cards) => {
      let places = match Serve.ask(app, &app.kinds.placesMapped, filters) {
        case Ok(found) => found
        case Err(problem) => { return Respond.problem(app, visitor, &problem) }
      }
      Respond.page(200, &MapPage.renderPlaces(&Context.frame(app, visitor), &cards.items, &places.items, cards.limited || places.limited, Serve.query(visitor, "near") == "1", &catalog, &located, Routes.SEARCH + SearchPage.queryOf(&located, &SearchPage.Open, "")))
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// Typeahead suggestions as JSON: title, place, and address of each match.
fn suggest(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  match Serve.ask(app, &app.kinds.suggest, Serve.query(visitor, "q")) {
    case Ok(cards) => Http.Response{..Respond.json(200, &Json.list(&cards.map(|card: Event.Card| Json.object(&[
                ("title", Json.Text(Event.titleFor(&card, visitor.locale == Locale.En))),
                ("place", Json.Text(card.municipality.name)),
                ("href", Json.Text(Routes.EVENT_PREFIX + card.slug))
              ])))), headers: [("content-type", "application/json; charset=utf-8"), ("cache-control", "public, max-age=0, s-maxage=60")] }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// "Nearby": the guide of the town around the visitor's position. A position off the islands opens
/// the search, and no position the map.
fn nearMe(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let lat = Geo.parseDegrees(Serve.query(visitor, "lat"))
  let lng = Geo.parseDegrees(Serve.query(visitor, "lng"))
  let (atLat, atLng) = match (lat, lng) {
    case (Some(a), Some(b)) => (a, b)
    case _ => { return Respond.redirect(Routes.MAP) }
  }
  let catalog = match Serve.ask(app, &app.kinds.catalog, ()) {
    case Ok(found) => found
    case Err(problem) => { return Respond.problem(app, visitor, &problem) }
  }
  match Catalog.nearestTown(&catalog, atLat, atLng) {
    case Some(town) => Respond.redirect(Routes.TOWN_PREFIX + town.slug)
    case None => Respond.redirect(Routes.SEARCH)
  }
}

/// Events around a position as JSON for the map: pins and their cards.
fn nearby(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let filters = filtersOf(visitor)
  if filters.lat == None { return Respond.problem(app, visitor, &Problem.Refused("invalid_coordinates")) }
  let requested = Option.unwrapOr(Serve.query(visitor, "radius").toInt(), Limits.NEARBY_RADIUS_M)
  let radius = if requested <= 0 { Limits.NEARBY_RADIUS_M } else if requested > Limits.RADIUS_MAX_M { Limits.RADIUS_MAX_M } else { requested }
  match Serve.ask(app, &app.kinds.pins, Search.Filters{..filters, sort: Search.Near, radiusM: Some(radius)}) {
    case Ok(cards) => {
      let places = match Serve.ask(app, &app.kinds.placesMapped, Search.Filters{..filters, radiusM: Some(radius)}) {
        case Ok(found) => found
        case Err(problem) => { return Respond.problem(app, visitor, &problem) }
      }
      Respond.json(200, &MapPage.combinedPins(&Context.frame(app, visitor), &cards.items, &places.items))
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}

/// Validated camera reads never load an unbounded catalogue.
fn viewport(app: &Assembly.App, visitor: &Context.Visitor) -> Http.Response {
  let read = |name: Str| Geo.parseDegrees(Serve.query(visitor, name))
  let box = match (read("south"), read("west"), read("north"), read("east")) {
    case (Some(s), Some(w), Some(n), Some(e)) => {
      if !(s >= -85.0 && s <= 85.0 && n >= -85.0 && n <= 85.0 && w >= -180.0 && w <= 180.0 && e >= -180.0 && e <= 180.0 && s < n && w < e) { return Respond.problem(app, visitor, &Problem.Refused("invalid_coordinates")) }
      Search.Viewport{south: s, west: w, north: n, east: e}
    }
    case _ => { return Respond.problem(app, visitor, &Problem.Refused("invalid_coordinates")) }
  }
  if box.north < App.BOUNDS_SOUTH || box.south > App.BOUNDS_NORTH || box.east < App.BOUNDS_WEST || box.west > App.BOUNDS_EAST { return Respond.json(200, &Json.object(&[("items", Json.list(&[])), ("limited", Json.Boolean(false))])) }
  let filters = Search.Filters{..filtersOf(visitor), viewport: Some(box), after: "", near: "", lat: None, lng: None, radiusM: None}
  match Serve.ask(app, &app.kinds.pins, filters) {
    case Ok(cards) => {
      let frame = Context.frame(app, visitor)
      let places = match Serve.ask(app, &app.kinds.placesMapped, filters) {
        case Ok(found) => found
        case Err(problem) => { return Respond.problem(app, visitor, &problem) }
      }
      let answer = Respond.json(200, &Json.object(&[("items", MapPage.combinedPins(&frame, &cards.items, &places.items)), ("limited", Json.Boolean(cards.limited || places.limited))]))
      // Pins depend only on the address once it names the language they are rendered in.
      if Serve.query(visitor, "hl") == Locale.code(&frame.locale) { Http.Response{..answer, headers: answer.headers.push(("cache-control", HttpConstants.CACHE_SHARED_PINS))} } else { answer }
    }
    case Err(problem) => Respond.problem(app, visitor, &problem)
  }
}
