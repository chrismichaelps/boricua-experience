/** @Web.Platform.Lambda — platform invocations read as requests and answered as documents */
module Web.Platform

import Std.Bytes as ByteSeq
import Std.Http as Http
import Std.Http.Server.Route as Route
import Std.Json as Json
import Std.Option as Option
import Std.Result as Result

/// The request an invocation carries. A platform wraps the HTTP request as JSON in `body` when the
/// event says `Action: Invoke`; gateways put it at the top level.
export fn requestOf(event: &Json.Json) -> Route.Request {
  let request = requestIn(event)
  let target = targetIn(&request)
  let method = Option.unwrapOr(Option.firstPresent(&[textAt(&request, "method"), textAt(&request, "httpMethod"), Option.andThen(Json.path(&request, &["requestContext", "http", "method"]), |found: Json.Json| Json.asText(&found))]), "GET")
  let headers = headersIn(&request)
  let raw = Option.unwrapOr(textAt(&request, "body"), "")
  let encoded = Option.unwrapOr(textAt(&request, "encoding"), "") == "base64" || Option.unwrapOr(Option.andThen(Json.field(&request, "isBase64Encoded"), |found: Json.Json| Json.asBool(&found)), false)
  let body = if encoded {
    match ByteSeq.decodeBase64(raw) {
      case Ok(bytes) => Option.unwrapOr(Result.toOption(ByteSeq.toText(&bytes)), "")
      case Err(_) => ""
    }
  } else { raw }
  Route.Request {
    message: Http.Request{method: Http.methodFrom(method.toUpper()), target: target, headers: headers, body: body, binaryBody: None},
    path: Route.pathOf(target),
    params: mapOf([]),
    query: Route.queryOf(target),
    peer: Option.unwrapOr(Http.header(&headers, "x-forwarded-for"), "platform")
  }
}

/// The request document inside an invocation.
fn requestIn(event: &Json.Json) -> Json.Json {
  if Option.unwrapOr(textAt(event, "Action"), "") != "Invoke" { return *event }
  match Json.decode(Option.unwrapOr(textAt(event, "body"), "")) {
    case Ok(found) => found
    case Err(_) => *event
  }
}

/// The path and query the request asks for, from whichever shape the platform sent.
fn targetIn(request: &Json.Json) -> Str {
  let whole = Option.unwrapOr(Option.firstPresent(&[textAt(request, "rawPath"), textAt(request, "path"), textAt(request, "url")]), "/")
  let query = Option.unwrapOr(textAt(request, "rawQueryString"), "")
  if query.isEmpty() || whole.contains("?") { whole } else { whole + "?" + query }
}

/// The headers, names in lower case; a list value is joined as HTTP joins repeated headers.
fn headersIn(request: &Json.Json) -> Array[(Str, Str)] {
  let held = match Json.field(request, "headers") {
    case Some(found) => found
    case None => { return [] }
  }
  var found: Array[(Str, Str)] = []
  for entry in Option.unwrapOr(Json.asObject(&held), []) {
    let name = entry[0].toLower()
    match Json.asText(&entry[1]) {
      case Some(value) => { found = found.push((name, value)) }
      case None => {
        let joined = Option.unwrapOr(Json.asList(&entry[1]), []).map(|member: Json.Json| Option.unwrapOr(Json.asText(&member), "")).filter(|part: Str| !part.isEmpty())
        if joined.length() > 0 { found = found.push((name, joined.join(", "))) }
      }
    }
  }
  found
}

/// A text field of a JSON object.
fn textAt(document: &Json.Json, name: Str) -> Option[Str] { Json.asText(&Json.field(document, name) ?) }

/// The answer document: status, single headers, every cookie in `multiValueHeaders`, and the body
/// (base64 when it is binary).
export fn answered(response: &Http.Response) -> Str {
  var single: Array[(Str, Json.Json)] = []
  var cookies: Array[Json.Json] = []
  for header in response.headers {
    if header[0].toLower() == "set-cookie" { cookies = cookies.push(Json.Text(header[1])) } else { single = single.push((header[0], Json.Text(header[1]))) }
  }
  let (body, binary) = match response.binaryBody {
    case Some(bytes) => (ByteSeq.encodeBase64(&bytes), true)
    case None => (response.body, false)
  }
  Json.encode(&Json.object(&[
        ("statusCode", Json.Number(response.status.code)),
        ("headers", Json.object(&single)),
        ("multiValueHeaders", Json.object(&[("set-cookie", Json.list(&cookies))])),
        ("body", Json.Text(body)),
        ("isBase64Encoded", Json.Boolean(binary))
      ]))
}
