/// An icon as inline SVG, hidden from assistive software; the control it sits in carries the label.
export fn icon(name: Str) -> H.Node { sized(name, 24) }

/// An icon at a pixel size.
export fn sized(name: Str, size: Int) -> H.Node {
  let paths = match PATHS.get(name) {
    case Some(found) => found
    case None => []
  }
  var svg = H.tag("svg")
    .at("viewBox", "0 0 24 24")
    .at("width", show(size))
    .at("height", show(size))
    .at("fill", "none")
    .at("stroke", "currentColor")
    .at("stroke-width", "2")
    .at("stroke-linecap", "round")
    .at("stroke-linejoin", "round")
    .at("aria-hidden", "true")
    .at("focusable", "false")
    .class("icon")
  for data in paths {
    svg = svg.holding([H.tag("path").at("d", data)])
  }
  svg
}

/// Whether the set has an icon of this name.
export fn has(name: Str) -> Bool { PATHS.containsKey(name) }
