/** @View.Components.Notice.Messages — flash messages, empty states, and the cookie banner */
module View.Components.Notice

import Std.Html.Build as H
import Std.Html.Build {Building}
import Constants.Routes as Routes
import View.Components.Icons as Icons
import View.Frame as Frame

/// The one-time message of the previous action, announced politely.
export fn flash(frame: &Frame.Frame) -> H.Node {
  if frame.flash.isEmpty() { return H.nothing() }
  H.div().class("toast").role("status").at("aria-live", "polite").data("feature", "toast").holding([Icons.sized("check", 18), H.span().says(Frame.t(frame, frame.flash))])
}

/// A calm empty state with an icon, a message, and an optional action.
export fn empty(icon: Str, title: Str, body: Str, action: H.Node) -> H.Node {
  H.div().class("empty").holding([H.span().class("empty-icon").holding([Icons.sized(icon, 32)]), H.h2().says(title), H.p().says(body), action])
}

/// The cookie choice, shown until the visitor makes one: accept all, refuse optional, or choose.
export fn cookieBanner(frame: &Frame.Frame) -> H.Node {
  if frame.consent != None { return H.nothing() }
  let back = H.input().kind("hidden").name("return").value(Frame.here(frame))
  H.section().class("cookie-banner").role("region").label(Frame.t(frame, "cookies.title")).holding([
      H.h2().says(Frame.t(frame, "cookies.title")),
      H.p().holding([H.span().says(Frame.t(frame, "cookies.body") + " "), H.a().class("text-link").href(Routes.COOKIES).says(Frame.t(frame, "cookies.learn_more"))]),
      H.form().action(Routes.CONSENT).method("post").class("cookie-actions").holding([
          back,
          H.details().class("cookie-custom").data("feature", "privacy-controls").holding([
              H.summary().holding([H.span().says(Frame.t(frame, "cookies.customize")), Icons.sized("chevron-right", 18)]),
              H.labelFor().class("privacy-switch").holding([H.input().kind("checkbox").checked().disabled(), H.span().class("privacy-switch-track").at("aria-hidden", "true"), H.span().says(Frame.t(frame, "cookies.necessary"))]),
              H.labelFor().class("privacy-switch").holding([H.input().kind("checkbox").name("analytics").value("on"), H.span().class("privacy-switch-track").at("aria-hidden", "true"), H.span().says(Frame.t(frame, "cookies.analytics"))]),
              H.labelFor().class("privacy-switch").holding([H.input().kind("checkbox").name("marketing").value("on"), H.span().class("privacy-switch-track").at("aria-hidden", "true"), H.span().says(Frame.t(frame, "cookies.marketing"))]),
              H.button().submit().name("choice").value("custom").class("button button-ghost").says(Frame.t(frame, "cookies.save"))
            ]),
          H.button().submit().name("choice").value("necessary").class("button button-ghost").says(Frame.t(frame, "cookies.reject")),
          H.button().submit().name("choice").value("all").class("button").says(Frame.t(frame, "cookies.accept"))
        ])
    ])
}
