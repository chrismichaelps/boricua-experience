/** @View.Components.Hero.Carousel — changing island scenes behind a fixed search surface */
module View.Components.Hero

import Std.Html.Build {Building}
import Std.Html.Build as H
import Constants.Routes as Routes
import Domain.Catalog as Catalog
import Domain.Locale as Locale
import Domain.Search as Search
import View.Components.Icons as Icons
import View.Components.Search as Controls
import View.Frame as Frame

/// The home hero with labelled carousel controls and a first scene usable without scripts.
/// The photo at phone width (1300px) and at full width (2200px), for `srcset`.
export fn photoSet(src: Str) -> Str { src.replace(".webp", "-1300.webp") + " 1300w, " + src + " 2200w" }

export fn render(frame: &Frame.Frame, catalog: &Catalog.Catalog) -> H.Node {
  var images: Array[H.Node] = []
  var dots: Array[H.Node] = []
  for index in 0..catalog.scenes.length() {
    let scene = catalog.scenes[index]
    let caption = if frame.locale == Locale.Es { scene.captionEs } else { scene.captionEn }
    images = images.push(H.img().class(if index == 0 { "hero-slide is-current" } else { "hero-slide" }).src(scene.image).at("srcset", photoSet(scene.image)).at("sizes", "100vw").alt("").at("loading", if index == 0 { "eager" } else { "lazy" }).at("decoding", "async").at("fetchpriority", if index == 0 { "high" } else { "low" }).data("place", caption).data("href", Routes.TOWN_PREFIX + scene.town))
    dots = dots.push(H.button().kind("button").class("hero-dot").data("slide", show(index)).label(Frame.tf(frame, "home.slide", &[("place", caption)])).at("aria-pressed", if index == 0 { "true" } else { "false" }).holding([H.span().at("aria-hidden", "true")]))
  }
  H.div().class("hero-frame").data("feature", "hero-carousel").role("region").label(Frame.t(frame, "home.carousel")).at("aria-roledescription", Frame.t(frame, "home.carousel_role")).holding([
      H.div().class("hero-photos").at("aria-hidden", "true").holding(images),
      H.div().class("hero-copy").holding([
          H.h1().says(Frame.t(frame, "home.headline")),
          H.p().says(Frame.t(frame, "home.subhead"))
        ]),
      Controls.pill(frame, catalog, &Search.everything()),
      H.div().class("hero-bottom").holding([
          if catalog.scenes.isEmpty() { H.nothing() } else { H.a().class("hero-place").data("carousel", "place").href(Routes.TOWN_PREFIX + catalog.scenes[0].town).says(if frame.locale == Locale.Es { catalog.scenes[0].captionEs } else { catalog.scenes[0].captionEn }) },
          if catalog.scenes.length() < 2 { H.nothing() } else { H.div().class("hero-controls").holding([
                H.div().class("hero-dots").role("group").label(Frame.t(frame, "home.carousel")).holding(dots),
                H.button().kind("button").class("hero-pause").data("carousel", "pause").data("pause-label", Frame.t(frame, "home.pause_slides")).data("play-label", Frame.t(frame, "home.play_slides")).label(Frame.t(frame, "home.pause_slides")).holding([
                    H.span().class("carousel-pause-symbol").at("aria-hidden", "true").holding([Icons.sized("pause", 16)]),
                    H.span().class("carousel-play-symbol").at("aria-hidden", "true").says("▶")
                  ])
              ]) }
        ])
    ])
}
