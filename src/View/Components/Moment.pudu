/** @View.Components.Moment.Time — dates and times as `<time>` elements the browser rewrites in the reader's zone */
module View.Components.Moment

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Time as StdTime
import I18n.Dates as Dates
import Utils.Time as Time
import View.Frame as Frame

/// A `<time>` holding the Puerto Rico text, the instant, and the style the browser re-renders it in.
fn stamp(at: Str, style: Str, text: Str) -> H.Node {
  H.time().at("datetime", at).data("moment", style).says(text)
}

/// A card's line (`Hoy · 7:30 PM`, or `Ahora · hasta 9:00 PM` while it is on).
export fn when(frame: &Frame.Frame, startsAt: Str, endsAt: Str, now: &StdTime.Instant) -> H.Node {
  stamp(startsAt, "when", Dates.when(&frame.locale, startsAt, endsAt, now)).data("ends", endsAt)
}

/// An event's full schedule: date, start, and end.
export fn schedule(frame: &Frame.Frame, startsAt: Str, endsAt: Str) -> H.Node {
  stamp(startsAt, "schedule", Dates.schedule(&frame.locale, startsAt, endsAt)).data("ends", endsAt)
}

/// A short date, `Sáb 10 oct`.
export fn day(frame: &Frame.Frame, at: Str) -> H.Node {
  match Time.parseTimestamp(at) {
    case Some(instant) => stamp(at, "day", Dates.short(&frame.locale, &Time.local(&instant)))
    case None => H.nothing()
  }
}
