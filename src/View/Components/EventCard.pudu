/** @View.Components.EventCard.Listing — an event as a card and cards as rails and grids */
module View.Components.EventCard

import Std.Html.Build as H
import Std.Html.Build {Building}
import Std.Option as Option
import Std.Time as StdTime
import Constants.Routes as Routes
import Domain.Event as Event
import I18n.Dates as Dates
import I18n.Format as Format
import View.Components.Icons as Icons
import View.Components.Moment as Moment
import View.Frame as Frame

/// The cover an event shows, its own or its category's illustration.
export fn coverOf(event: &Event.Card) -> Str {
  Option.unwrapOr(event.coverUrl, "/assets/covers/" + event.category.slug + ".svg")
}

/// One event as a card: cover, price, save, time, title, place, and social proof.
export fn card(frame: &Frame.Frame, event: &Event.Card) -> H.Node {
  let locale = frame.locale
  let now = StdTime.instantOf(frame.nowMillis)
  let href = Routes.EVENT_PREFIX + event.slug
  let social = Format.going(&locale, event.approvedCount)
  let seats = Format.seats(&locale, event)
  let distance = Format.distance(&locale, event.distanceM)
  H.article().class(if Event.isCancelled(event) { "card card-cancelled" } else { "card" }).holding([
      H.a().class("card-link").href(href).holding([
          H.div().class("card-media").holding([
              H.img().src(coverOf(event)).alt("").at("loading", "lazy").at("decoding", "async").at("width", "640").at("height", "400"),
              H.span().class("pill pill-light card-price").says(Format.price(&locale, event.priceCents)),
              if Event.isCancelled(event) { H.span().class("pill pill-dark card-flag").says(Frame.t(frame, "event.cancelled")) } else if Event.needsApproval(event) { H.span().class("pill pill-dark card-flag").holding([Icons.sized("lock", 14), H.span().says(Frame.t(frame, "event.approval_short"))]) } else { H.nothing() }
            ]),
          H.div().class("card-body").holding([
              H.p().class("card-when").holding([Moment.when(frame, event.startsAt, event.endsAt, &now)]),
              H.h3().class("card-title").says(event.title),
              H.p().class("card-place").holding([Icons.sized("pin", 14), H.span().says(event.venueName + " · " + event.municipality.name)]),
              H.div().class("card-meta").holding([
                  H.span().class("meta").holding([Icons.sized("users", 14), H.span().says(social)]),
                  if event.likeCount > 0 { H.span().class("meta").holding([Icons.sized("heart", 14), H.span().says(show(event.likeCount))]) } else { H.nothing() },
                  if seats.isEmpty() { H.nothing() } else { H.span().class("meta meta-accent").says(seats) },
                  if distance.isEmpty() { H.nothing() } else { H.span().class("meta").says(distance) }
                ])
            ])
        ])
    ])
}

/// A titled row of cards that scrolls sideways on phones, with a link to see more.
export fn rail(frame: &Frame.Frame, id: Str, title: Str, cards: &Array[Event.Card], more: Str) -> H.Node {
  if cards.isEmpty() { return H.nothing() }
  H.section().class("rail").at("aria-labelledby", id).holding([
      H.div().class("rail-head").holding([
          H.h2().class("section-title").id(id).says(title),
          if more.isEmpty() { H.nothing() } else { H.a().class("text-link").href(more).holding([H.span().says(Frame.t(frame, "home.see_all")), Icons.sized("chevron-right", 16)]) }
        ]),
      H.div().class("rail-track").role("list").holding(cards.map(|event: Event.Card| H.div().class("rail-item").role("listitem").holding([card(frame, &event)])))
    ])
}

/// Cards in a responsive grid.
export fn grid(frame: &Frame.Frame, cards: &Array[Event.Card]) -> H.Node {
  H.div().class("card-grid").holding(cards.map(|event: Event.Card| card(frame, &event)))
}
