/** @View.Components.Reviews.Opinions — a place's rating summary, reviews, the review form, answers, and reports */
module View.Components.Reviews

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Option as Option
import Constants.Routes as Routes
import Domain.Problem as Problem
import Domain.Resume as Resume
import Domain.Review as Review
import Domain.TownGuide as TownGuide
import I18n.Dates as Dates
import I18n.Translate as Translate
import Utils.Query as Query
import Utils.Text as Text
import Utils.Time as Time
import View.Components.Avatar as Avatar
import View.Components.Form as Form
import View.Components.Icons as Icons
import View.Frame as Frame

/// The reviews section of a place page.
export fn section(frame: &Frame.Frame, slug: Str, board: &Review.ReviewBoard, draft: &Review.ReviewDraft, problem: &Option[Problem.Problem]) -> H.Node {
  sectionFiltered(frame, slug, board, draft, problem, &Review.ALL_REVIEWS)
}

/// The reviews section showing only the reviews a reader filtered for.
export fn sectionFiltered(frame: &Frame.Frame, slug: Str, board: &Review.ReviewBoard, draft: &Review.ReviewDraft, problem: &Option[Problem.Problem], filter: &Review.ReviewFilter) -> H.Node {
  let base = Routes.PLACE_PREFIX + slug
  H.section().class("panel reviews").id("reviews").at("aria-labelledby", "reviews-title").holding([
      H.h2().class("section-title").id("reviews-title").says(Frame.t(frame, "review.title")),
      summary(frame, board),
      filters(frame, base, board, filter),
      composer(frame, base, board, draft, problem),
      if board.items.isEmpty() && Review.filtered(filter) {
        H.p().class("muted").holding([H.span().says(Frame.t(frame, "review.filter_none") + " "), H.a().class("text-link").href(base + "#reviews").says(Frame.t(frame, "review.filter_all"))])
      } else if board.items.isEmpty() { H.p().class("muted").says(Frame.t(frame, "review.none")) } else {
        H.ol().class("review-list").holding(board.items.map(|review: Review.Review| item(frame, base, board, &review)))
      },
      match board.next {
        case Some(cursor) => H.a().class("button button-ghost load-more").href(base + filterQuery(filter, cursor) + "#reviews").says(Frame.t(frame, "review.more"))
        case None => H.nothing()
      }
    ])
}

/// The query of a filtered page of reviews, with its cursor when there is one.
fn filterQuery(filter: &Review.ReviewFilter, cursor: Str) -> Str {
  Query.render(&[("estrellas", if filter.rating > 0 { show(filter.rating) } else { "" }), ("con", filter.companions), ("resenas", cursor)])
}

/// Chips narrowing the reviews to a star count or to who the visit was with; only filters that
/// find something are offered, and none at all for fewer than three reviews.
fn filters(frame: &Frame.Frame, base: Str, board: &Review.ReviewBoard, filter: &Review.ReviewFilter) -> H.Node {
  if board.count < 3 && !Review.filtered(filter) { return H.nothing() }
  let chip = |href: Str, label: Str, on: Bool| H.a().class(if on { "chip chip-active" } else { "chip" }).href(href).at("aria-current", if on { "true" } else { "false" }).says(label)
  let starChips = [5, 4, 3, 2, 1].filter(|n: Int| Review.countOf(board, n) > 0 || filter.rating == n).map(|n: Int| chip(base + filterQuery(&Review.ReviewFilter{rating: n, companions: filter.companions}, "") + "#reviews", Frame.tf(frame, "review.filter_stars", &[("count", show(n))]), filter.rating == n))
  let company = Review.COMPANIONS.filter(|kind: Str| Review.companionCount(board, kind) > 0 || filter.companions == kind).map(|kind: Str| chip(base + filterQuery(&Review.ReviewFilter{rating: filter.rating, companions: kind}, "") + "#reviews", Frame.t(frame, "review.with_" + kind), filter.companions == kind))
  H.nav().class("review-filters chips").label(Frame.t(frame, "review.filter_label")).holding([chip(base + "#reviews", Frame.t(frame, "review.filter_all"), !Review.filtered(filter))].concat(starChips).concat(company))
}

/// Recent published opinions across all ratings, independent of the full-list cursor.
export fn highlights(frame: &Frame.Frame, slug: Str, board: &Review.ReviewBoard) -> H.Node {
  if board.highlights.isEmpty() { return H.nothing() }
  H.section().class("visitor-highlights").at("aria-labelledby", "visitor-highlights-title").holding([
      H.div().class("place-section-heading").holding([
          H.div().holding([H.h2().class("section-title").id("visitor-highlights-title").says(Frame.t(frame, "review.highlights")), H.p().class("muted small").says(Frame.t(frame, "review.highlights_note"))]),
          H.a().class("text-link").href(Routes.PLACE_PREFIX + slug + "#reviews").says(Frame.t(frame, "review.read_all"))
        ]),
      H.ul().class("visitor-review-rail").at("tabindex", "0").label(Frame.t(frame, "review.highlights")).holding(board.highlights.map(|review: Review.Review| H.li().class("visitor-review-card").holding([
              author(frame, &review),
              stars(frame, review.rating),
              H.p().class("visitor-review-excerpt").says(Text.truncate(review.body, 240)),
              H.a().class("text-link").href(Routes.PLACE_PREFIX + slug + "#review-" + review.id).says(Frame.t(frame, "review.read_full"))
            ])))
    ])
}

/// What visitors say about a town's places: the town's average and count, then the newest published
/// reviews, each linking to its place. Nothing when no place in town has a review.
export fn townVoices(frame: &Frame.Frame, townName: Str, guide: &TownGuide.TownGuide) -> H.Node {
  let reviews = Option.unwrapOr(guide.reviews, [])
  let count = Option.unwrapOr(guide.reviewCount, 0)
  if reviews.isEmpty() || count == 0 { return H.nothing() }
  let average = Option.unwrapOr(guide.reviewAverage, 0.0)
  H.section().class("visitor-highlights town-voices").at("aria-labelledby", "town-voices-title").holding([
      H.div().class("place-section-heading").holding([
          H.div().holding([
              H.h2().class("section-title").id("town-voices-title").says(Frame.tf(frame, "review.town_title", &[("town", townName)])),
              H.p().class("review-average town-voices-average").holding([H.strong().says(show(average)), stars(frame, roundStars(average)), H.span().class("muted").says(Translate.count(&frame.locale, "place.reviews", count))])
            ])
        ]),
      H.ul().class("visitor-review-rail").at("tabindex", "0").label(Frame.tf(frame, "review.town_title", &[("town", townName)])).holding(reviews.map(|review: TownGuide.TownReview| H.li().class("visitor-review-card").holding([
              H.div().class("review-author").holding([
                  Avatar.face(review.author, None, "md"),
                  H.div().holding([H.strong().says(review.author), H.p().class("muted small").says(townWhen(frame, &review))])
                ]),
              stars(frame, review.rating),
              H.p().class("visitor-review-excerpt").says(Text.truncate(review.body, 240)),
              H.a().class("text-link town-voices-place").href(Routes.PLACE_PREFIX + review.placeSlug + "#reviews").holding([Icons.sized("pin", 14), H.span().says(review.placeName)])
            ])))
    ])
}

/// The visit month of a town review, or the month it was written.
fn townWhen(frame: &Frame.Frame, review: &TownGuide.TownReview) -> Str {
  let stamp = match review.visitedOn {
    case Some(day) => day + "T12:00:00Z"
    case None => review.createdAt
  }
  match Time.parseTimestamp(stamp) {
    case Some(at) => if review.visitedOn == None { Dates.monthYear(&frame.locale, &Time.local(&at)) } else { Frame.tf(frame, "review.visited_on", &[("month", Dates.monthYear(&frame.locale, &Time.local(&at)))]) }
    case None => ""
  }
}

/// Public reviewer identity with visit or publication month; no verification claim is inferred.
fn author(frame: &Frame.Frame, review: &Review.Review) -> H.Node {
  H.div().class("review-author").holding([
      Avatar.face(review.author.displayName, review.author.avatarUrl, "md"),
      H.div().holding([H.strong().says(review.author.displayName), H.p().class("muted small").says(when(frame, review))])
    ])
}

/// Filled and empty stars for a rating, read aloud as "4 of 5".
fn stars(frame: &Frame.Frame, rating: Int) -> H.Node {
  H.span().class("stars").role("img").label(Frame.tf(frame, "review.stars_label", &[("count", show(rating))])).holding([1, 2, 3, 4, 5].map(|n: Int| H.span().class(if n <= rating { "star star-on" } else { "star" }).at("aria-hidden", "true").says("★")))
}

/// The average, the count, and a bar per number of stars.
fn summary(frame: &Frame.Frame, board: &Review.ReviewBoard) -> H.Node {
  if board.count == 0 { return H.nothing() }
  let average = Option.unwrapOr(board.average, 0.0)
  H.div().class("review-summary").holding([
      H.div().class("review-average").holding([
          H.strong().says(show(average)),
          stars(frame, roundStars(average)),
          H.span().class("muted").says(Translate.count(&frame.locale, "place.reviews", board.count))
        ]),
      H.ul().class("review-bars").holding([5, 4, 3, 2, 1].map(|n: Int| {
            let count = Review.countOf(board, n)
            H.li().holding([
                H.span().says(show(n) + " ★"),
                H.span().class("review-bar").holding([H.span().class("review-bar-fill").at("style", "width:" + show(if board.count == 0 { 0 } else { count * 100 / board.count }) + "%")]),
                H.span().class("muted").says(show(count))
              ])
          }))
    ])
}

/// The nearest whole number of stars of an average.
fn roundStars(average: Float64) -> Int {
  var whole = 1
  for (n, threshold) in [(2, 1.5), (3, 2.5), (4, 3.5), (5, 4.5)] {
    if average >= threshold { whole = n }
  }
  whole
}

/// The review form for a member who may review, the owner's note, or an invitation to sign in.
fn composer(frame: &Frame.Frame, base: Str, board: &Review.ReviewBoard, draft: &Review.ReviewDraft, problem: &Option[Problem.Problem]) -> H.Node {
  if board.isOwner { return H.p().class("banner").says(Frame.t(frame, "review.owner_note")) }
  if !Frame.signedIn(frame) { return H.a().class("button button-ghost").href(Resume.signIn(Routes.SIGN_IN, base + "#reviews", "review")).says(Frame.t(frame, "review.sign_in")) }
  if !board.canReview { return H.nothing() }
  let errors = match problem {
    case Some(found) => Problem.fieldErrors(&found)
    case None => []
  }
  let current = match board.mine {
    case Some(mine) => if draft.body.isEmpty() && draft.rating.isEmpty() { Review.draftOf(&mine) } else { *draft }
    case None => *draft
  }
  let refusedRating = Problem.errorFor(&errors, "rating")
  H.div().class("review-composer").holding([
      match board.mine {
        case Some(mine) => if mine.status == "held" { H.p().class("banner").role("status").says(Frame.t(frame, "review.held_note")) } else { H.nothing() }
        case None => H.nothing()
      },
      Form.problemBanner(frame, problem),
      H.form().class("stack-form").action(base + "/review").method("post").holding([
          Form.token(frame),
          H.fieldset().class(if refusedRating == None { "field rating-input" } else { "field rating-input field-invalid" }).holding([
              H.legend().class("label").says(Frame.t(frame, if board.mine == None { "review.your_rating" } else { "review.edit_rating" })),
              H.div().class("rating-choices").holding([5, 4, 3, 2, 1].map(|n: Int| {
                    var radio = H.input().kind("radio").name("rating").id("rating-" + show(n)).value(show(n))
                    if current.rating == show(n) { radio = radio.checked() }
                    H.span().holding([radio, H.labelFor().at("for", "rating-" + show(n)).label(Frame.tf(frame, "review.stars_label", &[("count", show(n))])).says("★")])
                  })),
              match refusedRating {
                case Some(key) => H.p().class("field-error").role("alert").says(Frame.t(frame, key))
                case None => H.nothing()
              }
            ]),
          Form.area(frame, &Form.Field{..Form.field("body", Frame.t(frame, "review.body"), current.body), hint: Frame.t(frame, "review.body_hint"), required: true}, 4, &errors),
          Form.input(frame, &Form.Field{..Form.field("visited", Frame.t(frame, "review.visited"), current.visited), kind: "month"}, &errors, |c: H.Node| c.at("min", "2000-01")),
          H.fieldset().class("field companion-input").holding([
              H.legend().class("label").says(Frame.t(frame, "review.companions_label")),
              H.div().class("chips").holding(Review.COMPANIONS.map(|kind: Str| {
                    var radio = H.input().kind("radio").class("sr-only").name("companions").id("companions-" + kind).value(kind)
                    if current.companions == kind { radio = radio.checked() }
                    H.span().class("chip-choice").holding([radio, H.labelFor().class("chip").at("for", "companions-" + kind).says(Frame.t(frame, "review.with_" + kind))])
                  }))
            ]),
          H.button().submit().class("button").says(Frame.t(frame, if board.mine == None { "review.publish" } else { "review.save" }))
        ]),
      match board.mine {
        case Some(_) => H.form().action(base + "/review/delete").method("post").holding([
            Form.token(frame),
            H.button().submit().class("button button-ghost button-small").holding([Icons.sized("trash", 16), H.span().says(Frame.t(frame, "review.delete"))])
          ])
        case None => H.nothing()
      }
    ])
}

/// One review with the owner's answer, the owner's answer form, and the report form.
fn item(frame: &Frame.Frame, base: Str, board: &Review.ReviewBoard, review: &Review.Review) -> H.Node {
  let reviewBase = base + "/reviews/" + review.id
  H.li().class("review").id("review-" + review.id).holding([
      H.div().class("review-head").holding([
          author(frame, review),
          stars(frame, review.rating)
        ]),
      match review.companions {
        case Some(kind) => if Review.COMPANIONS.contains(kind) { H.p().class("review-companions muted small").holding([Icons.sized("users", 14), H.span().says(Frame.t(frame, "review.went_" + kind))]) } else { H.nothing() }
        case None => H.nothing()
      },
      H.p().class("review-body").says(review.body),
      match review.response {
        case Some(answer) => H.div().class("review-response").holding([H.p().class("small").holding([H.strong().says(Frame.t(frame, "review.owner_answer"))]), H.p().says(answer)])
        case None => H.nothing()
      },
      if board.isOwner {
        H.details().class("review-answer").holding([
            H.summary().says(Frame.t(frame, if review.response == None { "review.answer" } else { "review.edit_answer" })),
            H.form().class("stack-form").action(reviewBase + "/respond").method("post").holding([
                Form.token(frame),
                H.labelFor().class("sr-only").at("for", "answer-" + review.id).says(Frame.t(frame, "review.answer")),
                H.textarea().name("response").id("answer-" + review.id).rows(3).at("maxlength", "1000").says(Option.unwrapOr(review.response, "")),
                H.button().submit().class("button button-small").says(Frame.t(frame, "review.send_answer"))
              ])
          ])
      } else { H.nothing() },
      if Frame.signedIn(frame) && !review.isAuthor {
        if review.reported { H.p().class("muted small").says(Frame.t(frame, "review.reported")) } else {
          H.details().class("review-report").holding([
              H.summary().class("small").says(Frame.t(frame, "review.report")),
              H.form().class("stack-form").data("feature", "search-pickers").data("picker-close", Frame.t(frame, "search.close_picker")).action(reviewBase + "/report").method("post").holding([
                  Form.token(frame),
                  H.labelFor().class("sr-only").at("for", "reason-" + review.id).says(Frame.t(frame, "review.report_reason")),
                  H.select().name("reason").id("reason-" + review.id).holding(Review.REASONS.map(|reason: Str| H.option().value(reason).says(Frame.t(frame, "review.reason_" + reason)))),
                  H.textarea().name("detail").rows(2).at("maxlength", "1000").label(Frame.t(frame, "review.report_detail")),
                  H.button().submit().class("button button-ghost button-small").says(Frame.t(frame, "review.send_report"))
                ])
            ])
        }
      } else { H.nothing() }
    ])
}

/// When the reviewer visited, else when they wrote the review.
fn when(frame: &Frame.Frame, review: &Review.Review) -> Str {
  match review.visitedOn {
    case Some(day) => match Time.parseTimestamp(day + "T12:00:00Z") {
      case Some(at) => Frame.tf(frame, "review.visited_on", &[("month", Dates.monthYear(&frame.locale, &Time.local(&at)))])
      case None => ""
    }
    case None => match Time.parseTimestamp(review.createdAt) {
      case Some(at) => Dates.monthYear(&frame.locale, &Time.local(&at))
      case None => ""
    }
  }
}
