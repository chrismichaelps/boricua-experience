/** @View.Components.PhotoHeader.Photos — cover-first media and a shared menu-header gallery */
module View.Components.PhotoHeader

import Std.Html.Build {Building}
import Std.Html.Build as H
import Domain.Media as Media
import View.Components.PlaceGallery as PlaceGallery
import View.Frame as Frame

/// The header photographs: the uploaded cover, else the place's existing cover address, then the
/// further photographs. Empty means the category's default image is shown instead.
export fn photosOf(gallery: &Media.Gallery, cover: &Option[Str]) -> Array[Str] {
  let uploaded = Media.ofKind(gallery, Media.COVER).map(|file: Media.MediaFile| file.url)
  let first = if !uploaded.isEmpty() { uploaded } else {
    match cover {
      case Some(address) => if address.startsWith("/assets/covers/") { [] } else { [address] }
      case None => []
    }
  }
  first.concat(Media.ofKind(gallery, Media.GALLERY).map(|file: Media.MediaFile| file.url))
}

/// Menu headers share the same accessible image viewer as their parent place.
export fn render(frame: &Frame.Frame, photos: &Array[Str], fallback: Str, caption: Str, href: Str, modifier: Str) -> H.Node {
  H.div().class("photo-header " + modifier).holding([
      PlaceGallery.renderWithContext(frame, photos, fallback, caption,
        H.aside().class("gallery-context").label(Frame.t(frame, "place.about")).holding([
            H.h3().says(Frame.t(frame, "place.about")),
            H.p().says(caption),
            H.a().class("text-link gallery-read-all").data("photo", "context-link").href(href).says(Frame.t(frame, "gallery.view_place"))
          ]))
    ])
}
