/** @View.Components.Avatar.Faces — initials in a coloured circle, alone or stacked */
module View.Components.Avatar

import Std.Html.Build as H
import Std.Html.Build {Building}
import Utils.Text as Text

/// Background hues avatars are drawn in, chosen by name so a person keeps their colour.
const HUES: Array[Str] = ["#1878ec", "#0f9d8a", "#e0603a", "#8a4fd8", "#d63c6b", "#2f7d32", "#b8860b", "#2b5ea7"]

/// The hue of a name.
fn hueOf(name: Str) -> Str {
  var sum = 0
  for letter in name.chars() {
    sum = (sum * 31 + letter.code()) % 9973
  }
  HUES[sum % HUES.length()]
}

/// Pixel width of each size class, for the photo's intrinsic size.
const PIXELS: Map[Str, Str] = mapOf([("sm", "32"), ("md", "40"), ("lg", "56"), ("xl", "80")])

/// One avatar of a size class (`sm`, `md`, `lg`, `xl`): initials in a coloured circle.
export fn avatar(name: Str, size: Str) -> H.Node {
  H.span().class("avatar avatar-" + size).at("style", "background:" + hueOf(name)).at("aria-hidden", "true").says(Text.initials(name))
}

/// The person's photo when they have one, their initials otherwise.
export fn face(name: Str, photo: Option[Str], size: Str) -> H.Node {
  match photo {
    case Some(address) => {
      let pixels = match PIXELS.get(size) {
        case Some(found) => found
        case None => "40"
      }
      H.img().class("avatar avatar-photo avatar-" + size).src(address).alt("").at("width", pixels).at("height", pixels).at("loading", "lazy").at("decoding", "async")
    }
    case None => avatar(name, size)
  }
}

/// Up to four overlapping faces, as (name, photo) pairs, and a count of the rest.
export fn stack(people: &Array[(Str, Option[Str])], total: Int) -> H.Node {
  var shown: Array[H.Node] = []
  var index = 0
  for person in *people {
    if index < 4 { shown = shown.push(face(person[0], person[1], "sm")) }
    index = index + 1
  }
  let rest = total - shown.length()
  H.span().class("avatar-stack").holding(shown).when(rest > 0, H.span().class("avatar avatar-sm avatar-more").at("aria-hidden", "true").says("+" + show(rest)))
}
