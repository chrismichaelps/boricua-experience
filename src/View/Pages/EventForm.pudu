/** @View.Pages.EventForm.Publishing — the form that creates and edits an event */
module View.Pages.EventForm

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Constants.App as App
import Constants.Routes as Routes
import Domain.Catalog as Catalog
import Domain.Draft as Draft
import Domain.Problem as Problem
import View.Components.Form as Form
import View.Components.Icons as Icons
import View.Components.Search as SearchControls
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/** @View.Pages.EventForm.Mode — publishing a new event or editing one */
export type Mode = Creating | Editing(Str)

/// A group of radio choices with a legend.
fn choices(name: Str, legend: Str, options: &Array[(Str, Str, Str)], chosen: Str) -> H.Node {
  H.fieldset().class("choices").holding([H.legend().says(legend)].concat(options.map(|option: (Str, Str, Str)| {
          var radio = H.input().kind("radio").name(name).id("f-" + name + "-" + option[0]).value(option[0])
          if option[0] == chosen { radio = radio.checked() }
          H.labelFor().class("choice").at("for", "f-" + name + "-" + option[0]).holding([radio, H.span().holding([H.strong().says(option[1]), H.small().says(option[2])])])
        })))
}

/// The publishing form, filled with the draft and showing every refused field.
export fn render(frame: &Frame.Frame, catalog: &Catalog.Catalog, mode: &Mode, draft: &Draft.Draft, problem: &Option[Problem.Problem]) -> Html.Html {
  let errors = match problem {
    case Some(found) => Problem.fieldErrors(&found)
    case None => []
  }
  let (title, action, submit) = match mode {
    case Creating => (Frame.t(frame, "publish.title"), Routes.CREATE, Frame.t(frame, "publish.submit"))
    case Editing(slug) => (Frame.t(frame, "publish.edit_title"), Routes.EVENT_PREFIX + slug + "/edit", Frame.t(frame, "publish.save"))
  }
  let categories = [("", Frame.t(frame, "publish.choose"))].concat(catalog.categories.map(|category: Catalog.Category| (category.slug, SearchControls.categoryName(frame, &category))))
  let towns = [("", Frame.t(frame, "publish.choose"))].concat(catalog.municipalities.map(|town: Catalog.Municipality| (town.slug, town.name)))
  let field = |name: Str, label: Str, value: Str| Form.Field{..Form.field(name, Frame.t(frame, label), value), required: true}
  let meta = Seo.meta(title, Frame.t(frame, "publish.description"), Routes.CREATE, false)
  Layout.page(frame, &meta, Layout.Create, H.div().class("narrow").holding([
        H.h1().class("page-title").says(title),
        H.p().class("lead").says(Frame.t(frame, "publish.lead")),
        Form.problemBanner(frame, problem),
        H.form().class("stack-form").action(action).method("post").at("novalidate", "novalidate").data("feature", "publish").holding([
            Form.token(frame),
            H.section().class("form-section").holding([
                H.h2().class("section-title").says(Frame.t(frame, "publish.basics")),
                Form.input(frame, &field("title", "publish.field_title", draft.title), &errors, |c: H.Node| c.at("maxlength", "120")),
                Form.input(frame, &Form.Field{..field("summary", "publish.field_summary", draft.summary), hint: Frame.t(frame, "publish.hint_summary")}, &errors, |c: H.Node| c.at("maxlength", "200")),
                Form.select(frame, &field("category", "publish.field_category", draft.category), &categories, &errors),
                Form.area(frame, &Form.Field{..Form.field("description", Frame.t(frame, "publish.field_description"), draft.description), hint: Frame.t(frame, "publish.hint_description")}, 6, &errors)
              ]),
            H.section().class("form-section").holding([
                H.h2().class("section-title").says(Frame.t(frame, "publish.when")),
                H.div().class("row-2").holding([
                    Form.input(frame, &Form.Field{..field("startsAt", "publish.field_starts", draft.startsAt), kind: "datetime-local"}, &errors, |c: H.Node| c.data("date-min", "today")),
                    Form.input(frame, &Form.Field{..field("endsAt", "publish.field_ends", draft.endsAt), kind: "datetime-local", required: false}, &errors, |c: H.Node| c.data("date-min", "today"))
                  ]),
                H.p().class("field-hint").says(Frame.t(frame, "publish.hint_time"))
              ]),
            H.section().class("form-section").holding([
                H.h2().class("section-title").says(Frame.t(frame, "publish.where")),
                Form.select(frame, &field("municipality", "publish.field_town", draft.municipality), &towns, &errors),
                Form.input(frame, &field("venueName", "publish.field_venue", draft.venueName), &errors, |c: H.Node| c.at("maxlength", "120")),
                Form.input(frame, &Form.Field{..Form.field("addressLine", Frame.t(frame, "publish.field_address"), draft.addressLine), hint: Frame.t(frame, "publish.hint_address")}, &errors, |c: H.Node| c.at("maxlength", "200")),
                H.div().class(if Problem.errorFor(&errors, "location") == None { "field" } else { "field field-invalid" }).holding([
                    H.p().class("label").says(Frame.t(frame, "publish.field_pin")),
                    H.div().class("pin-picker").data("feature", "pin-picker").data("lat", if draft.lat.isEmpty() { show(App.MAP_CENTER_LAT) } else { draft.lat }).data("lng", if draft.lng.isEmpty() { show(App.MAP_CENTER_LNG) } else { draft.lng }).role("application").label(Frame.t(frame, "publish.field_pin")),
                    H.div().class("row-2").holding([
                        H.labelFor().class("compact").holding([H.span().says(Frame.t(frame, "publish.latitude")), H.input().kind("text").name("lat").value(draft.lat).at("inputmode", "decimal").data("pin", "lat")]),
                        H.labelFor().class("compact").holding([H.span().says(Frame.t(frame, "publish.longitude")), H.input().kind("text").name("lng").value(draft.lng).at("inputmode", "decimal").data("pin", "lng")])
                      ]),
                    H.button().kind("button").class("button button-ghost button-small").data("feature", "pin-here").holding([Icons.sized("crosshair", 16), H.span().says(Frame.t(frame, "publish.use_my_location"))]),
                    match Problem.errorFor(&errors, "location") {
                      case Some(key) => H.p().class("field-error").role("alert").says(Frame.t(frame, key))
                      case None => H.p().class("field-hint").says(Frame.t(frame, "publish.hint_pin"))
                    }
                  ])
              ]),
            H.section().class("form-section").holding([
                H.h2().class("section-title").says(Frame.t(frame, "publish.who")),
                choices("visibility", Frame.t(frame, "publish.field_visibility"), &[
                    ("public", Frame.t(frame, "visibility.public"), Frame.t(frame, "publish.visibility_public")),
                    ("unlisted", Frame.t(frame, "visibility.unlisted"), Frame.t(frame, "publish.visibility_unlisted")),
                    ("private", Frame.t(frame, "visibility.private"), Frame.t(frame, "publish.visibility_private"))
                  ], draft.visibility),
                choices("joinPolicy", Frame.t(frame, "publish.field_policy"), &[
                    ("approval", Frame.t(frame, "event.policy_approval"), Frame.t(frame, "event.policy_approval_long")),
                    ("open", Frame.t(frame, "event.policy_open"), Frame.t(frame, "event.policy_open_long"))
                  ], draft.joinPolicy),
                match Problem.errorFor(&errors, "joinPolicy") {
                  case Some(key) => H.p().class("field-error").role("alert").says(Frame.t(frame, key))
                  case None => H.nothing()
                },
                H.div().class("row-2").holding([
                    Form.input(frame, &Form.Field{..Form.field("capacity", Frame.t(frame, "publish.field_capacity"), draft.capacity), kind: "number", hint: Frame.t(frame, "publish.hint_capacity")}, &errors, |c: H.Node| c.at("min", "1").at("max", "100000").at("inputmode", "numeric")),
                    Form.input(frame, &Form.Field{..Form.field("price", Frame.t(frame, "publish.field_price"), draft.price), hint: Frame.t(frame, "publish.hint_price")}, &errors, |c: H.Node| c.at("inputmode", "decimal").placeholder("0.00"))
                  ])
              ]),
            H.section().class("form-section").holding([
                H.h2().class("section-title").says(Frame.t(frame, "publish.for_attendees")),
                Form.area(frame, &Form.Field{..Form.field("instructions", Frame.t(frame, "publish.field_instructions"), draft.instructions), hint: Frame.t(frame, "publish.hint_instructions")}, 4, &errors)
              ]),
            H.p().class("muted small").says(Frame.t(frame, "publish.adults_note")),
            H.button().submit().class("button button-block").says(submit)
          ])
      ]))
}
