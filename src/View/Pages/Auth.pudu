/** @View.Pages.Auth.Identity — signing in, signing up, recovering, and onboarding */
module View.Pages.Auth

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Constants.Routes as Routes
import Domain.Problem as Problem
import View.Components.Form as Form
import View.Components.Hero as Hero
import View.Components.Icons as Icons
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/** @View.Pages.Auth.Typed — what the visitor typed, kept when a form is refused */
export type Typed = { displayName: Str, email: Str, returnTo: Str }

/// The field errors of a problem.
fn errorsOf(problem: &Option[Problem.Problem]) -> Array[Problem.FieldError] {
  match problem {
    case Some(found) => Problem.fieldErrors(&found)
    case None => []
  }
}

/// A centred card holding an identity form.
fn card(frame: &Frame.Frame, meta: &Seo.Meta, title: Str, lead: Str, body: Array[H.Node]) -> Html.Html {
  Layout.page(frame, meta, Layout.Me, H.div().class("auth").holding([
        H.aside().class("auth-story").holding([
            H.img().src("/assets/img/el-yunque-photo.webp").at("srcset", Hero.photoSet("/assets/img/el-yunque-photo.webp")).at("sizes", "(max-width: 959px) 100vw, 50vw").alt("").at("width", "700").at("height", "900"),
            H.div().class("auth-story-copy").holding([H.h2().says(Frame.t(frame, "auth.story_title")), H.p().says(Frame.t(frame, "footer.tagline"))])
          ]),
        H.div().class("auth-card").holding([
            H.h1().class("page-title").says(title),
            if lead.isEmpty() { H.nothing() } else { H.p().class("lead").says(lead) }
          ].concat(body))
      ]))
}

/// The Google button, carrying where to return.
fn google(frame: &Frame.Frame, returnTo: Str) -> H.Node {
  H.a().class("button button-ghost button-block google").href(Routes.AUTH_GOOGLE + "?return=" + returnTo).holding([
      H.img().src("/assets/brand/google-mark.svg").alt("").at("width", "18").at("height", "18"),
      H.span().says(Frame.t(frame, "auth.continue_google"))
    ])
}

/// The "or" divider between the provider and the form.
fn divider(frame: &Frame.Frame) -> H.Node { H.p().class("divider").says(Frame.t(frame, "auth.or")) }

/// The sign-in page.
export fn signIn(frame: &Frame.Frame, typed: &Typed, problem: &Option[Problem.Problem]) -> Html.Html {
  let errors = errorsOf(problem)
  let meta = Seo.meta(Frame.t(frame, "auth.sign_in_title"), Frame.t(frame, "auth.sign_in_lead"), Routes.SIGN_IN, false)
  card(frame, &meta, Frame.t(frame, "auth.sign_in_title"), Frame.t(frame, "auth.sign_in_lead"), [
      Form.problemBanner(frame, problem),
      H.form().class("stack-form").action(Routes.SIGN_IN).method("post").holding([
          H.input().kind("hidden").name("return").value(typed.returnTo),
          Form.input(frame, &Form.Field{..Form.field("email", Frame.t(frame, "auth.email"), typed.email), kind: "email", required: true}, &errors, |c: H.Node| c.at("autocomplete", "email").at("inputmode", "email")),
          Form.input(frame, &Form.Field{..Form.field("password", Frame.t(frame, "auth.password"), ""), kind: "password", required: true}, &errors, |c: H.Node| c.at("autocomplete", "current-password")),
          H.button().submit().class("button button-block").says(Frame.t(frame, "auth.sign_in"))
        ]),
      divider(frame),
      google(frame, typed.returnTo),
      H.p().class("auth-links").holding([
          H.a().class("text-link").href(Routes.RECOVER).says(Frame.t(frame, "auth.forgot")),
          H.a().class("text-link").href(Routes.SIGN_UP + "?return=" + typed.returnTo).says(Frame.t(frame, "auth.no_account"))
        ])
    ])
}

/// The sign-up page with the age, terms, and privacy confirmations.
export fn signUp(frame: &Frame.Frame, typed: &Typed, problem: &Option[Problem.Problem]) -> Html.Html {
  let errors = errorsOf(problem)
  let meta = Seo.meta(Frame.t(frame, "auth.sign_up_title"), Frame.t(frame, "auth.sign_up_lead"), Routes.SIGN_UP, true)
  card(frame, &meta, Frame.t(frame, "auth.sign_up_title"), Frame.t(frame, "auth.sign_up_lead"), [
      Form.problemBanner(frame, problem),
      H.form().class("stack-form").action(Routes.SIGN_UP).method("post").holding([
          H.input().kind("hidden").name("return").value(typed.returnTo),
          Form.input(frame, &Form.Field{..Form.field("displayName", Frame.t(frame, "auth.name"), typed.displayName), required: true}, &errors, |c: H.Node| c.at("autocomplete", "name").at("maxlength", "60")),
          Form.input(frame, &Form.Field{..Form.field("email", Frame.t(frame, "auth.email"), typed.email), kind: "email", required: true}, &errors, |c: H.Node| c.at("autocomplete", "email").at("inputmode", "email")),
          Form.input(frame, &Form.Field{..Form.field("password", Frame.t(frame, "auth.password"), ""), kind: "password", required: true, hint: Frame.t(frame, "auth.password_hint")}, &errors, |c: H.Node| c.at("autocomplete", "new-password").at("minlength", "8")),
          Form.input(frame, &Form.Field{..Form.field("birthDate", Frame.t(frame, "auth.birth_date"), ""), kind: "date", required: true, hint: Frame.t(frame, "auth.birth_date_hint")}, &errors, |c: H.Node| c.at("autocomplete", "bday").at("min", "1900-01-01")),
          H.div().class("consents").holding([
              Form.checkbox(frame, "terms", H.span().holding([H.span().says(Frame.t(frame, "auth.accept_terms") + " "), H.a().class("text-link").href(Routes.TERMS).target("_blank").says(Frame.t(frame, "footer.terms"))]), false, &errors),
              Form.checkbox(frame, "privacy", H.span().holding([H.span().says(Frame.t(frame, "auth.accept_privacy") + " "), H.a().class("text-link").href(Routes.PRIVACY).target("_blank").says(Frame.t(frame, "footer.privacy"))]), false, &errors)
            ]),
          H.button().submit().class("button button-block").says(Frame.t(frame, "auth.create_account"))
        ]),
      divider(frame),
      google(frame, typed.returnTo),
      H.p().class("muted small center").says(Frame.t(frame, "auth.google_consent_note")),
      H.p().class("auth-links").holding([H.a().class("text-link").href(Routes.SIGN_IN + "?return=" + typed.returnTo).says(Frame.t(frame, "auth.have_account"))])
    ])
}

/// The page after a sign-up or recovery request: check your email.
export fn checkEmail(frame: &Frame.Frame, recovery: Bool) -> Html.Html {
  let meta = Seo.meta(Frame.t(frame, "auth.check_email"), Frame.t(frame, "auth.check_email"), Routes.SIGN_UP, false)
  card(frame, &meta, Frame.t(frame, "auth.check_email"), Frame.t(frame, if recovery { "auth.check_email_recovery" } else { "auth.check_email_body" }), [
      H.span().class("empty-icon").holding([Icons.sized("bell", 32)]),
      H.p().class("muted small").says(Frame.t(frame, "auth.check_email_same_browser")),
      H.a().class("button button-ghost button-block").href(Routes.SIGN_IN).says(Frame.t(frame, "auth.back_to_sign_in"))
    ])
}

/// The recovery request page.
export fn recover(frame: &Frame.Frame, typed: &Typed, problem: &Option[Problem.Problem]) -> Html.Html {
  let errors = errorsOf(problem)
  let meta = Seo.meta(Frame.t(frame, "auth.recover_title"), Frame.t(frame, "auth.recover_lead"), Routes.RECOVER, false)
  card(frame, &meta, Frame.t(frame, "auth.recover_title"), Frame.t(frame, "auth.recover_lead"), [
      Form.problemBanner(frame, problem),
      H.form().class("stack-form").action(Routes.RECOVER).method("post").holding([
          Form.input(frame, &Form.Field{..Form.field("email", Frame.t(frame, "auth.email"), typed.email), kind: "email", required: true}, &errors, |c: H.Node| c.at("autocomplete", "email")),
          H.button().submit().class("button button-block").says(Frame.t(frame, "auth.send_link"))
        ]),
      H.p().class("muted small").says(Frame.t(frame, "auth.recover_google_note"))
    ])
}

/// The new-password page reached from a recovery link.
export fn reset(frame: &Frame.Frame, problem: &Option[Problem.Problem]) -> Html.Html {
  let errors = errorsOf(problem)
  let meta = Seo.meta(Frame.t(frame, "auth.reset_title"), Frame.t(frame, "auth.reset_title"), Routes.RESET_PASSWORD, false)
  card(frame, &meta, Frame.t(frame, "auth.reset_title"), Frame.t(frame, "auth.reset_lead"), [
      Form.problemBanner(frame, problem),
      H.form().class("stack-form").action(Routes.RESET_PASSWORD).method("post").holding([
          Form.token(frame),
          Form.input(frame, &Form.Field{..Form.field("password", Frame.t(frame, "auth.new_password"), ""), kind: "password", required: true, hint: Frame.t(frame, "auth.password_hint")}, &errors, |c: H.Node| c.at("autocomplete", "new-password")),
          Form.input(frame, &Form.Field{..Form.field("confirmation", Frame.t(frame, "auth.confirm_password"), ""), kind: "password", required: true}, &errors, |c: H.Node| c.at("autocomplete", "new-password")),
          H.button().submit().class("button button-block").says(Frame.t(frame, "auth.save_password"))
        ])
    ])
}

/// The onboarding page for accounts that still owe their confirmations.
export fn welcome(frame: &Frame.Frame, displayName: Str, returnTo: Str, problem: &Option[Problem.Problem]) -> Html.Html {
  let errors = errorsOf(problem)
  let meta = Seo.meta(Frame.t(frame, "auth.welcome_title"), Frame.t(frame, "auth.welcome_lead"), Routes.ONBOARDING, false)
  card(frame, &meta, Frame.t(frame, "auth.welcome_title"), Frame.t(frame, "auth.welcome_lead"), [
      Form.problemBanner(frame, problem),
      H.form().class("stack-form").action(Routes.ONBOARDING).method("post").holding([
          Form.token(frame),
          H.input().kind("hidden").name("return").value(returnTo),
          Form.input(frame, &Form.Field{..Form.field("displayName", Frame.t(frame, "auth.name"), displayName), required: true}, &errors, |c: H.Node| c.at("autocomplete", "name").at("maxlength", "60")),
          Form.input(frame, &Form.Field{..Form.field("birthDate", Frame.t(frame, "auth.birth_date"), ""), kind: "date", required: true, hint: Frame.t(frame, "auth.birth_date_hint")}, &errors, |c: H.Node| c.at("autocomplete", "bday").at("min", "1900-01-01")),
          H.div().class("consents").holding([
              Form.checkbox(frame, "terms", H.span().holding([H.span().says(Frame.t(frame, "auth.accept_terms") + " "), H.a().class("text-link").href(Routes.TERMS).target("_blank").says(Frame.t(frame, "footer.terms"))]), false, &errors),
              Form.checkbox(frame, "privacy", H.span().holding([H.span().says(Frame.t(frame, "auth.accept_privacy") + " "), H.a().class("text-link").href(Routes.PRIVACY).target("_blank").says(Frame.t(frame, "footer.privacy"))]), false, &errors)
            ]),
          H.button().submit().class("button button-block").says(Frame.t(frame, "auth.continue"))
        ]),
      H.form().action(Routes.SIGN_OUT).method("post").holding([Form.token(frame), H.button().submit().class("text-link").says(Frame.t(frame, "auth.not_now"))])
    ])
}

/// Shown instead of the sign-up when a date of birth showed a minor: no form, no account, no data kept.
export fn unavailable(frame: &Frame.Frame) -> Html.Html {
  let meta = Seo.meta(Frame.t(frame, "auth.unavailable_title"), Frame.t(frame, "auth.unavailable_body"), Routes.SIGN_UP, false)
  card(frame, &meta, Frame.t(frame, "auth.unavailable_title"), Frame.t(frame, "auth.unavailable_body"), [
      H.a().class("button button-block button-ghost").href(Routes.HOME).says(Frame.t(frame, "auth.unavailable_home"))
    ])
}
