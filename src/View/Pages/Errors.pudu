/** @View.Pages.Errors.Answers — missing pages, failures, and the offline page */
module View.Pages.Errors

import Std.Html as Html
import Std.Html.Build as H
import Std.Html.Build {Building}
import Constants.Routes as Routes
import Domain.Problem as Problem
import View.Components.Notice as Notice
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/// The page for an address with nothing behind it.
export fn missing(frame: &Frame.Frame) -> Html.Html {
  let meta = Seo.meta(Frame.t(frame, "error.missing_title"), Frame.t(frame, "error.missing_body"), frame.path, false)
  Layout.page(frame, &meta, Layout.Elsewhere, Notice.empty("map", Frame.t(frame, "error.missing_title"), Frame.t(frame, "error.missing_body"), H.a().class("button").href(Routes.HOME).says(Frame.t(frame, "nav.explore"))))
}

/// The page for a problem that has no page of its own.
export fn problem(frame: &Frame.Frame, found: &Problem.Problem) -> Html.Html {
  let meta = Seo.meta(Frame.t(frame, "error.title"), Frame.t(frame, Problem.messageKey(found)), frame.path, false)
  Layout.page(frame, &meta, Layout.Elsewhere, Notice.empty("x", Frame.t(frame, "error.title"), Frame.t(frame, Problem.messageKey(found)), H.a().class("button").href(Routes.HOME).says(Frame.t(frame, "nav.explore"))))
}

/// The page the service worker shows when there is no connection and no saved copy.
export fn offline(frame: &Frame.Frame) -> Html.Html {
  let meta = Seo.meta(Frame.t(frame, "error.offline_title"), Frame.t(frame, "error.offline_body"), Routes.OFFLINE, false)
  Layout.page(frame, &meta, Layout.Elsewhere, Notice.empty("globe", Frame.t(frame, "error.offline_title"), Frame.t(frame, "error.offline_body"), H.a().class("button").href(Routes.HOME).data("feature", "retry").says(Frame.t(frame, "error.retry"))))
}
