/** @View.Pages.Search.Landing — what fixes the listing: nothing, a category, or a town */
export type Landing = Open | ForCategory(Catalog.Category) | ForTown(Catalog.Municipality)

/// The query string that reproduces the filters, with a cursor when given.
export fn queryOf(filters: &Search.Filters, landing: &Landing, after: Str) -> Str {
  let coordinate = |value: Option[Float64]| match value {
    case Some(found) => show(found)
    case None => ""
  }
  Query.render(&[
      ("q", filters.query),
      ("when", Search.windowName(&filters.window)),
      ("category", match landing {
          case ForCategory(_) => ""
          case _ => filters.category
        }),
      ("pueblo", match landing {
          case ForTown(_) => ""
          case _ => filters.municipality
        }),
      ("free", if filters.freeOnly { "1" } else { "" }),
      ("t", Search.traitsValue(&filters.traits)),
      ("sort", if filters.sort == Search.Soon && filters.query.isEmpty() && filters.lat == None && filters.near.isEmpty() { "" } else { Search.sortName(&filters.sort) }),
      ("cerca", filters.near),
      ("radio", if filters.near.isEmpty() && filters.lat == None { "" } else { show(Search.radiusKm(filters)) }),
      ("lat", if filters.near.isEmpty() { coordinate(filters.lat) } else { "" }),
      ("lng", if filters.near.isEmpty() { coordinate(filters.lng) } else { "" }),
      ("after", after)
    ])
}

/// A place continuation keeps its cursor separate from activity pagination.
export fn placeQueryOf(filters: &Search.Filters, landing: &Landing, after: Str) -> Str {
  let query = queryOf(filters, landing, "")
  query + (if query.isEmpty() { "?" } else { "&" }) + "places_after=" + Url.encodeComponent(after)
}

/// Escaped place cards for the progressive results grid.
export fn placeCards(frame: &Frame.Frame, catalog: &Catalog.Catalog, items: &Array[Place.Listing]) -> Str {
  Html.render(&H.nothing().holding(items.map(|place: Place.Listing| PlaceCard.card(frame, catalog, &place))).html())
}

/// A short name for a listing, from its filters, for a saved search.
export fn label(frame: &Frame.Frame, catalog: &Catalog.Catalog, filters: &Search.Filters) -> Str {
  var parts: Array[Str] = []
  if !filters.query.isEmpty() { parts = parts.push("“" + filters.query.take(40) + "”") }
  match Catalog.category(catalog, filters.category) {
    case Some(category) => { parts = parts.push(SearchControls.categoryName(frame, &category)) }
    case None => {}
  }
  match Catalog.municipality(catalog, filters.municipality) {
    case Some(town) => { parts = parts.push(town.name) }
    case None => {}
  }
  match Catalog.municipality(catalog, filters.near) {
    case Some(town) => { parts = parts.push(Frame.tf(frame, "search.around_town", &[("town", town.name), ("distance", Format.radius(&frame.locale, Search.radiusKm(filters)))])) }
    case None => {}
  }
  if filters.window != Search.Anytime { parts = parts.push(SearchControls.windowLabel(frame, &filters.window)) }
  if filters.freeOnly { parts = parts.push(Frame.t(frame, "footer.free")) }
  for name in filters.traits { parts = parts.push(Frame.t(frame, "quick." + name)) }
  if parts.isEmpty() { Frame.t(frame, "search.saved_all") } else { parts.join(" · ").take(80) }
}

/// The quick filters: one tap toggles today, the weekend, free, family, night, outdoors or step-free,
/// keeping every other choice; "near me" opens the map around the visitor.
fn quickFilters(frame: &Frame.Frame, filters: &Search.Filters, landing: &Landing, path: Str) -> H.Node {
  let chip = |key: Str, icon: Str, on: Bool, next: Search.Filters| {
    let link = H.a().class(if on { "chip quick-chip is-on" } else { "chip quick-chip" }).href(path + queryOf(&Search.Filters{..next, after: ""}, landing, "")).holding([Icons.sized(icon, 16), H.span().says(Frame.t(frame, "quick." + key))])
    if on { link.at("aria-current", "true") } else { link }
  }
  let window = |wanted: Search.When| if filters.window == wanted { Search.Anytime } else { wanted }
  let nearby = queryOf(filters, &Open, "")
  let marked = |name: Str| Search.Filters{..*filters, traits: Search.toggled(&filters.traits, name)}
  H.nav().class("quick-filters").label(Frame.t(frame, "quick.label")).holding([
      chip("today", "calendar", filters.window == Search.Today, Search.Filters{..*filters, window: window(Search.Today)}),
      chip("weekend", "calendar", filters.window == Search.Weekend, Search.Filters{..*filters, window: window(Search.Weekend)}),
      chip("free", "ticket", filters.freeOnly, Search.Filters{..*filters, freeOnly: !filters.freeOnly}),
      chip("family", "users", filters.traits.contains("family"), marked("family")),
      chip("night", "moon", filters.traits.contains("night"), marked("night")),
      chip("outdoor", "mountain", filters.traits.contains("outdoor"), marked("outdoor")),
      chip("accessible", "accessible", filters.traits.contains("accessible"), marked("accessible")),
      H.a().class("chip quick-chip").href(Routes.MAP + nearby + (if nearby.isEmpty() { "?" } else { "&" }) + "near=1").holding([Icons.sized("crosshair", 16), H.span().says(Frame.t(frame, "quick.near"))])
    ])
}

/// The button that keeps the listing, for members.
fn saveButton(frame: &Frame.Frame, filters: &Search.Filters) -> H.Node {
  if !Frame.signedIn(frame) { return H.nothing() }
  H.form().class("save-search").action(Routes.SEARCH_SAVE).method("post").holding([
      Form.token(frame),
      H.input().kind("hidden").name("query").value(queryOf(filters, &Open, "")),
      H.button().submit().class("button button-ghost button-small").holding([Icons.sized("bookmark", 18), H.span().says(Frame.t(frame, "search.save"))])
    ])
}

/// The title, description, and path of a listing.
fn identity(frame: &Frame.Frame, landing: &Landing, filters: &Search.Filters) -> (Str, Str, Str) {
  match landing {
    case ForCategory(category) => {
      let name = SearchControls.categoryName(frame, &category)
      (Frame.tf(frame, "search.category_title", &[("category", name)]), Frame.tf(frame, "search.category_description", &[("category", name)]), Routes.CATEGORY_PREFIX + category.slug)
    }
    case ForTown(town) => (Frame.tf(frame, "search.town_title", &[("town", town.name)]), Frame.tf(frame, "search.town_description", &[("town", town.name)]), Routes.TOWN_PREFIX + town.slug)
    case Open => {
      let title = if filters.query.isEmpty() { Frame.t(frame, "search.title") } else { Frame.tf(frame, "search.results_for", &[("query", filters.query)]) }
      (title, Frame.t(frame, "search.description"), Routes.SEARCH)
    }
  }
}

/// Cards rendered as markup, for the script that appends a further page.
export fn cards(frame: &Frame.Frame, items: &Array[Event.Card]) -> Str {
  Html.render(&H.nothing().holding(items.map(|card: Event.Card| EventCard.card(frame, &card))).html())
}

/// The results page.
export fn render(frame: &Frame.Frame, catalog: &Catalog.Catalog, filters: &Search.Filters, landing: &Landing, page: &Event.Page, places: &Array[Place.Listing]) -> Html.Html {
  renderResults(frame, catalog, filters, landing, page, &Place.Results{items: *places, next: None})
}

/// Independent activity and place pages share the same canonical filters.
export fn renderResults(frame: &Frame.Frame, catalog: &Catalog.Catalog, filters: &Search.Filters, landing: &Landing, page: &Event.Page, places: &Place.Results, continuingPlaces: Bool = false, guide: Option[TownGuide.TownGuide] = None) -> Html.Html {
  let (title, description, path) = identity(frame, landing, filters)
  let indexable = !continuingPlaces && match landing {
    case Open => !Search.isNarrowed(filters)
    case _ => filters.after.isEmpty()
  }
  let crumbs = match landing {
    case Open => []
    case _ => [Seo.breadcrumbs(frame.siteUrl, &[(Frame.t(frame, "nav.explore"), Routes.HOME), (title, path)])]
  }
  let meta = Seo.Meta{..Seo.meta(title, description, path, indexable), structured: crumbs}
  let activeCategory = match landing {
    case ForCategory(category) => category.slug
    case _ => filters.category
  }
  let more = match page.next {
    case Some(cursor) => H.a().class("button button-ghost load-more").href(path + queryOf(filters, landing, cursor)).data("feature", "load-more").says(Frame.t(frame, "search.load_more"))
    case None => H.nothing()
  }
  // The first page of the default listing is the quality ranking, so its places carry their position.
  let ranked = !continuingPlaces && filters.sort == Search.Soon && places.items.length() > 1
  let photographic = *landing == Open && !catalog.scenes.isEmpty()
  let scene = if photographic { catalog.scenes[0] } else { Catalog.Scene{image: "", captionEs: "", captionEn: "", town: ""} }
  Layout.page(frame, &meta, Layout.Explore, H.div().class("search-page").holding([
        if photographic {
          H.section().class("search-hero").holding([
              H.img().class("search-hero-photo").src(scene.image).at("srcset", Hero.photoSet(scene.image)).at("sizes", "100vw").alt("").at("fetchpriority", "high"),
              H.div().class("search-hero-content").holding([H.h1().says(title), H.p().says(description), SearchControls.pill(frame, catalog, filters)]),
              H.a().class("search-hero-place").href(Routes.TOWN_PREFIX + scene.town).says(if frame.locale == Locale.Es { scene.captionEs } else { scene.captionEn })
            ])
        } else { H.div().class("search-top").holding([SearchControls.pill(frame, catalog, filters)]) },
        SearchControls.chips(frame, catalog, activeCategory),
        H.div().id("search-results").class("results-head").holding([
            if photographic { H.h2().class("page-title").says(Frame.t(frame, "search.activities")) } else { H.h1().class("page-title").says(title) },
            H.div().class("results-actions").holding([
                saveButton(frame, filters),
                H.a().class("button button-ghost button-small").href(Routes.MAP + queryOf(filters, &Open, "")).holding([Icons.sized("map", 18), H.span().says(Frame.t(frame, "search.show_map"))])
              ])
          ]),
        quickFilters(frame, filters, landing, path),
        SearchControls.filterBar(frame, catalog, filters),
        match landing {
          case ForTown(town) => neighbors(frame, catalog, &town)
          case _ => H.nothing()
        },
        match (*landing, guide) {
          case (ForTown(town), Some(found)) => if continuingPlaces || !filters.after.isEmpty() { H.nothing() } else { TownGuidePanel.panel(frame, catalog, &town, &found) }
          case _ => H.nothing()
        },
        if page.items.isEmpty() && places.items.isEmpty() {
          Notice.empty("search", Frame.t(frame, "search.empty_title"), Frame.t(frame, "search.empty_body"), H.a().class("button").href(Routes.CREATE).says(Frame.t(frame, "home.create_action")))
        } else {
          H.div().class("results").data("feature", "results").holding([EventCard.grid(frame, &page.items), more])
        },
        if places.items.isEmpty() { H.nothing() } else {
          H.section().class("results place-results").at("aria-labelledby", "place-results-title").holding([
              H.h2().id("place-results-title").class("section-title").says(match landing {
                  case ForCategory(category) => Frame.tf(frame, "place.rail_category", &[("category", SearchControls.categoryName(frame, &category))])
                  case ForTown(town) => Frame.tf(frame, "place.rail_town", &[("town", town.name)])
                  case Open => Frame.t(frame, "place.rail")
                }),
              H.div().class("card-grid").holding(if ranked { PlaceCard.ranked(frame, catalog, &places.items) } else { places.items.map(|place: Place.Listing| PlaceCard.card(frame, catalog, &place)) }),
              match places.next {
                case Some(cursor) => H.a().class("button button-ghost load-more").href(path + placeQueryOf(filters, landing, cursor)).data("feature", "load-more").says(Frame.t(frame, "search.load_more"))
                case None => H.nothing()
              }
            ])
        }
      ]))
}

/// The towns nearest a town, each linking to activities around it.
fn neighbors(frame: &Frame.Frame, catalog: &Catalog.Catalog, town: &Catalog.Municipality) -> H.Node {
  let near = Catalog.neighbors(catalog, town, Limits.NEIGHBOR_COUNT)
  if near.isEmpty() { return H.nothing() }
  H.nav().class("neighbors").label(Frame.t(frame, "search.nearby_towns")).holding([
      H.h2().class("neighbors-title").says(Frame.t(frame, "search.nearby_towns")),
      H.a().class("chip chip-active").href(Routes.SEARCH + Query.render(&[("cerca", town.slug), ("radio", show(Search.DEFAULT_RADIUS_KM))])).holding([Icons.sized("crosshair", 16), H.span().says(Frame.tf(frame, "search.around_town", &[("town", town.name), ("distance", Format.radius(&frame.locale, Search.DEFAULT_RADIUS_KM))]))])
    ].concat(near.map(|found: Catalog.Neighbor| H.a().class("chip").href(Routes.TOWN_PREFIX + found.town.slug).holding([H.span().says(found.town.name), H.small().says(Geo.distanceLabel(found.meters))]))))
}
