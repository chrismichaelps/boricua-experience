/** @View.Pages.Home.Front — search first, then rails of what is happening */
module View.Pages.Home

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Std.Html as HtmlText
import Constants.Routes as Routes
import Domain.Catalog as Catalog
import Domain.Event as Event
import Domain.Locale as Locale
import Domain.Search as Search
import I18n.Format as Format
import Services.Discovery as Discovery
import Utils.Query as Query
import View.Components.EventCard as EventCard
import View.Components.Hero as Hero
import View.Components.Icons as Icons
import View.Components.Search as SearchControls
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/// The home page.
export fn render(frame: &Frame.Frame, catalog: &Catalog.Catalog, home: &Discovery.Home) -> Html.Html {
  let meta = Seo.Meta{..Seo.meta(Frame.t(frame, "home.title"), Frame.t(frame, "home.description"), Routes.HOME, true), structured: [Seo.website(frame.siteUrl)]}
  Layout.page(frame, &meta, Layout.Explore, H.div().class("home").holding([
        H.section().class("hero").holding([
            Hero.render(frame, catalog)
          ]),
        // The search's companions read as one group: categories, plans near you, and quick filters.
        H.div().class("home-discover").holding([SearchControls.chips(frame, catalog, ""), planTile(frame), quickLinks(frame)]),
        homeRail(frame, "rail-for-you", Frame.t(frame, if Frame.signedIn(frame) { "home.for_you" } else { "home.popular" }), &home.recommended, Routes.SEARCH),
        homeRail(frame, "rail-weekend", Frame.t(frame, "home.weekend"), &home.weekend, Routes.SEARCH + "?when=weekend"),
        H.div().class("near-slot").data("feature", "near-rail").data("src", Routes.API_HOME_NEAR),
        nearTile(frame, catalog),
        homeRail(frame, "rail-soon", Frame.t(frame, "home.soon"), &home.soon, Routes.SEARCH),
        homeRail(frame, "rail-free", Frame.t(frame, "home.free"), &home.free, Routes.SEARCH + "?free=1&when=week"),
        homeRail(frame, "rail-gems", Frame.t(frame, "home.gems"), &home.gems, ""),
        createTile(frame),
        directory(frame, catalog)
      ]))
}

/// A home row of activities. A row of a single activity reads as a gap on the page, so a row needs two;
/// its activities still appear in the other rows and in the full listing.
fn homeRail(frame: &Frame.Frame, id: Str, title: Str, cards: &Array[Event.Card], more: Str) -> H.Node {
  if cards.length() < 2 { return H.nothing() }
  EventCard.rail(frame, id, title, cards, more)
}

/// One-tap listings for the most asked-for moments and kinds: today, the weekend, free, family, night,
/// outdoors, step-free, and what is near.
fn quickLinks(frame: &Frame.Frame) -> H.Node {
  let link = |key: Str, icon: Str, href: Str| H.a().class("chip quick-chip").href(href).holding([Icons.sized(icon, 16), H.span().says(Frame.t(frame, "quick." + key))])
  H.nav().class("quick-filters home-quick").label(Frame.t(frame, "quick.label")).holding([
      link("today", "calendar", Routes.SEARCH + "?when=today"),
      link("weekend", "calendar", Routes.SEARCH + "?when=weekend"),
      link("free", "ticket", Routes.SEARCH + "?free=1"),
      link("family", "users", Routes.SEARCH + "?t=family"),
      link("night", "moon", Routes.SEARCH + "?t=night"),
      link("outdoor", "mountain", Routes.SEARCH + "?t=outdoor"),
      link("accessible", "accessible", Routes.SEARCH + "?t=accessible"),
      link("near", "crosshair", Routes.MAP + "?near=1")
    ])
}

/// The invitation to ready-made plans: "what should we do today near me?" answered in one tap.
fn planTile(frame: &Frame.Frame) -> H.Node {
  H.a().class("plan-tile").href(Routes.PLAN).holding([
      H.span().class("plan-tile-icon").at("aria-hidden", "true").holding([Icons.sized("map", 22)]),
      H.span().class("plan-tile-copy").holding([H.strong().says(Frame.t(frame, "plan.cta")), H.span().says(Frame.t(frame, "plan.cta_body"))]),
      Icons.sized("chevron-right", 20)
    ])
}

/// The blue promotional tile inviting the visitor to see what is near: by device location, or by
/// choosing a town and a radius, which needs no location permission at all.
fn nearTile(frame: &Frame.Frame, catalog: &Catalog.Catalog) -> H.Node {
  var towns = H.select().name("cerca").id("near-town").required()
  towns = towns.holding([H.option().value("").says(Frame.t(frame, "home.near_pick_town"))])
  for town in catalog.municipalities { towns = towns.holding([H.option().value(town.slug).says(town.name)]) }
  H.section().class("promo").holding([
      H.div().class("promo-copy").holding([
          H.h2().says(Frame.t(frame, "home.near_title")),
          H.p().says(Frame.t(frame, "home.near_body"))
        ]),
      H.div().class("promo-actions").holding([
          H.a().class("button button-light").href(Routes.MAP + "?near=1").holding([Icons.sized("crosshair", 18), H.span().says(Frame.t(frame, "home.near_action"))]),
          H.form().class("near-form").data("feature", "search-pickers").data("picker-close", Frame.t(frame, "search.close_picker")).data("picker-search", Frame.t(frame, "search.find_town")).data("picker-empty", Frame.t(frame, "search.no_towns")).action(Routes.SEARCH).method("get").holding([
              H.labelFor().class("sr-only").at("for", "near-town").says(Frame.t(frame, "search.near")),
              towns,
              H.labelFor().class("sr-only").at("for", "near-radius").says(Frame.t(frame, "search.radius")),
              SearchControls.radiusSelect(frame, Search.DEFAULT_RADIUS_KM, "near-radius"),
              H.button().submit().class("button button-light button-small").says(Frame.t(frame, "home.near_go"))
            ])
        ])
    ])
}

/// The rail of events around the visitor's remembered town, as markup the home page script inserts.
export fn nearRail(frame: &Frame.Frame, town: Str, filters: &Search.Filters, cards: &Array[Event.Card]) -> Str {
  let more = Routes.SEARCH + Query.render(&[("cerca", filters.near), ("radio", show(Search.radiusKm(filters)))])
  let title = Frame.tf(frame, "home.near_town", &[("town", town), ("distance", Format.radius(&frame.locale, Search.radiusKm(filters)))])
  HtmlText.render(&EventCard.rail(frame, "rail-near", title, &cards.slice(0, if cards.length() < 10 { cards.length() } else { 10 }), more).html())
}

/// The tile inviting the visitor to publish their own activity.
fn createTile(frame: &Frame.Frame) -> H.Node {
  H.section().class("create-tile").holding([
      H.div().holding([
          H.h2().class("app-heading").says(Frame.t(frame, "home.create_title")),
          H.p().says(Frame.t(frame, "home.create_body"))
        ]),
      H.a().class("button").href(Routes.CREATE).holding([Icons.sized("plus", 18), H.span().says(Frame.t(frame, "home.create_action"))])
    ])
}

/// The featured destinations, then every municipality grouped by region.
fn directory(frame: &Frame.Frame, catalog: &Catalog.Catalog) -> H.Node {
  H.section().class("directory").id("towns").at("aria-labelledby", "directory-title").holding([
      H.h2().class("section-title").id("directory-title").says(Frame.t(frame, "home.towns")),
      H.p().class("directory-intro").says(Frame.t(frame, "home.towns_body")),
      H.div().class("destination-grid").holding(catalog.scenes.map(|scene: Catalog.Scene| H.a().class("destination-card").href(Routes.TOWN_PREFIX + scene.town).holding([
              H.img().src(scene.image).at("srcset", Hero.photoSet(scene.image)).at("sizes", "(max-width: 599px) 100vw, 33vw").alt("").at("loading", "lazy").at("width", "640").at("height", "480"),
              H.span().class("destination-copy").holding([H.strong().says(if frame.locale == Locale.Es { scene.captionEs } else { scene.captionEn }), H.span().holding([H.span().says(Frame.t(frame, "home.discover_town")), Icons.sized("chevron-right", 18)])])
            ]))),
      townBrowser(frame, catalog)
    ])
}

/// Region tabs over a grid of towns; radio inputs select the panel, so it works before any script runs.
fn townBrowser(frame: &Frame.Frame, catalog: &Catalog.Catalog) -> H.Node {
  let regions = Catalog.regions(catalog)
  if regions.isEmpty() { return H.nothing() }
  let tabs = regions.map(|region: Str| H.span().class("region-tab").holding([regionInput(region, regions[0]), H.labelFor().at("for", "region-" + region).says(Frame.t(frame, "region." + region))]))
  let panels = regions.map(|region: Str| H.ul().class("town-panel").data("region", region).holding(catalog.municipalities.filter(|town: Catalog.Municipality| town.region == region).map(|town: Catalog.Municipality| H.li().holding([
            H.a().class("town-link").href(Routes.TOWN_PREFIX + town.slug).holding([H.span().says(town.name), Icons.sized("chevron-right", 16)])
          ]))))
  H.div().class("town-browser").holding([
      H.div().class("town-browser-head").holding([
          H.h3().class("town-browser-title").says(Frame.t(frame, "home.all_towns")),
          H.p().class("muted").says(Frame.t(frame, "home.all_towns_body"))
        ]),
      H.fieldset().class("region-tabs").holding([H.legend().class("sr-only").says(Frame.t(frame, "home.region_picker"))].concat(tabs))
    ].concat(panels))
}

/// One region radio; the metro area starts selected.
fn regionInput(region: Str, first: Str) -> H.Node {
  let input = H.input().kind("radio").class("region-input").name("region").id("region-" + region).value(region)
  if region == first { input.flag("checked") } else { input }
}

/// Initial skeleton app loading is disabled: no placeholder is rendered.
fn skeleton() -> H.Node {
  H.nothing()
}
