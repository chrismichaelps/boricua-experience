/** @View.Pages.Event.Detail — one event: what, when, where, who hosts, who goes, and how to join */
module View.Pages.Event

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Std.Option as Option
import Constants.Routes as Routes
import Domain.Event as Event
import Domain.Locale as Locale
import Domain.Participation as Participation
import Domain.Problem as Problem
import Domain.Resume as Resume
import I18n.Dates as Dates
import I18n.Format as Format
import I18n.Translate as Translate
import Utils.Query as Query
import Utils.Text as Text
import Utils.Time as Time
import View.Calendar as Calendar
import View.Components.EventCard as EventCard
import View.Components.Form as Form
import View.Components.Icons as Icons
import View.Components.Moment as Moment
import View.Components.People as People
import View.Components.PlaceGallery as PlaceGallery
import View.Components.Weather as Weather
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/// The event page; `problem` is the refusal of the last action on it, shown in the join panel.
export fn render(frame: &Frame.Frame, detail: &Event.Detail, problem: &Option[Problem.Problem]) -> Html.Html { renderFrom(frame, detail, problem, "") }

/// The activity page for a visit from a channel, which its join form carries so the request is
/// counted with it.
export fn renderFrom(frame: &Frame.Frame, detail: &Event.Detail, problem: &Option[Problem.Problem], channel: Str) -> Html.Html {
  let card = detail.card
  let path = Routes.EVENT_PREFIX + card.slug
  // Only a public activity that is still on is offered to search engines; ended and cancelled pages stay reachable by link.
  let indexable = card.visibility == "public" && card.status == "published" && !Event.hasEnded(&card, frame.nowMillis)
  let meta = Seo.Meta {
    ..Seo.meta(card.title, Text.truncate(card.summary, 160), path, indexable),
    image: EventCard.coverOf(&card),
    structured: if indexable { [Seo.event(frame.siteUrl, detail), Seo.breadcrumbs(frame.siteUrl, &[(Frame.t(frame, "nav.explore"), Routes.HOME), (Format.categoryName(&frame.locale, &card.category), Routes.CATEGORY_PREFIX + card.category.slug), (card.title, path)])] } else { [] }
  }
  Layout.page(frame, &meta, Layout.Explore, H.article().class("event").id("activity-detail").data("feature", "event").data("slug", card.slug).holding([
        cover(frame, detail),
        H.div().class("event-layout").holding([
            H.div().class("event-main").holding([
                heading(frame, detail),
                resumeBanner(frame, detail),
                interest(frame, detail),
                reactions(frame, detail),
                about(frame, detail),
                facts(frame, detail),
                otherDates(frame, detail),
                place(frame, detail),
                People.organizer(frame, &detail.organizer, detail.source == "curated"),
                if detail.source == "curated" { H.nothing() } else { People.attendees(frame, &detail.attendees, Routes.SIGN_IN + "?return=" + path) },
                participants(frame, detail),
                report(frame, detail)
              ]),
            H.aside().class("event-side").holding([joinPanel(frame, detail, problem, channel)])
          ])
      ]))
}

/// The cover with its overlaid back, share, and save controls.
fn cover(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let image = EventCard.coverOf(&card)
  let actual = !image.startsWith("/assets/covers/") && !image.isEmpty()
  let imageLabel = Frame.tf(frame, "media.slide", &[("number", "1"), ("total", "1")])
  H.section().class("event-cover-gallery").data("feature", if actual { "photo-gallery" } else { "" }).holding([
      H.div().class("event-cover").holding([
          if actual {
            H.a().class("event-cover-photo").href(image).data("photo-index", "0").label(imageLabel).holding([
                H.img().src(image).alt(imageLabel).at("width", "1280").at("height", "640").at("fetchpriority", "high")
              ])
          } else { H.img().src(image).alt("").at("width", "1280").at("height", "640").at("fetchpriority", "high") },
          H.div().class("cover-actions").holding([
              H.a().class("round-button").href(Routes.HOME).data("feature", "back").label(Frame.t(frame, "nav.back")).holding([Icons.icon("chevron-left")]),
              H.div().class("cover-actions-end").holding([
                  H.button().kind("button").class("round-button").data("feature", "share").data("title", card.title).label(Frame.t(frame, "event.share")).holding([Icons.icon("share")]),
                  if detail.viewer.signedIn { saveForm(frame, detail) } else { H.nothing() }
                ])
            ])
        ]),
      if actual {
        PlaceGallery.viewer(frame, &[image], card.title,
          H.aside().class("gallery-context").label(Frame.t(frame, "event.about")).holding([
              H.h3().says(Frame.t(frame, "event.about")),
              H.p().class("gallery-activity-summary").says(card.summary),
              H.p().class("muted small").says(Format.categoryName(&frame.locale, &card.category) + " · " + card.municipality.name),
              Moment.schedule(frame, card.startsAt, card.endsAt),
              H.a().class("text-link gallery-read-all").data("photo", "context-link").href(Routes.EVENT_PREFIX + card.slug + "#activity-detail").says(Frame.t(frame, "gallery.view_activity"))
            ]))
      } else { H.nothing() }
    ])
}

/// The save toggle as a one-button form.
fn saveForm(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  H.form().action(Routes.EVENT_PREFIX + detail.card.slug + "/save").method("post").data("feature", "toggle").holding([
      Form.token(frame),
      H.button().submit().class(if detail.viewer.saved { "round-button is-on" } else { "round-button" }).at("aria-pressed", if detail.viewer.saved { "true" } else { "false" }).label(Frame.t(frame, if detail.viewer.saved { "event.unsave" } else { "event.save" })).holding([Icons.icon("bookmark")])
    ])
}

/// Category, title, schedule, and place.
/// For English readers of a Spanish listing: its automatic English title and summary, labelled as such.
fn englishOf(frame: &Frame.Frame, card: &Event.Card) -> H.Node {
  if frame.locale != Locale.En { return H.nothing() }
  match card.english {
    case Some(found) => match found.summary {
      case Some(summary) => H.div().class("event-english").at("lang", "en").holding([
          H.p().class("event-english-label").says(Frame.t(frame, "event.auto_translation")),
          H.p().class("event-english-title").says(Option.unwrapOr(found.title, "")),
          H.p().says(summary)
        ])
      case None => H.nothing()
    }
    case None => H.nothing()
  }
}

fn heading(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  H.header().class("event-head").holding([
      H.a().class("chip chip-small").href(Routes.CATEGORY_PREFIX + card.category.slug).holding([Icons.sized(card.category.icon, 16), H.span().says(Format.categoryName(&frame.locale, &card.category))]),
      H.h1().class("event-title").says(card.title),
      H.p().class("event-summary").says(card.summary),
      englishOf(frame, &card),
      H.ul().class("event-lines").holding([
          H.li().holding([Icons.sized("calendar", 18), H.span().holding([Moment.schedule(frame, card.startsAt, card.endsAt)])]),
          H.li().holding([Icons.sized("pin", 18), H.span().holding([H.a().class("text-link").href(Routes.TOWN_PREFIX + card.municipality.slug).says(card.municipality.name), H.span().says(" · " + card.venueName)])]),
          H.li().holding([Icons.sized("ticket", 18), H.span().says(Format.price(&frame.locale, card.priceCents) + " · " + Frame.t(frame, if detail.source == "curated" { "event.official_source" } else if Event.needsApproval(&card) { "event.policy_approval" } else { "event.policy_open" }))])
        ]),
      Weather.card(card.municipality.slug, card.municipality.name, card.startsAt, card.outdoor),
      Weather.labels(frame)
    ])
}

/// The calendars an activity can be added to: Google, Outlook, and a file for Apple and others.
fn calendarMenu(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let path = Routes.EVENT_PREFIX + card.slug
  H.details().class("menu-disclosure").holding([
      H.summary().class("reaction").holding([Icons.sized("calendar", 18), H.span().says(Frame.t(frame, "event.add_calendar"))]),
      H.ul().class("disclosure-list").holding([
          H.li().holding([H.a().href(Calendar.googleUrl(frame.siteUrl, &card, path)).target("_blank").at("rel", "noopener noreferrer").says("Google Calendar")]),
          H.li().holding([H.a().href(Calendar.outlookUrl(frame.siteUrl, &card, path)).target("_blank").at("rel", "noopener noreferrer").says("Outlook")]),
          H.li().holding([H.a().href(path + "/calendar.ics").says(Frame.t(frame, "event.calendar_file"))])
        ])
    ])
}

/// Ways to share an activity's page: the device's own sheet, messaging, social and email.
fn shareMenu(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  // Shared links name their channel so the visits they bring are counted as shares.
  let url = frame.siteUrl + Routes.EVENT_PREFIX + card.slug + "?from=share"
  let text = card.title + " · " + url
  H.details().class("menu-disclosure").holding([
      H.summary().class("reaction").holding([Icons.sized("share", 18), H.span().says(Frame.t(frame, "event.share"))]),
      H.ul().class("disclosure-list").holding([
          H.li().holding([H.a().href("https://wa.me/" + Query.render(&[("text", text)])).target("_blank").at("rel", "noopener noreferrer").says("WhatsApp")]),
          H.li().holding([H.a().href("https://www.facebook.com/sharer/sharer.php" + Query.render(&[("u", url)])).target("_blank").at("rel", "noopener noreferrer").says("Facebook")]),
          H.li().holding([H.a().href("https://x.com/intent/post" + Query.render(&[("text", card.title), ("url", url)])).target("_blank").at("rel", "noopener noreferrer").says("X")]),
          H.li().holding([H.a().href("mailto:" + Query.render(&[("subject", card.title), ("body", text)])).says(Frame.t(frame, "event.share_email"))]),
          H.li().holding([H.button().kind("button").class("text-button").data("feature", "share").data("mode", "copy").data("title", card.title).says(Frame.t(frame, "event.share_copy"))])
        ])
    ])
}

/// After signing in from an action on this page, offers to finish it in one tap; nothing when it is
/// already done or no longer possible.
fn resumeBanner(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let kind = match Resume.fromQuery(frame.query) {
    case Some(found) => found
    case None => { return H.nothing() }
  }
  let open = card.status == "published" && !Event.hasEnded(&card, frame.nowMillis)
  if !detail.viewer.signedIn || detail.viewer.isOrganizer || !open { return H.nothing() }
  let base = Routes.EVENT_PREFIX + card.slug
  let action = if kind == "interested" || kind == "going" {
    if card.visibility != "public" || Option.unwrapOr(detail.viewer.interest, "") == kind { return H.nothing() }
    H.form().action(base + "/interest").method("post").holding([
        Form.token(frame),
        H.input().kind("hidden").name("kind").value(kind),
        H.button().submit().class("button").data("resume-action", kind).holding([Icons.sized(if kind == "going" { "check" } else { "star" }, 18), H.span().says(Frame.t(frame, if kind == "going" { "event.resume_going" } else { "event.resume_interested" }))])
      ])
  } else if kind == "like" {
    if detail.viewer.reaction == 1 { return H.nothing() }
    H.form().action(base + "/react").method("post").holding([
        Form.token(frame),
        H.input().kind("hidden").name("value").value("1"),
        H.button().submit().class("button").data("resume-action", kind).holding([Icons.sized("heart", 18), H.span().says(Frame.t(frame, "event.resume_like"))])
      ])
  } else if kind == "join" {
    if detail.source == "curated" || detail.viewer.requestStatus != None { return H.nothing() }
    H.a().class("button").href("#join").data("resume-action", kind).says(Frame.t(frame, "event.resume_join"))
  } else { return H.nothing() }
  H.section().class("resume-banner").role("status").data("feature", "resume").holding([
      H.p().class("resume-title").holding([Icons.sized("sparkle", 18), H.strong().says(Frame.t(frame, "event.resume_title"))]),
      H.div().class("resume-actions").holding([action, H.a().class("text-link").href(base).says(Frame.t(frame, "event.resume_dismiss"))])
    ])
}

/// Like, not interested, add to calendar.
fn reactions(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let base = Routes.EVENT_PREFIX + card.slug
  let reaction = detail.viewer.reaction
  let calendar = H.div().class("reaction-group").holding([calendarMenu(frame, detail), shareMenu(frame, detail)])
  // Guests are invited to sign in to like; organizers see the count but cannot like their own activity.
  if !detail.viewer.signedIn {
    return H.div().class("reactions").holding([
        H.a().class("reaction").href(Resume.signIn(Routes.SIGN_IN, base, "like")).holding([Icons.sized("heart", 18), H.span().says(Frame.t(frame, "event.like")), H.span().class("count").says(show(card.likeCount))]),
        calendar
      ])
  }
  if detail.viewer.isOrganizer || card.status == "cancelled" {
    return H.div().class("reactions").holding([
        H.span().class("reaction reaction-static").label(Frame.tf(frame, "event.likes_total", &[("count", show(card.likeCount))])).holding([Icons.sized("heart", 18), H.span().at("aria-hidden", "true").says(show(card.likeCount))]),
        calendar
      ])
  }
  H.div().class("reactions").holding([
      H.form().action(base + "/react").method("post").data("feature", "react").data("own", "1").holding([
          Form.token(frame),
          H.input().kind("hidden").name("value").value(if reaction == 1 { "0" } else { "1" }),
          H.button().submit().class(if reaction == 1 { "reaction is-on" } else { "reaction" }).at("aria-pressed", if reaction == 1 { "true" } else { "false" }).holding([Icons.sized("heart", 18), H.span().says(Frame.t(frame, "event.like")), H.span().class("count").says(show(card.likeCount))])
        ]),
      H.form().action(base + "/react").method("post").data("feature", "react").data("own", "-1").holding([
          Form.token(frame),
          H.input().kind("hidden").name("value").value(if reaction == -1 { "0" } else { "-1" }),
          H.button().submit().class(if reaction == -1 { "reaction is-on" } else { "reaction" }).at("aria-pressed", if reaction == -1 { "true" } else { "false" }).holding([Icons.sized("thumb-down", 18), H.span().says(Frame.t(frame, "event.not_interested"))])
        ]),
      calendar
    ])
}

/// "Interested" and "Going": a member's light mark on an upcoming activity with its public counts. Guests
/// are invited to sign in; organizers and finished activities only show how many marked it.
fn interest(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let base = Routes.EVENT_PREFIX + card.slug
  // Everyone confirmed to attend counts as going, alongside those who simply said they will.
  let summary = H.p().class("interest-count").data("interest-summary", "1").data("approved", show(card.approvedCount)).data("going-one", Translate.text(&frame.locale, "interest.going.one")).data("going-other", Translate.text(&frame.locale, "interest.going.other")).data("interested-one", Translate.text(&frame.locale, "interest.interested.one")).data("interested-other", Translate.text(&frame.locale, "interest.interested.other")).says(Translate.count(&frame.locale, "interest.going", card.goingCount + card.approvedCount) + " · " + Translate.count(&frame.locale, "interest.interested", card.interestedCount))
  let open = card.status == "published" && !Event.hasEnded(&card, frame.nowMillis) && card.visibility == "public"
  if !open || detail.viewer.isOrganizer { return H.div().class("interest").holding([summary]) }
  let mine = Option.unwrapOr(detail.viewer.interest, "")
  let mark = |kind: Str, icon: Str, label: Str| {
    let on = mine == kind
    if !detail.viewer.signedIn {
      H.a().class("interest-button").href(Resume.signIn(Routes.SIGN_IN, base, kind)).holding([Icons.sized(icon, 18), H.span().says(label)])
    } else {
      H.form().action(base + "/interest").method("post").data("feature", "interest").holding([
          Form.token(frame),
          H.input().kind("hidden").name("kind").value(if on { "" } else { kind }),
          H.button().submit().class(if on { "interest-button is-on" } else { "interest-button" }).data("kind", kind).at("aria-pressed", if on { "true" } else { "false" }).holding([Icons.sized(icon, 18), H.span().says(label)])
        ])
    }
  }
  H.div().class("interest").role("group").label(Frame.t(frame, "interest.group")).holding([
      H.div().class("interest-buttons").holding([mark("interested", "star", Frame.t(frame, "interest.interested_label")), mark("going", "check", Frame.t(frame, "interest.going_label"))]),
      summary
    ])
}

/// The description, paragraph by paragraph.
fn about(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  if detail.description.trim().isEmpty() { return H.nothing() }
  H.section().class("panel prose").id("activity-about").holding([
      H.h2().class("section-title").says(Frame.t(frame, "event.about")),
      H.div().holding(detail.description.split("\n\n").filter(|part: Str| !part.trim().isEmpty()).map(|part: Str| H.p().says(part.trim())))
    ])
}

/// The facts a visitor checks before going.
fn facts(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let capacity = match card.capacity {
    case Some(total) => Translate.fill(&frame.locale, "event.capacity_of", &[("count", show(card.approvedCount)), ("total", show(total))])
    case None => Translate.count(&frame.locale, "event.going", card.approvedCount)
  }
  H.section().class("panel").holding([
      H.h2().class("section-title").says(Frame.t(frame, "event.details")),
      H.dl().class("facts").holding([
          H.dt().says(Frame.t(frame, "event.when")), H.dd().holding([Moment.schedule(frame, card.startsAt, card.endsAt)]),
          H.dt().says(Frame.t(frame, "event.price")), H.dd().says(Format.price(&frame.locale, card.priceCents)),
          match detail.minAge {
            case Some(age) => H.nothing().holding([H.dt().says(Frame.t(frame, "event.declared_age")), H.dd().says(if age == 0 { Frame.t(frame, "event.all_ages") } else { Frame.tf(frame, "event.age_floor", &[("age", show(age))]) })])
            case None => H.nothing()
          },
          if detail.accessible { H.nothing().holding([H.dt().says(Frame.t(frame, "event.declared_access")), H.dd().says(Frame.t(frame, "event.step_free"))]) } else { H.nothing() },
          match card.parking {
            case Some(found) => H.nothing().holding([H.dt().says(Frame.t(frame, "event.parking")), H.dd().says(Frame.t(frame, if found { "event.parking_yes" } else { "event.parking_no" }))])
            case None => H.nothing()
          },
          match card.cashOnly {
            case Some(true) => H.nothing().holding([H.dt().says(Frame.t(frame, "event.payment")), H.dd().says(Frame.t(frame, "event.cash_only"))])
            case _ => H.nothing()
          },
          if detail.source == "curated" { H.nothing() } else { H.dt().says(Frame.t(frame, "event.attendance")) }, if detail.source == "curated" { H.nothing() } else { H.dd().says(capacity) },
          H.dt().says(Frame.t(frame, "event.joining")), H.dd().says(Frame.t(frame, if detail.source == "curated" { "event.external_body" } else if Event.needsApproval(&card) { "event.policy_approval_long" } else { "event.policy_open_long" })),
          H.dt().says(Frame.t(frame, "event.visibility")), H.dd().says(Frame.t(frame, "visibility." + card.visibility))
        ])
    ])
}

/// The other upcoming dates of a recurring activity, each linking to its own page.
fn otherDates(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  if detail.otherDates.isEmpty() { return H.nothing() }
  H.section().class("panel").at("aria-labelledby", "other-dates").holding([
      H.h2().class("section-title").id("other-dates").says(Frame.t(frame, "event.other_dates")),
      H.ul().class("date-list").holding(detail.otherDates.map(|date: Event.Occurrence| H.li().holding([
              H.a().class("date-link").href(Routes.EVENT_PREFIX + date.slug).holding([Icons.sized("calendar", 16), H.span().holding([Moment.schedule(frame, date.startsAt, date.endsAt)])])
            ])))
    ])
}

/// Where: the exact place with directions once revealed, the area otherwise.
fn place(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let card = detail.card
  let lat = Option.unwrapOr(detail.exactLat, card.lat)
  let lng = Option.unwrapOr(detail.exactLng, card.lng)
  let map = H.div().class("mini-map").data("feature", "mini-map").data("lat", show(lat)).data("lng", show(lng)).data("exact", if detail.locationRevealed { "1" } else { "0" }).role("img").label(Frame.tf(frame, "event.map_label", &[("place", card.venueName + ", " + card.municipality.name)]))
  if detail.locationRevealed {
    return H.section().class("panel").holding([
        H.h2().class("section-title").says(Frame.t(frame, "event.where")),
        map,
        H.p().class("place-name").holding([H.strong().says(card.venueName)]),
        H.p().class("muted").says(Option.unwrapOr(detail.addressLine, card.municipality.name)),
        H.a().class("button button-ghost button-small").href("https://www.google.com/maps/dir/?api=1&destination=" + show(lat) + "," + show(lng)).at("rel", "noopener").target("_blank").holding([Icons.sized("navigation", 16), H.span().says(Frame.t(frame, "event.directions"))]),
        match detail.instructions {
          case Some(text) => if text.trim().isEmpty() { H.nothing() } else { H.div().class("instructions").holding([H.h3().says(Frame.t(frame, "event.instructions")), H.p().says(text)]) }
          case None => H.nothing()
        }
      ])
  }
  H.section().class("panel").holding([
      H.h2().class("section-title").says(Frame.t(frame, "event.where")),
      map,
      H.p().class("place-name").holding([H.strong().says(card.municipality.name)]),
      H.p().class("locked").holding([Icons.sized("lock", 16), H.span().says(Frame.t(frame, "event.location_locked"))])
    ])
}

/// The co-attendees' live map, for approved attendees and the organizer while the event is near.
fn participants(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  let approved = detail.viewer.requestStatus == Some(Participation.APPROVED) || detail.viewer.isOrganizer
  if detail.source == "curated" || !approved || Event.isCancelled(&detail.card) { return H.nothing() }
  H.section().class("panel").holding([
      H.h2().class("section-title").says(Frame.t(frame, "event.live_title")),
      H.p().class("muted").says(Frame.t(frame, "event.live_body")),
      H.div().class("mini-map").data("feature", "participants").data("src", "/api/e/" + detail.card.slug + "/positions").data("lat", show(Option.unwrapOr(detail.exactLat, detail.card.lat))).data("lng", show(Option.unwrapOr(detail.exactLng, detail.card.lng))).role("img").label(Frame.t(frame, "event.live_title"))
    ])
}

/// A collapsed report form for members other than the organizer.
fn report(frame: &Frame.Frame, detail: &Event.Detail) -> H.Node {
  if !detail.viewer.signedIn || detail.viewer.isOrganizer { return H.nothing() }
  H.details().class("report").holding([
      H.summary().holding([Icons.sized("flag-report", 16), H.span().says(Frame.t(frame, "event.report"))]),
      H.form().action(Routes.EVENT_PREFIX + detail.card.slug + "/report").method("post").holding([
          Form.token(frame),
          Form.select(frame, &Form.Field{..Form.field("reason", Frame.t(frame, "event.report_reason"), "spam"), required: true}, &Participation.REPORT_REASONS.map(|reason: Str| (reason, Frame.t(frame, "report." + reason))), &[]),
          Form.area(frame, &Form.field("detail", Frame.t(frame, "event.report_detail"), ""), 3, &[]),
          H.button().submit().class("button button-ghost button-small").says(Frame.t(frame, "event.report_send"))
        ])
    ])
}

/// What the viewer can do now: sign in, join, wait, attend, manage, or nothing.
fn joinPanel(frame: &Frame.Frame, detail: &Event.Detail, problem: &Option[Problem.Problem], channel: Str) -> H.Node {
  let from = if channel.isEmpty() { H.nothing() } else { H.input().kind("hidden").name("from").value(channel) }
  let card = detail.card
  let base = Routes.EVENT_PREFIX + card.slug
  let ended = Event.hasEnded(&card, frame.nowMillis)
  let price = H.div().class("join-price").holding([H.strong().says(Format.price(&frame.locale, card.priceCents)), H.span().says(if detail.source == "curated" { Frame.t(frame, "event.official_source") } else { Format.seats(&frame.locale, &card) })])
  let refusal = match problem {
    case Some(found) => H.p().class("field-error").role("alert").says(Frame.t(frame, Problem.messageKey(&found)))
    case None => H.nothing()
  }
  let held = if detail.held { H.p().class("banner").role("status").says(Frame.t(frame, if detail.viewer.isOrganizer { "event.held_owner" } else { "event.held_notice" })) } else { H.nothing() }
  let body = if Event.isCancelled(&card) {
    H.p().class("banner banner-error").says(Frame.t(frame, "event.cancelled_notice"))
  } else if detail.held && !detail.viewer.isOrganizer && detail.viewer.requestStatus == None {
    H.nothing()
  } else if ended && detail.source == "curated" {
    H.p().class("muted").says(Frame.t(frame, if card.endsAt == None { "event.archived" } else { "event.ended" }))
  } else if detail.source == "curated" {
    H.div().class("join-actions").holding([
        H.p().class("muted small").says(Frame.t(frame, "event.external_body")),
        match Event.officialUrl(detail) {
          case Some(url) => H.a().class("button button-block").href(url).target("_blank").at("rel", "noopener noreferrer").says(Frame.t(frame, "event.source_action"))
          case None => H.p().class("muted").says(Frame.t(frame, "event.source_unavailable"))
        }
      ])
  } else if detail.viewer.isOrganizer {
    H.div().class("join-actions").holding([
        H.a().class("button").href(base + "/requests").holding([Icons.sized("users", 18), H.span().says(Translate.count(&frame.locale, "event.manage_requests", Option.unwrapOr(card.pendingCount, 0)))]),
        H.a().class("button button-ghost").href(base + "/edit").holding([Icons.sized("edit", 18), H.span().says(Frame.t(frame, "event.edit"))]),
        H.a().class("button button-ghost").href(base + "/cover").holding([Icons.sized("camera", 18), H.span().says(Frame.t(frame, "media.event_cover_title"))]),
        H.details().class("confirm").holding([
            H.summary().class("text-link danger").says(Frame.t(frame, "event.cancel")),
            H.form().action(base + "/cancel").method("post").holding([Form.token(frame), H.p().says(Frame.t(frame, "event.cancel_confirm")), H.button().submit().class("button button-danger").says(Frame.t(frame, "event.cancel_yes"))])
          ])
      ])
  } else if ended {
    H.p().class("muted").says(Frame.t(frame, if card.endsAt == None { "event.archived" } else { "event.ended" }))
  } else if !detail.viewer.signedIn {
    H.div().class("join-actions").holding([
        H.a().class("button button-block").href(Resume.signIn(Routes.SIGN_IN, base, "join")).says(Frame.t(frame, "event.sign_in_to_join")),
        H.p().class("muted small").says(Frame.t(frame, "event.sign_in_why"))
      ])
  } else {
    match detail.viewer.requestStatus {
      case Some("approved") => H.div().class("join-state join-approved").holding([
          H.p().class("state-line").holding([Icons.sized("check", 20), H.strong().says(Frame.t(frame, "event.you_are_going"))]),
          withdrawForm(frame, base)
        ])
      case Some("pending") => H.div().class("join-state join-pending").holding([
          H.p().class("state-line").holding([Icons.sized("clock", 20), H.strong().says(Frame.t(frame, "event.request_pending"))]),
          H.p().class("muted small").says(Frame.t(frame, "event.request_pending_body")),
          withdrawForm(frame, base)
        ])
      case Some("waitlisted") => H.div().class("join-state join-pending").holding([
          H.p().class("state-line").holding([Icons.sized("users", 20), H.strong().says(match detail.viewer.waitlistPosition {
                  case Some(position) => Frame.tf(frame, "event.waitlist_position", &[("position", show(position))])
                  case None => Frame.t(frame, "event.waitlisted")
                })]),
          H.p().class("muted small").says(Frame.t(frame, "event.waitlist_body")),
          withdrawForm(frame, base)
        ])
      case Some("rejected") => H.div().class("join-state join-rejected").holding([
          H.p().class("state-line").holding([Icons.sized("x", 20), H.strong().says(Frame.t(frame, "event.request_rejected"))]),
          match detail.viewer.decisionNote {
            case Some(note) => if note.isEmpty() || note == "cancelled" { H.nothing() } else { H.blockquote().says(note) }
            case None => H.nothing()
          }
        ])
      case _ => if detail.isFull {
        H.form().action(base + "/join").method("post").class("join-form").holding([
            Form.token(frame),
            from,
            H.p().class("banner").says(Frame.t(frame, "event.full_notice")),
            H.button().submit().class("button button-block button-ghost").says(Frame.t(frame, "event.join_waitlist")),
            H.p().class("muted small").says(if detail.waitlistCount > 0 { Translate.count(&frame.locale, "event.waitlist_ahead", detail.waitlistCount) } else { Frame.t(frame, "event.waitlist_note") })
          ])
      } else {
        H.form().action(base + "/join").method("post").class("join-form").holding([
            Form.token(frame),
            from,
            if Event.needsApproval(&card) { Form.area(frame, &Form.Field{..Form.field("message", Frame.t(frame, "event.message_label"), ""), hint: Frame.t(frame, "event.message_hint")}, 3, &[]) } else { H.nothing() },
            H.button().submit().class("button button-block").says(Frame.t(frame, if Event.needsApproval(&card) { "event.request_to_join" } else { "event.join_now" })),
            H.p().class("muted small").says(Frame.t(frame, if Event.needsApproval(&card) { "event.request_note" } else { "event.join_note" }))
          ])
      }
    }
  }
  H.div().class("join-panel").id("join").data("feature", "join-panel").holding([price, held, refusal, body])
}

/// A collapsed form withdrawing the viewer's request.
fn withdrawForm(frame: &Frame.Frame, base: Str) -> H.Node {
  H.details().class("confirm").holding([
      H.summary().class("text-link").says(Frame.t(frame, "event.withdraw")),
      H.form().action(base + "/withdraw").method("post").holding([Form.token(frame), H.button().submit().class("button button-ghost button-small").says(Frame.t(frame, "event.withdraw_yes"))])
    ])
}
