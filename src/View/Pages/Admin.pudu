/** @View.Pages.Admin.Dashboard — platform counts and the moderation queue */
module View.Pages.Admin

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Std.Option as Option
import Constants.Routes as Routes
import Domain.Admin as Admin
import Domain.Review as Review
import Services.Admin as AdminService
import View.Components.Form as Form
import View.Components.Notice as Notice
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/// One labelled count.
fn tile(label: Str, count: Int) -> H.Node { H.div().class("metric").holding([H.strong().says(show(count)), H.span().says(label)]) }

/// The dashboard page.
export fn render(frame: &Frame.Frame, dashboard: &AdminService.Dashboard) -> Html.Html {
  let o = dashboard.overview
  let meta = Seo.meta(Frame.t(frame, "admin.title"), Frame.t(frame, "admin.title"), Routes.ADMIN, false)
  Layout.page(frame, &meta, Layout.Elsewhere, H.div().class("admin").holding([
        H.h1().class("page-title").says(Frame.t(frame, "admin.title")),
        H.div().class("metrics").holding([
            tile(Frame.t(frame, "admin.accounts"), o.accounts),
            tile(Frame.t(frame, "admin.accounts_new"), o.accountsNew7d),
            tile(Frame.t(frame, "admin.accounts_paused"), o.accountsPaused),
            tile(Frame.t(frame, "admin.events_upcoming"), o.eventsUpcoming),
            tile(Frame.t(frame, "admin.events_new"), o.eventsNew7d),
            tile(Frame.t(frame, "admin.requests_pending"), o.requestsPending),
            tile(Frame.t(frame, "admin.requests_week"), o.requests7d),
            tile(Frame.t(frame, "admin.views_week"), o.views7d),
            tile(Frame.t(frame, "admin.live_now"), o.liveNow),
            tile(Frame.t(frame, "admin.reports_open"), o.reportsOpen),
            tile(Frame.t(frame, "admin.data_requests"), o.dataRequestsOpen),
            tile(Frame.t(frame, "admin.places"), o.places),
            tile(Frame.t(frame, "admin.reviews_week"), o.reviews7d),
            tile(Frame.t(frame, "admin.review_reports_open"), o.reviewReportsOpen)
          ]),
        H.h2().class("section-title").says(Frame.t(frame, "admin.review_queue")),
        if dashboard.reviews.isEmpty() { Notice.empty("check", Frame.t(frame, "admin.no_review_reports"), "", H.nothing()) } else {
          H.ul().class("requests").holding(dashboard.reviews.map(|review: Review.ReportedReview| H.li().class("request").holding([
                  H.div().holding([
                      H.a().class("text-link").href(Routes.PLACE_PREFIX + review.place.slug + "#reviews").says(review.place.name),
                      H.p().class("muted small").says(show(review.rating) + " ★ · " + Option.unwrapOr(review.authorName, "—") + (if review.status == "held" { " · " + Frame.t(frame, "admin.review_held") } else { "" }))
                    ]),
                  H.blockquote().says(review.body),
                  H.ul().class("muted small").holding(review.reports.map(|complaint: Review.ReviewComplaint| H.li().says(Frame.t(frame, "review.reason_" + complaint.reason) + (if complaint.detail.isEmpty() { "" } else { ": " + complaint.detail })))),
                  H.form().class("request-actions").action(Routes.ADMIN_REVIEW.replace(":id", review.id)).method("post").holding([
                      Form.token(frame),
                      H.button().submit().name("decision").value("keep").class("button button-ghost button-small").says(Frame.t(frame, "admin.keep_review")),
                      H.button().submit().name("decision").value("remove").class("button button-danger button-small").says(Frame.t(frame, "admin.remove_review"))
                    ])
                ])))
        },
        H.h2().class("section-title").says(Frame.t(frame, "admin.reports")),
        if dashboard.reports.isEmpty() { Notice.empty("check", Frame.t(frame, "admin.no_reports"), "", H.nothing()) } else {
          H.ul().class("requests").holding(dashboard.reports.map(|report: Admin.Report| H.li().class("request").holding([
                  H.div().holding([
                      H.a().class("text-link").href(Routes.EVENT_PREFIX + report.event.slug).says(report.event.title),
                      H.p().class("muted small").says(Frame.t(frame, "report." + report.reason) + " · " + Option.unwrapOr(report.reporterName, "—"))
                    ]),
                  if report.detail.isEmpty() { H.nothing() } else { H.blockquote().says(report.detail) },
                  H.form().class("request-actions").action(Routes.ADMIN_REPORT.replace(":id", show(report.id))).method("post").holding([
                      Form.token(frame),
                      H.button().submit().name("decision").value("dismiss").class("button button-ghost button-small").says(Frame.t(frame, "admin.dismiss")),
                      H.button().submit().name("decision").value("act").class("button button-danger button-small").says(Frame.t(frame, "admin.act"))
                    ])
                ])))
        }
      ]))
}
