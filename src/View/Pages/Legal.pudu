/** @View.Pages.Legal.Policies — terms, privacy, cookies, and about */
module View.Pages.Legal

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Constants.Routes as Routes
import View.Components.Form as Form
import View.Components.Hero as Hero
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/** @View.Pages.Legal.Document — which policy page to render */
export type Document = Terms | Privacy | Cookies | About | Accessibility

/// The section keys of each document, in reading order.
const TERMS_SECTIONS: Array[Str] = ["service", "eligibility", "account", "publishing", "joining", "minors", "conduct", "safety", "content", "moderation", "disclaimers", "liability", "indemnity", "changes", "law", "contact"]
const PRIVACY_SECTIONS: Array[Str] = ["scope", "collect", "use", "visibility", "location", "providers", "retention", "rights", "deletion", "security", "minors", "transfers", "changes"]
const COOKIES_SECTIONS: Array[Str] = ["what", "necessary", "storage", "optional", "third", "choices"]
const ABOUT_SECTIONS: Array[Str] = ["mission", "how", "safety", "privacy"]
const ACCESSIBILITY_SECTIONS: Array[Str] = ["commitment", "standard", "tools", "compatibility", "limitations", "feedback"]

/// The key prefix, sections, path, and whether it carries an effective-date line.
fn shape(document: &Document) -> (Str, Array[Str], Str, Bool) {
  match document {
    case Terms => ("legal.terms", TERMS_SECTIONS, Routes.TERMS, true)
    case Privacy => ("legal.privacy", PRIVACY_SECTIONS, Routes.PRIVACY, true)
    case Cookies => ("legal.cookies", COOKIES_SECTIONS, Routes.COOKIES, true)
    case About => ("about", ABOUT_SECTIONS, Routes.ABOUT, false)
    case Accessibility => ("legal.accessibility", ACCESSIBILITY_SECTIONS, Routes.ACCESSIBILITY, true)
  }
}

/// A policy page: title, effective date, summary, contents, then numbered sections. The about page has no
/// effective date, summary, or contents.
export fn render(frame: &Frame.Frame, document: &Document) -> Html.Html {
  let (prefix, sections, path, versioned) = shape(document)
  let title = Frame.t(frame, prefix + ".title")
  let meta = Seo.meta(title, Frame.t(frame, prefix + ".description"), path, true)
  var numbered: Array[H.Node] = []
  var links: Array[H.Node] = []
  for index in 0..sections.length() {
    let section = sections[index]
    let anchor = "s-" + section
    let heading = Frame.t(frame, prefix + "." + section + ".title")
    let number = if versioned { show(index + 1) + ". " } else { "" }
    links = links.push(H.li().holding([H.a().href("#" + anchor).says(number + heading)]))
    numbered = numbered.push(H.section().id(anchor).class("legal-section").holding([
          H.h2().says(number + heading)
        ].concat(Frame.t(frame, prefix + "." + section + ".body").split("\n\n").map(|paragraph: Str| H.p().says(paragraph)))))
  }
  let about = *document == About
  let head = H.header().class(if about { "about-hero" } else { "legal-head" }).holding([
      if about { H.img().class("about-hero-photo").src("/assets/img/el-morro-flags-photo.webp").at("srcset", Hero.photoSet("/assets/img/el-morro-flags-photo.webp")).at("sizes", "(min-width: 1248px) 1200px, 100vw").alt("").at("width", "2200").at("height", "1467").at("fetchpriority", "high") } else { H.nothing() },
      H.h1().class("page-title").says(title),
      if versioned { H.p().class("legal-version").says(Frame.t(frame, "legal.effective")) } else { H.nothing() },
      H.p().class("lead").says(Frame.t(frame, prefix + ".intro"))
    ])
  let summary = if versioned { H.aside().class("legal-summary").holding([H.h2().says(Frame.t(frame, "legal.summary_title")), H.p().says(Frame.t(frame, prefix + ".summary"))]) } else { H.nothing() }
  let contents = if versioned { H.nav().class("legal-contents").label(Frame.t(frame, "legal.contents")).holding([H.p().says(Frame.t(frame, "legal.contents")), H.ol().holding(links)]) } else { H.nothing() }
  let reset = if *document == Cookies { H.form().action(Routes.CONSENT).method("post").holding([Form.token(frame), H.input().kind("hidden").name("choice").value("reset"), H.input().kind("hidden").name("return").value(Routes.COOKIES), H.button().submit().class("button button-ghost").says(Frame.t(frame, "cookies.change"))]) } else { H.nothing() }
  Layout.page(frame, &meta, Layout.Elsewhere, H.div().class(if versioned { "legal-page" } else { "legal-page is-plain about-page" }).holding([
        contents,
        if about { head } else { H.nothing() },
        H.article().class("prose legal").holding([if about { H.nothing() } else { head }, summary].concat(numbered).concat([reset]))
      ]))
}
