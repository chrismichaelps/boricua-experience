/** @View.Pages.Legal.Policies — terms, privacy, cookies, and about */
module View.Pages.Legal

import Std.Html as Html
import Std.Html.Build as H
import Std.Html.Build {Building}
import Constants.App as App
import Constants.Routes as Routes
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/** @View.Pages.Legal.Document — which policy page to render */
export type Document = Terms | Privacy | Cookies | About

/// The section keys of each document, in reading order.
const TERMS_SECTIONS: Array[Str] = ["eligibility", "accounts", "events", "joining", "conduct", "safety", "minors", "content", "liability", "termination", "changes", "contact"]
const PRIVACY_SECTIONS: Array[Str] = ["collect", "use", "location", "sharing", "retention", "rights", "deletion", "cookies", "security", "minors", "contact"]
const COOKIES_SECTIONS: Array[Str] = ["what", "necessary", "analytics", "marketing", "choices"]
const ABOUT_SECTIONS: Array[Str] = ["mission", "how", "safety", "privacy"]

/// The key prefix, sections, path, and whether it carries a version line.
fn shape(document: &Document) -> (Str, Array[Str], Str, Bool) {
  match document {
    case Terms => ("legal.terms", TERMS_SECTIONS, Routes.TERMS, true)
    case Privacy => ("legal.privacy", PRIVACY_SECTIONS, Routes.PRIVACY, true)
    case Cookies => ("legal.cookies", COOKIES_SECTIONS, Routes.COOKIES, true)
    case About => ("about", ABOUT_SECTIONS, Routes.ABOUT, false)
  }
}

/// A policy page.
export fn render(frame: &Frame.Frame, document: &Document) -> Html.Html {
  let (prefix, sections, path, versioned) = shape(document)
  let title = Frame.t(frame, prefix + ".title")
  let meta = Seo.meta(title, Frame.t(frame, prefix + ".description"), path, true)
  let version = match document {
    case Privacy => App.PRIVACY_VERSION
    case Cookies => App.COOKIE_POLICY_VERSION
    case _ => App.TERMS_VERSION
  }
  Layout.page(frame, &meta, Layout.Elsewhere, H.article().class("narrow prose legal").holding([
        H.h1().class("page-title").says(title),
        if versioned { H.p().class("muted small").says(Frame.tf(frame, "legal.version", &[("version", version), ("email", App.PRIVACY_EMAIL)])) } else { H.nothing() },
        H.p().class("lead").says(Frame.t(frame, prefix + ".intro"))
      ].concat(sections.map(|section: Str| H.section().holding([
              H.h2().says(Frame.t(frame, prefix + "." + section + ".title")),
              H.div().holding(Frame.t(frame, prefix + "." + section + ".body").split("\n\n").map(|paragraph: Str| H.p().says(paragraph)))
            ]))).concat([
        if *document == Cookies { H.form().action(Routes.CONSENT).method("post").holding([H.input().kind("hidden").name("choice").value("reset"), H.input().kind("hidden").name("return").value(Routes.COOKIES), H.button().submit().class("button button-ghost").says(Frame.t(frame, "cookies.change"))]) } else { H.nothing() }
      ])))
}
