/** @View.Pages.Story.Pages — the about and culture pages, told with the illustrated mascot */
module View.Pages.Story

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Constants.Routes as Routes
import View.Components.Story as Story
import View.Frame as Frame
import View.Layout as Layout
import View.Seo as Seo

/// The value and principle tiles of the culture page: illustration, tag key, tag tone, title key.
const CULTURE_TILES: Array[(Str, Str, Str, Str)] = [
  ("cotorra-love", "story.value", "blue", "story.culture.card1"),
  ("bulb", "story.value", "blue", "story.culture.card2"),
  ("seal", "story.value", "blue", "story.culture.card3"),
  ("flag-pr", "story.value", "blue", "story.culture.card4"),
  ("heart", "story.principle", "pink", "story.culture.card5"),
  ("thumbs-up", "story.principle", "pink", "story.culture.card6"),
  ("shield", "story.principle", "pink", "story.culture.card7"),
  ("coqui", "story.principle", "pink", "story.culture.card8")
]

/// The about page's value tiles: illustration and key stem.
const ABOUT_VALUES: Array[(Str, Str)] = [("cotorra-love", "value1"), ("flag-pr", "value2"), ("shield", "value3"), ("coqui", "value4")]

/// The about page's steps: illustration per step.
const STEPS: Array[Str] = ["search", "ticket", "party"]

/// The culture page's principles: icon per principle.
const PRINCIPLE_ICONS: Array[Str] = ["search", "star", "navigation", "check"]

/// The culture page's commitments: illustration and key stem.
const PILLARS: Array[(Str, Str)] = [("rocket", "pillar1"), ("key", "pillar2"), ("star", "pillar3")]

/// A story page in the shell, marked for scroll reveals.
fn shell(frame: &Frame.Frame, meta: &Seo.Meta, sections: Array[H.Node]) -> Html.Html {
  Layout.page(frame, meta, Layout.Elsewhere, H.div().class("story").data("feature", "reveal").holding(sections))
}

/// The about page: the mascot's welcome, why we exist, three steps, the island in numbers, what
/// guides us, trust, and an invitation to write.
export fn about(frame: &Frame.Frame) -> Html.Html {
  let t = |key: Str| Frame.t(frame, key)
  let meta = Seo.meta(t("about.title"), t("about.description"), Routes.ABOUT, true)
  var steps: Array[H.Node] = []
  for index in 0..STEPS.length() {
    let number = show(index + 1)
    steps = steps.push(Story.reveal(Story.tile(STEPS[index], number, "yellow", t("story.about.step" + number + "_title"), t("story.about.step" + number + "_body")), index))
  }
  var values: Array[H.Node] = []
  for index in 0..ABOUT_VALUES.length() {
    let (art, stem) = ABOUT_VALUES[index]
    values = values.push(Story.reveal(Story.tile(art, t("story.value"), "blue", t("story.about." + stem + "_title"), t("story.about." + stem + "_body")), index))
  }
  shell(frame, &meta, [
      Story.hero(Story.headline(t("story.about.headline_top"), t("story.about.headline_bottom")), t("story.about.lead"), [
          Story.action(Routes.SEARCH, t("story.explore"), true),
          Story.action(Routes.CREATE, t("story.host"), false)
        ], "cotorra-hero"),
      Story.band([Story.statement(t("story.about.why_eyebrow"), t("story.about.why_title"), t("story.about.why_body"))]),
      H.section().class("st-section").holding([
          Story.reveal(Story.heading(t("story.about.how_eyebrow"), t("story.about.how_title"), "", "purple"), 0),
          H.ol().class("st-tiles st-tiles-three").holding(steps)
        ]),
      H.section().class("st-section").label(t("story.about.facts_label")).holding([
          H.ul().class("st-facts").holding([
              Story.reveal(Story.fact("78", t("story.about.fact_towns")), 0),
              Story.reveal(Story.fact("2", t("story.about.fact_languages")), 1),
              Story.reveal(Story.fact("18+", t("story.about.fact_adults")), 2),
              Story.reveal(Story.fact("0", t("story.about.fact_location")), 3)
            ])
        ]),
      H.section().class("st-section").holding([
          Story.reveal(Story.heading(t("story.about.values_eyebrow"), t("story.about.values_title"), t("about.intro"), "yellow"), 0),
          H.ul().class("st-tiles").holding(values)
        ]),
      Story.split("/assets/img/el-yunque-photo.webp", H.div().class("st-split-text").holding([
            Story.eyebrow(t("story.about.trust_eyebrow")),
            H.h2().class("st-title is-left").says(t("story.about.trust_title")),
            H.p().class("st-body").says(t("story.about.trust_body"))
          ])),
      Story.closing("envelope", t("story.about.cta_title"), t("story.about.cta_body"), [
          Story.action(Routes.CONTACT, t("story.contact"), true),
          Story.action(Routes.CULTURE, t("story.culture_link"), false)
        ])
    ])
}

/// The culture page: the mascot's welcome, the mission, values and principles, how we decide,
/// three commitments, and an invitation.
export fn culture(frame: &Frame.Frame) -> Html.Html {
  let t = |key: Str| Frame.t(frame, key)
  let meta = Seo.meta(t("story.culture.title"), t("story.culture.description"), Routes.CULTURE, true)
  var tiles: Array[H.Node] = []
  for index in 0..CULTURE_TILES.length() {
    let (art, tag, tone, title) = CULTURE_TILES[index]
    tiles = tiles.push(Story.reveal(Story.tile(art, t(tag), tone, t(title), ""), index % 4))
  }
  var principles: Array[H.Node] = []
  for index in 0..PRINCIPLE_ICONS.length() {
    let number = show(index + 1)
    principles = principles.push(Story.reveal(Story.feature(PRINCIPLE_ICONS[index], t("story.culture.principle" + number + "_title"), t("story.culture.principle" + number + "_body")), index % 2))
  }
  var pillars: Array[H.Node] = []
  for index in 0..PILLARS.length() {
    let (art, stem) = PILLARS[index]
    pillars = pillars.push(Story.reveal(Story.tile(art, "", "blue", t("story.culture." + stem + "_title"), t("story.culture." + stem + "_body")), index))
  }
  shell(frame, &meta, [
      Story.hero(Story.headline(t("story.culture.headline_top"), t("story.culture.headline_bottom")), t("story.culture.lead"), [
          Story.action(Routes.ABOUT, t("story.about_link"), true),
          Story.action(Routes.CONTACT, t("story.contact"), false)
        ], "cotorra-hero"),
      Story.band([Story.statement(t("story.culture.mission_eyebrow"), t("story.culture.mission"), "")]),
      H.section().class("st-section").holding([
          Story.reveal(Story.heading(t("story.culture.values_eyebrow"), t("story.culture.values_title"), t("story.culture.values_body"), "purple"), 0),
          H.ul().class("st-tiles").holding(tiles)
        ]),
      H.section().class("st-section").holding([
          Story.reveal(Story.heading(t("story.culture.principles_eyebrow"), t("story.culture.principles_title"), "", "yellow"), 0),
          H.ul().class("st-features").holding(principles)
        ]),
      H.section().class("st-section").holding([
          Story.reveal(Story.heading(t("story.culture.pillars_eyebrow"), t("story.culture.pillars_title"), "", "blue"), 0),
          H.ul().class("st-tiles st-tiles-three").holding(pillars)
        ]),
      Story.closing("party", t("story.culture.cta_title"), t("story.culture.cta_body"), [
          Story.action(Routes.CONTACT, t("story.contact"), true),
          Story.action(Routes.SEARCH, t("story.explore"), false)
        ])
    ])
}
