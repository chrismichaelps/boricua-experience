/** @View.Layout.Shell — the document every page is rendered inside */
module View.Layout

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Constants.App as App
import Constants.Routes as Routes
import Domain.Locale as Locale
import Domain.Profile as Profile
import View.Components.Assistant as Assistant
import View.Components.Avatar as Avatar
import View.Components.Footer as Footer
import View.Components.Form as Form
import View.Components.Icons as Icons
import View.Components.Notice as Notice
import View.Frame as Frame
import View.Seo as Seo

/** @View.Layout.Section — the part of the app a page belongs to, marked in navigation */
export type Section = Explore | MapView | Create | Activity | Me | Elsewhere

/// A page in the app shell.
export fn page(frame: &Frame.Frame, meta: &Seo.Meta, section: Section, content: H.Node) -> Html.Html {
  H.html().lang(Locale.tag(&frame.locale)).holding([
      H.head().holding(headTags(frame).concat(Seo.head(frame, meta))),
      H.body().class(bodyClass(&section) + (if frame.path == Routes.HOME && section == Explore { " app-home" } else if frame.path == Routes.SEARCH && section == Explore { " app-search" } else { "" })).holding([
          H.a().class("skip").href("#content").says(Frame.t(frame, "nav.skip")),
          appBar(frame, &section),
          H.main().id("content").class("shell").at("tabindex", "-1").holding([content]),
          Footer.render(frame),
          tabBar(frame, &section),
          if frame.path == Routes.HOME && section == Explore { Assistant.render(frame) } else { H.nothing() },
          Notice.cookieBanner(frame),
          Notice.flash(frame),
          H.div().class("live-badge").id("live-badge").at("hidden", "hidden").role("status").holding([H.span().class("live-dot"), H.span().says(Frame.t(frame, "location.live"))])
        ])
    ]).html()
}

/// The body class for a section, so full-screen tools can drop the footer.
fn bodyClass(section: &Section) -> Str {
  match section {
    case MapView => "app app-full"
    case _ => "app"
  }
}

/// Charset, viewport, colours, icons, manifest, fonts, styles, and scripts.
fn headTags(frame: &Frame.Frame) -> Array[H.Node] {
  let version = "?v=" + App.ASSET_VERSION
  [
    H.meta().at("charset", "utf-8"),
    H.meta().name("viewport").at("content", "width=device-width, initial-scale=1, viewport-fit=cover"),
    H.meta().name("theme-color").at("content", App.THEME_COLOR),
    H.meta().name("color-scheme").at("content", "light"),
    H.meta().name("apple-mobile-web-app-capable").at("content", "yes"),
    H.meta().name("mobile-web-app-capable").at("content", "yes"),
    H.meta().name("apple-mobile-web-app-status-bar-style").at("content", "default"),
    H.meta().name("apple-mobile-web-app-title").at("content", App.SHORT_NAME),
    H.link().rel("icon").href(Routes.FAVICON + version).at("sizes", "48x48"),
    H.link().rel("icon").href("/assets/brand/icon.svg" + version).kind("image/svg+xml"),
    H.link().rel("icon").href("/assets/brand/icon-192.png" + version).kind("image/png").at("sizes", "192x192"),
    H.link().rel("apple-touch-icon").href("/assets/brand/apple-touch-icon.png" + version).at("sizes", "180x180"),
    H.link().rel("manifest").href(Routes.MANIFEST),
    H.link().rel("preload").href("/assets/fonts/nunito-sans.woff2").at("as", "font").kind("font/woff2").at("crossorigin", "anonymous"),
    H.link().rel("stylesheet").href("/assets/css/app.css" + version),
    H.link().rel("stylesheet").href("/assets/css/home.css" + version),
    H.link().rel("stylesheet").href("/assets/css/search.css" + version),
    H.link().rel("stylesheet").href("/assets/css/experience.css" + version),
    H.link().rel("stylesheet").href("/assets/css/menu.css" + version),
    H.link().rel("stylesheet").href("/assets/css/assistant.css" + version),
    H.script().kind("module").src("/assets/js/main.js" + version).flag("defer").data("locale", Locale.code(&frame.locale))
  ].concat(if frame.formToken.isEmpty() { [] } else { [H.meta().name("csrf-token").at("content", frame.formToken)] })
}

/// A navigation link, marked current in its section.
fn navLink(href: Str, icon: Str, label: Str, current: Bool, className: Str) -> H.Node {
  var link = H.a().class(if current { className + " is-current" } else { className }).href(href).holding([Icons.icon(icon), H.span().says(label)])
  if current { link = link.at("aria-current", "page") }
  link
}

/// The top bar: brand, navigation on wide screens, language, inbox, and the account.
fn appBar(frame: &Frame.Frame, section: &Section) -> H.Node {
  H.header().class("appbar").holding([
      H.a().class("brand").href(Routes.HOME).label(App.SITE_NAME).holding([
          H.img().src("/assets/brand/cotorra-mark.svg?v=" + App.ASSET_VERSION).alt("").at("width", "48").at("height", "48"),
          H.span().class("brand-name").holding([H.strong().says("boricua"), H.span().says("experience")])
        ]),
      H.nav().class("topnav").label(Frame.t(frame, "nav.main")).holding([
          navLink(Routes.HOME, "search", Frame.t(frame, "nav.explore"), *section == Explore, "topnav-link"),
          navLink(Routes.MAP, "map", Frame.t(frame, "nav.map"), *section == MapView, "topnav-link"),
          navLink(Routes.CREATE, "plus", Frame.t(frame, "nav.create"), *section == Create, "topnav-link"),
          navLink(Routes.ACTIVITY, "ticket", Frame.t(frame, "nav.activity"), *section == Activity, "topnav-link")
        ]),
      H.div().class("appbar-actions").holding([
          languageSwitch(frame),
          account(frame)
        ])
    ])
}

/// A one-button form switching between Spanish and English; wide screens only, the menu holds it on phones.
fn languageSwitch(frame: &Frame.Frame) -> H.Node {
  let other = if frame.locale == Locale.Es { "en" } else { "es" }
  H.form().action(Routes.LANGUAGE).method("post").class("lang-switch").holding([
      Form.token(frame),
      H.input().kind("hidden").name("lang").value(other),
      H.input().kind("hidden").name("return").value(Frame.here(frame)),
      H.button().submit().class("icon-button").label(Frame.t(frame, "nav.language")).at("lang", other).holding([Icons.sized("globe", 20), H.span().says(other.toUpper())])
    ])
}

/// The bell with its unread count; `data-unread` lets the page ring it when the count has grown.
fn bell(frame: &Frame.Frame, unread: Int) -> H.Node {
  let shown = if Frame.here(frame) == Routes.NOTIFICATIONS { 0 } else { unread }
  H.a().class("icon-button bell").href(Routes.NOTIFICATIONS).label(Frame.t(frame, "nav.notifications")).data("feature", "bell").data("unread", show(shown)).holding([
      H.span().class("bell-icon").holding([Icons.sized("bell", 22)]),
      if shown > 0 { H.span().class("badge").says(if shown > 9 { "9+" } else { show(shown) }) } else { H.nothing() }
    ])
}

/// One row of the account menu.
fn menuLink(href: Str, icon: Str, label: Str, trailing: H.Node) -> H.Node {
  H.a().class("menu-row").href(href).role("menuitem").holding([Icons.sized(icon, 20), H.span().says(label), trailing])
}

/// The language row: a one-button form naming the current language and switching to the other.
fn languageRow(frame: &Frame.Frame) -> H.Node {
  let other = if frame.locale == Locale.Es { "en" } else { "es" }
  H.form().action(Routes.LANGUAGE).method("post").class("menu-form").holding([
      Form.token(frame),
      H.input().kind("hidden").name("lang").value(other),
      H.input().kind("hidden").name("return").value(Frame.here(frame)),
      H.button().submit().class("menu-row").role("menuitem").label(Frame.t(frame, "nav.language")).holding([
          Icons.sized("globe", 20),
          H.span().says(Frame.t(frame, "nav.language_row")),
          H.span().class("menu-value").says(Frame.t(frame, "nav.language_current")),
          Icons.sized("chevron-right", 16)
        ])
    ])
}

/// The account menu: a disclosure that is a popover on wide screens and a full sheet on phones.
fn accountMenu(frame: &Frame.Frame) -> H.Node {
  let legal = H.div().class("menu-foot").holding([
      H.a().href(Routes.ABOUT).says(Frame.t(frame, "footer.about")),
      H.a().href(Routes.TERMS).says(Frame.t(frame, "footer.terms")),
      H.a().href(Routes.PRIVACY).says(Frame.t(frame, "footer.privacy"))
    ])
  let (trigger, body) = match frame.member {
    case Some(member) => (
      [Icons.sized("menu", 18), Avatar.face(member.displayName, member.avatarUrl, "sm")],
      [
        H.a().class("menu-member").href(Routes.PROFILE_PREFIX + member.id).role("menuitem").holding([
            Avatar.face(member.displayName, member.avatarUrl, "md"),
            H.span().holding([H.strong().says(member.displayName), H.span().says(Frame.t(frame, "nav.view_profile"))])
          ]),
        H.div().class("menu-group").holding([
            menuLink(Routes.NOTIFICATIONS, "bell", Frame.t(frame, "nav.notifications"), if member.unreadNotifications > 0 { H.span().class("menu-count").says(show(member.unreadNotifications)) } else { H.nothing() }),
            menuLink(Routes.ACTIVITY, "ticket", Frame.t(frame, "nav.my_activity"), H.nothing()),
            menuLink(Routes.CREATE, "plus", Frame.t(frame, "nav.create_activity"), H.nothing())
          ]),
        H.div().class("menu-group").holding([
            menuLink(Routes.ACCOUNT, "settings", Frame.t(frame, "nav.account_settings"), H.nothing()),
            languageRow(frame)
          ]),
        H.div().class("menu-group").holding([
            H.form().action(Routes.SIGN_OUT).method("post").class("menu-form").holding([Form.token(frame), H.button().submit().class("menu-row").role("menuitem").holding([Icons.sized("logout", 20), H.span().says(Frame.t(frame, "nav.sign_out"))])])
          ]),
        legal
      ])
    case None => (
      [Icons.sized("menu", 18), H.span().class("menu-guest").holding([Icons.sized("user", 18)])],
      [
        H.div().class("menu-group menu-cta").holding([
            H.a().class("button button-block").href(Routes.SIGN_IN + "?return=" + Frame.here(frame).replace("&", "%26")).says(Frame.t(frame, "nav.sign_in")),
            H.a().class("button button-block button-ghost").href(Routes.SIGN_UP).says(Frame.t(frame, "nav.create_account"))
          ]),
        H.div().class("menu-group").holding([
            menuLink(Routes.MAP, "map", Frame.t(frame, "nav.map"), H.nothing()),
            languageRow(frame)
          ]),
        legal
      ])
  }
  H.details().class("account-menu").data("feature", "account-menu").holding([
      H.summary().class("menu-trigger").label(Frame.t(frame, "nav.menu")).holding(trigger),
      H.div().class("menu-panel").role("menu").label(Frame.t(frame, "nav.menu")).holding([
          H.div().class("menu-sheet-head").holding([
              H.span().class("brand").holding([H.img().src("/assets/brand/cotorra-mark.svg?v=" + App.ASSET_VERSION).alt("").at("width", "44").at("height", "44"), H.span().class("brand-name").holding([H.strong().says("boricua"), H.span().says("experience")])]),
              H.button().kind("button").class("icon-button menu-close").label(Frame.t(frame, "nav.close_menu")).data("menu", "close").holding([Icons.sized("x", 22)])
            ])
        ].concat(body))
    ])
}

/// The inbox and the account menu for a member; the menu alone for a guest.
fn account(frame: &Frame.Frame) -> H.Node {
  match frame.member {
    case Some(member) => H.div().class("appbar-member").holding([bell(frame, member.unreadNotifications), accountMenu(frame)])
    case None => accountMenu(frame)
  }
}

/// The bottom tab bar on phones.
fn tabBar(frame: &Frame.Frame, section: &Section) -> H.Node {
  H.nav().class("tabbar").label(Frame.t(frame, "nav.main")).holding([
      navLink(Routes.HOME, "search", Frame.t(frame, "nav.explore"), *section == Explore, "tab"),
      navLink(Routes.MAP, "map", Frame.t(frame, "nav.map"), *section == MapView, "tab"),
      navLink(Routes.CREATE, "plus", Frame.t(frame, "nav.create"), *section == Create, "tab tab-create"),
      navLink(Routes.ACTIVITY, "ticket", Frame.t(frame, "nav.activity"), *section == Activity, "tab"),
      navLink(if Frame.signedIn(frame) { Routes.ACCOUNT } else { Routes.SIGN_IN }, "user", Frame.t(frame, "nav.profile"), *section == Me, "tab")
    ])
}

/// Whether a member may act: onboarded and active.
export fn canAct(member: &Profile.MyProfile) -> Bool { member.onboarded && member.status == Profile.ACTIVE }
