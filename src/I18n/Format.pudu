/** @I18n.Format.Values — prices, counts, and distances written for a reader */
module I18n.Format

import Domain.Event as Event
import Domain.Locale as Locale
import I18n.Translate as Translate
import Utils.Geo as Geo
import Utils.Money as Money

/// `Gratis` / `Free`, or the price.
export fn price(locale: &Locale.Locale, cents: Option[Int]) -> Str {
  match cents {
    case Some(0) => Translate.text(locale, "event.free")
    case Some(amount) => Money.dollars(amount)
    case None => Translate.text(locale, "event.price_unknown")
  }
}

/// `12 van` / `12 going`.
export fn going(locale: &Locale.Locale, count: Int) -> Str { Translate.count(locale, "event.going", count) }

/// `Quedan 3` / `3 spots left`, `Lleno` / `Full`, or nothing without a capacity.
export fn seats(locale: &Locale.Locale, card: &Event.Card) -> Str {
  match Event.seatsLeft(card) {
    case Some(0) => Translate.text(locale, "event.full")
    case Some(left) => Translate.count(locale, "event.spots_left", left)
    case None => ""
  }
}

/// `A 3.2 km` / `3.2 km away`, or nothing without a distance.
export fn distance(locale: &Locale.Locale, meters: Option[Int]) -> Str {
  match meters {
    case Some(found) => Translate.fill(locale, "event.distance", &[("distance", match locale { case Locale.En => measure(locale, found) case _ => Geo.distanceLabel(found) })])
    case None => ""
  }
}

/// The category's name in the reader's language.
export fn categoryName(locale: &Locale.Locale, category: &Event.CategoryRef) -> Str {
  match locale {
    case Locale.Es => category.nameEs
    case Locale.En => category.nameEn
  }
}

/// A distance as people read it: kilometres in Spanish, miles in English, with one decimal.
export fn measure(locale: &Locale.Locale, meters: Int) -> Str {
  match locale {
    case Locale.En => {
      let tenths = (meters * 10 + 804) / 1609
      show(tenths / 10) + "." + show(tenths % 10) + " mi"
    }
    case _ => show(meters / 1000) + "." + show((meters % 1000) / 100) + " km"
  }
}

/// A radius of whole kilometres as people read it: "25 km" in Spanish, "16 mi" in English.
export fn radius(locale: &Locale.Locale, km: Int) -> Str {
  match locale {
    case Locale.En => show((km * 1000 + 804) / 1609) + " mi"
    case _ => show(km) + " km"
  }
}

