/** @I18n.Translate.Lookup — message keys turned into text in a language */
module I18n.Translate

import Std.Option as Option
import Domain.Locale as Locale
import I18n.En as En
import I18n.EnAccount as EnAccount
import I18n.EnLegal as EnLegal
import I18n.EnMenu as EnMenu
import I18n.EnStory as EnStory
import I18n.Es as Es
import I18n.EsAccount as EsAccount
import I18n.EsLegal as EsLegal
import I18n.EsMenu as EsMenu
import I18n.EsStory as EsStory

/// The text of a key in a language; the Spanish text when English lacks it; the key itself when
/// neither has it, so a missing entry is visible rather than blank.
export fn text(locale: &Locale.Locale, key: Str) -> Str {
  let found = match locale {
    case Locale.Es => spanish(key)
    case Locale.En => english(key)
  }
  Option.unwrapOr(Option.orElse(found, spanish(key)), key)
}

/// The Spanish text of a key from the interface, account, policy, menu, or story catalogue.
fn spanish(key: Str) -> Option[Str] { Option.firstPresent(&[Es.MESSAGES.get(key), EsAccount.MESSAGES.get(key), EsLegal.MESSAGES.get(key), EsMenu.MESSAGES.get(key), EsStory.MESSAGES.get(key)]) }

/// The English text of a key from the interface, account, policy, menu, or story catalogue.
fn english(key: Str) -> Option[Str] { Option.firstPresent(&[En.MESSAGES.get(key), EnAccount.MESSAGES.get(key), EnLegal.MESSAGES.get(key), EnMenu.MESSAGES.get(key), EnStory.MESSAGES.get(key)]) }

/// Whether a language's catalogues hold a key, without falling back.
export fn has(locale: &Locale.Locale, key: Str) -> Bool {
  match locale {
    case Locale.Es => spanish(key) != None
    case Locale.En => english(key) != None
  }
}

/// The text of a key with each `:name` replaced by its value, longest names first so `:count`
/// never consumes part of `:counted`.
export fn fill(locale: &Locale.Locale, key: Str, values: &Array[(Str, Str)]) -> Str {
  var message = text(locale, key)
  let ordered = values.sortBy(|left: (Str, Str), right: (Str, Str)| left[0].length() > right[0].length())
  for pair in ordered {
    message = message.replace(":" + pair[0], pair[1])
  }
  message
}

/// The singular or plural form of a counted message: `key.one` for one, `key.other` otherwise.
export fn count(locale: &Locale.Locale, key: Str, amount: Int) -> Str {
  fill(locale, key + (if amount == 1 { ".one" } else { ".other" }), &[("count", show(amount))])
}
