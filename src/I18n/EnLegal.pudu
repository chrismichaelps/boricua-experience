/** @I18n.EnLegal.Catalog — English text of the policies and the about page */
module I18n.EnLegal

/// English policy messages by key.
export const MESSAGES: Map[Str, Str] = mapOf([
  ("legal.version", "Version :version · Questions: :email"),
  ("legal.terms.title", "Terms of Use"),
  ("legal.terms.description", "The rules for using Boricua Experience: who can use it, how to publish and join activities, and your responsibilities."),
  ("legal.terms.intro", "By creating an account or using Boricua Experience you accept these terms. They are written to be understood; please read them."),
  ("legal.terms.eligibility.title", "Adults 18 and over only"),
  ("legal.terms.eligibility.body", "Boricua Experience is only for people 18 or older. By signing up you confirm you meet that age. If we learn an account belongs to a minor, we will close it and delete its data.\n\nParents and guardians are responsible for supervising the internet use of minors in their care."),
  ("legal.terms.accounts.title", "Your account"),
  ("legal.terms.accounts.body", "You can sign in with your email and password or with Google. You are responsible for activity on your account and for keeping your password safe. You can pause or delete your account anytime from settings."),
  ("legal.terms.events.title", "Publishing activities"),
  ("legal.terms.events.body", "Organizers decide whether their activity is public, link-only, or private; whether it requires approval; and its capacity, price, date, and place. What you publish must be true and up to date.\n\nActivities aimed mainly at children are not allowed. If your activity includes minors, you are responsible for complying with all applicable laws.\n\nAny payment is agreed directly between organizer and attendees; Boricua Experience does not process payments or guarantee refunds."),
  ("legal.terms.joining.title", "Joining activities"),
  ("legal.terms.joining.body", "When you ask to join, the organizer sees your name, your town, and your message. If approved, you see the exact address and instructions. Respect the organizer's and the venue's rules."),
  ("legal.terms.conduct.title", "Community conduct"),
  ("legal.terms.conduct.body", "Don't post false, misleading, offensive, discriminatory, or illegal content; don't harass others; don't use the platform for spam, fraud, or unsolicited advertising. We may remove content or suspend accounts that break these rules."),
  ("legal.terms.safety.title", "Your safety"),
  ("legal.terms.safety.body", "Activities are organized by community members, not by Boricua Experience. Use your judgment, meet in safe places, and tell someone your plans. You can report any activity from its page."),
  ("legal.terms.minors.title", "Minors"),
  ("legal.terms.minors.body", "The platform is not designed for minors and contains no features aimed at them. Report any activity aimed at minors using the matching reason."),
  ("legal.terms.content.title", "Your content"),
  ("legal.terms.content.body", "You keep the rights to what you publish. You let us show it on the platform and in search engines while your activity is public. Records needed for the platform's integrity may be kept in anonymized form."),
  ("legal.terms.liability.title", "Liability"),
  ("legal.terms.liability.body", "We provide the platform as is. To the extent the law allows, we are not responsible for what happens at activities organized by others, nor for indirect losses from using the service."),
  ("legal.terms.termination.title", "Suspension and closure"),
  ("legal.terms.termination.body", "You can delete your account at any time. We may suspend or close accounts that put others at risk or break these terms."),
  ("legal.terms.changes.title", "Changes"),
  ("legal.terms.changes.body", "If we change these terms in an important way, we will ask you to accept them again when you sign in."),
  ("legal.terms.contact.title", "Contact and governing law"),
  ("legal.terms.contact.body", "These terms are governed by the laws of Puerto Rico and the United States. Write to the address above with any question."),
  ("legal.privacy.title", "Privacy Policy"),
  ("legal.privacy.description", "What data we keep, why, for how long, and how to exercise your rights of access, correction, portability, objection, and deletion."),
  ("legal.privacy.intro", "Your privacy is not negotiable. We keep the minimum the app needs, and you control your location."),
  ("legal.privacy.collect.title", "What we keep"),
  ("legal.privacy.collect.body", "Account: name, email, language, and, if you use Google, your Google account identifier.\n\nOptional profile: bio and town.\n\nActivity: what you publish, your requests, saves, likes, and reports.\n\nConsents: when you accepted the terms, privacy, age, and your cookie choices.\n\nLocation: only if you turn on live location."),
  ("legal.privacy.use.title", "Why we use it"),
  ("legal.privacy.use.body", "To show you activities, connect organizers with attendees, send the notifications you choose, recommend activities based on what you like, keep the platform safe, and comply with the law. We don't sell your data."),
  ("legal.privacy.location.title", "Your location"),
  ("legal.privacy.location.body", "Live location is off until you turn it on, and turns off with one tap. It is never public. You choose whether only you see it or also approved people at your same activities, around the time of the event.\n\nWhile you share, we keep a 30-day history. You can delete it anytime from your account."),
  ("legal.privacy.sharing.title", "Who we share with"),
  ("legal.privacy.sharing.body", "With the organizers of activities you ask to join (your name, town, and message) and with providers that host our database and site, under confidentiality agreements. We share information with authorities only when the law requires it."),
  ("legal.privacy.retention.title", "How long"),
  ("legal.privacy.retention.body", "Account data, while you have an account. Location history, 30 days. Security logs, consents, and data requests, as long as the law requires; then they are deleted or anonymized."),
  ("legal.privacy.rights.title", "Your rights"),
  ("legal.privacy.rights.body", "You can access your data and download it as a file, correct it from your account, object to uses such as marketing, pause your account, or delete it. We log each request so we can show we handled it."),
  ("legal.privacy.deletion.title", "When you delete your account"),
  ("legal.privacy.deletion.body", "We immediately delete your profile, your location and its history, your preferences, and notifications. We cancel your upcoming activities and notify their attendees. Past activities show as from a deleted user. We keep, unlinked from you, only the records the law requires."),
  ("legal.privacy.cookies.title", "Cookies"),
  ("legal.privacy.cookies.body", "We use necessary cookies to keep your session, language, and cookie choice. Optional cookies are used only with your permission. See the cookie policy for details."),
  ("legal.privacy.security.title", "Security"),
  ("legal.privacy.security.body", "Connections are encrypted, your session lives in a sealed cookie no script can read, and each record is protected in the database so only you, or whoever you authorize, can see it."),
  ("legal.privacy.minors.title", "Minors"),
  ("legal.privacy.minors.body", "We do not knowingly collect data from anyone under 18. If we find an account belonging to a minor, we delete it with its data."),
  ("legal.privacy.contact.title", "Contact"),
  ("legal.privacy.contact.body", "For any request about your data, write to the address above."),
  ("legal.cookies.title", "Cookie Policy"),
  ("legal.cookies.description", "Which cookies we use, why, and how to change your choice."),
  ("legal.cookies.intro", "No optional cookie is used before you choose."),
  ("legal.cookies.what.title", "What they are"),
  ("legal.cookies.what.body", "Small files the browser keeps to remember information between visits."),
  ("legal.cookies.necessary.title", "Necessary"),
  ("legal.cookies.necessary.body", "They keep your session secure, remember your language and cookie choice, and protect forms. The app can't work without them, so they are always on."),
  ("legal.cookies.analytics.title", "Analytics"),
  ("legal.cookies.analytics.body", "They would help us understand how the app is used in aggregate. We use none today; if we add any, they will only run with your permission."),
  ("legal.cookies.marketing.title", "Marketing"),
  ("legal.cookies.marketing.body", "They would help measure campaigns. We use none today; if we add any, they will only run with your permission."),
  ("legal.cookies.choices.title", "Your choice"),
  ("legal.cookies.choices.body", "Change your choice anytime with the button below. We keep a record of every choice."),
  ("about.title", "About Boricua Experience"),
  ("about.description", "A platform to discover, join, and create activities in Puerto Rico, built on privacy."),
  ("about.intro", "We believe the best of Puerto Rico happens when people get together."),
  ("about.mission.title", "Our mission"),
  ("about.mission.body", "Make finding something to do as easy as searching for it, and hosting something of your own as easy as publishing it: culture, music, sports, workshops, beaches, community, birthdays, and civic causes."),
  ("about.how.title", "How it works"),
  ("about.how.body", "Search or explore the map. Ask to join and the organizer approves who goes. Once approved, you get the exact address and instructions."),
  ("about.safety.title", "Safety first"),
  ("about.safety.body", "Adults 18 and over only, with reports and moderation, and addresses protected until approval."),
  ("about.privacy.title", "Privacy by design"),
  ("about.privacy.body", "Your location is yours: off by default, never public, with a history you can delete. Download or delete your data anytime.")
])
