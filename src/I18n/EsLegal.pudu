/** @I18n.EsLegal.Catalog — Spanish text of the policies and the about page */
module I18n.EsLegal

/// Spanish policy messages by key.
export const MESSAGES: Map[Str, Str] = mapOf([
    ("legal.version", "Versión :version · Vigente desde el 10 de octubre de 2026"),
    ("legal.contents", "En esta página"),
    ("legal.summary_title", "En resumen"),
    ("legal.terms.title", "Términos de uso"),
    ("legal.terms.description", "El acuerdo entre tú y Boricua Experience: quién puede usar la plataforma, cómo se publican y se solicitan actividades, y de qué es responsable cada parte."),
    ("legal.terms.intro", "Estos términos son el acuerdo entre tú y Boricua Experience para usar el sitio web y la app. Al crear una cuenta, o al usar la plataforma sin una, los aceptas. Los escribimos para que se puedan leer de corrido."),
    ("legal.terms.summary", "Boricua Experience es para personas de 18 años o más. Quien organiza una actividad es responsable de ella; nosotros damos el espacio para encontrarla y unirse, no la actividad en sí. Trata a la gente con respeto, mantén la información honesta y usa tu juicio cuando conozcas a alguien en persona."),
    ("legal.terms.service.title", "Qué es Boricua Experience"),
    ("legal.terms.service.body", "Boricua Experience es una plataforma donde la gente en Puerto Rico descubre actividades, publica las suyas y pide unirse a las que organizan otras personas. Las actividades las crean y las dirigen miembros de la comunidad.\n\nNo organizamos, supervisamos, aseguramos ni asistimos a las actividades que aparecen en la plataforma, y no somos parte de ningún acuerdo entre quien organiza y quienes asisten. En este documento, “organizador” es el miembro que publicó una actividad y “asistente” es el miembro que pidió unirse a ella."),
    ("legal.terms.eligibility.title", "Quién puede usarla"),
    ("legal.terms.eligibility.body", "Debes tener al menos 18 años para crear una cuenta, publicar una actividad o pedir unirte a una. Al registrarte te pedimos tu fecha de nacimiento para confirmarlo; no guardamos la fecha, solo el hecho de que cumpliste el requisito.\n\nEn Puerto Rico la mayoría de edad es a los 21 años. Si tienes entre 18 y 20, confirmas que puedes aceptar este acuerdo según las leyes que te aplican. El servicio es gratuito y nada en él requiere que asumas una obligación económica con nosotros.\n\nSolo puedes tener una cuenta, a tu propio nombre, y la información que nos das debe ser cierta. No puedes usar la plataforma si antes cerramos tu cuenta por incumplir estos términos."),
    ("legal.terms.account.title", "Tu cuenta"),
    ("legal.terms.account.body", "Puedes entrar con correo electrónico y contraseña o con tu cuenta de Google. Eres responsable de todo lo que ocurra con tu cuenta, así que mantén tu contraseña en privado y cámbiala enseguida, con la recuperación de acceso, si crees que otra persona la usó.\n\nPuedes pausar tu cuenta, lo que oculta tu perfil y tus actividades, o borrarla para siempre, en cualquier momento desde la configuración de tu cuenta."),
    ("legal.terms.publishing.title", "Publicar una actividad"),
    ("legal.terms.publishing.body", "Al publicar una actividad decides su visibilidad (pública, solo con enlace o privada), si las solicitudes necesitan tu aprobación, el cupo, el precio y dónde y cuándo ocurre. La dirección exacta solo la ven las personas que apruebas; los demás ven un área aproximada.\n\nComo organizador eres responsable de la actividad: de que lo que describes sea cierto y esté al día; de tener cualquier permiso, autorización o seguro que la actividad requiera; de seguir las reglas del lugar y las leyes de Puerto Rico, incluidas las de alcohol, ruido, uso de playas y reservas naturales y reuniones públicas; y de tener un cuidado razonable por la seguridad de quienes asisten.\n\nSi la actividad tiene costo, el pago se acuerda directamente entre tú y los asistentes. Boricua Experience no procesa pagos, no guarda dinero ni gestiona reembolsos; cualquier política de reembolso te corresponde a ti establecerla y cumplirla. Si cancelas o cambias una actividad, hazlo en la plataforma para que los asistentes reciban el aviso."),
    ("legal.terms.joining.title", "Pedir unirte"),
    ("legal.terms.joining.body", "Cuando pides unirte a una actividad, el organizador ve tu nombre, tu foto de perfil, tu pueblo y el mensaje que escribas. El organizador decide a quién aprueba. Una vez aprobado ves el lugar exacto y las instrucciones y, a menos que lo desactives en tu configuración, los demás asistentes aprobados pueden ver que vas.\n\nSi cambian tus planes, retira tu solicitud para que tu espacio lo pueda usar otra persona. Sigue las instrucciones del organizador y las reglas del lugar donde ocurre la actividad."),
    ("legal.terms.minors.title", "Menores y actividades familiares"),
    ("legal.terms.minors.body", "Las cuentas son solo para adultos. Las personas menores de 18 años no pueden registrarse, publicar ni pedir unirse a actividades, ni usar la cuenta de otra persona.\n\nLas actividades no pueden estar dirigidas principalmente a menores. Un organizador puede recibir familias, pero en ese caso cada menor debe asistir con su madre, padre o tutor legal, quien tiene una cuenta, pide unirse en nombre del menor y es responsable de él durante toda la actividad. Los organizadores no pueden usar la plataforma para recopilar nombres, fotos ni datos de contacto de menores, y la foto de perfil debe mostrar a quien tiene la cuenta, no a un niño.\n\nSi sabemos que una cuenta pertenece a una persona menor de 18 años, la cerramos y borramos su información según la Política de privacidad. Si crees que un menor está usando la plataforma, o que una actividad pone a menores en riesgo, repórtala con el motivo “Involucra menores”. Los reportes sobre menores se revisan primero."),
    ("legal.terms.conduct.title", "Cómo nos tratamos"),
    ("legal.terms.conduct.body", "Boricua Experience funciona porque la gente puede confiar en lo que encuentra y en las personas que conoce aquí. Te comprometes a no publicar actividades falsas o engañosas; a no acosar, amenazar ni discriminar a nadie, incluso por raza, color, sexo, identidad de género, orientación sexual, religión, origen nacional, discapacidad o edad; a no publicar contenido sexual ni contenido que promueva la violencia o actividades ilegales; a no enviar spam, publicidad que nadie pidió ni estafas; a no hacerte pasar por otra persona; y a no recopilar información de otros miembros para usarla fuera de la plataforma.\n\nTambién te comprometes a no interferir con el funcionamiento de la plataforma, por ejemplo extrayendo su contenido de forma automatizada, buscando vulnerabilidades o creando cuentas de forma automática."),
    ("legal.terms.safety.title", "Conocer gente y participar"),
    ("legal.terms.safety.body", "No verificamos los antecedentes de los miembros y no podemos garantizar la identidad, las intenciones ni la conducta de nadie que conozcas a través de la plataforma. Usa tu juicio: cuando puedas, reúnete en lugares públicos, dile a alguien a dónde vas y vete de cualquier situación que no se sienta bien.\n\nMuchas actividades en Puerto Rico ocurren al aire libre, en playas, ríos, veredas y en el mar, donde las condiciones cambian rápido. Revisa los avisos oficiales del tiempo y de seguridad, respeta los cierres y las advertencias, y no participes en nada que esté por encima de tu capacidad. Participas en las actividades de forma voluntaria y bajo tu propio riesgo.\n\nSi estás en peligro, llama al 911. Luego reporta la actividad o al miembro en la plataforma para que podamos actuar."),
    ("legal.terms.content.title", "Lo que publicas"),
    ("legal.terms.content.body", "El texto y las fotos que publicas siguen siendo tuyos. Le das a Boricua Experience una licencia no exclusiva y gratuita para alojar, mostrar y adaptar ese contenido con el fin de operar y mostrar la plataforma, incluso en resultados de búsqueda mientras una actividad sea pública. La licencia termina cuando borras el contenido o tu cuenta, salvo las copias que debamos conservar por las razones de la Política de privacidad.\n\nPublica solo contenido que tengas derecho a compartir, y solo fotos de personas que aceptaron aparecer."),
    ("legal.terms.moderation.title", "Reportes y medidas"),
    ("legal.terms.moderation.body", "Cualquier persona puede reportar una actividad. Revisamos los reportes y podemos ocultar o retirar contenido, limitar funciones, o suspender o cerrar cuentas que incumplan estos términos o pongan a otros en riesgo, y podemos hacerlo sin aviso previo cuando la seguridad lo exige. Cuando es seguro hacerlo, te informamos lo que pasó.\n\nTambién colaboramos con las autoridades cuando la ley lo exige o cuando está en juego la seguridad de alguien."),
    ("legal.terms.disclaimers.title", "Lo que no prometemos"),
    ("legal.terms.disclaimers.body", "Trabajamos para que la plataforma esté disponible y su información sea útil, pero la ofrecemos tal como está y según esté disponible. No garantizamos que funcione sin interrupciones ni errores, que una actividad ocurra como se describe, ni que un miembro sea quien dice ser."),
    ("legal.terms.liability.title", "Límites de nuestra responsabilidad"),
    ("legal.terms.liability.body", "En la medida en que la ley lo permite, Boricua Experience no es responsable de lo que ocurra en actividades organizadas por miembros, de la conducta de ningún miembro dentro o fuera de la plataforma, ni de pérdidas indirectas, incidentales o consecuentes que surjan del uso de la plataforma. Nada en estos términos limita una responsabilidad que la ley no nos permite limitar."),
    ("legal.terms.indemnity.title", "Tu responsabilidad con nosotros"),
    ("legal.terms.indemnity.body", "Si se presenta una reclamación contra Boricua Experience por una actividad que organizaste, por contenido que publicaste o por incumplir estos términos o la ley, aceptas cubrir los costos razonables que esa reclamación nos cause, incluidos los honorarios legales, en la medida en que la ley lo permite."),
    ("legal.terms.changes.title", "Cambios a estos términos"),
    ("legal.terms.changes.body", "Podemos actualizar estos términos a medida que la plataforma cambie. Cuando un cambio sea importante te avisaremos en la plataforma antes de que entre en vigor y te pediremos aceptar la nueva versión la próxima vez que entres. La versión y la fecha de vigencia al principio de esta página siempre indican qué términos aplican."),
    ("legal.terms.law.title", "Ley aplicable y disputas"),
    ("legal.terms.law.body", "Estos términos se rigen por las leyes del Estado Libre Asociado de Puerto Rico y las leyes federales de Estados Unidos que apliquen. Si surge un desacuerdo, te pedimos que primero intentes resolverlo con nosotros de forma informal. Si no se puede resolver, lo atenderán los tribunales competentes de San Juan, Puerto Rico, salvo que la ley te dé derecho a otro foro."),
    ("legal.terms.contact.title", "Cómo comunicarte"),
    ("legal.terms.contact.body", "Para reportar una actividad, usa la opción de reporte en su página. Para descargar, corregir o borrar tu información, usa la configuración de tu cuenta. Cada solicitud que hagas allí queda registrada para poder demostrar que se atendió."),
    ("legal.privacy.title", "Política de privacidad"),
    ("legal.privacy.description", "Qué información guarda Boricua Experience, para qué, quién la puede ver, por cuánto tiempo y cómo la controlas."),
    ("legal.privacy.intro", "Esta política explica qué información recopila Boricua Experience cuando usas el sitio web y la app, qué hacemos con ella, quién la puede ver y qué opciones tienes. Aplica a todas las personas que usan la plataforma, con o sin cuenta."),
    ("legal.privacy.summary", "Guardamos lo que la plataforma necesita y nada más. No vendemos tu información ni mostramos publicidad. Tu ubicación exacta está apagada hasta que la actives y nunca es pública. Puedes descargar o borrar tu información en cualquier momento desde tu cuenta."),
    ("legal.privacy.scope.title", "Quiénes somos"),
    ("legal.privacy.scope.body", "Boricua Experience opera la plataforma en boricuaexperience.com y es responsable de la información que se describe aquí. Los organizadores que reciben tu información cuando pides unirte a su actividad son responsables de cómo la usan fuera de la plataforma."),
    ("legal.privacy.collect.title", "Qué recopilamos"),
    ("legal.privacy.collect.body", "Al crear una cuenta guardamos tu nombre, tu correo electrónico, tu idioma preferido y, si entras con Google, el identificador que Google nos da para tu cuenta. Para confirmar que eres adulto te pedimos tu fecha de nacimiento, la verificamos en ese momento y solo guardamos el hecho de que tienes 18 años o más.\n\nTu perfil también puede incluir una foto, una breve descripción y tu pueblo; todo esto es opcional. Mientras usas la plataforma guardamos las actividades que publicas, las solicitudes que envías y sus mensajes, las decisiones de los organizadores, las actividades que guardas, tus “me gusta” y “no me gusta”, los reportes que haces y tu configuración de notificaciones y privacidad.\n\nSi activas la ubicación en vivo, guardamos las posiciones que comparte tu dispositivo mientras está activa. También guardamos un registro de las políticas que aceptaste y de tus preferencias de cookies, y la información técnica que nuestros servidores necesitan para funcionar de forma segura: tu dirección IP, el tipo de navegador y dispositivo, y la hora y el resultado de cada solicitud."),
    ("legal.privacy.use.title", "Cómo la usamos"),
    ("legal.privacy.use.body", "Usamos tu información para ofrecer la plataforma: mostrarte actividades, permitir que los organizadores revisen solicitudes, revelar el lugar exacto a los asistentes aprobados, enviarte las notificaciones que eliges y recordarte antes de que empiece una actividad. Tus “me gusta”, lo que guardas y tu pueblo nos ayudan a recomendarte actividades; puedes verlos y cambiarlos cuando quieras.\n\nTambién la usamos para mantener la plataforma segura, investigar reportes y prevenir fraude y abuso, guardar los registros que exige la ley y entender, de forma agregada, cómo se usa la plataforma para mejorarla. Usamos tu ubicación solo con tu permiso y las cookies opcionales solo con tu consentimiento. No vendemos tu información ni la usamos para publicidad."),
    ("legal.privacy.visibility.title", "Lo que ven otras personas"),
    ("legal.privacy.visibility.body", "Tu perfil público muestra tu nombre, tu foto, tu pueblo, tu descripción y las actividades públicas que organizas. Cuando pides unirte a una actividad, su organizador también ve el mensaje de tu solicitud. Una vez aprobado, los demás asistentes aprobados pueden ver que vas, a menos que te ocultes de las listas de asistentes en tu configuración.\n\nTu correo electrónico, tu fecha de nacimiento, tu historial de ubicación y tus reportes nunca se muestran a otros miembros."),
    ("legal.privacy.location.title", "Tu ubicación"),
    ("legal.privacy.location.body", "Cuando usas “Cerca de mí”, tu navegador envía tu posición con esa búsqueda para ordenar los resultados por distancia; no se guarda en tu cuenta. Compartir la ubicación en vivo es otra cosa: está apagado hasta que lo actives, se apaga con un toque y nunca es público. Tú eliges si solo la ves tú o también las personas aprobadas para tus mismas actividades, y solo alrededor de la hora en que ocurren.\n\nMientras la ubicación en vivo está activa guardamos un historial de posiciones por 30 días para que puedas revisarlo y borrarlo; luego se borra automáticamente. Puedes borrarlo antes desde tu cuenta."),
    ("legal.privacy.providers.title", "Empresas que nos ayudan"),
    ("legal.privacy.providers.body", "Trabajamos con pocos proveedores, que tratan la información solo según nuestras instrucciones: Supabase, para la base de datos, el inicio de sesión y el almacenamiento de fotos; Vercel, que aloja el sitio web; Google, solo si eliges entrar con tu cuenta de Google; y OpenFreeMap, que sirve las imágenes del mapa que carga tu navegador y, por tanto, recibe tu dirección IP y el área del mapa que estás viendo, sin ninguna información de tu cuenta.\n\nCompartimos información con las autoridades solo cuando la ley lo exige o cuando creemos de buena fe que es necesario para proteger la seguridad de alguien."),
    ("legal.privacy.retention.title", "Por cuánto tiempo"),
    ("legal.privacy.retention.body", "Guardamos la información de tu cuenta mientras la cuenta exista. El historial de ubicación en vivo se guarda 30 días. Los registros del servidor se guardan por un periodo corto por seguridad y luego se borran. Los registros de las políticas que aceptaste, tus preferencias de cookies, tus solicitudes sobre tu información y las decisiones de moderación se guardan el tiempo que exija la ley o el necesario para defender reclamaciones legales, y luego se borran o se anonimizan."),
    ("legal.privacy.rights.title", "Tus opciones y derechos"),
    ("legal.privacy.rights.body", "Desde la configuración de tu cuenta puedes descargar una copia de tu información en un formato portátil, corregir tu perfil, cambiar quién te ve y qué notificaciones recibes, apagar la ubicación compartida y borrar su historial, pausar tu cuenta o borrarla. Puedes oponerte a cualquier uso opcional de tu información y cambiar tus preferencias de cookies cuando quieras.\n\nRegistramos cada solicitud para poder demostrar que se atendió, y la completamos sin demoras indebidas. Ejercer estos derechos es gratis y nunca afectará cómo te tratamos."),
    ("legal.privacy.deletion.title", "Cuando borras tu cuenta"),
    ("legal.privacy.deletion.body", "El borrado es inmediato y no se puede deshacer. Borramos tu perfil, tu foto, tu ubicación y su historial, tus preferencias y tus notificaciones. Las actividades futuras que organizaste se cancelan y sus asistentes reciben un aviso. Las actividades pasadas siguen visibles como organizadas por un miembro eliminado, sin tu nombre.\n\nConservamos, separados de tu identidad, solo los registros que exige la ley y los necesarios para demostrar que respetamos tu consentimiento y tus solicitudes."),
    ("legal.privacy.security.title", "Cómo la protegemos"),
    ("legal.privacy.security.body", "Todas las conexiones están cifradas. Tu sesión vive en una cookie sellada que ningún script de la página puede leer, los formularios están protegidos contra solicitudes desde otros sitios y cada registro de nuestra base de datos está bloqueado para que solo tú, o las personas que autorices, lleguen a él. Ningún sistema es perfectamente seguro; si alguna vez un incidente afectara tu información, te avisaríamos a ti y a las autoridades según lo exige la ley."),
    ("legal.privacy.minors.title", "Niños y adolescentes"),
    ("legal.privacy.minors.body", "Boricua Experience no está dirigida a menores de 18 años y no recopilamos a sabiendas información de menores. El registro pide la fecha de nacimiento sin sugerir la respuesta; si indica que la persona es menor de 18, la cuenta no se crea, la fecha no se guarda y ese navegador no puede volver a intentarlo por un día.\n\nSi sabemos que tenemos información de un niño menor de 13 años, la borramos de inmediato. Si sabemos que una cuenta pertenece a una persona menor de 18, cerramos la cuenta y borramos su información en un plazo de 30 días, conservando solo lo que exige la ley. Madres, padres y tutores pueden avisarnos sobre la cuenta de un menor o sobre una actividad que involucre menores reportándola con el motivo “Involucra menores”; esos reportes se revisan primero."),
    ("legal.privacy.transfers.title", "Dónde se guarda"),
    ("legal.privacy.transfers.body", "Nuestra base de datos y el sitio web están alojados en el este de Estados Unidos. Puerto Rico es parte de Estados Unidos, así que tu información sigue bajo la ley de Estados Unidos."),
    ("legal.privacy.changes.title", "Cambios a esta política"),
    ("legal.privacy.changes.body", "Cuando cambiemos esta política de una forma que importe, te avisaremos en la plataforma antes de que el cambio entre en vigor y, cuando la ley lo exija, te pediremos tu consentimiento otra vez. La versión y la fecha de vigencia al principio de esta página indican qué política aplica."),
    ("legal.cookies.title", "Política de cookies"),
    ("legal.cookies.description", "Las cookies y el almacenamiento del navegador que usa Boricua Experience, para qué sirve cada uno y cómo cambiar tu preferencia."),
    ("legal.cookies.intro", "Las cookies son archivos pequeños que guarda tu navegador para que un sitio web recuerde algo entre páginas y visitas. Esta página enumera cada una de las que usa Boricua Experience y por qué."),
    ("legal.cookies.summary", "Solo usamos las cookies que la plataforma necesita para funcionar. Hoy no usamos cookies de analítica ni de publicidad y, si algún día las añadimos, estarán apagadas hasta que las permitas."),
    ("legal.cookies.what.title", "Cómo las usamos"),
    ("legal.cookies.what.body", "Todas nuestras cookies son propias: las establece boricuaexperience.com y solo se envían de vuelta a ese sitio. Ninguna se usa para seguirte por otros sitios web. Todas están marcadas para que los scripts de la página no puedan leerlas y, en el sitio publicado, solo viajan por conexiones cifradas."),
    ("legal.cookies.necessary.title", "Cookies que la plataforma necesita"),
    ("legal.cookies.necessary.body", "Sesión iniciada (bx_session) mantiene tu sesión iniciada. Guarda tu sesión sellada y dura hasta 30 días, o hasta que cierres sesión.\n\nProtección del inicio de sesión (bx_flow) protege un inicio de sesión mientras está en curso, por ejemplo mientras estás en la página de Google, y vence a los 10 minutos.\n\nPreferencia de idioma (bx_lang) recuerda el idioma que elegiste, por un año.\n\nPreferencia de cookies (bx_consent) recuerda tu preferencia de cookies, por un año, para no preguntarte en cada página.\n\nPreferencia del visitante (bx_visitor) es un identificador al azar, sin relación con tu cuenta, que nos permite registrar la preferencia de cookies que elegiste como visitante. Dura un año.\n\nMensaje de confirmación (bx_flash) lleva un mensaje de confirmación de una sola vez, como “Guardado”, a la página siguiente, y desaparece en menos de un minuto.\n\nComo la plataforma no puede funcionar sin ellas, no requieren tu consentimiento."),
    ("legal.cookies.storage.title", "Almacenamiento en tu navegador"),
    ("legal.cookies.storage.body", "Compartir ubicación en vivo comienza solo cuando lo eliges. Se detiene al desactivarlo, ocultar la página o salir, y no se reanuda automáticamente al recargar. La app guarda sus archivos públicos en la caché del navegador para abrir rápido; las páginas privadas de tu cuenta no se guardan para uso sin conexión."),
    ("legal.cookies.optional.title", "Cookies opcionales"),
    ("legal.cookies.optional.body", "El aviso te deja permitir cookies de analítica, que nos ayudarían a entender de forma agregada cómo se usa la plataforma, y de marketing, que nos ayudarían a medir campañas. Hoy no usamos ninguna de las dos. Registramos tu preferencia para que, si algún día las añadimos, solo funcionen con tu permiso."),
    ("legal.cookies.third.title", "Otros servicios"),
    ("legal.cookies.third.body", "Las imágenes del mapa se cargan desde OpenFreeMap, que no establece cookies. Si eliges entrar con Google, Google puede establecer sus propias cookies en su propio sitio, bajo sus propias políticas."),
    ("legal.cookies.choices.title", "Cambiar tu preferencia"),
    ("legal.cookies.choices.body", "Puedes cambiar tu preferencia cuando quieras con el botón de abajo, y registramos cada cambio. También puedes borrar las cookies desde la configuración de tu navegador; si borras bx_session, se cerrará tu sesión."),
    ("about.title", "Sobre Boricua Experience"),
    ("about.description", "Una plataforma para descubrir, unirse y crear actividades en Puerto Rico, pensada desde la privacidad."),
    ("about.intro", "Creemos que lo mejor de Puerto Rico pasa cuando la gente se junta."),
    ("about.mission.title", "Nuestra misión"),
    ("about.mission.body", "Que encontrar algo que hacer sea tan fácil como buscarlo, y organizar algo propio tan fácil como publicarlo: cultura, música, deportes, talleres, playas, comunidad, cumpleaños y causas cívicas, en cada uno de los 78 pueblos de la isla."),
    ("about.how.title", "Cómo funciona"),
    ("about.how.body", "Busca o explora el mapa. Pide unirte y el organizador decide quién va. Cuando te aprueban recibes la dirección exacta y las instrucciones, y puedes ver quién más va."),
    ("about.safety.title", "La seguridad primero"),
    ("about.safety.body", "Las cuentas son para adultos de 18 años o más. Las direcciones exactas se mantienen ocultas hasta que el organizador te aprueba, cualquiera puede reportar una actividad y los reportes que involucran menores se revisan primero."),
    ("about.privacy.title", "Privacidad desde el diseño"),
    ("about.privacy.body", "Tu ubicación es tuya: apagada por defecto, nunca pública y con un historial que puedes borrar. Puedes descargar o borrar tu información en cualquier momento.")
  ])
