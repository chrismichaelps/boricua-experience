/** @I18n.EsLegal.Catalog — Spanish text of the policies and the about page */
module I18n.EsLegal

/// Spanish policy messages by key.
export const MESSAGES: Map[Str, Str] = mapOf([
  ("legal.version", "Versión :version · Preguntas: :email"),
  ("legal.terms.title", "Términos de uso"),
  ("legal.terms.description", "Las reglas para usar Boricua Experience: quién puede usarla, cómo publicar y unirse a actividades, y tus responsabilidades."),
  ("legal.terms.intro", "Al crear una cuenta o usar Boricua Experience aceptas estos términos. Léelos con calma; están escritos para entenderse."),
  ("legal.terms.eligibility.title", "Solo mayores de 18 años"),
  ("legal.terms.eligibility.body", "Boricua Experience es solo para personas de 18 años o más. Al registrarte confirmas que cumples esa edad. Si sabemos que una cuenta pertenece a un menor, la cerraremos y borraremos sus datos.\n\nMadres, padres y tutores son responsables de supervisar el uso de internet de los menores a su cargo."),
  ("legal.terms.accounts.title", "Tu cuenta"),
  ("legal.terms.accounts.body", "Puedes entrar con tu correo y contraseña o con Google. Eres responsable de lo que ocurra con tu cuenta y de mantener tu contraseña segura. Puedes pausar o eliminar tu cuenta cuando quieras desde la configuración."),
  ("legal.terms.events.title", "Publicar actividades"),
  ("legal.terms.events.body", "Quien organiza decide si su actividad es pública, solo con enlace o privada; si requiere aprobación; su capacidad, precio, fecha y lugar. La información que publiques debe ser cierta y estar al día.\n\nNo se permiten actividades dirigidas principalmente a menores. Si tu actividad incluye menores, eres responsable de cumplir con todas las leyes aplicables.\n\nCualquier pago se acuerda directamente entre organizador y asistentes; Boricua Experience no procesa pagos ni garantiza reembolsos."),
  ("legal.terms.joining.title", "Unirse a actividades"),
  ("legal.terms.joining.body", "Al pedir unirte, el organizador verá tu nombre, tu pueblo y el mensaje que envíes. Si te aprueba, verás la dirección exacta y las instrucciones. Respeta las reglas del organizador y del lugar."),
  ("legal.terms.conduct.title", "Convivencia"),
  ("legal.terms.conduct.body", "No publiques contenido falso, engañoso, ofensivo, discriminatorio o ilegal; no acoses a otras personas; no uses la plataforma para spam, fraude ni publicidad no solicitada. Podemos retirar contenido o suspender cuentas que incumplan estas reglas."),
  ("legal.terms.safety.title", "Tu seguridad"),
  ("legal.terms.safety.body", "Las actividades las organizan personas de la comunidad, no Boricua Experience. Usa tu juicio, reúnete en lugares seguros y avisa a alguien de tus planes. Puedes reportar cualquier actividad desde su página."),
  ("legal.terms.minors.title", "Menores de edad"),
  ("legal.terms.minors.body", "La plataforma no está diseñada para menores ni contiene funciones dirigidas a ellos. Reporta cualquier actividad dirigida a menores con el motivo correspondiente."),
  ("legal.terms.content.title", "Tu contenido"),
  ("legal.terms.content.body", "Conservas los derechos sobre lo que publicas. Nos das permiso para mostrarlo dentro de la plataforma y en buscadores mientras tu actividad sea pública. Las reseñas o registros necesarios para la integridad de la plataforma pueden conservarse de forma anónima."),
  ("legal.terms.liability.title", "Responsabilidad"),
  ("legal.terms.liability.body", "Ofrecemos la plataforma tal como está. En la medida que la ley lo permite, no somos responsables por lo que ocurra en actividades organizadas por terceros, ni por pérdidas indirectas derivadas del uso del servicio."),
  ("legal.terms.termination.title", "Suspensión y cierre"),
  ("legal.terms.termination.body", "Puedes eliminar tu cuenta en cualquier momento. Podemos suspender o cerrar cuentas que pongan en riesgo a otras personas o incumplan estos términos."),
  ("legal.terms.changes.title", "Cambios"),
  ("legal.terms.changes.body", "Si cambiamos estos términos de forma importante, te pediremos aceptarlos de nuevo al entrar."),
  ("legal.terms.contact.title", "Contacto y ley aplicable"),
  ("legal.terms.contact.body", "Estos términos se rigen por las leyes de Puerto Rico y de los Estados Unidos. Escríbenos al correo indicado arriba para cualquier pregunta."),
  ("legal.privacy.title", "Política de privacidad"),
  ("legal.privacy.description", "Qué datos guardamos, para qué, cuánto tiempo, y cómo ejercer tus derechos de acceso, corrección, portabilidad, oposición y eliminación."),
  ("legal.privacy.intro", "Tu privacidad no es negociable. Guardamos lo mínimo para que la app funcione y tú controlas tu ubicación."),
  ("legal.privacy.collect.title", "Qué datos guardamos"),
  ("legal.privacy.collect.body", "Cuenta: nombre, correo, idioma y, si entras con Google, el identificador de tu cuenta de Google.\n\nPerfil opcional: biografía y pueblo.\n\nActividad: lo que publicas, tus solicitudes, guardados, me gusta y reportes.\n\nConsentimientos: cuándo aceptaste los términos, la privacidad, la edad y tus preferencias de cookies.\n\nUbicación: solo si activas la ubicación en vivo."),
  ("legal.privacy.use.title", "Para qué los usamos"),
  ("legal.privacy.use.body", "Para mostrarte actividades, conectar a organizadores con asistentes, enviarte notificaciones que tú eliges, recomendarte actividades según lo que te gusta, mantener la plataforma segura y cumplir con la ley. No vendemos tus datos."),
  ("legal.privacy.location.title", "Tu ubicación"),
  ("legal.privacy.location.body", "La ubicación en vivo está apagada hasta que la activas, y se apaga con un toque. Nunca es pública. Tú eliges si la ves solo tú o también las personas aprobadas en tus mismas actividades, cerca de la hora del evento.\n\nMientras la compartes guardamos un historial por 30 días. Puedes borrarlo cuando quieras desde tu cuenta."),
  ("legal.privacy.sharing.title", "Con quién compartimos"),
  ("legal.privacy.sharing.body", "Con los organizadores de las actividades a las que pides unirte (tu nombre, pueblo y mensaje) y con proveedores que alojan nuestra base de datos y el sitio, bajo acuerdos de confidencialidad. Compartiremos información con autoridades solo cuando la ley lo exija."),
  ("legal.privacy.retention.title", "Cuánto tiempo"),
  ("legal.privacy.retention.body", "Tus datos de cuenta, mientras tengas cuenta. El historial de ubicación, 30 días. Los registros de seguridad, consentimientos y solicitudes de datos, el tiempo que exija la ley; después se borran o anonimizan."),
  ("legal.privacy.rights.title", "Tus derechos"),
  ("legal.privacy.rights.body", "Puedes acceder a tus datos y descargarlos en un archivo, corregirlos desde tu cuenta, oponerte a usos como el marketing, pausar tu cuenta o eliminarla. Registramos cada solicitud para poder demostrar que la atendimos."),
  ("legal.privacy.deletion.title", "Cuando eliminas tu cuenta"),
  ("legal.privacy.deletion.body", "Borramos de inmediato tu perfil, tu ubicación y su historial, tus preferencias y notificaciones. Cancelamos tus actividades futuras y avisamos a sus asistentes. Las actividades pasadas se muestran como de un usuario eliminado. Conservamos de forma desvinculada solo los registros que la ley exige."),
  ("legal.privacy.cookies.title", "Cookies"),
  ("legal.privacy.cookies.body", "Usamos cookies necesarias para mantener tu sesión, tu idioma y tu elección de cookies. Las cookies opcionales solo se usan con tu permiso. Lee la política de cookies para más detalles."),
  ("legal.privacy.security.title", "Seguridad"),
  ("legal.privacy.security.body", "Las conexiones van cifradas, tu sesión se guarda en una cookie sellada que ningún script puede leer, y cada dato se protege en la base de datos para que solo tú o quien tú autorices pueda verlo."),
  ("legal.privacy.minors.title", "Menores"),
  ("legal.privacy.minors.body", "No recopilamos datos de menores de 18 años a sabiendas. Si detectamos una cuenta de un menor, la eliminamos junto con sus datos."),
  ("legal.privacy.contact.title", "Contacto"),
  ("legal.privacy.contact.body", "Para cualquier solicitud sobre tus datos, escríbenos al correo indicado arriba."),
  ("legal.cookies.title", "Política de cookies"),
  ("legal.cookies.description", "Qué cookies usamos, para qué, y cómo cambiar tu elección."),
  ("legal.cookies.intro", "Ninguna cookie opcional se usa antes de que elijas."),
  ("legal.cookies.what.title", "Qué son"),
  ("legal.cookies.what.body", "Pequeños archivos que el navegador guarda para recordar información entre visitas."),
  ("legal.cookies.necessary.title", "Necesarias"),
  ("legal.cookies.necessary.body", "Mantienen tu sesión segura, recuerdan tu idioma y tu elección de cookies, y protegen los formularios. Sin ellas la app no funciona, por eso siempre están activas."),
  ("legal.cookies.analytics.title", "Análisis"),
  ("legal.cookies.analytics.body", "Nos ayudarían a entender cómo se usa la app de forma agregada. Hoy no usamos ninguna; si las añadimos, solo funcionarán con tu permiso."),
  ("legal.cookies.marketing.title", "Marketing"),
  ("legal.cookies.marketing.body", "Servirían para medir campañas. Hoy no usamos ninguna; si las añadimos, solo funcionarán con tu permiso."),
  ("legal.cookies.choices.title", "Tu elección"),
  ("legal.cookies.choices.body", "Puedes cambiar tu elección cuando quieras con el botón de abajo. Guardamos un registro de cada elección."),
  ("about.title", "Sobre Boricua Experience"),
  ("about.description", "Una plataforma para descubrir, unirse y crear actividades en Puerto Rico, hecha con la privacidad como base."),
  ("about.intro", "Creemos que lo mejor de Puerto Rico pasa cuando la gente se junta."),
  ("about.mission.title", "Nuestra misión"),
  ("about.mission.body", "Que encontrar algo que hacer sea tan fácil como buscarlo, y que organizar algo propio sea tan fácil como publicarlo: cultura, música, deportes, talleres, playa, comunidad, cumpleaños y causas cívicas."),
  ("about.how.title", "Cómo funciona"),
  ("about.how.body", "Busca o explora el mapa. Pide unirte y el organizador aprueba quién va. Cuando te aprueban, recibes la dirección exacta y las instrucciones."),
  ("about.safety.title", "Seguridad primero"),
  ("about.safety.body", "Solo para mayores de 18 años, con reportes y moderación, y con direcciones protegidas hasta la aprobación."),
  ("about.privacy.title", "Privacidad por diseño"),
  ("about.privacy.body", "Tu ubicación es tuya: apagada por defecto, nunca pública, y con historial que puedes borrar. Puedes descargar o eliminar tus datos cuando quieras.")
])
