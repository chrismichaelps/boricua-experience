/** @App.Messages.Vocabulary — every request the application answers */
module App.Messages

import Std.Json as Json
import Domain.Achievement as Achievement
import Domain.Assistant as Conversation
import Domain.Catalog as Catalog
import Domain.Consent as Consent
import Domain.Credentials as Credentials
import Domain.Draft as Draft
import Domain.Event as Event
import Domain.Index as Index
import Domain.Location as Location
import Domain.Media as Media
import Domain.Menu as Menu
import Domain.MenuDraft as MenuDraft
import Domain.Notification as Notification
import Domain.Place as Listing
import Domain.Problem as Problem
import Domain.Profile as Profile
import Domain.Review as Review
import Domain.Search as Search
import Domain.Session as Session
import PuduLangMediator.Request as Request
import Services.Admin as AdminService
import Services.Auth.Accounts as Accounts
import Services.Contact as ContactService
import Services.Discovery as Discovery
import Services.Participation as Participation
import Validation.Participation as ParticipationRules

/** @App.Messages.Visit — a request a guest or a member may send */
export type Visit[T] = { session: Option[Session.Session], input: T }

/** @App.Messages.Signed — a request only a member may send */
export type Signed[T] = { session: Session.Session, input: T }

/** @App.Messages.Place — an optional position and radius */
export type Place = { lat: Option[Float64], lng: Option[Float64], radiusM: Option[Int] }

/** @App.Messages.Decision — an organizer's answer to one request */
export type Decision = { requestId: Str, approve: Bool, note: Str }

/** @App.Messages.Edit — changes to one event */
export type Edit = { eventId: Str, draft: Draft.Draft }

/** @App.Messages.PlaceEdit — changes to one place */
export type PlaceEdit = { placeId: Str, draft: Listing.Draft }

/** @App.Messages.PlaceStatus — publishing or hiding one place */
export type PlaceStatus = { placeId: Str, visible: Bool }

/** @App.Messages.ReviewRead — a page of a place's reviews */
export type ReviewRead = { placeId: Str, after: Str }

/** @App.Messages.MediaStart — an owner's declared upload for one place */
export type MediaStart = { placeId: Str, request: Media.UploadRequest }

/** @App.Messages.MediaFinish — an upload the browser reports as sent, to be verified */
export type MediaFinish = { placeId: Str, mediaId: Str }

/** @App.Messages.EventCoverStart — an organizer's declared cover for one activity */
export type EventCoverStart = { eventId: Str, request: Media.UploadRequest }

/** @App.Messages.EventCoverFinish — a sent activity cover to be verified */
export type EventCoverFinish = { eventId: Str, mediaId: Str }

/** @App.Messages.MenuSaving — an owner's complete menu, conditional on the revision it was read at */
export type MenuSaving = { placeId: Str, editing: MenuDraft.MenuEditing }

/** @App.Messages.ReviewSaving — the member's review of one place */
export type ReviewSaving = { placeId: Str, draft: Review.ReviewDraft }

/** @App.Messages.ReviewAnswer — the owner's answer to one review */
export type ReviewAnswer = { reviewId: Str, response: Str }

/** @App.Messages.ReviewReporting — a report about one review */
export type ReviewReporting = { reviewId: Str, reason: Str, detail: Str }

/** @App.Messages.ReviewDecision — an administrator's decision on one review */
export type ReviewDecision = { reviewId: Str, keep: Bool }

/** @App.Messages.Joining — a join request with its message */
export type Joining = { eventId: Str, message: Str, channel: Str }

/** @App.Messages.Reacting — a reaction to an event */
export type Reacting = { eventId: Str, value: Int }

/** @App.Messages.Reporting — a report about an event */
export type Reporting = { eventId: Str, form: ParticipationRules.Report }

/** @App.Messages.SignUp — a sign-up with the visitor's language and where to return */
export type SignUp = { form: Credentials.SignUp, locale: Str, returnTo: Str }

/** @App.Messages.Provider — a provider sign-in and where to return */
export type Provider = { provider: Str, returnTo: Str }

/** @App.Messages.Callback — a redirect's code and the flow that started it */
export type Callback = { code: Str, flow: Session.Flow }

/** @App.Messages.Onboard — the confirmations an account owes and its language */
export type Onboard = { form: Credentials.Onboarding, locale: Str }

/** @App.Messages.CookieChoice — a cookie choice and who made it */
export type CookieChoice = { subject: Str, choice: Consent.Choice }

/** @App.Messages.Resolution — an administrator's decision on a report */
export type Resolution = { reportId: Int, action: Str }

/** @App.Messages.Kinds — every kind of request, made once and shared by the mediator and the routes */
export type Kinds = {
  assistant: Request.Kind[Signed[(Conversation.Input, Str)], Json.Json, Problem.Problem],
  assistantTool: Request.Kind[Signed[Conversation.Tool], Json.Json, Problem.Problem],
  home: Request.Kind[Visit[Place], Discovery.Home, Problem.Problem],
  search: Request.Kind[Visit[Search.Filters], Event.Page, Problem.Problem],
  suggest: Request.Kind[Str, Array[Event.Card], Problem.Problem],
  pins: Request.Kind[Search.Filters, Search.Pins, Problem.Problem],
  catalog: Request.Kind[(), Catalog.Catalog, Problem.Problem],
  event: Request.Kind[Visit[Str], Event.Detail, Problem.Problem],
  eventPage: Request.Kind[Visit[(Str, Str)], Event.Detail, Problem.Problem],
  attendees: Request.Kind[Visit[Str], Event.Attendees, Problem.Problem],
  publish: Request.Kind[Signed[Draft.Draft], Draft.Published, Problem.Problem],
  editable: Request.Kind[Signed[Str], (Event.Detail, Draft.Draft), Problem.Problem],
  update: Request.Kind[Signed[Edit], Draft.Published, Problem.Problem],
  cancel: Request.Kind[Signed[Str], (), Problem.Problem],
  place: Request.Kind[Visit[Str], Listing.Detail, Problem.Problem],
  placesListed: Request.Kind[(Str, Str), Array[Listing.Listing], Problem.Problem],
  publishPlace: Request.Kind[Signed[Listing.Draft], Listing.Published, Problem.Problem],
  editablePlace: Request.Kind[Signed[Str], (Listing.Detail, Listing.Draft), Problem.Problem],
  updatePlace: Request.Kind[Signed[PlaceEdit], Listing.Published, Problem.Problem],
  placeStatus: Request.Kind[Signed[PlaceStatus], (), Problem.Problem],
  myPlaces: Request.Kind[Signed[()], Array[Listing.Listing], Problem.Problem],
  menuBoard: Request.Kind[Visit[Str], Menu.MenuBoard, Problem.Problem],
  saveMenu: Request.Kind[Signed[MenuSaving], Menu.MenuListing, Problem.Problem],
  placeMedia: Request.Kind[Visit[Str], Media.Gallery, Problem.Problem],
  startMedia: Request.Kind[Signed[MediaStart], Media.UploadTicket, Problem.Problem],
  finishMedia: Request.Kind[Signed[MediaFinish], (), Problem.Problem],
  removeMedia: Request.Kind[Signed[Str], (), Problem.Problem],
  eventCover: Request.Kind[Signed[Str], Array[Media.MediaFile], Problem.Problem],
  startEventCover: Request.Kind[Signed[EventCoverStart], Media.UploadTicket, Problem.Problem],
  finishEventCover: Request.Kind[Signed[EventCoverFinish], (), Problem.Problem],
  removeEventCover: Request.Kind[Signed[EventCoverFinish], (), Problem.Problem],
  reviews: Request.Kind[Visit[ReviewRead], Review.ReviewBoard, Problem.Problem],
  saveReview: Request.Kind[Signed[ReviewSaving], (), Problem.Problem],
  deleteReview: Request.Kind[Signed[Str], (), Problem.Problem],
  respondReview: Request.Kind[Signed[ReviewAnswer], (), Problem.Problem],
  reportReview: Request.Kind[Signed[ReviewReporting], (), Problem.Problem],
  resolveReview: Request.Kind[Signed[ReviewDecision], (), Problem.Problem],
  join: Request.Kind[Signed[Joining], Str, Problem.Problem],
  withdraw: Request.Kind[Signed[Str], (), Problem.Problem],
  decide: Request.Kind[Signed[Decision], Str, Problem.Problem],
  queue: Request.Kind[Signed[Str], Participation.Queue, Problem.Problem],
  save: Request.Kind[Signed[Str], Bool, Problem.Problem],
  approveAll: Request.Kind[Signed[Str], Int, Problem.Problem],
  calendarFeed: Request.Kind[(Str, Str), Array[Event.CalendarEntry], Problem.Problem],
  saveSearch: Request.Kind[Signed[Search.Saving], (), Problem.Problem],
  deleteSearch: Request.Kind[Signed[Str], (), Problem.Problem],
  react: Request.Kind[Signed[Reacting], Participation.ReactionState, Problem.Problem],
  report: Request.Kind[Signed[Reporting], (), Problem.Problem],
  activity: Request.Kind[Signed[()], Participation.Activity, Problem.Problem],
  recordPosition: Request.Kind[Signed[Location.Position], Str, Problem.Problem],
  stopSharing: Request.Kind[Signed[()], (), Problem.Problem],
  eraseLocation: Request.Kind[Signed[()], (), Problem.Problem],
  participants: Request.Kind[Signed[Str], Array[Location.Participant], Problem.Problem],
  me: Request.Kind[Signed[()], Profile.MyProfile, Problem.Problem],
  profile: Request.Kind[Str, Profile.PublicProfile, Problem.Problem],
  onboard: Request.Kind[Signed[Onboard], (), Problem.Problem],
  renewConsent: Request.Kind[Signed[Credentials.Renewal], (), Problem.Problem],
  updateProfile: Request.Kind[Signed[Profile.ProfileEdit], (), Problem.Problem],
  updatePreferences: Request.Kind[Signed[Profile.Preferences], (), Problem.Problem],
  updateDiscovery: Request.Kind[Signed[Profile.Discovery], (), Problem.Problem],
  changeAvatar: Request.Kind[Signed[Str], Str, Problem.Problem],
  removeAvatar: Request.Kind[Signed[()], (), Problem.Problem],
  notifications: Request.Kind[Signed[()], Array[Notification.Notification], Problem.Problem],
  cookies: Request.Kind[Visit[CookieChoice], (), Problem.Problem],
  exportData: Request.Kind[Signed[()], Str, Problem.Problem],
  pause: Request.Kind[Signed[()], (), Problem.Problem],
  reactivate: Request.Kind[Signed[()], (), Problem.Problem],
  deleteAccount: Request.Kind[Signed[Str], (), Problem.Problem],
  refuseMinor: Request.Kind[Signed[()], (), Problem.Problem],
  signIn: Request.Kind[Credentials.SignIn, Session.Session, Problem.Problem],
  signUp: Request.Kind[SignUp, Accounts.Joined, Problem.Problem],
  provider: Request.Kind[Provider, (Str, Session.Flow), Problem.Problem],
  callback: Request.Kind[Callback, Session.Session, Problem.Problem],
  recover: Request.Kind[Str, Session.Flow, Problem.Problem],
  changePassword: Request.Kind[Signed[Credentials.NewPassword], (), Problem.Problem],
  signOut: Request.Kind[Signed[()], (), Problem.Problem],
  sitemap: Request.Kind[(), Array[Index.Entry], Problem.Problem],
  dashboard: Request.Kind[Signed[()], AdminService.Dashboard, Problem.Problem],
  resolve: Request.Kind[Signed[Resolution], (), Problem.Problem],
  contact: Request.Kind[ContactService.Sending, ContactService.Outcome, Problem.Problem],
  achievements: Request.Kind[Signed[Str], Achievement.Board, Problem.Problem],
  achievementSignals: Request.Kind[Signed[(Array[Achievement.Signal], Str)], Array[Achievement.Unlocked], Problem.Problem],
  showcase: Request.Kind[(Str, Str), Achievement.Showcase, Problem.Problem]
}

/// Tags grouping kinds for behaviors: pages read, commands change state.
export const READ: Str = "read"
export const COMMAND: Str = "command"
export const IDENTITY: Str = "identity"

/// A kind with its name and tag.
fn kind[Q, R](name: Str, tag: Str) -> Request.Kind[Q, R, Problem.Problem] { Request.tagged(&Request.kind(name), [tag]) }

/// Every kind, made once.
export fn kinds() -> Kinds {
  Kinds {
    assistant: kind("assistant.prepare", READ),
    assistantTool: kind("assistant.tool", READ),
    home: kind("discover.home", READ),
    search: kind("discover.search", READ),
    suggest: kind("discover.suggest", READ),
    pins: kind("discover.pins", READ),
    catalog: kind("discover.catalog", READ),
    event: kind("events.detail", READ),
    eventPage: kind("events.page", READ),
    attendees: kind("events.attendees", READ),
    publish: kind("events.publish", COMMAND),
    editable: kind("events.editable", READ),
    update: kind("events.update", COMMAND),
    cancel: kind("events.cancel", COMMAND),
    place: kind("places.detail", READ),
    placesListed: kind("places.listed", READ),
    publishPlace: kind("places.publish", COMMAND),
    editablePlace: kind("places.editable", READ),
    updatePlace: kind("places.update", COMMAND),
    placeStatus: kind("places.status", COMMAND),
    myPlaces: kind("places.mine", READ),
    menuBoard: kind("menus.board", READ),
    saveMenu: kind("menus.save", COMMAND),
    placeMedia: kind("media.gallery", READ),
    startMedia: kind("media.start", COMMAND),
    finishMedia: kind("media.finish", COMMAND),
    removeMedia: kind("media.remove", COMMAND),
    eventCover: kind("media.event_cover", READ),
    startEventCover: kind("media.event_cover_start", COMMAND),
    finishEventCover: kind("media.event_cover_finish", COMMAND),
    removeEventCover: kind("media.event_cover_remove", COMMAND),
    reviews: kind("reviews.board", READ),
    saveReview: kind("reviews.save", COMMAND),
    deleteReview: kind("reviews.delete", COMMAND),
    respondReview: kind("reviews.respond", COMMAND),
    reportReview: kind("reviews.report", COMMAND),
    resolveReview: kind("reviews.resolve", COMMAND),
    join: kind("participation.join", COMMAND),
    withdraw: kind("participation.withdraw", COMMAND),
    decide: kind("participation.decide", COMMAND),
    queue: kind("participation.queue", READ),
    save: kind("participation.save", COMMAND),
    approveAll: kind("participation.approve_all", COMMAND),
    calendarFeed: kind("participation.calendar_feed", READ),
    saveSearch: kind("participation.save_search", COMMAND),
    deleteSearch: kind("participation.delete_search", COMMAND),
    react: kind("participation.react", COMMAND),
    report: kind("participation.report", COMMAND),
    activity: kind("participation.activity", READ),
    recordPosition: kind("location.record", COMMAND),
    stopSharing: kind("location.stop", COMMAND),
    eraseLocation: kind("location.erase", COMMAND),
    participants: kind("location.participants", READ),
    me: kind("account.me", READ),
    profile: kind("account.profile", READ),
    onboard: kind("account.onboard", COMMAND),
    renewConsent: kind("account.renew_consent", COMMAND),
    updateProfile: kind("account.update_profile", COMMAND),
    updatePreferences: kind("account.update_preferences", COMMAND),
    updateDiscovery: kind("account.update_discovery", COMMAND),
    changeAvatar: kind("account.change_avatar", COMMAND),
    removeAvatar: kind("account.remove_avatar", COMMAND),
    notifications: kind("account.notifications", COMMAND),
    cookies: kind("privacy.cookies", COMMAND),
    exportData: kind("privacy.export", COMMAND),
    pause: kind("privacy.pause", COMMAND),
    reactivate: kind("privacy.reactivate", COMMAND),
    deleteAccount: kind("privacy.delete", COMMAND),
    refuseMinor: kind("privacy.refuse_minor", COMMAND),
    signIn: kind("identity.sign_in", IDENTITY),
    signUp: kind("identity.sign_up", IDENTITY),
    provider: kind("identity.provider", IDENTITY),
    callback: kind("identity.callback", IDENTITY),
    recover: kind("identity.recover", IDENTITY),
    changePassword: kind("identity.change_password", IDENTITY),
    signOut: kind("identity.sign_out", IDENTITY),
    sitemap: kind("seo.sitemap", READ),
    dashboard: kind("admin.dashboard", READ),
    resolve: kind("admin.resolve", COMMAND),
    contact: kind("site.contact", COMMAND),
    achievements: kind("achievements.board", READ),
    achievementSignals: kind("achievements.signals", COMMAND),
    showcase: kind("achievements.showcase", READ)
  }
