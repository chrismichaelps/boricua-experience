/** @App.Handlers.Privacy.Registrations — consent, export, pause, deletion */
module App.Handlers.Privacy

import PuduLangMediator as Messaging
import PuduLangMediator.Context as Context
import PuduLangMediator.Registration as Registration
import App.Messages as Messages
import Services.Privacy as Privacy
import Services.Runtime as Runtime

/// The handlers of privacy rights.
export fn registrations(kinds: &Messages.Kinds, runtime: &Runtime.Runtime) -> Array[Registration.Registration] {
  let held = *runtime
  [
    Registration.handler(&kinds.cookies, |asked: Messages.Visit[Messages.CookieChoice], _context: Context.Context| Messaging.lift(Privacy.recordCookies(&held, asked.input.subject, &asked.input.choice, &asked.session))),
    Registration.handler(&kinds.exportData, |asked: Messages.Signed[()], _context: Context.Context| Messaging.lift(Privacy.exportData(&held, &asked.session))),
    Registration.handler(&kinds.pause, |asked: Messages.Signed[()], _context: Context.Context| Messaging.lift(Privacy.pause(&held, &asked.session))),
    Registration.handler(&kinds.deleteAccount, |asked: Messages.Signed[Str], _context: Context.Context| Messaging.lift(Privacy.delete(&held, &asked.session, asked.input)))
  ]
}
