/** @App.Handlers.Places.Registrations — place pages, listings, and publishing */
module App.Handlers.Places

import App.Messages as Messages
import Domain.Place as Place
import PuduLangMediator.Context as Context
import PuduLangMediator as Messaging
import PuduLangMediator.Registration as Registration
import Services.Media as Media
import Services.Menus as Menus
import Services.Places as Places
import Services.Reviews as Reviews
import Services.Runtime as Runtime

/// The handlers of places.
export fn registrations(kinds: &Messages.Kinds, runtime: &Runtime.Runtime) -> Array[Registration.Registration] {
  let held = *runtime
  [
    Registration.handler(&kinds.place, |asked: Messages.Visit[Str], _context: Context.Context| Messaging.lift(Places.detail(&held, asked.input, asked.session))),
    Registration.handler(&kinds.placesListed, |asked: (Str, Str), _context: Context.Context| Messaging.lift(Places.listed(&held, asked[0], asked[1]))),
    Registration.handler(&kinds.publishPlace, |asked: Messages.Signed[Place.Draft], _context: Context.Context| Messaging.lift(Places.publish(&held, &asked.input, &asked.session))),
    Registration.handler(&kinds.editablePlace, |asked: Messages.Signed[Str], _context: Context.Context| Messaging.lift(Places.editable(&held, asked.input, &asked.session))),
    Registration.handler(&kinds.updatePlace, |asked: Messages.Signed[Messages.PlaceEdit], _context: Context.Context| Messaging.lift(Places.update(&held, asked.input.placeId, &asked.input.draft, &asked.session))),
    Registration.handler(&kinds.placeStatus, |asked: Messages.Signed[Messages.PlaceStatus], _context: Context.Context| Messaging.lift(Places.setStatus(&held, asked.input.placeId, asked.input.visible, &asked.session))),
    Registration.handler(&kinds.myPlaces, |asked: Messages.Signed[()], _context: Context.Context| Messaging.lift(Places.mine(&held, &asked.session))),
    Registration.handler(&kinds.menuBoard, |asked: Messages.Visit[Str], _context: Context.Context| Messaging.lift(Menus.board(&held, asked.input, asked.session))),
    Registration.handler(&kinds.saveMenu, |asked: Messages.Signed[Messages.MenuSaving], _context: Context.Context| Messaging.lift(Menus.save(&held, asked.input.placeId, &asked.input.editing.draft, asked.input.editing.revision, asked.input.editing.menuId, &asked.session))),
    Registration.handler(&kinds.placeMedia, |asked: Messages.Visit[Str], _context: Context.Context| Messaging.lift(Media.gallery(&held, asked.input, asked.session))),
    Registration.handler(&kinds.startMedia, |asked: Messages.Signed[Messages.MediaStart], _context: Context.Context| Messaging.lift(Media.start(&held, asked.input.placeId, &asked.input.request, &asked.session))),
    Registration.handler(&kinds.finishMedia, |asked: Messages.Signed[Messages.MediaFinish], _context: Context.Context| Messaging.lift(Media.finish(&held, asked.input.placeId, asked.input.mediaId, &asked.session))),
    Registration.handler(&kinds.removeMedia, |asked: Messages.Signed[Str], _context: Context.Context| Messaging.lift(Media.remove(&held, asked.input, &asked.session))),
    Registration.handler(&kinds.reviews, |asked: Messages.Visit[Messages.ReviewRead], _context: Context.Context| Messaging.lift(Reviews.board(&held, asked.input.placeId, asked.input.after, asked.session))),
    Registration.handler(&kinds.saveReview, |asked: Messages.Signed[Messages.ReviewSaving], _context: Context.Context| Messaging.lift(Reviews.save(&held, asked.input.placeId, &asked.input.draft, &asked.session))),
    Registration.handler(&kinds.deleteReview, |asked: Messages.Signed[Str], _context: Context.Context| Messaging.lift(Reviews.delete(&held, asked.input, &asked.session))),
    Registration.handler(&kinds.respondReview, |asked: Messages.Signed[Messages.ReviewAnswer], _context: Context.Context| Messaging.lift(Reviews.respond(&held, asked.input.reviewId, asked.input.response, &asked.session))),
    Registration.handler(&kinds.reportReview, |asked: Messages.Signed[Messages.ReviewReporting], _context: Context.Context| Messaging.lift(Reviews.report(&held, asked.input.reviewId, asked.input.reason, asked.input.detail, &asked.session))),
    Registration.handler(&kinds.resolveReview, |asked: Messages.Signed[Messages.ReviewDecision], _context: Context.Context| Messaging.lift(Reviews.resolve(&held, asked.input.reviewId, asked.input.keep, &asked.session)))
  ]
}
