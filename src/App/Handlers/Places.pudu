/** @App.Handlers.Places.Registrations — place pages, listings, and publishing */
module App.Handlers.Places

import App.Messages as Messages
import Domain.Place as Place
import PuduLangMediator.Context as Context
import PuduLangMediator as Messaging
import PuduLangMediator.Registration as Registration
import Services.Places as Places
import Services.Runtime as Runtime

/// The handlers of places.
export fn registrations(kinds: &Messages.Kinds, runtime: &Runtime.Runtime) -> Array[Registration.Registration] {
  let held = *runtime
  [
    Registration.handler(&kinds.place, |asked: Messages.Visit[Str], _context: Context.Context| Messaging.lift(Places.detail(&held, asked.input, asked.session))),
    Registration.handler(&kinds.placesListed, |asked: (Str, Str), _context: Context.Context| Messaging.lift(Places.listed(&held, asked[0], asked[1]))),
    Registration.handler(&kinds.publishPlace, |asked: Messages.Signed[Place.Draft], _context: Context.Context| Messaging.lift(Places.publish(&held, &asked.input, &asked.session))),
    Registration.handler(&kinds.editablePlace, |asked: Messages.Signed[Str], _context: Context.Context| Messaging.lift(Places.editable(&held, asked.input, &asked.session))),
    Registration.handler(&kinds.updatePlace, |asked: Messages.Signed[Messages.PlaceEdit], _context: Context.Context| Messaging.lift(Places.update(&held, asked.input.placeId, &asked.input.draft, &asked.session))),
    Registration.handler(&kinds.placeStatus, |asked: Messages.Signed[Messages.PlaceStatus], _context: Context.Context| Messaging.lift(Places.setStatus(&held, asked.input.placeId, asked.input.visible, &asked.session))),
    Registration.handler(&kinds.myPlaces, |asked: Messages.Signed[()], _context: Context.Context| Messaging.lift(Places.mine(&held, &asked.session)))
  ]
}
