/** @Domain.Profile.Accounts — a member's own account and others' public profiles */
module Domain.Profile

import Std.Json as Json
import Domain.Event as Event

/** @Domain.Profile.MyProfile — the signed-in account with preferences and counts */
export type MyProfile = {
  id: Str,
  @json("display_name") displayName: Str,
  bio: Str,
  @json("avatar_url") avatarUrl: Option[Str],
  @json("home_municipality") homeMunicipality: Option[Str],
  @json("preferred_locale") preferredLocale: Str,
  status: Str,
  @json("is_admin") isAdmin: Bool,
  onboarded: Bool,
  @json("location_visibility") locationVisibility: Str,
  @default("true") @json("show_in_attendee_lists") showInAttendeeLists: Bool,
  @json("notify_request_updates") notifyRequestUpdates: Bool,
  @json("notify_new_requests") notifyNewRequests: Bool,
  @json("notify_reminders") notifyReminders: Bool,
  @json("notify_event_changes") notifyEventChanges: Bool,
  @json("marketing_opt_in") marketingOptIn: Bool,
  @json("sharing_live") sharingLive: Bool,
  @json("unread_notifications") unreadNotifications: Int,
  @json("created_at") createdAt: Str
} derives Json.Decode

/** @Domain.Profile.PublicProfile — an organizer as anyone may see them */
export type PublicProfile = {
  id: Str,
  @default("false") @json("is_admin") isAdmin: Bool,
  @json("display_name") displayName: Str,
  bio: Str,
  @json("avatar_url") avatarUrl: Option[Str],
  municipality: Option[Str],
  @json("member_since") memberSince: Str,
  @json("hosted_count") hostedCount: Int,
  @json("upcoming_count") upcomingCount: Int,
  @json("guests_hosted") guestsHosted: Int,
  @json("likes_received") likesReceived: Int,
  upcoming: Array[Event.Card]
} derives Json.Decode

/** @Domain.Profile.ProfileEdit — the fields a member changes on their profile */
export type ProfileEdit = { displayName: Str, bio: Str, homeMunicipality: Str, locale: Str }

/** @Domain.Profile.Preferences — the choices a member makes in settings */
export type Preferences = {
  notifyRequestUpdates: Bool,
  notifyNewRequests: Bool,
  notifyReminders: Bool,
  notifyEventChanges: Bool,
  marketingOptIn: Bool,
  locationVisibility: Str,
  showInAttendeeLists: Bool
}

/// Status of an account that may act.
export const ACTIVE: Str = "active"
/// Status of a paused account.
export const PAUSED: Str = "paused"
/// Location visibility values.
export const ONLY_ME: Str = "only_me"
export const APPROVED_ACTIVITIES: Str = "approved_activities"
