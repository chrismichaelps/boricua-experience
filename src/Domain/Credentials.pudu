/** @Domain.Credentials.Forms — what identity forms collect */
module Domain.Credentials

/** @Domain.Credentials.SignUp — a new account with its confirmations */
export type SignUp = { displayName: Str, email: Str, password: Str, confirmation: Str, birthDate: Str, terms: Bool, privacy: Bool }

/** @Domain.Credentials.SignIn — an email and password */
export type SignIn = { email: Str, password: Str }

/** @Domain.Credentials.NewPassword — a new password typed twice */
export type NewPassword = { password: Str, confirmation: Str }

/** @Domain.Credentials.Renewal — the new Terms of Use and Privacy Policy versions accepted */
export type Renewal = { terms: Bool, privacy: Bool }

/** @Domain.Credentials.Onboarding — the confirmations an account still owes */
export type Onboarding = { displayName: Str, birthDate: Str, terms: Bool, privacy: Bool }
