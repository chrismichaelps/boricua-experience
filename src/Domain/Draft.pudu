/** @Domain.Draft.EventForm — an event as an organizer writes it */
module Domain.Draft

import Std.Option as Option

import Domain.Event as Event
import Utils.Time as Time

/** @Domain.Draft.Draft — the publishing form's values, as entered */
export type Draft = {
  title: Str,
  summary: Str,
  description: Str,
  instructions: Str,
  category: Str,
  municipality: Str,
  venueName: Str,
  addressLine: Str,
  lat: Str,
  lng: Str,
  startsAt: Str,
  endsAt: Str,
  visibility: Str,
  joinPolicy: Str,
  capacity: Str,
  price: Str,
  minAge: Str,
  accessible: Bool,
  /// "yes", "no", or empty when not said.
  parking: Str,
  cashOnly: Str
}

/** @Domain.Draft.Ready — a draft validated and converted for the database */
export type Ready = {
  title: Str,
  summary: Str,
  description: Str,
  instructions: Str,
  category: Str,
  municipality: Str,
  venueName: Str,
  addressLine: Str,
  lat: Float64,
  lng: Float64,
  startsAt: Str,
  endsAt: Option[Str],
  visibility: Str,
  joinPolicy: Str,
  capacity: Option[Int],
  priceCents: Option[Int],
  minAge: Option[Int],
  accessible: Bool,
  parking: Option[Bool],
  cashOnly: Option[Bool]
}

/** @Domain.Draft.Published — the event a publish or edit produced */
export type Published = { id: Str, slug: Str }

/// An empty draft: public, approval required, price unknown.
export fn blank() -> Draft {
  Draft {
    title: "",
    summary: "",
    description: "",
    instructions: "",
    category: "",
    municipality: "",
    venueName: "",
    addressLine: "",
    lat: "",
    lng: "",
    startsAt: "",
    endsAt: "",
    visibility: "public",
    joinPolicy: "approval",
    capacity: "",
    price: "",
    minAge: "",
    accessible: false,
    parking: "",
    cashOnly: ""
  }
}

/// The draft an existing event fills the edit form with.
export fn fromDetail(detail: &Event.Detail) -> Draft {
  let card = detail.card
  Draft {
    title: card.title,
    summary: card.summary,
    description: detail.description,
    instructions: match detail.instructions {
      case Some(text) => text
      case None => ""
    },
    category: card.category.slug,
    municipality: card.municipality.slug,
    venueName: card.venueName,
    addressLine: match detail.addressLine {
      case Some(text) => text
      case None => ""
    },
    lat: show(match detail.exactLat {
        case Some(value) => value
        case None => card.lat
      }),
    lng: show(match detail.exactLng {
        case Some(value) => value
        case None => card.lng
      }),
    startsAt: localOf(card.startsAt),
    endsAt: Option.unwrapOr(Option.map(card.endsAt, |value: Str| localOf(value)), ""),
    visibility: card.visibility,
    joinPolicy: card.joinPolicy,
    capacity: match card.capacity {
      case Some(total) => show(total)
      case None => ""
    },
    minAge: Option.unwrapOr(Option.map(detail.minAge, |age: Int| show(age)), ""),
    accessible: detail.accessible,
    parking: answerOf(card.parking),
    cashOnly: answerOf(card.cashOnly),
    price: match card.priceCents {
      case Some(cents) => show(cents / 100) + "." + (if cents % 100 < 10 { "0" } else { "" }) + show(cents % 100)
      case None => ""
    }
  }
}

/// A database timestamp as a `datetime-local` value.
fn localOf(timestamp: Str) -> Str {
  match Time.parseTimestamp(timestamp) {
    case Some(instant) => Time.localInput(&instant)
    case None => ""
  }
}

/// Visibility and join-policy values.
export const VISIBILITIES: Array[Str] = ["public", "unlisted", "private"]
export const JOIN_POLICIES: Array[Str] = ["approval", "open"]

/// A yes/no fact as the form writes it: "yes", "no", or empty when not said.
export fn answerOf(fact: Option[Bool]) -> Str {
  match fact {
    case Some(true) => "yes"
    case Some(false) => "no"
    case None => ""
  }
}

/// A form answer as a fact: yes, no, or not said for anything else.
export fn factOf(answer: Str) -> Option[Bool] {
  match answer {
    case "yes" => Some(true)
    case "no" => Some(false)
    case _ => None
  }
}
