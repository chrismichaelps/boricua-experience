/** @Domain.Search.Filters — what a visitor asked a listing for */
module Domain.Search

import Std.Json as Json
import Std.Option as Option
import Domain.Catalog as Catalog
import Domain.Event as Event
import Utils.Time as Time

/** @Domain.Search.Pins — bounded camera results with explicit truncation */
export type Pins = { items: Array[Event.Card], limited: Bool } derives Json.Decode

/** @Domain.Search.Sort — the order of a listing */
export type Sort = Soon | Near | Relevant | Top

/** @Domain.Search.When — a preset or inclusive calendar range */
export type When = Anytime | Today | Tomorrow | Weekend | Week | Month | Dates(Str, Str)

/** @Domain.Search.Viewport — the camera rectangle in decimal degrees */
export type Viewport = { south: Float64, west: Float64, north: Float64, east: Float64 }

/** @Domain.Search.Filters — every filter of a listing, empty when unused */
export type Filters = {
  query: Str,
  category: Str,
  municipality: Str,
  near: Str,
  window: When,
  freeOnly: Bool,
  traits: Array[Str],
  maxPriceCents: Option[Int],
  lat: Option[Float64],
  lng: Option[Float64],
  radiusM: Option[Int],
  viewport: Option[Viewport],
  sort: Sort,
  after: Str
}

/** @Domain.Search.SavedSearch — a listing a member kept, by its canonical query string */
export type SavedSearch = { id: Str, label: Str, query: Str, @json("created_at") createdAt: Str } derives Json.Decode

/** @Domain.Search.Saving — a listing to keep under a label */
export type Saving = { label: Str, query: Str }

/// Saved searches a member may keep.
export const SAVED_SEARCHES_MAX: Int = 20

/// Filters that select every upcoming event, soonest first.
export fn everything() -> Filters {
  Filters {
    query: "",
    category: "",
    municipality: "",
    near: "",
    window: Anytime,
    freeOnly: false,
    traits: [],
    maxPriceCents: None,
    lat: None,
    lng: None,
    radiusM: None,
    viewport: None,
    sort: Soon,
    after: ""
  }
}

/// The sort's wire name.
export fn sortName(sort: &Sort) -> Str {
  match sort {
    case Soon => "soon"
    case Near => "near"
    case Relevant => "relevant"
    case Top => "top"
  }
}

/// The sort a wire name selects; soonest first for anything else.
export fn sortFrom(name: Str) -> Sort {
  if name == "near" { return Near }
  if name == "relevant" { return Relevant }
  if name == "top" { return Top }
  Soon
}

/// The window's wire name.
export fn windowName(window: &When) -> Str {
  match window {
    case Anytime => ""
    case Today => "today"
    case Tomorrow => "tomorrow"
    case Weekend => "weekend"
    case Week => "week"
    case Month => "month"
    case Dates(first, last) => first + ".." + last
  }
}

/// The window a wire name selects; any time for anything else.
export fn windowFrom(name: Str) -> When {
  let parts = name.split("..")
  if parts.length() == 2 {
    match (dateDay(parts[0]), dateDay(parts[1])) {
      case (Some(first), Some(last)) => {
        if last >= first && last - first < MAX_DATE_DAYS { return Dates(parts[0], parts[1]) }
      }
      case _ => {}
    }
    return Anytime
  }
  match name {
    case "today" => Today
    case "tomorrow" => Tomorrow
    case "weekend" => Weekend
    case "week" => Week
    case "month" => Month
    case _ => Anytime
  }
}

/// Maximum number of calendar days in an exact search range.
export const MAX_DATE_DAYS: Int = 366

/// A real ISO calendar date as its Puerto Rico day number.
export fn dateDay(written: Str) -> Option[Int] {
  if written.length() != 10 { return None }
  let parsed = Time.parseLocalInput(written + "T00:00") ?
  if Time.localInput(&parsed).take(10) != written { return None }
  Some(Time.dayNumber(&parsed))
}

/// Every preset window, in the order the filters list them.
export const WINDOWS: Array[When] = [Anytime, Today, Tomorrow, Weekend, Week, Month]

/// Whether any filter narrows the listing.
export fn isNarrowed(filters: &Filters) -> Bool {
  !filters.query.isEmpty() || !filters.category.isEmpty() || !filters.municipality.isEmpty()
    || !filters.near.isEmpty() || filters.window != Anytime || filters.freeOnly || filters.lat != None || !filters.traits.isEmpty()
}

/// Quick traits a listing may ask for: suits families, starts at night, outdoors, step-free access.
export const TRAITS: Array[Str] = ["family", "night", "outdoor", "accessible"]

/// The known traits a written list names, once each, in the order they are offered.
export fn traitsFrom(written: Str) -> Array[Str] {
  let asked = written.split(",").map(|part: Str| part.trim())
  TRAITS.filter(|name: Str| asked.contains(name))
}

/// The traits as the address writes them.
export fn traitsValue(traits: &Array[Str]) -> Str { traits.join(",") }

/// The traits with one added or removed.
export fn toggled(traits: &Array[Str], picked: Str) -> Array[Str] {
  if traits.contains(picked) { traits.filter(|kept: Str| kept != picked) } else { TRAITS.filter(|known: Str| known == picked || traits.contains(known)) }
}

/// Radii a visitor may choose around a town or a position, in kilometres.
export const RADII_KM: Array[Int] = [5, 10, 25, 50]
/// The radius used around a town chosen without one, in kilometres.
export const DEFAULT_RADIUS_KM: Int = 25

/// The radius in metres that a written number of kilometres selects, when it is one of the offered radii.
export fn radiusFrom(written: Str) -> Option[Int] {
  let km = written.trim().toInt() ?
  if RADII_KM.contains(km) { Some(km * 1000) } else { None }
}

/// The chosen radius in whole kilometres, or the default.
export fn radiusKm(filters: &Filters) -> Int {
  match filters.radiusM {
    case Some(meters) => meters / 1000
    case None => DEFAULT_RADIUS_KM
  }
}

/// The filters centred on the named town when no device position was given. A town the catalogue
/// does not know is dropped, and the listing falls back to every place.
export fn anchored(filters: &Filters, catalog: &Catalog.Catalog) -> Filters {
  if filters.near.isEmpty() || filters.lat != None { return *filters }
  match Catalog.municipality(catalog, filters.near) {
    case Some(town) => Filters{..*filters, lat: Some(town.lat), lng: Some(town.lng), radiusM: Some(Option.unwrapOr(filters.radiusM, DEFAULT_RADIUS_KM * 1000))}
    case None => Filters{..*filters, near: "", radiusM: None}
  }
}

/// The remembered nearby choice written as `town:km`, or nothing when it does not parse.
export fn rememberedNear(value: Str) -> Option[(Str, Int)] {
  let mark = value.indexOf(":")
  if mark <= 0 { return None }
  let town = value.take(mark)
  let meters = radiusFrom(value.drop(mark + 1)) ?
  if town.length() > 40 || town.chars().filter(|c: Char| !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')).length() > 0 { return None }
  Some((town, meters))
}

/// The cookie value that remembers a town and radius.
export fn nearValue(town: Str, meters: Int) -> Str { town + ":" + show(meters / 1000) }
