/** @Domain.Achievement.Board — achievements as data: the member's board, unlocks and public badges */
module Domain.Achievement

import Std.Json as Json

/** @Domain.Achievement.Group — a category of achievements; named apart from Catalog.Category, whose derived decoder the 0.1.3 compiler otherwise picks for this field */
export type Group = { slug: Str, title: Str } derives Json.Decode

/** @Domain.Achievement.Item — one achievement and the member's progress on it; a secret locked one has no title */
export type Item = {
  slug: Str,
  category: Str,
  rarity: Str,
  badge: Str,
  title: Option[Str],
  description: Option[Str],
  target: Int,
  progress: Int,
  @json("unlocked_at") unlockedAt: Option[Str],
  seasonal: Bool,
  open: Bool,
  @json("season_from") seasonFrom: Option[Str],
  @json("season_until") seasonUntil: Option[Str],
  @json("available_until") availableUntil: Option[Str]
} derives Json.Decode

/** @Domain.Achievement.Board — categories, every visible achievement, and the unlocked count */
export type Board = { categories: Array[Group], items: Array[Item], unlocked: Int, total: Int } derives Json.Decode

/** @Domain.Achievement.Unlocked — an achievement the member has just unlocked, for the toast */
export type Unlocked = {
  slug: Str,
  badge: Str,
  rarity: Str,
  title: Str,
  description: Str,
  @json("unlocked_at") unlockedAt: Str
} derives Json.Encode, Json.Decode

/** @Domain.Achievement.Unlocks — the answer to recorded signals */
export type Unlocks = { unlocked: Array[Unlocked] } derives Json.Decode

/** @Domain.Achievement.Badge — one unlocked badge on a public profile */
export type Badge = { slug: Str, badge: Str, rarity: Str, title: Str } derives Json.Decode

/** @Domain.Achievement.Showcase — a member's recent badges and their total */
export type Showcase = { total: Int, items: Array[Badge] } derives Json.Decode

/** @Domain.Achievement.Signal — one action only the browser sees */
export type Signal = { metric: Str, key: Str } derives Json.Encode, Json.Decode

/// Rarities from the most common to the rarest.
export const RARITIES: Array[Str] = ["common", "rare", "epic", "legendary"]

/// Signals one request may carry.
export const SIGNALS_MAX: Int = 20

/// Whether an achievement is unlocked.
export fn unlocked(item: &Item) -> Bool { item.unlockedAt != None }

/// Progress as a whole percentage of the target, capped at 100.
export fn percent(item: &Item) -> Int {
  if item.target <= 0 { return 0 }
  let shown = if item.progress > item.target { item.target } else { item.progress }
  shown * 100 / item.target
}

/// The badge image of an achievement under the static assets.
export fn badgePath(badge: Str) -> Str { "/assets/badges/" + badge + ".svg" }
