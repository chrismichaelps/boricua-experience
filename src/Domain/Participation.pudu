/** @Domain.Participation.Requests — join requests seen by members and organizers */
module Domain.Participation

import Std.Json as Json
import Domain.Event as Event

/** @Domain.Participation.PersonRef — a member named on a request */
export type PersonRef = { id: Str, @json("display_name") displayName: Str, @json("avatar_url") avatarUrl: Option[Str] } derives Json.Decode

/** @Domain.Participation.MyRequest — a member's own request with its event */
export type MyRequest = {
  @json("request_id") requestId: Str,
  status: Str,
  message: Str,
  @json("decision_note") decisionNote: Str,
  @json("created_at") createdAt: Str,
  event: Event.Card
} derives Json.Decode

/** @Domain.Participation.Insights — an organizer's numbers for one activity */
export type Insights = {
  approved: Int,
  pending: Int,
  waitlisted: Int,
  capacity: Option[Int],
  saves: Int,
  likes: Int,
  @json("views_7d") views7d: Int,
  @json("views_30d") views30d: Int,
  @json("requests_30d") requests30d: Int,
  conversion: Option[Float64],
  held: Bool
} derives Json.Decode

/** @Domain.Participation.Bulk — how many requests one bulk decision approved */
export type Bulk = { approved: Int } derives Json.Decode

/// Status of a member waiting for a place.
export const WAITLISTED: Str = "waitlisted"

/** @Domain.Participation.IncomingRequest — a request in an organizer's queue */
export type IncomingRequest = {
  @json("request_id") requestId: Str,
  status: Str,
  message: Str,
  @json("decision_note") decisionNote: Str,
  @json("created_at") createdAt: Str,
  requester: PersonRef
} derives Json.Decode

/** @Domain.Participation.JoinOutcome — the status a request reached */
export type JoinOutcome = { status: Str } derives Json.Decode

/** @Domain.Participation.SavedState — whether an event is saved after a toggle */
export type SavedState = { saved: Bool } derives Json.Decode

/** @Domain.Participation.ReactionState — a reaction after it changed, with the new like count */
export type ReactionState = { reaction: Int, @json("like_count") likeCount: Int } derives Json.Decode

/** @Domain.Participation.InterestState — a member's mark on an activity and its public counts */
export type InterestState = { kind: Option[Str], interested: Int, going: Int } derives Json.Decode

/// The marks a member may leave: interested, or going.
export const INTERESTED: Str = "interested"
export const GOING: Str = "going"

/// Statuses a request may hold.
export const PENDING: Str = "pending"
export const APPROVED: Str = "approved"
export const REJECTED: Str = "rejected"
export const WITHDRAWN: Str = "withdrawn"

/// Reasons a member may report an event for.
export const REPORT_REASONS: Array[Str] = ["spam", "scam", "unsafe", "minors", "offensive", "other"]
