/** @Test.Domain.Suite — decoding recorded answers and domain rules */
module Domain.DomainTest

import Std.Io as Io
import Std.Json as Json
import Std.Option as Option
import Std.Result as Result
import Std.Test as Test
import Api.Account as AccountApi
import Domain.Admin as Admin
import Domain.Catalog as Catalog
import Domain.Consent as Consent
import Domain.Draft as Draft
import Domain.Event as Event
import Domain.Locale as Locale
import Domain.Notification as Notification
import Domain.Participation as Participation
import Domain.Place as Place
import Domain.Problem as Problem
import Domain.Profile as Profile
import Domain.Search as Search
import Services.Discovery as Discovery
import Support.Fixtures as Fixtures
import Utils.Time as Time
import Utils.Wire as Wire

/// Runs the suite.
fn main() -> Int {
  let page: Result[Event.Page, Json.DecodeError] = Wire.decode(&Fixtures.json("search-page.json"))
  let member = Event.decodeDetail(&Fixtures.json("event-detail-member.json"))
  let guest = Event.decodeDetail(&Fixtures.json("event-detail-guest.json"))
  let categories: Result[Array[Catalog.Category], Json.DecodeError] = Wire.decode(&Fixtures.json("categories.json"))
  let towns: Result[Array[Catalog.Municipality], Json.DecodeError] = Wire.decode(&Fixtures.json("municipalities.json"))
  let mine: Result[Profile.MyProfile, Json.DecodeError] = Wire.decode(&Fixtures.json("my-profile.json"))
  let host: Result[Profile.PublicProfile, Json.DecodeError] = Wire.decode(&Fixtures.json("public-profile.json"))
  let requests: Result[Array[Participation.MyRequest], Json.DecodeError] = Wire.decode(&Fixtures.json("my-requests.json"))
  let queue: Result[Array[Participation.IncomingRequest], Json.DecodeError] = Wire.decode(&Fixtures.json("event-requests.json"))
  let inbox: Result[Array[Notification.Notification], Json.DecodeError] = Wire.decode(&Fixtures.json("notifications.json"))
  let organized: Result[Array[Event.Card], Json.DecodeError] = Wire.decode(&Fixtures.json("my-events.json"))
  let island = Catalog.Catalog{categories: [], municipalities: Result.unwrapOr(towns, []), scenes: []}
  let carolina = Option.unwrapOr(Catalog.municipality(&island, "carolina"), Catalog.Municipality{slug: "", name: "", region: "", lat: 0.0, lng: 0.0})
  let anchored = Search.anchored(&Search.Filters{..Search.everything(), near: "carolina"}, &island)
  let unknownTown = Search.anchored(&Search.Filters{..Search.everything(), near: "atlantis", radiusM: Some(5000)}, &island)
  let gpsFirst = Search.anchored(&Search.Filters{..Search.everything(), near: "carolina", lat: Some(18.2), lng: Some(-66.5)}, &island)
  let neighbors = Catalog.neighbors(&island, &carolina, 3).map(|found: Catalog.Neighbor| found.town.slug)
  let sample = match guest { case Ok(found) => found.card case Err(_) => panic("guest fixture") }
  let cardWith = |id: Str, engaged: Int| Event.Card{..sample, id: id, approvedCount: engaged, savedCount: 0, likeCount: 0, priceCents: Some(0), source: "curated", status: "published"}
  let a = cardWith("a", 0)
  let b = cardWith("b", 0)
  let c = cardWith("c", 0)
  let d = cardWith("d", 0)
  let busy = cardWith("busy", 9)
  let unpriced = Event.Card{..cardWith("unpriced", 0), priceCents: None}
  let arranged = Discovery.arrange(&Discovery.Raw{recommended: [a, b], weekend: [b, c], soon: [a, c, d], free: [d, a], month: [a, busy, unpriced, cardWith("quiet", 2), cardWith("silent", 0)]})
  let ids = |cards: Array[Event.Card]| cards.map(|card: Event.Card| card.id)
  let fonda = match Place.decodeDetail(&Fixtures.json("place-detail.json")) { case Ok(found) => found case Err(why) => panic("place fixture: " + Json.explainDecode(&why)) }
  let at = |weekday: Int, hour: Int, minute: Int| Place.openAt(&fonda.card.hours, &Time.Local{year: 2026, month: 10, day: 12, weekday: weekday, hour: hour, minute: minute})
  let refilled = Place.fromDetail(&fonda)
  let checks = Test.suite("Domain", &[
      Test.equals("a place answer decodes with its facts and owner relation", &(fonda.card.name, fonda.viewer.isOwner, Json.asText(&Option.unwrapOr(Json.field(&fonda.details, "cuisine"), Json.Null))), &("La Fonda", true, Some("criolla"))),
      Test.equals("open inside a range, closed outside it and on a day without hours", &(at(1, 12, 0), at(1, 22, 0), at(1, 10, 59), at(2, 12, 0)), &(Some(true), Some(false), Some(false), Some(false))),
      Test.equals("a range past midnight stays open into the next morning", &(at(5, 23, 30), at(6, 1, 59), at(6, 2, 0)), &(Some(true), Some(true), Some(false))),
      Test.equals("unknown hours answer nothing", &Place.openAt(&Json.object(&[]), &Time.Local{year: 2026, month: 10, day: 12, weekday: 1, hour: 12, minute: 0}), &None),
      Test.equals("the rating is shown with one decimal", &(Place.ratingText(&fonda.card), Place.ratingText(&Place.Listing{..fonda.card, ratingAvg: Some(5.0)}), Place.ratingText(&Place.Listing{..fonda.card, ratingCount: 0})), &(Some("4.7"), Some("5.0"), None)),
      Test.equals("an edit form is refilled from the stored facts and hours", &(refilled.facts.get("d.cuisine"), refilled.facts.get("d.service.takeout"), refilled.facts.get("d.accessible"), refilled.hours.get("h.5.0.to")), &(Some("criolla"), Some("1"), Some("1"), Some("02:00"))),
      Test.equals("offered radii are accepted in kilometres", &Search.radiusFrom("10"), &Some(10000)),
      Test.equals("other radii are refused", &(Search.radiusFrom("7"), Search.radiusFrom("abc"), Search.radiusFrom("")), &(None, None, None)),
      Test.equals("a town anchors the search at its centroid with the default radius", &(anchored.lat, anchored.lng, anchored.radiusM), &(Some(carolina.lat), Some(carolina.lng), Some(25000))),
      Test.equals("an unknown town is dropped with its radius", &(unknownTown.near, unknownTown.lat, unknownTown.radiusM), &("", None, None)),
      Test.equals("a device position wins over a town", &gpsFirst.lat, &Some(18.2)),
      Test.equals("a remembered choice reads town and metres", &Search.rememberedNear("carolina:10"), &Some(("carolina", 10000))),
      Test.equals("a tampered remembered choice is ignored", &(Search.rememberedNear("caro<lina:10"), Search.rememberedNear("carolina:7"), Search.rememberedNear(":10"), Search.rememberedNear("carolina")), &(None, None, None, None)),
      Test.equals("a remembered choice round-trips", &Search.rememberedNear(Search.nearValue("san-juan", 50000)), &Some(("san-juan", 50000))),
      Test.equals("Carolina's nearest towns", &neighbors, &["canovanas", "trujillo-alto", "loiza"]),
      Test.that("neighbor distances are plausible", Catalog.neighbors(&island, &carolina, 1).map(|n: Catalog.Neighbor| n.meters >= 4000 && n.meters <= 8000) == [true]),
      Test.equals("rails keep each event in the first rail that shows it", &(ids(arranged.recommended), ids(arranged.weekend), ids(arranged.soon), ids(arranged.free)), &(["a", "b"], ["c"], ["d"], [])),
      Test.equals("hidden gems are unseen, priced, quiet, least engaged first", &ids(arranged.gems), &["silent", "quiet"]),
      Test.equals("deleted private profile signs out", &AccountApi.profileOf(&Json.Null), &Err(Problem.SignedOut)),
      Test.equals("valid private profile remains decoded", &match AccountApi.profileOf(&Fixtures.json("my-profile.json")) { case Ok(_) => true case _ => false }, &true),
      Test.equals("malformed profile is not signed out", &match AccountApi.profileOf(&Json.Text("invalid")) { case Err(Problem.Unavailable(_)) => true case _ => false }, &true),
      Test.succeeded("a search page decodes", &page),
      Test.equals("a search page holds its cards and cursor", &Result.map(page, |p| (p.items.length(), Option.isSome(&p.next))), &Ok((3, true))),
      Test.succeeded("a member's detail decodes", &member),
      Test.equals("an approved member sees the location", &Result.map(member, |d| (d.locationRevealed, Option.isSome(&d.instructions), Option.isSome(&d.exactLat))), &Ok((true, true, true))),
      Test.equals("an approved member sees who is going", &Result.map(member, |d| (d.attendees.canView, d.attendees.people.length())), &Ok((true, 2))),
      Test.equals("a guest sees neither location nor names", &Result.map(guest, |d| (d.locationRevealed, d.instructions, d.attendees.canView, d.attendees.people.length())), &Ok((false, None, false, 0))),
      Test.equals("the organizer card is present", &Result.map(member, |d| Option.map(d.organizer, |o| o.displayName)), &Ok(Some("María Rivera"))),
      Test.equals("sixteen categories decode", &Result.map(categories, |all| all.length()), &Ok(16)),
      Test.equals("seventy-eight municipalities decode", &Result.map(towns, |all| all.length()), &Ok(78)),
      Test.equals("the profile decodes with its preferences", &Result.map(mine, |p| (p.displayName, p.locationVisibility, p.onboarded)), &Ok(("Carlos Ortiz", "approved_activities", true))),
      Test.equals("old public profile does not grant admin", &Result.map(host, |p| p.isAdmin), &Ok(false)),
      Test.equals("old cards retain member source", &Result.map(page, |p| p.items[0].source), &Ok("member")),
      Test.equals("a public profile lists upcoming events", &Result.map(host, |p| p.upcoming.length() > 0), &Ok(true)),
      Test.succeeded("a member's requests decode", &requests),
      Test.succeeded("an organizer's queue decodes", &queue),
      Test.succeeded("notifications decode", &inbox),
      Test.succeeded("organized events decode with pending counts", &organized),
      Test.equals("a notification without a note reads empty", &Result.map(inbox, |all| Option.map(Option.fromArray(&all), |n| Notification.note(&n))), &Ok(Some(""))),
      Test.equals("an unknown code reads as a refusal", &Problem.fromApi("event_full", 409), &Problem.Refused("event_full")),
      Test.equals("a 401 reads as signed out", &Problem.fromApi("whatever", 401), &Problem.SignedOut),
      Test.equals("a 5xx reads as unavailable", &Problem.status(&Problem.fromApi("boom", 502)), &503),
      Test.equals("a known code has its message", &Problem.messageKey(&Problem.Refused("event_full")), &"problem.event_full"),
      Test.equals("an unknown code has the generic message", &Problem.messageKey(&Problem.Refused("mystery")), &"problem.generic"),
      Test.equals("field errors are found by field", &Problem.errorFor(&[Problem.FieldError{field: "title", key: "form.too_short"}], "title"), &Some("form.too_short")),
      Test.equals("English is chosen from a header", &Locale.fromAcceptLanguage("en-US,en;q=0.9,es;q=0.8"), &Locale.En),
      Test.equals("Spanish is the default", &Locale.fromAcceptLanguage("fr-FR"), &Locale.Es),
      Test.equals("a consent choice round-trips", &Consent.decode(Consent.encode(&Consent.Choice{analytics: true, marketing: false, version: "1"}), "1"), &Some(Consent.Choice{analytics: true, marketing: false, version: "1"})),
      Test.equals("a consent of an older version is asked again", &Consent.decode("v0:necessary", "1"), &None),
      Test.equals("sorts round-trip by name", &Search.sortFrom(Search.sortName(&Search.Near)), &Search.Near),
      Test.equals("windows round-trip by name", &Search.windowFrom(Search.windowName(&Search.Weekend)), &Search.Weekend),
      Test.equals("no filter is not narrowed", &Search.isNarrowed(&Search.everything()), &false),
      Test.equals("unknown price is not free", &Result.map(page, |p| Event.isFree(&Event.Card{..p.items[0], priceCents: None})), &Ok(false)),
      Test.equals("zero price is free", &Result.map(page, |p| Event.isFree(&Event.Card{..p.items[0], priceCents: Some(0)})), &Ok(true)),
      Test.equals("unknown cutoff before boundary stays visible", &Result.map(page, |p| Event.hasEnded(&Event.Card{..p.items[0], status: "published", startsAt: "2026-10-09T23:00:00Z", endsAt: None, discoveryUntil: Some("2026-10-10T23:00:00Z")}, 1791673200000 - 1)), &Ok(false)),
      Test.equals("unknown cutoff at boundary archives", &Result.map(page, |p| Event.hasEnded(&Event.Card{..p.items[0], status: "published", startsAt: "2026-10-09T23:00:00Z", endsAt: None, discoveryUntil: Some("2026-10-10T23:00:00Z")}, 1791673200000)), &Ok(true)),
      Test.equals("unknown edit stays blank", &Result.map(guest, |d| Draft.fromDetail(&Event.Detail{..d, card: Event.Card{..d.card, endsAt: None, priceCents: None}}).price), &Ok("")),
      Test.equals("free edit retains explicit zero", &Result.map(guest, |d| Draft.fromDetail(&Event.Detail{..d, card: Event.Card{..d.card, priceCents: Some(0)}}).price), &Ok("0.00")),
      Test.equals("an event is over once its end time passes", &Result.map(page, |p| Option.map(Option.fromArray(&p.items), |card| Event.hasEnded(&Event.Card{..card, status: "published", endsAt: Some("2026-10-09T20:00:00Z")}, 1791576000000 + 1))), &Ok(Some(true))),
      Test.equals("an event before its end time is not over", &Result.map(page, |p| Option.map(Option.fromArray(&p.items), |card| Event.hasEnded(&Event.Card{..card, status: "published", endsAt: Some("2026-10-09T20:00:00Z")}, 1791576000000 - 1))), &Ok(Some(false))),
      Test.equals("an event the job marked ended is over", &Result.map(page, |p| Option.map(Option.fromArray(&p.items), |card| Event.hasEnded(&Event.Card{..card, status: "ended", endsAt: Some("2999-01-01T00:00:00Z")}, 0))), &Ok(Some(true))),
      Test.equals("seats left never go below zero", &Result.map(page, |p| Option.map(Option.fromArray(&p.items), |card| Event.seatsLeft(&Event.Card{..card, capacity: Some(1), approvedCount: 3}))), &Ok(Some(Some(0))))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
