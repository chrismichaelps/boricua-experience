/** @Test.Validation.Suite — every form accepted and refused for the right reasons */
module Validation.ValidationTest

import Std.Bytes as Bytes
import Std.Io as Io
import Std.Option as Option
import Std.Result as Result
import Std.Test as Test
import Domain.Credentials as Credentials
import Domain.Draft as Draft
import Domain.Location as Location
import Domain.Problem as Problem
import Validation.Account as Account
import Validation.Avatar as Avatar
import Validation.EventForm as EventForm
import Validation.Location as LocationRules
import Validation.Participation as ParticipationRules

/// A draft that passes every rule.
fn goodDraft() -> Draft.Draft {
  Draft.Draft {
    ..Draft.blank(),
    title: "Bomba en la calle",
    summary: "Toques de bomba en vivo y taller corto.",
    category: "cultura",
    municipality: "san-juan",
    venueName: "La Placita de Santurce",
    lat: "18.4498",
    lng: "-66.0703",
    startsAt: "2026-12-05T19:00",
    endsAt: "2026-12-05T23:00",
    capacity: "40",
    price: "12.50"
  }
}

/// The field names a result refused, in order.
fn refused[T](outcome: &Result[T, Problem.Problem]) -> Array[Str] {
  match outcome {
    case Ok(_) => []
    case Err(problem) => Problem.fieldErrors(&problem).map(|e: Problem.FieldError| e.field)
  }
}

/// Runs the suite.
fn main() -> Int {
  let ready = EventForm.check(&goodDraft())
  let signUp = Credentials.SignUp{displayName: "Ana", email: "ana@example.com", password: "boricua2026", confirmation: "boricua2026", birthDate: "1990-05-17", terms: true, privacy: true}
  let checks = Test.suite("Validation", &[
      Test.succeeded("a complete draft is ready", &ready),
      Test.equals("unknown price and end stay unknown", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "", price: ""}), |r| (r.endsAt, r.priceCents)), &Ok((None, None))),
      Test.equals("explicit zero is free", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), price: "0"}), |r| r.priceCents), &Ok(Some(0))),
      Test.equals("negative price is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), price: "-1"})), &["price"]),
      Test.equals("malformed end remains an error", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "later"})), &["endsAt"]),
      Test.equals("missing start cannot publish", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), startsAt: "", endsAt: ""})), &["startsAt"]),
      Test.equals("a ready draft carries UTC timestamps", &Result.map(ready, |r| r.startsAt), &Ok("2026-12-05T23:00:00Z")),
      Test.equals("a ready draft carries cents and capacity", &Result.map(ready, |r| (r.priceCents, r.capacity)), &Ok((Some(1250), Some(40)))),
      Test.equals("an empty draft names every required field", &refused(&EventForm.check(&Draft.blank())), &["title", "summary", "category", "municipality", "venueName", "location", "startsAt"]),
      Test.equals("a private event must require approval", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), visibility: "private", joinPolicy: "open"})), &["joinPolicy"]),
      Test.equals("an end before the start is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "2026-12-05T18:00"})), &["endsAt"]),
      Test.equals("an event longer than two weeks is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "2026-12-25T18:00"})), &["endsAt"]),
      Test.equals("a pin outside Puerto Rico is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), lat: "25.76", lng: "-80.19"})), &["location"]),
      Test.equals("a zero capacity is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), capacity: "0"})), &["capacity"]),
      Test.equals("an empty capacity is unlimited", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), capacity: ""}), |r| r.capacity), &Ok(None)),
      Test.equals("a malformed price is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), price: "doce"})), &["price"]),
      Test.succeeded("a complete sign-up passes", &Account.signUp(&signUp)),
      Test.equals("a sign-up without a date of birth is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: ""})), &["birthDate"]),
      Test.equals("an impossible date of birth is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: "1990-02-30"})), &["birthDate"]),
      Test.equals("a date of birth in the future is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: "2999-01-01"})), &["birthDate"]),
      Test.equals("a minor's date of birth is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: "2015-06-01"})), &["birthDate"]),
      Test.that("a minor's date of birth reads as underage", Account.underage("2015-06-01")),
      Test.that("an adult's date of birth does not read as underage", !Account.underage("1990-05-17")),
      Test.that("an unreadable date does not read as underage", !Account.underage("tomorrow")),
      Test.equals("a signup with mismatched passwords is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, confirmation: "different"})), &["confirmation"]),
      Test.equals("a sign-up with a short password is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, password: "corta", confirmation: "corta"})), &["password"]),
      Test.equals("an address without a domain is refused", &Account.isEmail("ana@local"), &false),
      Test.equals("an address with a domain passes", &Account.isEmail("ana.rivera@correo.pr"), &true),
      Test.equals("mismatched passwords are refused", &refused(&Account.newPassword(&Credentials.NewPassword{password: "boricua2026", confirmation: "boricua2027"})), &["confirmation"]),
      Test.equals("onboarding requires every confirmation", &refused(&Account.onboarding(&Credentials.Onboarding{displayName: "Ana", birthDate: "1990-05-17", terms: false, privacy: false})), &["terms", "privacy"]),
      Test.equals("a long join message is refused", &refused(&ParticipationRules.message("x".repeat(501))), &["message"]),
      Test.equals("an unknown report reason is refused", &refused(&ParticipationRules.report(&ParticipationRules.Report{reason: "boring", detail: ""})), &["reason"]),
      Test.equals("a reaction of two is refused", &refused(&ParticipationRules.reaction(2)), &["reaction"]),
      Test.succeeded("a reading in San Juan passes", &LocationRules.position(&Location.Position{lat: 18.46, lng: -66.1, accuracyM: 20.0})),
      Test.equals("a reading in Miami is refused", &refused(&LocationRules.position(&Location.Position{lat: 25.76, lng: -80.19, accuracyM: 20.0})), &["position"]),
      Test.equals("a WebP photo is recognised", &Result.map(Avatar.photo(Bytes.encodeBase64(&Bytes.fromText("RIFF0000WEBPVP8 data"))), |found| found[1]), &Ok("image/webp")),
      Test.equals("a JPEG photo in a data address is recognised", &Result.map(Avatar.photo("data:image/jpeg;base64," + Bytes.encodeBase64(&Bytes.fromArray(&[255u8, 216u8, 255u8, 224u8]))), |found| found[1]), &Ok("image/jpeg")),
      Test.equals("a PNG photo is recognised", &Option.isSome(&Avatar.mediaType(&Bytes.fromArray(&[137u8, 80u8, 78u8, 71u8, 13u8]))), &true),
      Test.equals("text is not a photo", &refused(&Avatar.photo(Bytes.encodeBase64(&Bytes.fromText("hello")))), &["photo"]),
      Test.equals("broken base64 is not a photo", &refused(&Avatar.photo("%%%")), &["photo"]),
      Test.equals("an oversized photo is refused", &Result.map(Result.swap(Avatar.photo(Bytes.encodeBase64(&Bytes.concat(&Bytes.fromArray(&[255u8, 216u8, 255u8]), &Bytes.fromText("x".repeat(700000)))))), |p| Problem.errorFor(&Problem.fieldErrors(&p), "photo")), &Ok(Some("form.photo_too_large"))),
      Test.equals("a refused field carries its message key", &Result.map(Result.swap(EventForm.check(&Draft.Draft{..goodDraft(), title: "No"})), |p| Problem.errorFor(&Problem.fieldErrors(&p), "title")), &Ok(Some("form.title_length")))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
