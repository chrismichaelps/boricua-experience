/** @Test.Validation.Suite — every form accepted and refused for the right reasons */
module Validation.ValidationTest

import Std.Bytes as Bytes
import Std.Io as Io
import Std.Json as Json
import Std.Option as Option
import Std.Result as Result
import Std.Test as Test
import Constants.App as App
import Domain.Catalog as Catalog
import Domain.Credentials as Credentials
import Domain.Draft as Draft
import Domain.Location as Location
import Domain.Place as Place
import Domain.Problem as Problem
import Domain.Profile as Profile
import Domain.Review as Review
import Support.Fixtures as Fixtures
import Utils.Time as Time
import Utils.Wire as Wire
import Validation.Account as Account
import Validation.Avatar as Avatar
import Validation.EventForm as EventForm
import Validation.Location as LocationRules
import Validation.Participation as ParticipationRules
import Validation.PlaceForm as PlaceForm
import Validation.ReviewForm as ReviewForm

/// The catalogue of the recorded category profiles and two towns.
fn profiles() -> Catalog.Catalog {
  let categories: Array[Catalog.Category] = Result.unwrapOr(Wire.decode(&Fixtures.json("category-profiles.json")), [])
  Catalog.Catalog{categories: categories, municipalities: [Catalog.Municipality{slug: "san-juan", name: "San Juan", region: "metro", lat: 18.46, lng: -66.1}, Catalog.Municipality{slug: "luquillo", name: "Luquillo", region: "este", lat: 18.37, lng: -65.72}], scenes: [], planStyles: []}
}

/// The recorded member profile, read before profiles carried their accepted versions.
fn member() -> Profile.MyProfile {
  match Wire.decode(&Fixtures.json("my-profile.json")) { case Ok(found) => found case Err(_) => panic("profile fixture") }
}

/// A restaurant draft that passes every rule.
fn goodPlace() -> Place.Draft {
  Place.Draft {
    ..Place.blank("comida"),
    municipality: "san-juan",
    name: "La Fonda",
    summary: "Mofongo, pescado frito y café de la montaña.",
    lat: "18.4655",
    lng: "-66.1057",
    phone: "(787) 555-0100",
    website: "https://lafonda.example.org",
    facts: mapOf([("d.cuisine", "criolla"), ("d.price_level", "2"), ("d.service.dine_in", "1"), ("d.service.takeout", "1"), ("d.accessible", "on"), ("d.stars", "5")]),
    hours: mapOf([("h.1.0.from", "11:00"), ("h.1.0.to", "22:00"), ("h.5.0.from", "18:00"), ("h.5.0.to", "02:00")])
  }
}

/// The field names a place draft is refused for.
fn placeRefusals(draft: &Place.Draft) -> Array[Str] {
  match PlaceForm.check(draft, &profiles()) {
    case Ok(_) => []
    case Err(problem) => Problem.fieldErrors(&problem).map(|error: Problem.FieldError| error.field)
  }
}

/// A draft that passes every rule.
fn goodDraft() -> Draft.Draft {
  Draft.Draft {
    ..Draft.blank(),
    title: "Bomba en la calle",
    summary: "Toques de bomba en vivo y taller corto.",
    category: "cultura",
    municipality: "san-juan",
    venueName: "La Placita de Santurce",
    lat: "18.4498",
    lng: "-66.0703",
    startsAt: "2026-12-05T19:00",
    endsAt: "2026-12-05T23:00",
    capacity: "40",
    price: "12.50"
  }
}

/// The field names a result refused, in order.
fn refused[T](outcome: &Result[T, Problem.Problem]) -> Array[Str] {
  match outcome {
    case Ok(_) => []
    case Err(problem) => Problem.fieldErrors(&problem).map(|e: Problem.FieldError| e.field)
  }
}

/// Runs the suite.
fn main() -> Int {
  let ready = EventForm.check(&goodDraft())
  let signUp = Credentials.SignUp{displayName: "Ana", email: "ana@example.com", password: "boricua2026", confirmation: "boricua2026", birthDate: "1990-05-17", terms: true, privacy: true}
  let checks = Test.suite("Validation", &[
      Test.equals("a review is converted with its visit month", &Result.map(ReviewForm.check(&Review.ReviewDraft{rating: "4", body: "  Muy buen mofongo, aunque hubo espera.  ", visited: "2026-09", companions: "family"}, &Time.Local{year: 2026, month: 10, day: 12, weekday: 1, hour: 12, minute: 0}), |r: Review.ReviewReady| (r.rating, r.body, r.visitedOn, r.companions)), &Ok((4, "Muy buen mofongo, aunque hubo espera.", Some("2026-09-01"), Some("family")))),
      Test.equals("a review needs stars, enough text and a past month", &Result.isErr(&ReviewForm.check(&Review.ReviewDraft{rating: "6", body: "corto", visited: "2026-11", companions: ""}, &Time.Local{year: 2026, month: 10, day: 12, weekday: 1, hour: 12, minute: 0})), &true),
      Test.equals("every refused review field is named", &match ReviewForm.check(&Review.ReviewDraft{rating: "0", body: "corto", visited: "2026-13", companions: "aliens"}, &Time.Local{year: 2026, month: 10, day: 12, weekday: 1, hour: 12, minute: 0}) { case Err(problem) => Problem.fieldErrors(&problem).map(|e: Problem.FieldError| e.field) case Ok(_) => [] }, &["rating", "body", "visited", "companions"]),
      Test.that("an owner answer may be cleared but not be one letter", ReviewForm.responseOk("") && ReviewForm.responseOk("Gracias") && !ReviewForm.responseOk("x")),
      Test.equals("a complete restaurant passes", &placeRefusals(&goodPlace()), &[]),
      Test.equals("facts are converted by type and unknown names are ignored", &Json.encode(&(match PlaceForm.check(&goodPlace(), &profiles()) { case Ok(found) => found case Err(_) => panic("good place refused") }).details), &"\{\"cuisine\":\"criolla\",\"price_level\":\"2\",\"service\":[\"dine_in\",\"takeout\"],\"accessible\":true\}"),
      Test.equals("hours are keyed by weekday and may run past midnight", &Json.encode(&(match PlaceForm.check(&goodPlace(), &profiles()) { case Ok(found) => found case Err(_) => panic("good place refused") }).hours), &"\{\"1\":[[\"11:00\",\"22:00\"]],\"5\":[[\"18:00\",\"02:00\"]]\}"),
      Test.equals("a required fact is required", &placeRefusals(&Place.Draft{..goodPlace(), facts: mapOf([])}), &["d.cuisine"]),
      Test.equals("a choice outside the options is refused", &placeRefusals(&Place.Draft{..goodPlace(), facts: mapOf([("d.cuisine", "sushi")])}), &["d.cuisine"]),
      Test.equals("a category without places is refused", &placeRefusals(&Place.Draft{..goodPlace(), category: "civica"}), &["category"]),
      Test.equals("an incomplete or empty range is refused", &(placeRefusals(&Place.Draft{..goodPlace(), hours: mapOf([("h.2.0.from", "09:00")])}), placeRefusals(&Place.Draft{..goodPlace(), hours: mapOf([("h.2.0.from", "09:00"), ("h.2.0.to", "09:00")])}), placeRefusals(&Place.Draft{..goodPlace(), hours: mapOf([("h.2.0.from", "25:00"), ("h.2.0.to", "26:00")])})), &(["hours"], ["hours"], ["hours"])),
      Test.equals("contact must be a phone and an https address", &placeRefusals(&Place.Draft{..goodPlace(), phone: "call me", website: "http://lafonda.example.org"}), &["phone", "website"]),
      Test.equals("a place outside the island is refused", &placeRefusals(&Place.Draft{..goodPlace(), lat: "40.7", lng: "-74.0"}), &["location"]),
      Test.equals("a beach number and toggle convert, a bad number is refused", &(placeRefusals(&Place.Draft{..goodPlace(), category: "playa", facts: mapOf([("d.water", "calm"), ("d.blue_flag", "1")])}), placeRefusals(&Place.Draft{..goodPlace(), category: "hospedaje", facts: mapOf([("d.lodging_type", "hotel"), ("d.price_from", "-5")])}), placeRefusals(&Place.Draft{..goodPlace(), category: "hospedaje", facts: mapOf([("d.lodging_type", "hotel"), ("d.price_from", "129.50")])})), &([], ["d.price_from"], [])),
      Test.that("phone and web address rules", PlaceForm.phoneOk("+1 787-555-0100") && !PlaceForm.phoneOk("555") && PlaceForm.urlOk("https://a.example/menu?x=1") && !PlaceForm.urlOk("https://bad host.example") && !PlaceForm.urlOk("javascript:alert(1)")),
      Test.equals("unknown activity age remains unknown", &Result.map(EventForm.check(&goodDraft()), |r| (r.minAge, r.accessible)), &Ok((None, false))),
      Test.equals("stated all-ages and access are explicit", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), minAge: "0", accessible: true}), |r| (r.minAge, r.accessible)), &Ok((Some(0), true))),
      Test.equals("maximum age floor is accepted", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), minAge: "21"}), |r| r.minAge), &Ok(Some(21))),
      Test.equals("out-of-bound age is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), minAge: "22"})), &["minAge"]),
      Test.equals("fractional age is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), minAge: "12.5"})), &["minAge"]),
      Test.equals("negative age is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), minAge: "-1"})), &["minAge"]),
      Test.succeeded("a complete draft is ready", &ready),
      Test.equals("unknown price and end stay unknown", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "", price: ""}), |r| (r.endsAt, r.priceCents)), &Ok((None, None))),
      Test.equals("explicit zero is free", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), price: "0"}), |r| r.priceCents), &Ok(Some(0))),
      Test.equals("negative price is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), price: "-1"})), &["price"]),
      Test.equals("malformed end remains an error", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "later"})), &["endsAt"]),
      Test.equals("missing start cannot publish", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), startsAt: "", endsAt: ""})), &["startsAt"]),
      Test.equals("a ready draft carries UTC timestamps", &Result.map(ready, |r| r.startsAt), &Ok("2026-12-05T23:00:00Z")),
      Test.equals("a ready draft carries cents and capacity", &Result.map(ready, |r| (r.priceCents, r.capacity)), &Ok((Some(1250), Some(40)))),
      Test.equals("an empty draft names every required field", &refused(&EventForm.check(&Draft.blank())), &["title", "summary", "category", "municipality", "venueName", "location", "startsAt"]),
      Test.equals("a private event must require approval", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), visibility: "private", joinPolicy: "open"})), &["joinPolicy"]),
      Test.equals("an end before the start is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "2026-12-05T18:00"})), &["endsAt"]),
      Test.equals("an event longer than two weeks is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), endsAt: "2026-12-25T18:00"})), &["endsAt"]),
      Test.equals("a pin outside Puerto Rico is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), lat: "25.76", lng: "-80.19"})), &["location"]),
      Test.equals("a zero capacity is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), capacity: "0"})), &["capacity"]),
      Test.equals("an empty capacity is unlimited", &Result.map(EventForm.check(&Draft.Draft{..goodDraft(), capacity: ""}), |r| r.capacity), &Ok(None)),
      Test.equals("a malformed price is refused", &refused(&EventForm.check(&Draft.Draft{..goodDraft(), price: "doce"})), &["price"]),
      Test.succeeded("a complete sign-up passes", &Account.signUp(&signUp)),
      Test.equals("a sign-up without a date of birth is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: ""})), &["birthDate"]),
      Test.equals("an impossible date of birth is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: "1990-02-30"})), &["birthDate"]),
      Test.equals("a date of birth in the future is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: "2999-01-01"})), &["birthDate"]),
      Test.equals("a minor's date of birth is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, birthDate: "2015-06-01"})), &["birthDate"]),
      Test.that("a minor's date of birth reads as underage", Account.underage("2015-06-01")),
      Test.that("an adult's date of birth does not read as underage", !Account.underage("1990-05-17")),
      Test.that("an unreadable date does not read as underage", !Account.underage("tomorrow")),
      Test.equals("a signup with mismatched passwords is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, confirmation: "different"})), &["confirmation"]),
      Test.equals("a sign-up with a short password is refused", &refused(&Account.signUp(&Credentials.SignUp{..signUp, password: "corta", confirmation: "corta"})), &["password"]),
      Test.equals("an address without a domain is refused", &Account.isEmail("ana@local"), &false),
      Test.equals("an address with a domain passes", &Account.isEmail("ana.rivera@correo.pr"), &true),
      Test.equals("mismatched passwords are refused", &refused(&Account.newPassword(&Credentials.NewPassword{password: "boricua2026", confirmation: "boricua2027"})), &["confirmation"]),
      Test.equals("onboarding requires every confirmation", &refused(&Account.onboarding(&Credentials.Onboarding{displayName: "Ana", birthDate: "1990-05-17", terms: false, privacy: false})), &["terms", "privacy"]),
      Test.equals("a renewal requires both documents", &refused(&Account.renewal(&Credentials.Renewal{terms: true, privacy: false})), &["privacy"]),
      Test.succeeded("a renewal accepting both passes", &Account.renewal(&Credentials.Renewal{terms: true, privacy: true})),
      Test.that("a member on the current versions owes nothing", !Account.owesRenewal(&Profile.MyProfile{..member(), termsVersion: App.TERMS_VERSION, privacyVersion: App.PRIVACY_VERSION})),
      Test.that("a member on older terms owes a renewal", Account.owesRenewal(&Profile.MyProfile{..member(), termsVersion: "2025-01", privacyVersion: App.PRIVACY_VERSION})),
      Test.that("a member on an older privacy policy owes a renewal", Account.owesRenewal(&Profile.MyProfile{..member(), termsVersion: App.TERMS_VERSION, privacyVersion: "2025-01"})),
      Test.that("an unknown version never blocks", !Account.owesRenewal(&member())),
      Test.that("an account still onboarding is sent to onboarding, not renewal", !Account.owesRenewal(&Profile.MyProfile{..member(), onboarded: false, termsVersion: "2025-01", privacyVersion: "2025-01"})),
      Test.equals("a long join message is refused", &refused(&ParticipationRules.message("x".repeat(501))), &["message"]),
      Test.equals("an unknown report reason is refused", &refused(&ParticipationRules.report(&ParticipationRules.Report{reason: "boring", detail: ""})), &["reason"]),
      Test.equals("a reaction of two is refused", &refused(&ParticipationRules.reaction(2)), &["reaction"]),
      Test.succeeded("a reading in San Juan passes", &LocationRules.position(&Location.Position{lat: 18.46, lng: -66.1, accuracyM: 20.0})),
      Test.equals("a reading in Miami is refused", &refused(&LocationRules.position(&Location.Position{lat: 25.76, lng: -80.19, accuracyM: 20.0})), &["position"]),
      Test.equals("a WebP photo is recognised", &Result.map(Avatar.photo(Bytes.encodeBase64(&Bytes.fromText("RIFF0000WEBPVP8 data"))), |found| found[1]), &Ok("image/webp")),
      Test.equals("a JPEG photo in a data address is recognised", &Result.map(Avatar.photo("data:image/jpeg;base64," + Bytes.encodeBase64(&Bytes.fromArray(&[255u8, 216u8, 255u8, 224u8]))), |found| found[1]), &Ok("image/jpeg")),
      Test.equals("a PNG photo is recognised", &Option.isSome(&Avatar.mediaType(&Bytes.fromArray(&[137u8, 80u8, 78u8, 71u8, 13u8]))), &true),
      Test.equals("text is not a photo", &refused(&Avatar.photo(Bytes.encodeBase64(&Bytes.fromText("hello")))), &["photo"]),
      Test.equals("broken base64 is not a photo", &refused(&Avatar.photo("%%%")), &["photo"]),
      Test.equals("an oversized photo is refused", &Result.map(Result.swap(Avatar.photo(Bytes.encodeBase64(&Bytes.concat(&Bytes.fromArray(&[255u8, 216u8, 255u8]), &Bytes.fromText("x".repeat(700000)))))), |p| Problem.errorFor(&Problem.fieldErrors(&p), "photo")), &Ok(Some("form.photo_too_large"))),
      Test.equals("a refused field carries its message key", &Result.map(Result.swap(EventForm.check(&Draft.Draft{..goodDraft(), title: "No"})), |p| Problem.errorFor(&Problem.fieldErrors(&p), "title")), &Ok(Some("form.title_length")))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
