/** @Test.View.Plan — plan choices, shared links, and the plans page and calendar */
module View.PlanTest

import Std.Html as Html
import Std.Io as Io
import Std.Json as Json
import Std.Test as Test
import Domain.Assistant as Assistant
import Domain.Build as Build
import Domain.Catalog as Catalog
import Domain.Draft as Draft
import Domain.Event as Event
import Domain.Locale as Locale
import Domain.Plan as Plan
import I18n.Format as Format
import Support.Fixtures as Fixtures
import Utils.Wire as Wire
import View.Calendar as Calendar
import View.Frame as Frame
import View.Pages.Map as MapPage
import View.Pages.Plan as PlanPage
import View.Pages.Trip as TripPage

/// A frame for a guest reading in a language.
fn visitor(locale: Locale.Locale) -> Frame.Frame {
  Frame.Frame{locale: locale, siteUrl: "http://localhost:8080", path: "/plan", query: "", member: None, formToken: "", consent: None, flash: "", nowMillis: 0, build: Build.development()}
}

/// Runs the plan checks.
fn main() -> Int {
  let outings: Plan.Outings = match Wire.decode(&Fixtures.json("plan-outings.json")) {
    case Ok(found) => found
    case Err(_) => Plan.Outings{plans: []}
  }
  let catalog = Catalog.Catalog{categories: [], municipalities: [Catalog.Municipality{slug: "san-juan", name: "San Juan", region: "metro", lat: 18.4655, lng: -66.1057}], scenes: []}
  let choices = PlanPage.Choices{lat: None, lng: None, town: "san-juan", window: Plan.Weekend, style: Plan.Mixed, stops: 3, mode: Plan.Local}
  let es = Html.render(&PlanPage.render(&visitor(Locale.Es), &catalog, &choices, &PlanPage.Found(outings)))
  let en = Html.render(&PlanPage.render(&visitor(Locale.En), &catalog, &choices, &PlanPage.Found(outings)))
  let start = Html.render(&PlanPage.render(&visitor(Locale.Es), &catalog, &choices, &PlanPage.Nothing))
  let empty = Html.render(&PlanPage.render(&visitor(Locale.Es), &catalog, &choices, &PlanPage.Found(Plan.Outings{plans: []})))
  let first = outings.plans[0]
  let shared = Html.render(&PlanPage.render(&visitor(Locale.Es), &catalog, &choices, &PlanPage.Shared(Plan.Outings{plans: [first]})))
  let trip = Html.render(&TripPage.render(&visitor(Locale.Es), &first))
  let ferryStop = Plan.Stop{..first.stops[1], leg: Some(Plan.Leg{seconds: 7200, meters: 51000, road: false, ferry: true})}
  let ferryPlan = Html.render(&PlanPage.render(&visitor(Locale.Es), &catalog, &choices, &PlanPage.Shared(Plan.Outings{plans: [Plan.Plan{..first, stops: [first.stops[0], ferryStop]}]})))
  let factsCard = Event.Card{..first.stops[0].card, parking: Some(true), cashOnly: Some(true), outdoor: true, english: Some(Event.CardEnglish{title: Some("Coffee route"), summary: Some("Visit farms.")})}
  let factsTrip = Html.render(&TripPage.render(&visitor(Locale.Es), &Plan.Plan{..first, stops: [Plan.Stop{..first.stops[0], card: factsCard}, first.stops[1]]}))
  let localizedPlan = Plan.Plan{..first, stops: [Plan.Stop{..first.stops[0], card: factsCard}]}
  let englishTrip = Html.render(&TripPage.render(&visitor(Locale.En), &localizedPlan))
  let englishPlan = Html.render(&PlanPage.render(&visitor(Locale.En), &catalog, &choices, &PlanPage.Found(Plan.Outings{plans: [localizedPlan]})))
  let arrival = Plan.Arrival{slug: "a-one", lat: 18.4, lng: -66.1, plan: ["a-one", "b-two"]}
  let ics = Calendar.plan("https://boricuaexperience.com", "Plan", &first.stops.map(|stop: Plan.Stop| (stop.card, stop.arrive, stop.leave)))
  let checks = Test.suite("Plan", &[
      Test.equals("trip uses database English title", &englishTrip.contains("Coffee route"), &true),
      Test.equals("plan uses database English title", &englishPlan.contains("Coffee route"), &true),
      Test.equals("refreshed map pins retain database English title", &Json.encode(&MapPage.pinsValue(&visitor(Locale.En), &[factsCard])).contains("Coffee route"), &true),
      Test.equals("assistant source retains database English title", &Json.encode(&Assistant.sourceLocalized(&factsCard, "en")).contains("Coffee route"), &true),

      Test.equals("styles read their wire names", &Plan.styleName(&Plan.styleFrom("adventure")), &"adventure"),
      Test.equals("an unknown style is mixed", &Plan.styleName(&Plan.styleFrom("<script>")), &"mixed"),
      Test.equals("an unknown window is today", &Plan.windowName(&Plan.windowFrom("someday")), &"today"),
      Test.equals("the visitor mode is remembered by name", &Plan.modeName(&Plan.modeFrom("visitor")), &"visitor"),
      Test.equals("stop counts stay within the offered choices", &[Plan.stopsFrom("1"), Plan.stopsFrom("3"), Plan.stopsFrom("9"), Plan.stopsFrom("x")], &[2, 3, 4, 3]),
      Test.equals("shared plans keep well-formed slugs once, in order", &Plan.sharedSlugs("b-one, a-two,b-one,../x,UPPER,c-three"), &["b-one", "a-two", "c-three"]),
      Test.equals("shared plans carry at most six stops", &Plan.sharedSlugs("aaa,bbb,ccc,ddd,eee,fff,ggg").length(), &6),
      Test.that("the fixture holds plans with stops", outings.plans.length() == 3 && first.stops.length() == 2),
      Test.that("each plan is a section with its map pins", es.split("class=\"plan-card\"").length() == 4 && es.contains("data-pins=")),
      Test.that("stops link to their activities in order", es.contains("href=\"/e/" + first.stops[0].card.slug + "\"")),
      Test.that("the drive between stops is measured on roads", es.contains("min en carro") && en.contains("min drive")),
      Test.that("a plan shares to WhatsApp with its own link", es.contains("https://wa.me/?text=") && es.contains("plan%3Fe%3D")),
      Test.that("a plan downloads as a calendar file", es.contains("/plan/calendar.ics?e=")),
      Test.that("found plans fold the choices under a summary", es.contains("plan-choices") && es.contains("San Juan · Este fin de semana")),
      Test.that("the start page invites a location or a town and stays open", start.contains("Empieza con tu ubicación") && !start.contains("plan-choices\"")),
      Test.that("no plans explains and offers to explore", empty.contains("No encontramos un plan")),
      Test.that("a shared plan says so", shared.contains("Un plan compartido") && shared.split("class=\"plan-card\"").length() == 2),
      Test.that("the plan calendar holds one event per stop", ics.split("BEGIN:VEVENT").length() == 3 && ics.endsWith("END:VCALENDAR\r\n")),
      Test.that("calendar stops run from arrival to departure", ics.contains("DTSTART:20261018") && ics.contains("DTEND:20261018")),
      Test.that("each plan starts its trip", es.contains("/plan/viaje?e=") && es.contains("Empezar viaje")),
      Test.that("each plan map offers 3D and the camera turns", es.contains("data-map-3d=\"1\"") && es.contains("data-turn=\"north\"")),
      Test.that("the trip lists every stop with where it is", trip.split("class=\"trip-stop\"").length() == first.stops.length() + 1 && trip.contains("data-stop=\"" + first.stops[0].card.slug + "\"") && trip.contains("data-lat=")),
      Test.that("the trip carries its messages and says the position stays on the phone", trip.contains("data-say-off-route=") && trip.contains("data-say-done-title=") && trip.contains("solo en este teléfono")),
      Test.that("the trip is not indexed and leads back to its plan", trip.contains("noindex") && trip.contains("href=\"/plan?e=")),
      Test.that("a well-formed arrival is accepted", Plan.validArrival(&arrival)),
      Test.equals("distances read in kilometres in Spanish and miles in English", &[Format.measure(&Locale.Es, 9500), Format.measure(&Locale.En, 9500), Format.measure(&Locale.En, 1609)], &["9.5 km", "5.9 mi", "1.0 mi"]),
      Test.that("English plans show miles", en.contains(" mi") && !en.contains(" km")),
      Test.that("a crossing to an island is a ferry, never a drive", ferryPlan.contains("Cruce en ferry desde Ceiba") && ferryPlan.contains("plan-leg-ferry")),
      Test.that("trip stops say parking and cash only when the organizer did", factsTrip.contains("Hay estacionamiento") && factsTrip.contains("Solo efectivo")),
      Test.that("plan stops and trip stops carry their town's forecast slot", es.contains("data-weather-town=") && factsTrip.contains("data-weather-outdoor=\"1\"") && factsTrip.contains("data-weather-card=\"1\"")),
      Test.equals("English readers see the automatic English title", &[Event.titleFor(&factsCard, true), Event.titleFor(&factsCard, false)], &["Coffee route", first.stops[0].card.title]),
      Test.equals("practical facts read yes, no or not said", &[Draft.factOf("yes"), Draft.factOf("no"), Draft.factOf(""), Draft.factOf("maybe")], &[Some(true), Some(false), None, None]),
      Test.equals("and write back the same way", &[Draft.answerOf(Some(true)), Draft.answerOf(Some(false)), Draft.answerOf(None)], &["yes", "no", ""]),
      Test.that("an arrival outside Puerto Rico is refused", !Plan.validArrival(&Plan.Arrival{..arrival, lat: 40.7})),
      Test.that("an arrival with a malformed address is refused", !Plan.validArrival(&Plan.Arrival{..arrival, slug: "../x"}) && !Plan.validArrival(&Plan.Arrival{..arrival, plan: ["a-one", "B"]})),
      Test.that("an arrival's plan holds at most six stops", !Plan.validArrival(&Plan.Arrival{..arrival, plan: ["aaa", "bbb", "ccc", "ddd", "eee", "fff", "ggg"]}))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) { let _reported = Io.writeErrorLine(failure) }
  Test.report(&ran)
}
