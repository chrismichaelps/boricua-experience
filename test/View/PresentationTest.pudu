      Test.equals("search retains free-only", &english.contains("name=\"free\" value=\"1\""), &true),
      Test.equals("search exposes translated picker labels", &spanish.contains("Buscar un pueblo"), &true),
      Test.equals("picker stylesheet is versioned", &home.contains("/assets/css/search.css?v=" + App.ASSET_VERSION), &true),
      Test.equals("footer exposes filtered free discovery", &home.contains("href=\"/search?free=1\""), &true),
      Test.equals("footer links to the database town directory", &home.contains("href=\"/#towns\""), &true),
      Test.equals("footer exposes account recovery", &home.contains("href=\"/recover\""), &true),
      Test.equals("footer credits real photography", &home.contains("/assets/img/credits.html"), &true),
      Test.equals("hero uses a real Luquillo photograph", &hero.contains("luquillo-photo.webp"), &true),
      Test.equals("footer has cookie preferences", &home.contains("Cookie preferences"), &true),
      Test.equals("obsolete AI notice is removed", &home.contains("AI-generated images"), &false),
      Test.equals("home exposes assistant", &home.contains("data-feature=\"assistant\""), &true),
      Test.equals("search omits assistant", &results.contains("data-feature=\"assistant\""), &false),
      Test.equals("root failure omits assistant", &failure.contains("data-feature=\"assistant\""), &false),
      Test.equals("town landing omits assistant", &listing.contains("data-feature=\"assistant\""), &false),
      Test.equals("login omits assistant", &login.contains("data-feature=\"assistant\""), &false),
      Test.equals("signup omits assistant", &signup.contains("data-feature=\"assistant\""), &false),
      Test.equals("map omits the assistant", &map.contains("data-feature=\"assistant\""), &false),
      Test.that("map carries its filters to the list and back to itself", map.contains("href=\"/search?category=musica&amp;free=1\"") && map.contains("class=\"map-filters\"") && map.contains("action=\"/map\"")),
      Test.that("map keeps location help for screen readers without the visible box", map.contains("class=\"sr-only\" id=\"map-location-help\"") && !map.contains("How location works")),
      Test.that("map offers the 3D turn controls", map.contains("data-turn=\"north\"") && map.contains("tap to face north")),
      Test.equals("map explains private location", &map.contains("Near me centers the map privately"), &true),
      Test.equals("map sheet has a named keyboard button", &map.contains("Expand or collapse the activity list"), &true),
      Test.equals("map sheet exposes its controlled list", &map.contains("aria-controls=\"map-list\""), &true),
      Test.equals("carousel uses the supplied destination count", &hero.split("data-slide=").length(), &3),
      Test.equals("carousel starts with Luquillo", &hero.contains("Luquillo, Puerto Rico"), &true),
      Test.equals("carousel has a translated pause control", &hero.contains("Pausar imágenes"), &true),
      Test.equals("map link retains the landing municipality", &listing.contains("pueblo=ponce"), &true),
      Test.equals("map link retains category", &listing.contains("category=musica"), &true),
      Test.equals("map link retains free-only", &listing.contains("free=1"), &true),
      Test.equals("map link retains the date window", &listing.contains("when=weekend"), &true),
      Test.equals("home has its overlay header", &home.contains("app-home"), &true),
      Test.equals("home failures keep standard navigation", &failure.contains("app-home"), &false),
      Test.equals("results keep standard navigation", &results.contains("app-home"), &false),
      Test.equals("search submits to the existing endpoint", &english.contains("action=\"/search\""), &true),
      Test.equals("search remains a GET form", &english.contains("method=\"get\""), &true),
      Test.that("detail attributes known age and access to organizer", declaredFacts.contains("8 years and older") && declaredFacts.contains("Organizer confirms step-free access.")),
      Test.that("unknown detail makes no access claim", !Html.render(&EventPage.render(&en, &detail, &None)).contains("Organizer confirms step-free access.")),
      Test.that("home quick filters name actual traits", homePage.contains("?t=family") && homePage.contains("?t=accessible")),
      Test.that("listing form preserves combined traits", traitControls.contains("name=\"t\" value=\"family,accessible\"")),
      Test.that("map form preserves combined traits", traitMap.contains("name=\"t\" value=\"family,accessible\"")),
      Test.that("paging query preserves traits and cursor", traitsQuery.contains("t=family%2Caccessible") && traitsQuery.contains("after=cursor")),
      Test.equals("query retains its field name", &english.contains("name=\"q\""), &true),
      Test.equals("municipality retains its field name", &english.contains("name=\"pueblo\""), &true),
      Test.equals("date retains its field name", &english.contains("name=\"when\""), &true),
      Test.equals("query text is escaped", &english.contains("<script>bad</script>"), &false),
      Test.equals("mascot is present", &english.contains("cotorra-search.svg"), &true),
      Test.equals("Spanish search remains translated", &spanish.contains("Dónde"), &true),
      Test.equals("local refresh styles are versioned", &home.contains("/assets/css/home.css?v=" + App.ASSET_VERSION), &true)
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) { let _reported = Io.writeErrorLine(failure) }
  Test.report(&ran)
}
