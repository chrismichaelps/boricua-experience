/** @Test.View.Presentation — search and shell output boundaries */
module View.PresentationTest

import Std.Html.Build {Building}
import Std.Html.Build as H
import Std.Html as Html
import Std.Http as Http
import Std.Json as Json
import Std.List as List
import Std.Test as Test
import Constants.App as App
import Domain.Catalog as Catalog
import Domain.Event as Event
import Domain.Locale as Locale
import Domain.Problem as Problem
import Domain.Profile as Profile
import Domain.Search as Search
import I18n.Dates as Dates
import I18n.Format as Format
import Services.Discovery as Discovery
import Services.Participation as ParticipationService
import Support.Fixtures as Fixtures
import Utils.Wire as Wire
import View.Calendar as Calendar
import View.Components.EventCard as EventCard
import View.Components.Hero as Hero
import View.Components.Notice as Notice
import View.Components.Search as Controls
import View.Frame as Frame
import View.Layout as Layout
import View.Pages.Activity as ActivityPage
import View.Pages.Auth as Auth
import View.Pages.Errors as Errors
import View.Pages.Event as EventPage
import View.Pages.Home as HomePage
import View.Pages.Legal as Legal
import View.Pages.Map as MapPage
import View.Pages.Profile as ProfilePage
import View.Pages.Search as SearchPage
import View.Seo as Seo
import Web.Respond as Respond

/// A visitor without a session.
fn visitor(locale: Locale.Locale, path: Str) -> Frame.Frame {
  Frame.Frame{locale: locale, siteUrl: "http://localhost:8080", path: path, query: "", member: None, formToken: "", consent: None, flash: "", nowMillis: 0}
}

/// Runs rendered-output regressions without database calls.
fn main() -> Int {
  let en = visitor(Locale.En, "/")
  let es = visitor(Locale.Es, "/")
  let emptyCatalog = Catalog.Catalog{categories: [], municipalities: [], scenes: []}
  let catalog = Catalog.Catalog{categories: [], municipalities: [], scenes: [
      Catalog.Scene{image: "/assets/img/luquillo-photo.webp", captionEs: "Luquillo, Puerto Rico", captionEn: "Luquillo, Puerto Rico", town: "luquillo"},
      Catalog.Scene{image: "/assets/img/san-juan-photo.webp", captionEs: "Viejo San Juan", captionEn: "Old San Juan", town: "san-juan"}
    ] }
  let tokenFrame = Frame.Frame{..es, formToken: "session-token"}
  let consentForm = Html.render(&Notice.cookieBanner(&tokenFrame).html())
  let cookiePage = Html.render(&Legal.render(&tokenFrame, &Legal.Cookies))
  let consentForms = List.drop(&cookiePage.split("action=\"/consent\""), 1)
  let emptyHero = Html.render(&Hero.render(&en, &emptyCatalog).html())
  let englishHero = Html.render(&Hero.render(&en, &catalog).html())
  let filters = Search.Filters{..Search.everything(), query: "<script>bad</script>", category: "cultura", freeOnly: true}
  let english = Html.render(&Controls.pill(&en, &catalog, &filters).html())
  let spanish = Html.render(&Controls.pill(&es, &catalog, &Search.everything()).html())
  let meta = Seo.meta("Home", "Description", "/", true)
  let tokenShell = Html.render(&Layout.page(&tokenFrame, &meta, Layout.Explore, H.div().says("Home")))
  let languageForms = List.drop(&tokenShell.split("action=\"/language\""), 1)
  let home = Html.render(&Layout.page(&en, &meta, Layout.Explore, H.div().says("Home")))
  let failure = Html.render(&Layout.page(&en, &meta, Layout.Elsewhere, H.div().says("Failure")))
  let results = Html.render(&Layout.page(&visitor(Locale.En, "/search"), &meta, Layout.Explore, H.div().says("Results")))
  let town = Catalog.Municipality{name: "Ponce", slug: "ponce", region: "sur", lat: 18.011, lng: -66.614}
  let narrowed = Search.Filters{..Search.everything(), municipality: "ponce", category: "musica", query: "salsa", freeOnly: true, window: Search.Weekend}
  let listing = Html.render(&SearchPage.render(&en, &catalog, &narrowed, &SearchPage.ForTown(town), &Event.Page{items: [], next: None}))
  let openSearch = Html.render(&SearchPage.render(&en, &catalog, &narrowed, &SearchPage.Open, &Event.Page{items: [], next: None}))
  let emptySearch = Html.render(&SearchPage.render(&en, &emptyCatalog, &narrowed, &SearchPage.Open, &Event.Page{items: [], next: None}))
  let hero = Html.render(&Hero.render(&es, &catalog).html())
  let login = Html.render(&Auth.signIn(&en, &Auth.Typed{displayName: "", email: "", returnTo: "/activity"}, &None))
  let signup = Html.render(&Auth.signUp(&en, &Auth.Typed{displayName: "", email: "", returnTo: "/activity"}, &None))
  let missing = Html.render(&Errors.missing(&en))
  let map = Html.render(&MapPage.render(&en, &[], false, false))
  let endedPage: Event.Page = match Wire.decode(&Fixtures.json("search-page.json")) { case Ok(page) => page case Err(_) => panic("fixture failed") }
  let detail = match Event.decodeDetail(&Fixtures.json("event-detail-guest.json")) { case Ok(found) => found case Err(_) => panic("fixture failed") }
  let unknownCard = Event.Card{..detail.card, priceCents: None, endsAt: None, discoveryUntil: Some("2026-10-13T02:00:00Z")}
  let unknownDetail = Event.Detail{..detail, card: unknownCard}
  let unknownSeo = Seo.event(en.siteUrl, &unknownDetail)
  let unknownCalendar = Calendar.ics(en.siteUrl, &unknownCard, "/e/" + unknownCard.slug)
  let endedCard = Event.Card{..endedPage.items[0], status: "published", endsAt: Some("2026-10-09T20:00:00Z"), capacity: Some(500), approvedCount: 0}

  let endedFrame = Frame.Frame{..es, nowMillis: 1791576000000}
  let endedOutput = Html.render(&EventCard.card(&endedFrame, &endedCard).html())
  let endedActivity = Html.render(&ActivityPage.render(&endedFrame, &ParticipationService.Activity{requests: [], saved: [], organizing: [endedCard]}))
  let seriesCard = Html.render(&EventCard.card(&es, &Event.Card{..detail.card, moreDates: 3}).html())
  let singleCard = Html.render(&EventCard.card(&es, &detail.card).html())
  let seriesPage = Html.render(&EventPage.render(&en, &Event.Detail{..detail, otherDates: [Event.Occurrence{slug: "plaza-2026-11-21", startsAt: "2026-11-21T22:00:00+00:00", endsAt: None}]}, &None))
  let singlePage = Html.render(&EventPage.render(&en, &detail, &None))
  let homePage = Html.render(&HomePage.render(&en, &catalog, &Discovery.Home{recommended: [], soon: [], weekend: [], free: [], gems: [detail.card]}))
  let nearListing = Html.render(&SearchPage.render(&es, &catalog, &Search.Filters{..Search.everything(), near: "ponce", radiusM: Some(10000), lat: Some(18.011), lng: Some(-66.614), sort: Search.Near}, &SearchPage.Open, &Event.Page{items: [], next: Some("24")}))
  let nearRailMarkup = HomePage.nearRail(&es, "Ponce", &Search.Filters{..Search.everything(), near: "ponce", radiusM: Some(10000)}, &[detail.card])
  let signedOutReply = Respond.problemJson(&Problem.SignedOut, true)
  let unavailableReply = Respond.problemJson(&Problem.Unavailable("network"), true)
  let expiredCookies = Http.headerValues(&signedOutReply.headers, "set-cookie")
  let original = match Event.decodeDetail(&Fixtures.json("event-detail-guest.json")) { case Ok(d) => d case Err(_) => panic("detail fixture") }
  let curated = Event.Detail{..original, source: "curated", sourceUrl: Some("https://example.org/official"), card: Event.Card{..original.card, source: "curated"}}
  let curatedActivity = Html.render(&ActivityPage.render(&en, &ParticipationService.Activity{requests: [], saved: [], organizing: [curated.card]}))
  let nativeActivity = Html.render(&ActivityPage.render(&en, &ParticipationService.Activity{requests: [], saved: [], organizing: [original.card]}))
  let nativeEndedOwner = Html.render(&EventPage.render(&en, &Event.Detail{..original, card: Event.Card{..original.card, status: "ended"}, viewer: Event.Viewer{..original.viewer, signedIn: true, isOrganizer: true}}, &None))
  let curatedGuest = Html.render(&EventPage.render(&en, &curated, &None))
  let curatedEs = Html.render(&EventPage.render(&es, &curated, &None))
  let curatedOwner = Html.render(&EventPage.render(&en, &Event.Detail{..curated, viewer: Event.Viewer{..curated.viewer, signedIn: true, isOrganizer: true}}, &None))
  let curatedMember = Html.render(&EventPage.render(&en, &Event.Detail{..curated, viewer: Event.Viewer{..curated.viewer, signedIn: true}}, &None))
  let curatedEnded = Html.render(&EventPage.render(&en, &Event.Detail{..curated, card: Event.Card{..curated.card, status: "ended"}}, &None))
  let curatedCancelled = Html.render(&EventPage.render(&en, &Event.Detail{..curated, card: Event.Card{..curated.card, status: "cancelled"}}, &None))
  let badSource = Event.Detail{..curated, sourceUrl: Some("javascript:alert(1)")}
  let unavailable = Html.render(&EventPage.render(&en, &badSource, &None))
  let sourceCard = Html.render(&EventCard.card(&en, &curated.card).html())
  let profile: Profile.PublicProfile = match Wire.decode(&Fixtures.json("public-profile.json")) { case Ok(p) => p case Err(_) => panic("profile fixture") }
  let adminEn = Html.render(&ProfilePage.render(&en, &Profile.PublicProfile{..profile, isAdmin: true}))
  let adminEs = Html.render(&ProfilePage.render(&es, &Profile.PublicProfile{..profile, isAdmin: true}))
  let checks = Test.suite("Presentation", &[
      Test.that("home offers a town and radius without location permission", homePage.contains("action=\"/search\"") && homePage.contains("name=\"cerca\"") && homePage.contains("name=\"radio\"")),
      Test.that("home keeps a slot for the remembered-town rail", homePage.contains("data-feature=\"near-rail\"") && homePage.contains("/api/home/near")),
      Test.that("home shows hidden gems", homePage.contains("rail-gems") && homePage.contains("Hidden gems")),
      Test.that("a near-town listing keeps town and radius, not coordinates, in its links", nearListing.contains("cerca=ponce") && nearListing.contains("radio=10") && !nearListing.contains("lat=18.011")),
      Test.that("a near-town listing offers the radius choice", nearListing.contains("name=\"radio\"") && nearListing.contains("A 10 km o menos")),
      Test.that("the remembered-town rail names the town and links its search", nearRailMarkup.contains("Cerca de Ponce · 10 km") && nearRailMarkup.contains("/search?cerca=ponce&amp;radio=10")),
      Test.that("a recurring card counts its later dates", seriesCard.contains("3 fechas más")),
      Test.that("a single card names no later dates", !singleCard.contains("card-series")),
      Test.that("a recurring page links its other dates", seriesPage.contains("Other dates") && seriesPage.contains("href=\"/e/plaza-2026-11-21\"")),
      Test.that("a single page has no other dates", !singlePage.contains("other-dates")),
      Test.equals("signup requires password confirmation", &signup.contains("name=\"confirmation\""), &true),
      Test.equals("signup does not expose itself to indexing", &signup.contains("noindex,follow"), &true),
      Test.equals("password controls are localized", &signup.contains("Show password"), &true),
      Test.equals("password visibility is hidden until enhanced", &signup.contains("class=\"password-visibility\" hidden=\"hidden\""), &true),
      Test.equals("404 has a main heading", &missing.contains("<h1>"), &true),
      Test.equals("404 avoids decorative icon", &missing.contains("empty-icon"), &false),
      Test.equals("absolute event images retain their origin", &Json.encode(&Seo.event(en.siteUrl, &Event.Detail{..curated, card: Event.Card{..curated.card, coverUrl: Some("https://example.org/photo.jpg")}})).contains("https://example.org/photo.jpg"), &true),
      Test.equals("absolute event images are not prefixed by site origin", &Json.encode(&Seo.event(en.siteUrl, &Event.Detail{..curated, card: Event.Card{..curated.card, coverUrl: Some("https://example.org/photo.jpg")}})).contains(en.siteUrl + "https://"), &false),
      Test.equals("curated activity has no request management", &curatedActivity.contains("/requests\""), &false),
      Test.equals("native activity retains request management", &nativeActivity.contains("/requests\""), &true),
      Test.equals("native ended owner retains request management", &nativeEndedOwner.contains("/requests\""), &true),
      Test.equals("curated guest uses official booking", &curatedGuest.contains("https://example.org/official"), &true),
      Test.equals("curated source is translated", &curatedEs.contains("Ver detalles y boletos oficiales"), &true),
      Test.equals("curated owner cannot manage attendee requests", &curatedOwner.contains("/requests\""), &false),
      Test.equals("curated member cannot join locally", &curatedMember.contains("/join\""), &false),
      Test.equals("curated guest has no local attendee list", &curatedGuest.contains("going-title"), &false),
      Test.equals("curated expired event has no booking CTA", &curatedEnded.contains("View official details and tickets"), &false),
      Test.equals("curated cancelled event has no booking CTA", &curatedCancelled.contains("View official details and tickets"), &false),
      Test.equals("unsafe official URL is rejected", &Event.officialUrl(&badSource), &None),
      Test.equals("missing source cannot become native join", &Event.officialUrl(&Event.Detail{..curated, sourceUrl: None}), &None),
      Test.equals("HTTP source is rejected", &Event.officialUrl(&Event.Detail{..curated, sourceUrl: Some("http://example.org")}), &None),
      Test.equals("unsafe source explains unavailable link", &unavailable.contains("The official link is currently unavailable."), &true),
      Test.equals("curated cards identify their source", &sourceCard.contains("Official source"), &true),
      Test.equals("curated SEO avoids native capacity", &Json.encode(&Seo.event(en.siteUrl, &Event.Detail{..curated, card: Event.Card{..curated.card, capacity: Some(500)}})).contains("maximumAttendeeCapacity"), &false),
      Test.equals("curated SEO avoids availability claims", &Json.encode(&Seo.event(en.siteUrl, &curated)).contains("InStock"), &false),
      Test.equals("admin profile badge is English", &adminEn.contains("Administrator"), &true),
      Test.equals("admin profile badge is Spanish", &adminEs.contains("Administrador"), &true),
      Test.equals("member profile never has admin badge", &Html.render(&ProfilePage.render(&en, &profile)).contains("admin-badge"), &false),

      Test.equals("signed-out JSON status", &signedOutReply.status.code, &401),
      Test.equals("signed-out JSON expires secure session", &expiredCookies.filter(|cookie: Str| cookie.startsWith("bx_session=") && cookie.contains("Max-Age=0") && cookie.contains("Secure")).length(), &1),
      Test.equals("dependency JSON status", &unavailableReply.status.code, &503),
      Test.equals("dependency failure preserves session", &Http.headerValues(&unavailableReply.headers, "set-cookie"), &[]),
      Test.equals("open search photo comes from ordered catalog", &openSearch.contains("class=\"search-hero-photo\" src=\"/assets/img/luquillo-photo.webp\""), &true),
      Test.equals("search preserves municipality filter", &openSearch.contains("pueblo=ponce"), &true),
      Test.equals("empty scene catalog has no broken search photo", &emptySearch.contains("search-hero-photo"), &false),
      Test.equals("category and town landings retain their own heading", &listing.contains("search-hero-photo"), &false),
      Test.equals("footer removes the adult-only note", &openSearch.contains("For adults 18 and over"), &false),
      Test.equals("footer uses the frame year", &openSearch.contains("© 1969 Boricua Experience."), &true),
      Test.equals("both language actions carry session token", &languageForms.filter(|part: Str| part.take(part.indexOf("</form>")).contains("name=\"_token\"") && part.take(part.indexOf("</form>")).contains("value=\"session-token\"")).length(), &2),
      Test.equals("organizing unknown archive is neutral in English", &Html.render(&ActivityPage.render(&en, &ParticipationService.Activity{requests: [], saved: [], organizing: [Event.Card{..unknownCard, status: "ended"}]})).contains("This activity has ended."), &false),
      Test.equals("organizing unknown archive is neutral in Spanish", &Html.render(&ActivityPage.render(&es, &ParticipationService.Activity{requests: [], saved: [], organizing: [Event.Card{..unknownCard, status: "ended"}]})).contains("Esta actividad ya terminó."), &false),
      Test.equals("unknown ended card says archived", &Html.render(&EventCard.card(&en, &Event.Card{..unknownCard, status: "ended"}).html()).contains("Archived"), &true),
      Test.equals("unknown archived card never claims actual end", &Html.render(&EventCard.card(&en, &Event.Card{..unknownCard, status: "ended"}).html()).contains("This activity has ended"), &false),
      Test.equals("stale English submission has neutral refusal", &Frame.t(&en, "problem.event_ended"), &"This activity is no longer accepting requests."),
      Test.equals("stale Spanish submission has neutral refusal", &Frame.t(&es, "problem.event_ended"), &"Esta actividad ya no acepta solicitudes."),
      Test.equals("unknown English price is explicit", &Format.price(&Locale.En, None), &"Check admission"),
      Test.equals("unknown Spanish price is explicit", &Format.price(&Locale.Es, None), &"Consulta la entrada"),
      Test.equals("unknown English end is explicit", &Dates.schedule(&Locale.En, unknownCard.startsAt, None).contains("End time not provided"), &true),
      Test.equals("unknown Spanish end is explicit", &Dates.schedule(&Locale.Es, unknownCard.startsAt, None).contains("Hora de fin no informada"), &true),
      Test.equals("unknown SEO has no invented end", &Json.field(&unknownSeo, "endDate"), &None),
      Test.equals("unknown SEO has no invented offer", &Json.field(&unknownSeo, "offers"), &None),
      Test.equals("unknown calendar has no invented end", &unknownCalendar.contains("DTEND:"), &false),
      Test.equals("unknown calendar keeps start", &unknownCalendar.contains("DTSTART:"), &true),
      Test.equals("unknown card retains price message", &Html.render(&EventCard.card(&en, &unknownCard).html()).contains("Check admission"), &true),
      Test.equals("deadline card immediately says ended", &endedOutput.contains("Esta actividad ya terminó."), &true),
      Test.equals("deadline card has no stale available seats", &endedOutput.contains("Quedan 500"), &false),
      Test.equals("ended activity keeps event navigation", &endedActivity.contains("href=\"/e/" + endedCard.slug + "\""), &true),
      Test.equals("ended activity hides pending request action", &endedActivity.contains("Solicitudes pendientes:"), &false),
      Test.equals("consent carries the session token", &consentForm.contains("name=\"_token\" value=\"session-token\""), &true),
      Test.equals("cookie reset and banner each carry a token", &consentForms.filter(|part: Str| part.take(part.indexOf("</form>")).contains("name=\"_token\" value=\"session-token\"")).length(), &2),
      Test.equals("empty destinations keep functional search", &emptyHero.contains("action=\"/search\""), &true),
      Test.equals("empty destinations have no broken caption", &emptyHero.contains("hero-place"), &false),
      Test.equals("empty destinations have no carousel controls", &emptyHero.contains("hero-controls"), &false),
      Test.equals("English destination comes from the catalog", &englishHero.contains("Old San Juan"), &true),
      Test.equals("regions come from supplied municipalities", &Catalog.regions(&Catalog.Catalog{..emptyCatalog, municipalities: [Catalog.Municipality{slug: "test", name: "Test", region: "sur", lat: 0.0, lng: 0.0}]}), &["sur"]),
      Test.equals("auth header retains curved branding", &login.contains("/assets/brand/cotorra-mark.svg"), &true),
      Test.equals("auth form has no duplicate brand", &login.contains("auth-brand"), &false),
      Test.equals("auth uses the official Google asset", &login.contains("/assets/brand/google-mark.svg"), &true),
      Test.equals("auth keeps email/password fields", &login.contains("autocomplete=\"current-password\""), &true),
      Test.equals("auth retains the return path", &login.contains("value=\"/activity\""), &true),
      Test.equals("text searches keep default relevance ordering", &english.contains("name=\"sort\" value=\"\""), &true),
      Test.equals("search retains the active category", &english.contains("name=\"category\" value=\"cultura\""), &true),
      Test.equals("search retains free-only", &english.contains("name=\"free\" value=\"1\""), &true),
      Test.equals("search exposes translated picker labels", &spanish.contains("Buscar un pueblo"), &true),
      Test.equals("picker stylesheet is versioned", &home.contains("/assets/css/search.css?v=" + App.ASSET_VERSION), &true),
      Test.equals("footer exposes filtered free discovery", &home.contains("href=\"/search?free=1\""), &true),
      Test.equals("footer links to the database town directory", &home.contains("href=\"/#towns\""), &true),
      Test.equals("footer exposes account recovery", &home.contains("href=\"/recover\""), &true),
      Test.equals("footer credits real photography", &home.contains("/assets/img/credits.html"), &true),
      Test.equals("hero uses a real Luquillo photograph", &hero.contains("luquillo-photo.webp"), &true),
      Test.equals("footer has cookie preferences", &home.contains("Cookie preferences"), &true),
      Test.equals("obsolete AI notice is removed", &home.contains("AI-generated images"), &false),
      Test.equals("map omits the assistant", &map.contains("data-feature=\"assistant\""), &false),
      Test.equals("map explains private location", &map.contains("Near me centers the map privately"), &true),
      Test.equals("map sheet has a named keyboard button", &map.contains("Expand or collapse the activity list"), &true),
      Test.equals("map sheet exposes its controlled list", &map.contains("aria-controls=\"map-list\""), &true),
      Test.equals("carousel uses the supplied destination count", &hero.split("data-slide=").length(), &3),
      Test.equals("carousel starts with Luquillo", &hero.contains("Luquillo, Puerto Rico"), &true),
      Test.equals("carousel has a translated pause control", &hero.contains("Pausar imágenes"), &true),
      Test.equals("map link retains the landing municipality", &listing.contains("pueblo=ponce"), &true),
      Test.equals("map link retains category", &listing.contains("category=musica"), &true),
      Test.equals("map link retains free-only", &listing.contains("free=1"), &true),
      Test.equals("map link retains the date window", &listing.contains("when=weekend"), &true),
      Test.equals("home has its overlay header", &home.contains("app-home"), &true),
      Test.equals("home failures keep standard navigation", &failure.contains("app-home"), &false),
      Test.equals("results keep standard navigation", &results.contains("app-home"), &false),
      Test.equals("search submits to the existing endpoint", &english.contains("action=\"/search\""), &true),
      Test.equals("search remains a GET form", &english.contains("method=\"get\""), &true),
      Test.equals("query retains its field name", &english.contains("name=\"q\""), &true),
      Test.equals("municipality retains its field name", &english.contains("name=\"pueblo\""), &true),
      Test.equals("date retains its field name", &english.contains("name=\"when\""), &true),
      Test.equals("query text is escaped", &english.contains("<script>bad</script>"), &false),
      Test.equals("mascot is present", &english.contains("cotorra-search.svg"), &true),
      Test.equals("Spanish search remains translated", &spanish.contains("Dónde"), &true),
      Test.equals("local refresh styles are versioned", &home.contains("/assets/css/home.css?v=" + App.ASSET_VERSION), &true)
    ])
  Test.report(&Test.run(&checks))
}
