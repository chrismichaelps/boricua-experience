/// A visitor without a session.
fn visitor(locale: Locale.Locale, path: Str) -> Frame.Frame {
  Frame.Frame{locale: locale, siteUrl: "http://localhost:8080", path: path, query: "", member: None, formToken: "", consent: None, flash: "", nowMillis: 0, build: Build.development()}
}

/// Runs rendered-output regressions without database calls.
fn main() -> Int {
  let en = visitor(Locale.En, "/")
  let es = visitor(Locale.Es, "/")
  let emptyCatalog = Catalog.Catalog{categories: [], municipalities: [], scenes: [], planStyles: []}
  let catalog = Catalog.Catalog{categories: [], municipalities: [], scenes: [
      Catalog.Scene{image: "/assets/img/luquillo-photo.webp", captionEs: "Luquillo, Puerto Rico", captionEn: "Luquillo, Puerto Rico", town: "luquillo"},
      Catalog.Scene{image: "/assets/img/san-juan-photo.webp", captionEs: "Viejo San Juan", captionEn: "Old San Juan", town: "san-juan"}
    ], planStyles: [] }
  let tokenFrame = Frame.Frame{..es, formToken: "session-token"}
  let consentForm = Html.render(&Notice.cookieBanner(&tokenFrame).html())
  let cookiePage = Html.render(&Legal.render(&tokenFrame, &Legal.Cookies))
  let consentForms = List.drop(&cookiePage.split("action=\"/consent\""), 1)
  let emptyHero = Html.render(&Hero.render(&en, &emptyCatalog).html())
  let englishHero = Html.render(&Hero.render(&en, &catalog).html())
  let filters = Search.Filters{..Search.everything(), query: "<script>bad</script>", category: "cultura", freeOnly: true}
  let english = Html.render(&Controls.pill(&en, &catalog, &filters).html())
  let spanish = Html.render(&Controls.pill(&es, &catalog, &Search.everything()).html())
  let meta = Seo.meta("Home", "Description", "/", true)
  let tokenShell = Html.render(&Layout.page(&tokenFrame, &meta, Layout.Explore, H.div().says("Home")))
  let languageForms = List.drop(&tokenShell.split("action=\"/language\""), 1)
  let home = Html.render(&Layout.page(&en, &meta, Layout.Explore, H.div().says("Home")))
  let failure = Html.render(&Layout.page(&en, &meta, Layout.Elsewhere, H.div().says("Failure")))
  let results = Html.render(&Layout.page(&visitor(Locale.En, "/search"), &meta, Layout.Explore, H.div().says("Results")))
  let town = Catalog.Municipality{name: "Ponce", slug: "ponce", region: "sur", lat: 18.011, lng: -66.614}
  let narrowed = Search.Filters{..Search.everything(), municipality: "ponce", category: "musica", query: "salsa", freeOnly: true, window: Search.Weekend}
  let listing = Html.render(&SearchPage.render(&visitor(Locale.En, "/pueblo/ponce"), &catalog, &narrowed, &SearchPage.ForTown(town), &Event.Page{items: [], next: None}, &[]))
  let openSearch = Html.render(&SearchPage.render(&en, &catalog, &narrowed, &SearchPage.Open, &Event.Page{items: [], next: None}, &[]))
  let emptySearch = Html.render(&SearchPage.render(&en, &emptyCatalog, &narrowed, &SearchPage.Open, &Event.Page{items: [], next: None}, &[]))
  let hero = Html.render(&Hero.render(&es, &catalog).html())
  let login = Html.render(&Auth.signIn(&en, &Auth.Typed{displayName: "", email: "", returnTo: "/activity"}, &None))
  let dateField = Html.render(&Form.input(&en, &Form.Field{..Form.field("startsAt", "Starts", "2026-10-20T19:35"), kind: "datetime-local"}, &[], |c: H.Node| c).html())
  let traitFilters = Search.Filters{..Search.everything(), traits: ["family", "accessible"], category: "cultura", query: "bomba"}
  let traitControls = Html.render(&Controls.filterBar(&en, &catalog, &traitFilters).html())
  let traitMap = Html.render(&Controls.mapBar(&en, &catalog, &traitFilters, "/search?t=family,accessible").html())
  let traitsQuery = SearchPage.queryOf(&traitFilters, &SearchPage.Open, "cursor")
  let signup = Html.render(&Auth.signUp(&en, &Auth.Typed{displayName: "", email: "", returnTo: "/activity"}, &None))
  let renewal = Html.render(&Auth.renewal(&en, "/activity", &None))
  let missing = Html.render(&Errors.missing(&en))
  let map = Html.render(&MapPage.render(&en, &[], false, false, &emptyCatalog, &Search.Filters{..Search.everything(), category: "musica", freeOnly: true}, "/search?category=musica&free=1"))
  let endedPage: Event.Page = match Wire.decode(&Fixtures.json("search-page.json")) { case Ok(page) => page case Err(why) => panic("fixture failed: " + Json.explainDecode(&why)) }
  let detail = match Event.decodeDetail(&Fixtures.json("event-detail-guest.json")) { case Ok(found) => found case Err(_) => panic("fixture failed") }
  let unknownCard = Event.Card{..detail.card, priceCents: None, endsAt: None, discoveryUntil: Some("2026-10-13T02:00:00Z")}
  let declaredFacts = Html.render(&EventPage.render(&en, &Event.Detail{..detail, minAge: Some(8), accessible: true}, &None))
  let unknownDetail = Event.Detail{..detail, card: unknownCard}
  let unknownSeo = Seo.event(en.siteUrl, &unknownDetail)
  let unknownCalendar = Calendar.ics(en.siteUrl, &unknownCard, "/e/" + unknownCard.slug)
  let endedCard = Event.Card{..endedPage.items[0], status: "published", endsAt: Some("2026-10-09T20:00:00Z"), capacity: Some(500), approvedCount: 0}

  let endedFrame = Frame.Frame{..es, nowMillis: 1791576000000}
  let endedOutput = Html.render(&EventCard.card(&endedFrame, &endedCard).html())
  let endedActivity = Html.render(&ActivityPage.render(&endedFrame, &ParticipationService.Activity{requests: [], saved: [], searches: [], organizing: [endedCard]}))
  let seriesCard = Html.render(&EventCard.card(&es, &Event.Card{..detail.card, moreDates: 3}).html())
  let singleCard = Html.render(&EventCard.card(&es, &detail.card).html())
  let seriesPage = Html.render(&EventPage.render(&en, &Event.Detail{..detail, otherDates: [Event.Occurrence{slug: "plaza-2026-11-21", startsAt: "2026-11-21T22:00:00+00:00", endsAt: None}]}, &None))
  let singlePage = Html.render(&EventPage.render(&en, &detail, &None))
  let homePage = Html.render(&HomePage.render(&en, &catalog, &Discovery.Home{recommended: [], soon: [], weekend: [], free: [], gems: [detail.card, Event.Card{..detail.card, slug: "another-gem"}]}))
  let singleGem = Html.render(&HomePage.render(&en, &catalog, &Discovery.Home{recommended: [], soon: [], weekend: [], free: [], gems: [detail.card]}))
  let nearListing = Html.render(&SearchPage.render(&es, &catalog, &Search.Filters{..Search.everything(), near: "ponce", radiusM: Some(10000), lat: Some(18.011), lng: Some(-66.614), sort: Search.Near}, &SearchPage.Open, &Event.Page{items: [], next: Some("24")}, &[]))
  let nearRailMarkup = HomePage.nearRail(&es, "Ponce", &Search.Filters{..Search.everything(), near: "ponce", radiusM: Some(10000)}, &[detail.card])
  let profiled = Catalog.Catalog{..catalog, categories: Result.unwrapOr(Wire.decode(&Fixtures.json("category-profiles.json")), []), municipalities: [Catalog.Municipality{slug: "san-juan", name: "San Juan", region: "metro", lat: 18.46, lng: -66.1}]}
  let fonda = match Place.decodeDetail(&Fixtures.json("place-detail.json")) { case Ok(found) => found case Err(_) => panic("place fixture") }
  let mondayNoon = Frame.Frame{..es, nowMillis: 1791824400000}
  let chooserPage = Html.render(&PlaceFormPage.chooser(&en, &profiled))
  let restaurantForm = Html.render(&PlaceFormPage.render(&es, &profiled, &PlaceFormPage.Creating, &Place.blank("comida"), &None))
  let beachForm = Html.render(&PlaceFormPage.render(&en, &profiled, &PlaceFormPage.Creating, &Place.blank("playa"), &None))
  let refusedForm = Html.render(&PlaceFormPage.render(&en, &profiled, &PlaceFormPage.Creating, &Place.blank("comida"), &Some(Problem.Invalid([Problem.FieldError{field: "d.cuisine", key: "form.fact_required"}, Problem.FieldError{field: "hours", key: "form.hours_invalid"}]))))
  let board: Review.ReviewBoard = match Wire.decode(&Fixtures.json("review-board.json")) { case Ok(found) => found case Err(why) => panic("board fixture: " + Json.explainDecode(&why)) }
  let ownerBoard = Review.ReviewBoard{..board, canReview: false, isOwner: true}
  let menus: Menu.MenuBoard = match Wire.decode(&Fixtures.json("menu-board.json")) { case Ok(found) => found case Err(why) => panic("menu fixture: " + Json.explainDecode(&why)) }
  let noMedia = Media.empty()
  let photo = |id: Str, kind: Str, kindType: Str, label: Str| Media.MediaFile{id: id, kind: kind, mediaType: kindType, label: label, bytes: 1000, url: "https://test.supabase.co/storage/v1/object/public/place-media/p/" + id}
  let pictured = Media.Gallery{isOwner: true, files: [photo("c1", "cover", "image/webp", ""), photo("g1", "gallery", "image/webp", ""), photo("m1", "menu", "application/pdf", "<b>Lunch</b>"), photo("m2", "menu", "image/jpeg", "")]}
  let menuReader = Html.render(&MenuPage.render(&en, &fonda, &menus, &noMedia))
  let spanishMenu = Html.render(&MenuPage.render(&es, &fonda, &menus, &noMedia))
  let privateMenu = Html.render(&MenuPage.render(&en, &fonda, &Menu.MenuBoard{..menus, isOwner: true, menus: menus.menus.map(|menu: Menu.MenuListing| Menu.MenuListing{..menu, status: "draft"})}, &noMedia))
  let emptyMenu = Html.render(&MenuPage.render(&en, &fonda, &Menu.MenuBoard{..menus, menus: []}, &noMedia))
  let unsafeMenu = Html.render(&MenuPage.render(&en, &fonda, &Menu.MenuBoard{..menus, menus: menus.menus.map(|menu: Menu.MenuListing| Menu.MenuListing{..menu, name: "<script>unsafe</script>"})}, &noMedia))
  let menuEntry = H.render(&MenuPage.link(&en, fonda.card.slug, &Some(menus)))
  let unsupportedMenu = H.render(&MenuPage.link(&en, fonda.card.slug, &Some(Menu.MenuBoard{..menus, supported: false, menus: []})))
  let ownerMenu = Html.render(&MenuPage.render(&en, &fonda, &Menu.MenuBoard{..menus, isOwner: true}, &noMedia))
  let picturedMenu = Html.render(&MenuPage.render(&en, &fonda, &menus, &pictured))
  let picturedPlace = Html.render(&PlacePage.render(&en, &profiled, &fonda, &ownerBoard, &None, &pictured, &Review.blank(), &None))
  let bareMenu = Html.render(&MenuPage.render(&en, &fonda, &menus, &noMedia))
  let mediaManager = Html.render(&MediaPage.render(&en, &fonda, &pictured, true))
  let photoOnlyManager = Html.render(&MediaPage.render(&es, &fonda, &Media.Gallery{isOwner: true, files: []}, false))
  let guestEdit = !menuReader.contains("/menu/edit")
  let editing = MenuDraft.MenuEditing{draft: MenuDraft.fromListing(&menus.menus[0]), menuId: Some("menu-test"), revision: 2}
  let typed = MenuDraft.MenuEditing{..editing, draft: MenuDraft.MenuEditorDraft{..editing.draft, sections: [MenuDraft.MenuSectionInput{..editing.draft.sections[0], items: [MenuDraft.MenuDishInput{..editing.draft.sections[0].items[0], name: "<b>Typed</b>", price: "doce"}]}]}}
  let menuEditor = Html.render(&MenuFormPage.render(&en, &fonda, &editing, &None, false))
  let refusedEditor = Html.render(&MenuFormPage.render(&en, &fonda, &typed, &Some(Problem.Invalid([Problem.FieldError{field: "s.0.i.0.price", key: "menu.price_invalid"}])), false))
  let conflictEditor = Html.render(&MenuFormPage.render(&es, &fonda, &editing, &Some(Problem.Refused("menu_changed")), true))
  let newEditor = Html.render(&MenuFormPage.render(&en, &fonda, &MenuDraft.MenuEditing{draft: MenuDraft.blank("en"), menuId: None, revision: 0}, &None, false))
  let placePage = Html.render(&PlacePage.render(&mondayNoon, &profiled, &fonda, &ownerBoard, &None, &noMedia, &Review.blank(), &None))
  let guestPlace = Html.render(&PlacePage.render(&es, &profiled, &Place.Detail{..fonda, viewer: Place.Relation{signedIn: false, isOwner: false}}, &Review.ReviewBoard{..board, canReview: false}, &None, &noMedia, &Review.blank(), &None))
  let member: Profile.MyProfile = match Wire.decode(&Fixtures.json("my-profile.json")) { case Ok(found) => found case Err(_) => panic("profile fixture") }
  let memberFrame = Frame.Frame{..en, member: Some(member), formToken: "t"}
  let memberPlace = Html.render(&PlacePage.render(&memberFrame, &profiled, &Place.Detail{..fonda, viewer: Place.Relation{signedIn: true, isOwner: false}}, &board, &None, &noMedia, &Review.blank(), &None))
  let highlightsPlace = Html.render(&PlacePage.render(&en, &profiled, &fonda, &Review.ReviewBoard{..board, highlights: board.items}, &None, &pictured, &Review.blank(), &None))
  let refusedReview = Html.render(&PlacePage.render(&memberFrame, &profiled, &Place.Detail{..fonda, viewer: Place.Relation{signedIn: true, isOwner: false}}, &board, &None, &noMedia, &Review.ReviewDraft{rating: "", body: "corto", visited: "", companions: ""}, &Some(Problem.Invalid([Problem.FieldError{field: "rating", key: "review.rating_required"}, Problem.FieldError{field: "body", key: "review.body_length"}]))))
  let placePinJson = Json.encode(&MapPage.combinedPins(&en, &[], &[Place.Listing{..fonda.card, mapIconUrl: Some("/assets/listings/example.png")}]))
  let placeMap = Html.render(&MapPage.renderPlaces(&en, &[], &[fonda.card], false, false, &profiled, &Search.everything(), "/search"))
  let placeCard = Html.render(&PlaceCard.card(&mondayNoon, &profiled, &fonda.card).html())
  let placeSearchFilters = Search.Filters{..Search.everything(), query: "Macdonald", category: "comida", municipality: "ponce"}
  let placeSearch = Html.render(&SearchPage.renderResults(&en, &profiled, &placeSearchFilters, &SearchPage.Open, &Event.Page{items: [], next: Some("event-cursor")}, &Place.Results{items: [fonda.card], next: Some("place&cursor")}))
  let secondPlace = Place.Listing{..fonda.card, id: "otra-fonda-id", slug: "otra-fonda", name: "Otra Fonda"}
  let rankedSearch = Html.render(&SearchPage.renderResults(&en, &profiled, &Search.everything(), &SearchPage.Open, &Event.Page{items: [detail.card], next: None}, &Place.Results{items: [fonda.card, secondPlace], next: None}))
  let laterPlaces = Html.render(&SearchPage.renderResults(&en, &profiled, &Search.everything(), &SearchPage.Open, &Event.Page{items: [], next: None}, &Place.Results{items: [fonda.card, secondPlace], next: None}, true))
  let areaPage = Html.render(&PlacePage.renderWith(&en, &profiled, &fonda, &board, &None, &noMedia, &Review.blank(), &None, &PlacePage.Area{townRank: 2, places: [fonda.card, secondPlace], activities: [detail.card]}, &Review.ALL_REVIEWS))
  let lowRank = Html.render(&PlacePage.renderWith(&en, &profiled, &fonda, &board, &None, &noMedia, &Review.blank(), &None, &PlacePage.Area{townRank: 40, places: [fonda.card], activities: []}, &Review.ALL_REVIEWS))
  let busyBoard = Review.ReviewBoard{..board, count: 5, companions: Json.object(&[("family", Json.Number(2)), ("solo", Json.Number(0))]), items: board.items.map(|r: Review.Review| Review.Review{..r, companions: Some("family")})}
  let filteredPage = Html.render(&PlacePage.renderWith(&memberFrame, &profiled, &Place.Detail{..fonda, viewer: Place.Relation{signedIn: true, isOwner: false}}, &busyBoard, &None, &noMedia, &Review.blank(), &None, &PlacePage.NO_AREA, &Review.filterOf("4", "family")))
  let emptyFiltered = Html.render(&PlacePage.renderWith(&en, &profiled, &fonda, &Review.ReviewBoard{..busyBoard, items: []}, &None, &noMedia, &Review.blank(), &None, &PlacePage.NO_AREA, &Review.filterOf("1", "")))
  let quietBoard = Html.render(&PlacePage.render(&en, &profiled, &fonda, &board, &None, &noMedia, &Review.blank(), &None))
  let rinconGuide: TownGuide.TownGuide = match Wire.decode(&Fixtures.json("town-guide.json")) { case Ok(found) => found case Err(_) => panic("town guide fixture") }
  let rinconTown = Catalog.Municipality{slug: "rincon", name: "Rincón", region: "oeste", lat: 18.34, lng: -67.25}
  let guidePanel = Html.render(&TownGuidePanel.panel(&en, &profiled, &rinconTown, &rinconGuide).html())
  let islandPanel = Html.render(&TownGuidePanel.panel(&es, &profiled, &rinconTown, &TownGuide.TownGuide{..rinconGuide, island: true, airport: None}).html())
  let signedOutReply = Respond.problemJson(&Problem.SignedOut, true)
  let unavailableReply = Respond.problemJson(&Problem.Unavailable("network"), true)
  let expiredCookies = Http.headerValues(&signedOutReply.headers, "set-cookie")
  let original = match Event.decodeDetail(&Fixtures.json("event-detail-guest.json")) { case Ok(d) => d case Err(_) => panic("detail fixture") }
  let curated = Event.Detail{..original, source: "curated", sourceUrl: Some("https://example.org/official"), card: Event.Card{..original.card, source: "curated"}}
  let curatedActivity = Html.render(&ActivityPage.render(&en, &ParticipationService.Activity{requests: [], saved: [], searches: [], organizing: [curated.card]}))
  let nativeActivity = Html.render(&ActivityPage.render(&en, &ParticipationService.Activity{requests: [], saved: [], searches: [], organizing: [original.card]}))
  let nativeEndedOwner = Html.render(&EventPage.render(&en, &Event.Detail{..original, card: Event.Card{..original.card, status: "ended"}, viewer: Event.Viewer{..original.viewer, signedIn: true, isOrganizer: true}}, &None))
  let curatedGuest = Html.render(&EventPage.render(&en, &curated, &None))
  let curatedEs = Html.render(&EventPage.render(&es, &curated, &None))
  let curatedOwner = Html.render(&EventPage.render(&en, &Event.Detail{..curated, viewer: Event.Viewer{..curated.viewer, signedIn: true, isOrganizer: true}}, &None))
  let curatedMember = Html.render(&EventPage.render(&en, &Event.Detail{..curated, viewer: Event.Viewer{..curated.viewer, signedIn: true}}, &None))
  let defaultCoverPage = Html.render(&EventCoverPage.render(&en, &detail, &[]))
  let sourceCoverPage = Html.render(&EventCoverPage.render(&en, &Event.Detail{..detail, card: Event.Card{..detail.card, coverUrl: Some("https://example.test/official.jpg")}}, &[]))
  let uploadedCoverPage = Html.render(&EventCoverPage.render(&es, &detail, &[Media.MediaFile{id: "c9", kind: "cover", mediaType: "image/webp", label: "", bytes: 10, url: "https://test.supabase.co/storage/v1/object/public/place-media/events/e/c9.webp"}]))
  let organizerReactions = Html.render(&EventPage.render(&en, &Event.Detail{..detail, viewer: Event.Viewer{..detail.viewer, signedIn: true, isOrganizer: true}}, &None))
  let memberReactions = Html.render(&EventPage.render(&en, &Event.Detail{..detail, viewer: Event.Viewer{..detail.viewer, signedIn: true}}, &None))
  let cancelledReactions = Html.render(&EventPage.render(&en, &Event.Detail{..detail, card: Event.Card{..detail.card, status: "cancelled"}, viewer: Event.Viewer{..detail.viewer, signedIn: true}}, &None))
  let curatedEnded = Html.render(&EventPage.render(&en, &Event.Detail{..curated, card: Event.Card{..curated.card, status: "ended"}}, &None))
  let curatedCancelled = Html.render(&EventPage.render(&en, &Event.Detail{..curated, card: Event.Card{..curated.card, status: "cancelled"}}, &None))
  let badSource = Event.Detail{..curated, sourceUrl: Some("javascript:alert(1)")}
  let unavailable = Html.render(&EventPage.render(&en, &badSource, &None))
  let sourceCard = Html.render(&EventCard.card(&en, &curated.card).html())
  let profile: Profile.PublicProfile = match Wire.decode(&Fixtures.json("public-profile.json")) { case Ok(p) => p case Err(_) => panic("profile fixture") }
  let noBadges = Achievement.Showcase{total: 0, items: []}
  let adminEn = Html.render(&ProfilePage.render(&en, &Profile.PublicProfile{..profile, isAdmin: true}, &noBadges))
  let adminEs = Html.render(&ProfilePage.render(&es, &Profile.PublicProfile{..profile, isAdmin: true}, &noBadges))
  let resumeFrame = Frame.Frame{..en, query: "from=share&resume=going"}
  let guestPage = Html.render(&EventPage.render(&en, &detail, &None))
  let resumedGoing = Html.render(&EventPage.render(&resumeFrame, &Event.Detail{..detail, viewer: Event.Viewer{..detail.viewer, signedIn: true}}, &None))
  let alreadyGoing = Html.render(&EventPage.render(&resumeFrame, &Event.Detail{..detail, viewer: Event.Viewer{..detail.viewer, signedIn: true, interest: Some("going")}}, &None))
  let guestResume = Html.render(&EventPage.render(&resumeFrame, &detail, &None))
  let resumedLike = Html.render(&EventPage.render(&Frame.Frame{..en, query: "resume=like"}, &Event.Detail{..detail, viewer: Event.Viewer{..detail.viewer, signedIn: true}}, &None))
  let signInResume = Html.render(&Auth.signIn(&en, &Auth.Typed{displayName: "", email: "", returnTo: "/e/plaza?resume=going"}, &None))
  let signInPlain = Html.render(&Auth.signIn(&en, &Auth.Typed{displayName: "", email: "", returnTo: "/e/plaza"}, &None))
  let checks = Test.suite("Presentation", &[
      Test.that("a town guide gives the drive, the driest months and the year by month", guidePanel.contains("About 2 h 7 min by car from the main airport") && guidePanel.contains("Driest months: January, February, March") && guidePanel.contains("class=\"climate-strip\"") && guidePanel.contains("climate-month is-best")),
      Test.that("a town guide cites its climate source and links categories to the town listing", guidePanel.contains("NOAA") && guidePanel.contains("/pueblo/rincon?category=")),
      Test.that("an island's guide says how to get there instead of a drive", islandPanel.contains("lancha desde Ceiba") && !islandPanel.contains("en carro")),
      Test.that("busy reviews offer star and companion filters that find something", filteredPage.contains("class=\"review-filters chips\"") && filteredPage.contains("estrellas=4&amp;con=family#reviews") && filteredPage.contains(">Family<") && !filteredPage.contains("con=solo")),
      Test.that("the active filters are marked", filteredPage.contains("class=\"chip chip-active\" href=\"/lugar/") && filteredPage.contains("aria-current=\"true\"")),
      Test.that("a review says who the visit was with, and the form asks", filteredPage.contains("Went with family") && filteredPage.contains("name=\"companions\"") && filteredPage.contains("Who did you go with?")),
      Test.that("a filter that finds nothing offers every review again", emptyFiltered.contains("No reviews match this filter.")),
      Test.that("a place with few reviews shows no filters", !quietBoard.contains("review-filters")),
      Test.that("a place page shows the area with nearby places and activities, without itself", areaPage.contains("id=\"place-area\"") && areaPage.contains("Otra Fonda") && areaPage.contains("href=\"#place-area\"") && areaPage.contains(detail.card.title)),
      Test.that("a place in its town's top ten says so", areaPage.contains("#2 of places in")),
      Test.that("a lower rank and an area of only itself stay quiet", !lowRank.contains("of places in") && !lowRank.contains("id=\"place-area\"")),
