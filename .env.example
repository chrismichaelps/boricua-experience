# Development settings. Copy to .env (gitignored). Never put production values here: production
# secrets live only in the Vercel project, and scripts/dev.sh refuses the production project.

# The hosted development project (boricua-experience-dev): Project Settings → API.
# For the local Docker stack instead, use http://127.0.0.1:54321 and the keys `supabase status` prints.
BORICUA_SUPABASE_URL=https://<dev-project-ref>.supabase.co
BORICUA_SUPABASE_ANON_KEY=
BORICUA_SUPABASE_SERVICE_KEY=
BORICUA_SUPABASE_PUBLISHABLE_KEY=
# The development database password; scripts/dev-db.sh uses it to apply migrations and the seed.
BORICUA_DB_PASSWORD=
BORICUA_SITE_URL=http://localhost:8080
# 32 random bytes as hex, different from production: openssl rand -hex 32
BORICUA_SESSION_KEY=

# The development Google OAuth client (not the production one); scripts/dev-db.sh pushes it to the
# development project's auth settings.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
