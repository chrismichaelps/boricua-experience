# Development settings. Copy to .env (gitignored). Never put production values here: production
# secrets live only in the Vercel project, and scripts/dev.sh refuses the production project.

# The hosted development project (boricua-experience-dev): Project Settings → API.
# For the local Docker stack instead, use http://127.0.0.1:54321 and the keys `supabase status` prints.
BORICUA_SUPABASE_URL=https://<dev-project-ref>.supabase.co
BORICUA_SUPABASE_ANON_KEY=
BORICUA_SUPABASE_SERVICE_KEY=
BORICUA_SUPABASE_PUBLISHABLE_KEY=
# The development database password; scripts/dev-db.sh uses it to apply migrations and the seed.
BORICUA_DB_PASSWORD=
BORICUA_SITE_URL=http://localhost:8080
# 32 random bytes as hex, different from production: openssl rand -hex 32
BORICUA_SESSION_KEY=

# The development Google OAuth client (not the production one); scripts/dev-db.sh pushes it to the
# development project's auth settings.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Public Node proxy8080 forwards normal requests to the internal Pudu server.
BORICUA_PORT=8082
BORICUA_ASSISTANT_BRIDGE_URL=http://127.0.0.1:8082
# Optional free-only server key; never expose through browser variables.
BORICUA_OPENROUTER_KEY=
# Daily media cleanup: the platform scheduler sends it as a bearer token. Empty disables the route.
CRON_SECRET=

# Contact relay (optional): a sending-only provider key, the team's private inbox and the sender.
# The inbox never appears in a page. Without a key, messages are only recorded.
# Optional: the site's own Google OAuth client (the same one the identity provider's Google sign-in
# uses). With both set, Google returns to /auth/google/callback on this site, so its consent screen
# names this site instead of the identity provider's address. Leave empty to keep the provider flow.
BORICUA_GOOGLE_CLIENT_ID=
BORICUA_GOOGLE_CLIENT_SECRET=
BORICUA_RESEND_KEY=
BORICUA_CONTACT_TO=
BORICUA_MAIL_FROM=Boricua Experience <hola@boricuaexperience.com>
